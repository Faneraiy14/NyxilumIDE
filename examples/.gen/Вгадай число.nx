// Програма з блоків «Вгадай число» - код створено Nyx IDE.

// Відповідь-число стає числом (щоб з нею можна було рахувати).
func _відповідь(t) {
    var s = trim(t)
    try {
        return toDouble(s)
    } catch (e) {
        return s
    }
}

func main() {
    var число = 0
    var спроби = 0
    var відповідь = 0
    print("Я загадав число від 1 до 100. Вгадай!")
    число = randomInt(1, 100)
    спроби = 0
    while (true) {
        printNoNewLine("Твоє число?" + " ")
        відповідь = _відповідь(readLine())
        спроби = спроби + 1
        if (відповідь == число) {
            print("Вгадав! Спроб: " + toString(спроби))
            exit(0)
        }
        if (відповідь < число) {
            print("Більше!")
        }
        if (відповідь > число) {
            print("Менше!")
        }
    }
}
