// Програма з блоків «Список покупок» - код створено Nyx IDE.

// Відповідь-число стає числом (щоб з нею можна було рахувати).
func _відповідь(t) {
    var s = trim(t)
    try {
        return toDouble(s)
    } catch (e) {
        return s
    }
}

// Списки для блоків «Змінні»: номери елементів - з 1, як у Scratch.
func _елемент(список, n) {
    var i = toInt(n) - 1
    if (i < 0 || i >= len(список)) { return "" }
    return список[i]
}

func main() {
    var відповідь = 0
    var покупки = []
    print("Складемо список покупок (3 речі).")
    for крок1 in 0..3 {
        printNoNewLine("Що купити?" + " ")
        відповідь = _відповідь(readLine())
        append(покупки, відповідь)
    }
    print("Твій список:")
    print(покупки)
    print("Усього: " + toString(len(покупки)))
}
