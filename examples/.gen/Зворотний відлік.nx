// Програма з блоків «Зворотний відлік» - код створено Nyx IDE.

// Відповідь-число стає числом (щоб з нею можна було рахувати).
func _відповідь(t) {
    var s = trim(t)
    try {
        return toDouble(s)
    } catch (e) {
        return s
    }
}

func main() {
    var секунди = 0
    секунди = 10
    for крок1 in 0..10 {
        print(секунди)
        секунди = секунди - 1
        sleep(toInt(1 * 1000))
    }
    print("Старт!")
}
