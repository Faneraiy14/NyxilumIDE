// Програма з блоків «Сонечко» - код створено Nyx IDE.

// Відповідь-число стає числом (щоб з нею можна було рахувати).
func _відповідь(t) {
    var s = trim(t)
    try {
        return toDouble(s)
    } catch (e) {
        return s
    }
}

// Сцена для блоків «Малювання».
var _s = null
func _сцена(w, h) {
    if (_s == null) { _s = surfaceOpen("Сцена", toInt(w), toInt(h)) }
}
func _готово() {
    if (_s == null) { _сцена(480, 360) }
    if (!surfaceIsOpen(_s)) { exit(0) }
}
func _очистити(c) {
    _готово()
    surfaceClear(_s, c)
}
func _коло(x, y, r, c) {
    _готово()
    surfaceCircle(_s, toInt(x), toInt(y), toInt(r), c)
}
func _прямокутник(x, y, w, h, c) {
    _готово()
    surfaceRect(_s, toInt(x), toInt(y), toInt(w), toInt(h), c)
}
func _лінія(x1, y1, x2, y2, c) {
    _готово()
    surfaceLine(_s, toInt(x1), toInt(y1), toInt(x2), toInt(y2), c, 3)
}
func _текст(t, x, y, c) {
    _готово()
    surfaceText(_s, toString(t), toInt(x), toInt(y), 20, c)
}
func _показати() {
    _готово()
    surfacePresent(_s)
    var e = surfaceNextEvent(_s, 0)
    while (e != null) { e = surfaceNextEvent(_s, 0) }
    if (!surfaceIsOpen(_s)) { exit(0) }
}
func _клавіша(k) {
    _готово()
    return surfaceKeyDown(_s, k)
}
func _мишаX() {
    _готово()
    return surfaceMouseX(_s)
}
func _мишаY() {
    _готово()
    return surfaceMouseY(_s)
}

func main() {
    _сцена(480, 360)
    _очистити(4243696)
    _коло(380, 80, 50, 15781920)
    _прямокутник(0, 280, 480, 80, 3194944)
    _прямокутник(120, 180, 120, 100, 9067056)
    _прямокутник(160, 220, 40, 60, 15781920)
    _лінія(110, 180, 180, 120, 15216688)
    _лінія(180, 120, 250, 180, 15216688)
    _текст("Мій будиночок", 20, 20, 16777215)
    _показати()
    while (_s != null && surfaceIsOpen(_s)) { _показати()  sleep(30) }
}
