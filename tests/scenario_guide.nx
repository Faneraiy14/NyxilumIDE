// Сценарій навчання: перший запуск відкриває урок 1 у блоках; "Покажи мені"
// сама збирає програму й запускає її; урок зараховується; приклади.
// NX_HEADLESS=1 nx tests/scenario_guide.nx <нова-тека> <тека-для-png>
import "../src/ide.nx" { ideInit, ideStep, ideShutdown, app, currentBlocks, doAction, draw }
import "../src/guide.nx" { LESSONS }
import "../src/blocks_model.nx" { generateCode }

func check(cond, msg) {
    if (!cond) { throw "ПРОВАЛ: " + msg }
    print("ok - " + msg)
}

func typeConsole(t) {
    var i = 0
    while (i < len(t)) {
        var m = newMap()
        mapSet(m, "type", "text")
        mapSet(m, "text", t[i])
        surfacePostEvent(S, m)
        i = i + 1
    }
    var k = newMap()
    mapSet(k, "type", "key") mapSet(k, "key", "Enter") mapSet(k, "ctrl", false) mapSet(k, "shift", false)
    surfacePostEvent(S, k)
}

// Прокрутити показ до кінця (і запуск програми), відповідаючи на питання.
func playDemo(answer, maxMs) {
    doAction("g.demo")
    var t0 = timeMs()
    var answered = false
    while (timeMs() - t0 < maxMs && (app.demo != null || app.con.running)) {
        ideStep(16)
        if (answer != "" && !answered && app.demo == null && app.con.running && contains(toString(app.con.lines), "?")) {
            typeConsole(answer)
            answered = true
        }
    }
    ideStep(0)
    ideStep(0)
}

func main() {
    var dir = scriptArgs()[0]
    var out = scriptArgs()[1]
    ideInit(dir)
    ideStep(0)

    // екскурсія: перший запуск починається з неї
    check(app.tour == 0, "перший запуск: екскурсія")
    surfaceSave(S, out + "/t00.png")
    doAction("t.next")
    draw()
    surfaceSave(S, out + "/t01_files.png")
    doAction("t.next")
    // крок зі стрілкою: показ сам згортає й розгортає панель
    var sawCollapsed = false
    var t0 = timeMs()
    while (timeMs() - t0 < 8000 && app.demo != null) {
        ideStep(16)
        if (app.filesCollapsed) {
            if (!sawCollapsed) { surfaceSave(S, out + "/t02_collapsed.png") }
            sawCollapsed = true
        }
    }
    check(sawCollapsed && !app.filesCollapsed, "показ згорнув і розгорнув панель програм")
    var step = 3
    while (step < 12) {
        doAction("t.next")
        draw()
        if (step == 5 || step == 8) { surfaceSave(S, out + "/t0" + toString(step) + ".png") }
        step = step + 1
    }
    check(app.tour == -1, "екскурсію пройдено")
    check(app.guideOpen && app.guideLesson == 0 && app.mode == "blocks", "після екскурсії - урок 1 у режимі блоків")
    surfaceSave(S, out + "/g01_lesson1.png")

    var ws = currentBlocks()
    check(endsWith(app.currentB, "Урок 1.nxb") && len(ws.stacks) == 1 && ws.stacks[0].next == null, "урок 1 - своя чиста програма з шапкою")

    playDemo("", 20000)
    print(generateCode(ws.stacks, "x")[0])
    print(app.con.lines)
    check(contains(app.con.lastOutput, "Привіт, світе!"), "показ уроку 1 зібрав і запустив програму")
    check(indexOf(app.done, LESSONS[0].title) >= 0, "урок 1 зараховано")
    surfaceSave(S, out + "/g02_lesson1_done.png")

    doAction("g.next")
    ws = currentBlocks()
    check(endsWith(app.currentB, "Урок 2.nxb") && ws.stacks[0].next == null, "урок 2 - нова чиста програма")
    playDemo("Сева", 30000)
    print(generateCode(ws.stacks, "x")[0])
    check(contains(app.con.lastOutput, "Привіт, Сева"), "показ уроку 2: питання й відповідь")
    check(indexOf(app.done, LESSONS[1].title) >= 0, "урок 2 зараховано")

    doAction("g.next")
    ws = currentBlocks()
    playDemo("", 30000)
    print(generateCode(ws.stacks, "x")[0])
    check(indexOf(app.done, LESSONS[2].title) >= 0, "урок 3 (повторення) зараховано")
    surfaceSave(S, out + "/g03_lesson3.png")

    // "Почати спочатку" лишає тільки шапку
    doAction("bclear")
    check(len(ws.stacks) == 1 && ws.stacks[0].spec == "start" && ws.stacks[0].next == null, "«Почати спочатку» лишає шапку")

    // історія версій
    doAction("history")
    check(app.histOpen && !app.guideOpen, "панель історії відкрито")
    doAction("h.save")
    app.dialog.text = "порожня програма"
    doAction("dialog.ok")
    check(len(app.histList) == 1, "версію збережено")
    doAction("g.next")
    doAction("help")
    doAction("history")
    surfaceSave(S, out + "/g05_history.png")
    doAction("help")

    doAction("g.tab.examples")
    ideStep(0)
    surfaceSave(S, out + "/g04_examples.png")
    doAction("g.ex:Вгадай число.nxb")
    check(app.mode == "blocks" && endsWith(app.currentB, "Вгадай число.nxb"), "приклад відкрито в блоках")
    doAction("g.ex:привіт.nx")
    check(app.mode == "code" && contains(app.current, "привіт"), "приклад коду відкрито")

    ideShutdown()
    check(contains(readFile(dir + "/.nyx/уроки.json"), "Повторення"), "прогрес збережено")
    print("СЦЕНАРІЙ НАВЧАННЯ ПРОЙДЕНО")
}
