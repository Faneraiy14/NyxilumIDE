// Сценарій режиму "Код" у новому вигляді (як VS Code): Провідник, вкладки,
// друк, підказки, запуск з введенням, помилка, автодоповнення, пошук,
// палітра команд, історія версій.
// NYX_IDE_CONFIG=<файл> NX_HEADLESS=1 nx tests/scenario_code.nx <тека> <тека-для-png>
import "helpers.nx"
import "../src/ide.nx" { ideInit, ideStep, ideShutdown, app, currentEditor, currentBlocks, doAction, draw, openPath, setMode }
import "../src/editor.nx" { edText, edHasSel }

func main() {
    var a = scriptArgs()
    var dir = a[0]
    outDir = a[1]
    presetConfig("middle", false, true, true)
    ideInit(dir)
    step()
    shot("01_start")
    var ed = currentEditor()
    check(ed != null && len(ed.lines) > 5, "відкрито приклад привіт.nx (" + toString(len(app.tabs)) + " вкладка)")
    check(app.side == "files" && app.panelOpen, "Провідник і нижня панель відкриті")

    // новий файл - як у VS Code: іконка в заголовку Провідника, назва прямо в дереві
    clickId("ex.newfile")
    check(app.entry != null && app.entry.mode == "newfile", "з'явився рядок для назви нового файла")
    typeText("тест")
    shot("01b_entry")
    key("Enter", false, false)
    step()
    ed = currentEditor()
    check(endsWith(ed.path, "тест.nx") && len(app.tabs) == 2, "створено тест.nx (без розширення - .nx) у новій вкладці")

    key("a", true, false)
    key("Delete", false, false)
    typeText("func main() {\nvar x = 0x10\nprint(\"Число: \" + toString(x))\nprintNoNewLine(\"Ім'я? \")\nvar n = readLine()\nprint(\"Привіт, \" + n)\n")
    step()
    var text = edText(ed)
    check(contains(text, "    var x = 0x10"), "автовідступ всередині {")
    check(endsWith(trim(text), "}"), "автодужка } у кінці")
    shot("02_typed")

    // запуск і відповідь програмі
    key("F5", false, false)
    step()
    var t0 = timeMs()
    while (timeMs() - t0 < 5000 && !contains(toString(app.con.lines), "Ім'я?")) { ideStep(50) }
    check(contains(toString(app.con.lines), "Число: 16"), "програма вивела Число: 16")
    typeText("Сева")
    key("Enter", false, false)
    t0 = timeMs()
    while (timeMs() - t0 < 5000 && app.con.running) { ideStep(50) }
    step()
    check(contains(toString(app.con.lines), "Привіт, Сева"), "введення дійшло до програми")
    check(contains(toString(app.con.lines), "Готово"), "програма завершилась успішно")
    shot("03_ran")

    // помилка -> червоний рядок + підказка + "Проблеми"
    key("End", true, false)
    typeText("\nfunc зламано() {\nprint(немає)\n")
    key("Home", true, false)
    key("Down", false, false)
    key("End", false, false)
    typeText("\nзламано()")
    key("F5", false, false)
    t0 = timeMs()
    step()
    while (timeMs() - t0 < 5000 && app.con.running) { ideStep(50) }
    step()
    step()
    check(ed.errLine >= 0, "рядок з помилкою підсвічено: " + toString(ed.errLine + 1))
    check(contains(toString(app.con.lines), "Підказка:"), "у консолі є підказка до помилки")
    check(len(app.problems) > 0, "помилка є у вкладці «Проблеми»")
    clickId("status.problems")
    check(app.panelTab == "problems", "клік по лічильнику в рядку стану відкриває «Проблеми»")
    shot("04_error")
    clickId("ptab:console")

    // автодоповнення і пошук
    key("End", true, false)
    typeText("\nprin")
    step()
    check(ed.acOpen && len(ed.acItems) > 0, "автодоповнення відкрилось")
    while (ed.acItems[ed.acSel][0] != "print") { key("Down", false, false)  step() }
    key("Enter", false, false)
    step()
    check(endsWith(ed.lines[ed.cy], "print()"), "вставлено print()")
    key("z", true, false)
    key("z", true, false)
    step()
    key("f", true, false)
    typeText("Число")
    step()
    check(ed.findOpen && edHasSel(ed) && contains(ed.lines[ed.cy], "Число"), "Ctrl+F знайшов «Число»")
    key("Escape", false, false)
    step()
    check(!ed.findOpen, "Escape закрив пошук")

    // палітра команд і швидке відкриття
    key("p", true, true)
    step()
    check(app.palette != null, "Ctrl+Shift+P відкриває палітру команд")
    typeText("бічну")
    step()
    check(len(app.palette.items) == 1, "палітра фільтрує команди")
    clickId("pal:0")
    step()
    check(app.side == "", "команда з палітри сховала бічну панель")
    key("b", true, false)
    step()
    check(app.side == "files", "Ctrl+B повернув бічну панель")
    key("p", true, false)
    typeText("привіт")
    step()
    key("Enter", false, false)
    step()
    check(endsWith(app.active, "привіт.nx"), "Ctrl+P відкрив привіт.nx")
    clickId("tab:" + dir + "/тест.nx")
    check(endsWith(app.active, "тест.nx"), "клік по вкладці перемикає файл")

    // пошук у файлах
    key("f", true, true)
    typeText("Привіт")
    step()
    check(app.side == "search" && len(app.searchResults) >= 2, "пошук у файлах знайшов " + toString(len(app.searchResults)))
    shot("05_search")
    key("Escape", false, false)

    // історія версій
    ed = currentEditor()
    doAction("act:history")
    doAction("h.save")
    app.dialog.text = "версія з помилкою"
    doAction("dialog.ok")
    check(len(app.histList) == 1, "версію збережено")
    var savedText = edText(ed)
    key("End", true, false)
    typeText("\n// новий рядок")
    step()
    doAction("h.sel:0")
    draw()
    var plus = 0
    for r in app.histDiff { if (r[0] == "+") { plus = plus + 1 } }
    check(plus >= 1, "diff показує доданий рядок")
    shot("06_history")
    doAction("h.restore")
    check(edText(ed) == savedText, "версію повернуто")
    key("z", true, false)
    step()
    check(contains(edText(ed), "// новий рядок"), "повернення можна скасувати Ctrl+Z")

    // Провідник: нова тека, файл у ній, перейменування, видалення
    clickId("act:files")
    clickId("ex.newdir")
    typeText("ігри")
    key("Enter", false, false)
    step()
    check(dirExists(dir + "/ігри") && app.exSel == dir + "/ігри", "створено теку «ігри»")
    clickId("ex.newfile")
    check(app.entry.dir == dir + "/ігри", "новий файл - у виділеній теці")
    typeText("змійка.nxb")
    key("Enter", false, false)
    step()
    check(fileExists(dir + "/ігри/змійка.nxb") && endsWith(app.active, "змійка.nxb"), "у теці створено програму з блоків")
    draw()
    var fr = uiFind("file:" + dir + "/ігри/змійка.nxb")
    check(fr != null, "файл видно в дереві під текою")
    ev("mousedown", fr[0] + 40, fr[1] + 10)
    var m3 = newMap()
    mapSet(m3, "type", "mousedown") mapSet(m3, "x", fr[0] + 40) mapSet(m3, "y", fr[1] + 10) mapSet(m3, "button", 3)
    surfacePostEvent(S, m3)
    ev("mouseup", fr[0] + 40, fr[1] + 10)
    step()
    check(app.ctx != null && len(app.ctx.items) == 4, "права кнопка - меню файла")
    shot("07_ctx")
    clickId("ctx:rename")
    check(app.entry != null && app.entry.mode == "rename" && app.entry.text == "змійка.nxb", "перейменування з поточною назвою")
    var bs = 0
    while (bs < 10) {
        key("Backspace", false, false)
        bs = bs + 1
    }
    typeText("пітон.nxb")
    key("Enter", false, false)
    step()
    check(fileExists(dir + "/ігри/пітон.nxb") && !fileExists(dir + "/ігри/змійка.nxb"), "файл перейменовано")
    check(endsWith(app.active, "пітон.nxb") && indexOf(app.tabs, dir + "/ігри/пітон.nxb") >= 0, "вкладка теж перейменувалась")
    // F2 по виділеній теці
    app.exSel = dir + "/ігри"
    key("F2", false, false)
    step()
    check(app.entry != null && app.entry.target == dir + "/ігри", "F2 - перейменувати виділене")
    key("Escape", false, false)
    step()
    check(app.entry == null, "Escape скасовує")
    // видалення теки з підтвердженням
    draw()
    var dr = uiFind("dir:" + dir + "/ігри")
    var m4 = newMap()
    mapSet(m4, "type", "mousedown") mapSet(m4, "x", dr[0] + 40) mapSet(m4, "y", dr[1] + 10) mapSet(m4, "button", 3)
    surfacePostEvent(S, m4)
    ev("mouseup", dr[0] + 40, dr[1] + 10)
    step()
    clickId("ctx:delete")
    check(app.dialog != null && app.dialog.action == "delete", "видалення питає підтвердження")
    shot("08_delete")
    clickId("dialog.ok")
    check(!dirExists(dir + "/ігри") && indexOf(app.tabs, dir + "/ігри/пітон.nxb") < 0, "теку видалено, її вкладки закрито")

    // закриття вкладки
    var before = len(app.tabs)
    key("w", true, false)
    step()
    check(len(app.tabs) == before - 1, "Ctrl+W закрив вкладку")

    // нескінченний цикл: "Зупинити" (F5 під час роботи) справді зупиняє
    clickId("ex.newfile")
    typeText("вічний")
    key("Enter", false, false)
    step()
    ed = currentEditor()
    key("a", true, false)
    key("Delete", false, false)
    typeText("func main() {\nvar i = 0\nwhile (true) {\ni = i + 1\n")
    key("F5", false, false)
    step()
    var t2 = timeMs()
    while (timeMs() - t2 < 800) { ideStep(50) }
    check(app.con.running, "нескінченна програма працює")
    key("F5", false, false)
    step()
    t2 = timeMs()
    while (timeMs() - t2 < 2000 && app.con.running) { ideStep(50) }
    check(!app.con.running && contains(toString(app.con.lines), "Зупинено"), "F5 / «Зупинити» зупинили програму")

    // код -> блоки: проста програма відкривається блоками й працює так само
    writeFile(dir + "/рахунок.nx", "func main() {\n    var n = 0\n    for i in 0..3 {\n        n = n + 2\n    }\n    print(\"Вийшло \" + toString(n))\n}\n")
    openPath(dir + "/рахунок.nx")
    doAction("codetoblocks")
    step()
    check(app.mode == "blocks" && endsWith(app.currentB, "рахунок (блоки).nxb"), "«Код: відкрити як блоки» - нова вкладка з блоками")
    check(len(currentBlocks().stacks) == 1 && currentBlocks().stacks[0].next.spec == "repeat", "блоки зібрано з коду")
    key("F5", false, false)
    step()
    var tb = timeMs()
    while (timeMs() - tb < 8000 && (app.con.running || !contains(toString(app.con.lines), "Готово"))) { ideStep(30) }
    check(contains(toString(app.con.lines), "Вийшло 6"), "програма з цих блоків працює")
    shot("c09_code_to_blocks")
    // що блоками не скласти - пояснення в консолі, режим не міняється
    writeFile(dir + "/складна.nx", "struct Точка {\n    x: i32\n}\nfunc main() {\n}\n")
    setMode("code")
    openPath(dir + "/складна.nx")
    doAction("codetoblocks")
    step()
    check(app.mode == "code" && contains(toString(app.con.lines), "Рядок 1: «struct» блоками не скласти"), "зрозуміла помилка, якщо блоками не скласти")

    ideShutdown()
    check(fileExists(dir + "/тест.nx"), "файл збережено на диск")
    print("СЦЕНАРІЙ ПРОЙДЕНО")
}
