// Модель блоків: генерація коду, збереження/завантаження, запуск згенерованого.
import "../src/blocks_model.nx"

func check(cond, msg) {
    if (!cond) { throw "ПРОВАЛ: " + msg }
    print("ok - " + msg)
}

func main() {
    var start = newBlock("start")
    var ask = newBlock("ask")
    var say = newBlock("say")
    var j = newBlock("join")
    j.args[0] = "Привіт, "
    var v = newBlock("var")
    v.args[0] = "відповідь"
    j.args[1] = v
    say.args[0] = j
    var rep = newBlock("repeat")
    rep.args[0] = "3"
    var s2 = newBlock("say")
    var r = newBlock("random")
    s2.args[0] = r
    rep.body = s2
    var cond = newBlock("ifelse")
    var eq = newBlock("eq")
    eq.args[0] = "1"
    eq.args[1] = "1"
    cond.args[0] = eq
    var yes = newBlock("say")
    var weird = "так $" + "{не інтерполяція} \"лапки\" $1"
    yes.args[0] = weird
    cond.body = yes
    var no = newBlock("say")
    no.args[0] = "ні"
    cond.body2 = no
    var setb = newBlock("set")
    setb.args[0] = "мій рахунок"
    setb.args[1] = "5"
    var ch = newBlock("change")
    ch.args[0] = "мій рахунок"
    var s3 = newBlock("say")
    var v2 = newBlock("var")
    v2.args[0] = "мій рахунок"
    s3.args[0] = v2
    start.next = ask
    ask.next = say
    say.next = rep
    rep.next = cond
    cond.next = setb
    setb.next = ch
    ch.next = s3

    var stray = newBlock("say")   // без шапки - не виконується
    stray.args[0] = "мене не видно"

    var g = generateCode([start, stray], "тест")
    var code = g[0]
    print(code)
    check(len(g[1]) == len(split(code, "\n")) - 1 || len(g[1]) == len(split(code, "\n")), "карта рядок->блок відповідає коду")
    check(!contains(code, "мене не видно"), "блоки без шапки не потрапляють у код")
    check(contains(code, "var мій_рахунок = 0"), "змінна оголошена з безпечною назвою")

    // запуск згенерованого коду
    var dir = scriptArgs()[0]
    writeFile(dir + "/gen.nx", code)
    var o = newMap()
    mapSet(o, "interactive", true)
    var h = procStart(nxPath(), [dir + "/gen.nx"], o)
    procWrite(h, "Сева\n")
    procWait(h)
    sleep(100)
    var out = procOutput(h)
    print(out)
    check(procExitCode(h) == 0, "згенерована програма працює")
    check(contains(out, "Привіт, Сева"), "запитати + з'єднати + змінна")
    check(contains(out, weird), "текст учня не ламає код")
    check(contains(out, "6"), "запам'ятати 5, збільшити на 1 = 6")

    // збереження і завантаження
    var json = stacksToJson([start, stray])
    var back = stacksFromJson(json)
    check(len(back) == 2, "збережено 2 стопки")
    var g2 = generateCode(back, "тест")
    check(g2[0] == code, "після завантаження той самий код")
    // Малювання: сцена, фігури, клавіша, миша, повторення з анімацією
    var st = newBlock("start")
    var sc = newBlock("scene")
    var rp = newBlock("repeat")
    rp.args[0] = "3"
    var cl = newBlock("clear")
    var ci = newBlock("circle")
    var mx = newBlock("mousex")
    ci.args[0] = mx
    var rc = newBlock("rect")
    var ln = newBlock("line")
    var tx = newBlock("text")
    var sh = newBlock("show")
    var wt = newBlock("wait")
    wt.args[0] = "0.05"
    var cond2 = newBlock("if")
    cond2.args[0] = newBlock("key")
    var say3 = newBlock("say")
    say3.args[0] = "натиснуто"
    cond2.body = say3
    cl.next = ci
    ci.next = rc
    rc.next = ln
    ln.next = tx
    tx.next = sh
    sh.next = wt
    wt.next = cond2
    rp.body = cl
    var fin = newBlock("say")
    fin.args[0] = "намальовано"
    var stop = newBlock("stop")
    st.next = sc
    sc.next = rp
    rp.next = fin
    fin.next = stop
    var gd = generateCode([st], "малюнок")
    writeFile(dir + "/draw.nx", gd[0])
    var r = procRun(nxPath(), [dir + "/draw.nx"])
    print(r.stdout + r.stderr)
    check(r.exitCode == 0 && contains(r.stdout, "намальовано"), "блоки малювання працюють (сцена без вікна)")

    // Рух і Вигляд: герой ходить, повертає, відбивається, каже, міняє костюм
    var hs = newBlock("start")
    var cos1 = newBlock("costume")
    cos1.args[0] = "ракета"
    var back = newBlock("backdrop")
    var rp2 = newBlock("repeat")
    rp2.args[0] = "40"
    var go1 = newBlock("go")
    var bo = newBlock("bounce")
    var tu = newBlock("turn")
    tu.args[0] = "5"
    go1.next = bo
    bo.next = tu
    rp2.body = go1
    var sy2 = newBlock("say2")
    var xs = newBlock("say")
    xs.args[0] = newBlock("herox")
    var en = newBlock("stop")
    hs.next = cos1
    cos1.next = back
    back.next = rp2
    rp2.next = sy2
    sy2.next = xs
    xs.next = en
    var gh = generateCode([hs], "герой")
    check(contains(gh[0], "func _кадр()") && contains(gh[0], "_іти(10)"), "код героя з прелюдією спрайтів")
    writeFile(dir + "/hero.nx", gh[0])
    var rh = procRun(nxPath(), [dir + "/hero.nx"])
    print(rh.stdout + rh.stderr)
    check(rh.exitCode == 0 && len(trim(rh.stdout)) > 0, "герой рухається без помилок, x = " + trim(rh.stdout))

    // списки і предмет
    var ls = newBlock("start")
    var add1 = newBlock("listadd")
    add1.args[0] = "яблуко"
    var add2 = newBlock("listadd")
    add2.args[0] = "груша"
    var sayLen = newBlock("say")
    sayLen.args[0] = newBlock("listlen")
    var sayIt = newBlock("say")
    var it2 = newBlock("listitem")
    it2.args[0] = "2"
    sayIt.args[0] = it2
    var sayOut = newBlock("say")
    var it9 = newBlock("listitem")
    it9.args[0] = "9"
    sayOut.args[0] = it9
    var ifHas = newBlock("if")
    ifHas.args[0] = newBlock("listhas")
    var sayHas = newBlock("say")
    sayHas.args[0] = "є яблуко"
    ifHas.body = sayHas
    var itm = newBlock("item")
    var gotoItem = newBlock("goto")
    gotoItem.args[0] = "100"
    gotoItem.args[1] = "100"
    var ifT = newBlock("if")
    ifT.args[0] = newBlock("touching")
    var sayT = newBlock("say")
    sayT.args[0] = "упіймав"
    ifT.body = sayT
    var fin2 = newBlock("stop")
    ls.next = add1
    add1.next = add2
    add2.next = sayLen
    sayLen.next = sayIt
    sayIt.next = sayOut
    sayOut.next = ifHas
    ifHas.next = itm
    itm.next = gotoItem
    gotoItem.next = ifT
    ifT.next = fin2
    var gl = generateCode([ls], "списки")
    check(contains(gl[0], "var список = []"), "список оголошено як []")
    writeFile(dir + "/lists.nx", gl[0])
    var rl = procRun(nxPath(), [dir + "/lists.nx"])
    print(rl.stdout + rl.stderr)
    var outs = split(trim(rl.stdout), "\n")
    check(rl.exitCode == 0 && outs[0] == "2" && outs[1] == "груша", "довжина 2, елемент 2 - груша")
    check(contains(rl.stdout, "є яблуко"), "список містить яблуко")
    check(contains(rl.stdout, "упіймав"), "герой торкається предмета")

    print("МОДЕЛЬ БЛОКІВ: УСЕ ГАРАЗД")
}
