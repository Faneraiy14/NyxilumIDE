{
    "id": "anylint",
    "name": "Anylint",
    "version": "1.1",
    "description": "Статичний аналіз коду: порожні catch, мертвий код після return, TODO, секрети в коді, складні функції, дублювання... Перевіряє файл після кожного збереження; команди - перевірити проєкт, виправити автоматично, звіт, прийняти поточні знахідки. Потрібні php і Anylint (github.com/Faneraiy14/anylint); шлях - змінна ANYLINT_BIN, інакше шукає ~/Projects/anylint.",
    "lint": {
        "files": [
            ".nx",
            ".php",
            ".js",
            ".ts",
            ".py",
            ".cs",
            ".java",
            ".c",
            ".cpp",
            ".go",
            ".rs"
        ],
        "script": "lint.nx"
    },
    "commands": [
        {
            "id": "project",
            "title": "Перевірити весь проєкт",
            "script": "project.nx"
        },
        {
            "id": "fix",
            "title": "Виправити автоматично (поточний файл)",
            "script": "fix.nx"
        },
        {
            "id": "fixall",
            "title": "Виправити автоматично (весь проєкт)",
            "script": "fixall.nx"
        },
        {
            "id": "report",
            "title": "Звіт про проєкт (HTML)",
            "script": "report.nx"
        },
        {
            "id": "baseline",
            "title": "Прийняти поточні знахідки (baseline)",
            "script": "baseline.nx"
        }
    ]
}