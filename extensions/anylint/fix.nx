// Команда «Anylint: Виправити автоматично (поточний файл)»:
//   nx fix.nx <тека проєкту> <поточний файл>
// anylint --fix сам переписує файл; IDE помітить зміну й перечитає редактор.
import "anylint.nx"

func main() {
    var a = scriptArgs()
    if (len(a) < 2 || a[1] == "") {
        print("Відкрий файл, який треба виправити.")
        exit(1)
    }
    print("Anylint виправляє " + a[1] + " ...")
    var r = anylintRunIn([a[1], "--fix"], a[0])
    if (r[2] != "") {
        print(r[2])
        exit(1)
    }
    print(r[1])
    if (r[0] == 0) { print("Готово - знахідок не лишилось.") }
    else { print("Що лишилось вище - автоматично не виправляється, треба руками.") }
}
