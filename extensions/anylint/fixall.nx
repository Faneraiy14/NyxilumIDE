// Команда «Anylint: Виправити автоматично (весь проєкт)»:
//   nx fixall.nx <тека проєкту> <поточний файл>
import "anylint.nx"

func main() {
    var dir = scriptArgs()[0]
    print("Anylint виправляє все в " + dir + " ...")
    var r = anylintRunIn([dir, "--fix", "--jobs", "auto"], dir)
    if (r[2] != "") {
        print(r[2])
        exit(1)
    }
    print(r[1])
    if (r[0] == 0) { print("Готово - знахідок не лишилось.") }
}
