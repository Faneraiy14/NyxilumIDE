// Екскурсія по IDE: по черзі підсвічує частини вікна (решта затемнена) і
// пояснює, що це. Крок може мати показ - IDE сама натискає (наприклад,
// згортає й розгортає панель програм стрілкою). Керування - у ide.nx.

import "theme.nx"
import "ui.nx"

// [області (id з uiRegion), назва, пояснення, показ]
var TOUR = [
    [[], "Привіт! Це Nyx IDE",
     "Тут можна навчитися програмувати з нуля, а потім писати справжні програми мовою NyxilumLang.\n\nЗараз я покажу, що тут до чого. Тисни «Далі» (або стрілку вправо на клавіатурі).", []],
    [["act:files", "side.panel"], "Провідник",
     "Тут лежать усі твої програми і теки. Клацни по файлу - він відкриється. «+ Код» і «+ Блоки» створюють нову програму. Теки розгортаються стрілочкою.", []],
    [["side.collapse"], "Згорнути й розгорнути",
     "Стрілочка ‹ згортає бічну панель, щоб було більше місця. Розгорнути - клацнути іконку зліва ще раз (або Ctrl+B).\n\nДивись - зараз я натисну сам.", [["click", "side.collapse"], ["wait", 1000], ["click", "act:files"]]],
    [["tabs"], "Вкладки",
     "Кожен відкритий файл - окрема вкладка, як у справжніх редакторах. Крапка - є незбережені зміни, хрестик - закрити (Ctrl+W).", []],
    [["bcatstrip"], "Категорії блоків",
     "Кольорові кружечки - групи блоків: Події, Вивід, Керування, Змінні, Оператори, Малювання. Клацни по кружечку - побачиш його блоки.", []],
    [["bpalette"], "Палітра",
     "Блоки вибраної категорії. Тягни блок мишею на робоче поле праворуч. Довгі блоки видно цілком, якщо прокрутити палітру (колесо, Shift+колесо).", []],
    [["bworkspace"], "Робоче поле",
     "Тут складаєш програму. Виконується все, що прилипло під жовту шапку «коли натиснуто Запустити», згори донизу. Порожнє місце можна тягнути мишею.", []],
    [["run"], "Запустити",
     "Зелена кнопка (або F5) запускає програму. Поки програма працює, кнопка стає червоною - «Зупинити».", []],
    [["panel"], "Консоль і Проблеми",
     "Внизу - консоль: сюди програма пише все, що «каже», а коли питає - відповідь пишеш тут же. Вкладка «Проблеми» збирає помилки й підказки. Сховати чи показати - Ctrl+J.", []],
    [["act:history"], "Історія версій",
     "Зберігай версії програми і дивись, що змінилось. Можна повернутися до старої версії - як справжні програмісти в git.", []],
    [["act:learn"], "Навчання",
     "Уроки з перевіркою і кнопкою «Покажи мені», а ще готові приклади: ігри, малюнки.", []],
    [["cmd.open"], "Усі команди",
     "Тут - пошук будь-якої команди (Ctrl+Shift+P) і швидке відкриття файла (Ctrl+P). Не знаєш, де щось - шукай тут.", []],
    [["act:settings"], "Налаштування",
     "Рівень (новачок, середній, просунутий), увімкнути чи вимкнути блоки, уроки, підказки і пропозиції гайду. Почнемо!", []]
]

// Прямокутник, що охоплює всі області кроку, або null.
func tourRect(ids) {
    var r = null
    for id in ids {
        var f = uiFind(id)
        if (f != null) {
            if (r == null) { r = [f[0], f[1], f[0] + f[2], f[1] + f[3]] }
            else { r = [min(r[0], f[0]), min(r[1], f[1]), max(r[2], f[0] + f[2]), max(r[3], f[1] + f[3])] }
        }
    }
    if (r == null) { return null }
    return [r[0], r[1], r[2] - r[0], r[3] - r[1]]
}

func _tourWrap(text, maxW, size) {
    var lines = []
    for para in split(text, "\n") {
        if (len(trim(para)) == 0) {
            append(lines, "")
            continue
        }
        var cur = ""
        for word in split(para, " ") {
            var cand = word
            if (cur != "") { cand = cur + " " + word }
            if (textWidth(cand, size) > maxW && cur != "") {
                append(lines, cur)
                cur = word
            } else { cur = cand }
        }
        if (cur != "") { append(lines, cur) }
    }
    return lines
}

func drawTour(step) {
    var W = surfaceWidth(S)
    var H = surfaceHeight(S)
    var st = TOUR[step]
    var r = tourRect(st[0])
    if (r != null && (r[2] <= 0 || r[3] <= 0)) { r = null }
    var dim = 0xb0000000
    if (r == null) { surfaceRect(S, 0, 0, W, H, dim) }
    else {
        var pad = 6
        var x0 = max(0, r[0] - pad)
        var y0 = max(0, r[1] - pad)
        var x1 = min(W, r[0] + r[2] + pad)
        var y1 = min(H, r[1] + r[3] + pad)
        surfaceRect(S, 0, 0, W, y0, dim)
        surfaceRect(S, 0, y1, W, H - y1, dim)
        surfaceRect(S, 0, y0, x0, y1 - y0, dim)
        surfaceRect(S, x1, y0, W - x1, y1 - y0, dim)
        surfaceRectLine(S, x0, y0, x1 - x0, y1 - y0, C_YELLOW, 3)
    }

    // плашка з поясненням: праворуч від області, інакше ліворуч/знизу/по центру
    var bw = 380
    var lines = _tourWrap(st[2], bw - 40, 16)
    var bh = 70 + len(lines) * 20 + 60
    var bx = toInt((W - bw) / 2)
    var by = toInt((H - bh) / 2)
    if (r != null) {
        if (r[0] + r[2] + 20 + bw < W) {
            bx = r[0] + r[2] + 20
            by = r[1]
        } else if (r[0] - 20 - bw > 0) {
            bx = r[0] - 20 - bw
            by = r[1]
        } else {
            bx = clamp(r[0], 10, W - bw - 10)
            by = r[1] + r[3] + 20
            if (by + bh > H) { by = r[1] - bh - 20 }
        }
        by = clamp(by, 10, max(10, H - bh - 10))
    }
    surfaceRoundRect(S, bx + 4, by + 4, bw, bh, 12, 0x88000000)
    surfaceRoundRect(S, bx, by, bw, bh, 12, C_PANEL)
    surfaceRoundRect(S, bx, by, bw, 6, 3, C_YELLOW)
    surfaceText(S, st[1], bx + 20, by + 22, 20, C_TEXT, true)
    var ly = by + 56
    for l in lines {
        surfaceText(S, l, bx + 20, ly, 16, C_SUBTEXT)
        ly = ly + 20
    }
    var n = toString(step + 1) + " з " + toString(len(TOUR))
    surfaceText(S, n, bx + 20, by + bh - 38, 14, C_DIM)
    var last = step == len(TOUR) - 1
    var nextLabel = "Далі →"
    if (last) { nextLabel = "Почнімо!" }
    uiButton("t.next", nextLabel, bx + bw - 130, by + bh - 46, 112, 34, "primary")
    if (step > 0) { uiButton("t.prev", "←", bx + bw - 180, by + bh - 46, 42, 34, "normal") }
    if (!last) { uiButton("t.skip", "Пропустити", bx + 90, by + bh - 46, 110, 34, "flat") }
}
