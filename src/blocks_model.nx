// Режим "Блоки": модель - які бувають блоки, як вони з'єднані, як із
// них виходить справжній код NyxilumLang і як вони зберігаються (.nxb).
//
// Блок має специфікацію (spec - id з таблиці SPECS), аргументи (args - для
// кожного "віконця" або рядок-значення, або вкладений блок-репортер),
// тіла (body, body2 - перший блок вкладеного ланцюжка для "повторити",
// "якщо ... інакше") і next - наступний блок під ним.

import "theme.nx"
import "builtins.nx"

struct Block {
    spec: string
    args: array
    body: any
    body2: any
    next: any
    x: i32
    y: i32
    sx: i32
    sy: i32
    w: i32
    hh: i32
    h: i32
}

// Вид блока: "hat" (шапка - з неї починається програма), "cmd" (команда),
// "c" (обіймає інші блоки), "c2" (якщо/інакше), "rep" (значення), "bool"
// (так/ні). У підписі %s - текст, %n - число, %b - умова, %v - змінна.
struct Spec {
    id: string
    kind: string
    cat: string
    label: string
    defs: array
    gen: string
}

var CATEGORIES = ["Події", "Рух", "Вигляд", "Вивід", "Керування", "Змінні", "Оператори", "Малювання", "Мої блоки"]
var CAT_COLORS = [0xd4a000, 0x2f9fd0, 0xc05ad8, 0x4c8fe8, 0xe8901a, 0xe8642c, 0x3faa4a, 0x8a5cf0, 0xe0508a]

// Костюми героя (віконце %h).
var COSTUMES = ["кіт", "м'яч", "ракета", "зірка", "робот"]

var SPECS = []
var _specById = null

func _spec(id, kind, cat, label, defs, gen) {
    append(SPECS, Spec { id: id, kind: kind, cat: cat, label: label, defs: defs, gen: gen })
}

func initSpecs() {
    if (_specById != null) { return }
    _specById = newMap()
    _spec("start", "hat", "Події", "коли натиснуто «Запустити»", [], "")

    _spec("say", "cmd", "Вивід", "сказати %s", ["Привіт!"], "print($1)")
    _spec("saynl", "cmd", "Вивід", "сказати в той самий рядок %s", ["..."], "printNoNewLine($1)")
    _spec("ask", "cmd", "Вивід", "запитати %s і запам'ятати в %v", ["Як тебе звати?", "відповідь"], "printNoNewLine($S1 + \" \")\n$2 = _відповідь(readLine())")

    _spec("repeat", "c", "Керування", "повторити %n разів", ["10"], "for крок$ID in 0..$I1 {")
    _spec("forever", "c", "Керування", "повторювати завжди", [], "while (true) {")
    _spec("while", "c", "Керування", "поки %b", [""], "while ($1) {")
    _spec("if", "c", "Керування", "якщо %b", [""], "if ($1) {")
    _spec("ifelse", "c2", "Керування", "якщо %b", [""], "if ($1) {")
    _spec("wait", "cmd", "Керування", "чекати %n секунд", ["1"], "sleep(toInt($1 * 1000))")
    _spec("stop", "cmd", "Керування", "зупинити програму", [], "exit(0)")

    _spec("set", "cmd", "Змінні", "запам'ятати в %v значення %s", ["рахунок", "0"], "$1 = $2")
    _spec("change", "cmd", "Змінні", "збільшити %v на %n", ["рахунок", "1"], "$1 = $1 + $2")
    _spec("var", "rep", "Змінні", "%v", ["рахунок"], "$1")
    // списки (%l - назва списку): номери елементів з 1, як у Scratch
    _spec("listadd", "cmd", "Змінні", "додати %s до списку %l", ["яблуко", "список"], "append($2, $1)")
    _spec("listitem", "rep", "Змінні", "елемент %n списку %l", ["1", "список"], "_елемент($2, $1)")
    _spec("listlen", "rep", "Змінні", "довжина списку %l", ["список"], "len($1)")
    _spec("listhas", "bool", "Змінні", "список %l містить %s", ["список", "яблуко"], "contains($1, $2)")
    _spec("listclear", "cmd", "Змінні", "очистити список %l", ["список"], "clear($1)")
    _spec("list", "rep", "Змінні", "список %l", ["список"], "$1")

    _spec("add", "rep", "Оператори", "%n + %n", ["", ""], "$1 + $2")
    _spec("sub", "rep", "Оператори", "%n - %n", ["", ""], "$1 - $2")
    _spec("mul", "rep", "Оператори", "%n × %n", ["", ""], "$1 * $2")
    _spec("div", "rep", "Оператори", "%n ÷ %n", ["", ""], "$1 / $2")
    _spec("mod", "rep", "Оператори", "остача від %n ÷ %n", ["", ""], "$1 % $2")
    _spec("random", "rep", "Оператори", "випадкове від %n до %n", ["1", "10"], "randomInt($1, $2)")
    _spec("round", "rep", "Оператори", "округлити %n", [""], "round($1)")
    _spec("join", "rep", "Оператори", "з'єднати %s %s", ["привіт ", "світе"], "$S1 + $S2")
    _spec("length", "rep", "Оператори", "довжина %s", ["слово"], "len($S1)")
    _spec("eq", "bool", "Оператори", "%s = %s", ["", ""], "$1 == $2")
    _spec("lt", "bool", "Оператори", "%n < %n", ["", ""], "$1 < $2")
    _spec("gt", "bool", "Оператори", "%n > %n", ["", ""], "$1 > $2")
    _spec("and", "bool", "Оператори", "%b і %b", ["", ""], "$1 && $2")
    _spec("or", "bool", "Оператори", "%b або %b", ["", ""], "$1 || $2")
    _spec("not", "bool", "Оператори", "не %b", [""], "!($1)")

    _spec("scene", "cmd", "Малювання", "відкрити сцену %n × %n", ["480", "360"], "_сцена($1, $2)")
    _spec("clear", "cmd", "Малювання", "залити сцену кольором %c", ["чорний"], "_очистити($1)")
    _spec("circle", "cmd", "Малювання", "коло x %n y %n радіус %n колір %c", ["240", "180", "40", "жовтий"], "_коло($1, $2, $3, $4)")
    _spec("rect", "cmd", "Малювання", "прямокутник x %n y %n ширина %n висота %n колір %c", ["100", "100", "80", "50", "синій"], "_прямокутник($1, $2, $3, $4, $5)")
    _spec("line", "cmd", "Малювання", "лінія від %n %n до %n %n колір %c", ["0", "0", "480", "360", "білий"], "_лінія($1, $2, $3, $4, $5)")
    _spec("text", "cmd", "Малювання", "текст %s x %n y %n колір %c", ["Привіт!", "20", "20", "білий"], "_текст($1, $2, $3, $4)")
    _spec("show", "cmd", "Малювання", "показати малюнок", [], "_показати()")
    _spec("key", "bool", "Малювання", "натиснуто клавішу %k", ["Right"], "_клавіша($1)")
    _spec("mousex", "rep", "Малювання", "миша x", [], "_мишаX()")
    _spec("mousey", "rep", "Малювання", "миша y", [], "_мишаY()")
    _spec("mousedown", "bool", "Малювання", "миша натиснута", [], "_мишаНатиснута()")

    // Рух і Вигляд: герой-спрайт, як у Scratch (src/prelude/спрайти.nx)
    _spec("go", "cmd", "Рух", "іти на %n кроків", ["10"], "_іти($1)")
    _spec("turn", "cmd", "Рух", "повернути на %n градусів", ["15"], "_повернути($1)")
    _spec("goto", "cmd", "Рух", "перейти в x %n y %n", ["240", "180"], "_перейти($1, $2)")
    _spec("changex", "cmd", "Рух", "змінити x на %n", ["10"], "_змінитиX($1)")
    _spec("changey", "cmd", "Рух", "змінити y на %n", ["10"], "_змінитиY($1)")
    _spec("point", "cmd", "Рух", "дивитися в напрямку %n", ["0"], "_напрям($1)")
    _spec("bounce", "cmd", "Рух", "якщо на краю - відбитися", [], "_відбитися()")
    _spec("herox", "rep", "Рух", "x героя", [], "round(_герX)")
    _spec("heroy", "rep", "Рух", "y героя", [], "round(_герY)")
    _spec("herodir", "rep", "Рух", "напрямок героя", [], "round(_герКут)")
    _spec("onedge", "bool", "Рух", "герой на краю", [], "_наКраю()")
    _spec("touching", "bool", "Рух", "герой торкається предмета", [], "_торкається()")
    _spec("costume", "cmd", "Вигляд", "показати героя %h", ["кіт"], "_костюм($1)")
    _spec("hide", "cmd", "Вигляд", "сховати героя", [], "_сховати()")
    _spec("say2", "cmd", "Вигляд", "герой каже %s", ["Привіт!"], "_каже($1)")
    _spec("size", "cmd", "Вигляд", "розмір героя %n відсотків", ["100"], "_розмір($1)")
    _spec("backdrop", "cmd", "Вигляд", "колір тла %c", ["блакитний"], "_тло($1)")
    _spec("item", "cmd", "Вигляд", "поставити предмет %h в x %n y %n", ["зірка", "100", "100"], "_предмет($1, $2, $3)")
    _spec("hideitem", "cmd", "Вигляд", "сховати предмет", [], "_сховатиПредмет()")

    // Мої блоки: значення параметра всередині "визначити" (самі блоки
    // "визначити ..." і виклики - def:/call:, див. customSpec)
    _spec("param", "rep", "Мої блоки", "%v", ["значення"], "$1")

    for sp in SPECS { mapSet(_specById, sp.id, sp) }
}

func specOf(id) {
    initSpecs()
    var sp = mapGet(_specById, id)
    if (sp == null && (startsWith(id, "def:") || startsWith(id, "call:"))) {
        sp = customSpec(id)
        mapSet(_specById, id, sp)
    }
    return sp
}

// ---------- мої блоки (як «Створити блок» у Scratch) ----------
//
// Власний блок - це функція. Назва й параметри записані прямо в id
// специфікації: "def:стрибнути|висота" - шапка «визначити стрибнути
// (висота)», під нею - що блок робить; "call:стрибнути|висота" - сам
// блок-команда з віконцем на кожен параметр. Окремо нічого не зберігається:
// специфікація створюється з id, коли блок трапляється вперше.

// Назва для id: без символів, що мають особливе значення в id і підписі.
func _customClean(s) {
    var out = ""
    for c in trim(toString(s)) {
        if (c != "|" && c != "%" && c != "(" && c != ")") { out = out + c }
    }
    return trim(out)
}

// "стрибнути (висота) (швидкість)" -> [назва, [параметри]]; назва "" - нема.
func parseCustomBlock(text) {
    var name = ""
    var params = []
    var cur = ""
    var inParen = false
    for c in toString(text) {
        if (c == "(" && !inParen) {
            name = name + " " + cur
            cur = ""
            inParen = true
        } else if (c == ")" && inParen) {
            var p = _customClean(cur)
            if (p != "" && indexOf(params, p) < 0 && len(params) < 9) { append(params, p) }
            cur = ""
            inParen = false
        } else { cur = cur + c }
    }
    if (!inParen) { name = name + " " + cur }
    name = _customClean(join(split(name, " "), " "))
    while (contains(name, "  ")) { name = replace(name, "  ", " ") }
    return [name, params]
}

func customId(kind, name, params) {
    var id = kind + ":" + name
    for p in params { id = id + "|" + p }
    return id
}

// [назва, [параметри]] з id "def:..." / "call:...".
func customParts(id) {
    var parts = split(substring(id, indexOf(id, ":") + 1, len(id) - indexOf(id, ":") - 1), "|")
    return [parts[0], slice(parts, 1)]
}

func customFuncIdent(name) { return varIdent(name) }

func customSpec(id) {
    var cp = customParts(id)
    var name = cp[0]
    var params = cp[1]
    if (startsWith(id, "def:")) {
        var lab = "визначити " + name
        for p in params { lab = lab + " (" + p + ")" }
        return Spec { id: id, kind: "hat", cat: "Мої блоки", label: lab, defs: [], gen: "" }
    }
    var lab2 = name
    var defs = []
    var gen = customFuncIdent(name) + "("
    var k = 0
    while (k < len(params)) {
        if (len(params) > 1) { lab2 = lab2 + " " + params[k] }
        lab2 = lab2 + " %s"
        append(defs, "")
        if (k > 0) { gen = gen + ", " }
        gen = gen + "$" + toString(k + 1)
        k = k + 1
    }
    return Spec { id: id, kind: "cmd", cat: "Мої блоки", label: lab2, defs: defs, gen: gen + ")" }
}

func catColor(cat) {
    var i = indexOf(CATEGORIES, cat)
    if (i < 0) { return C_DIM }
    return CAT_COLORS[i]
}

// Типи віконець у підписі - по порядку.
func slotTypes(sp) {
    var types = []
    var lab = sp.label
    var i = 0
    while (i < len(lab) - 1) {
        if (lab[i] == "%") {
            append(types, lab[i + 1])
            i = i + 2
        } else { i = i + 1 }
    }
    return types
}

func newBlock(specId) {
    var sp = specOf(specId)
    var args = []
    for d in sp.defs { append(args, d) }
    return Block { spec: specId, args: args, body: null, body2: null, next: null,
        x: 0, y: 0, sx: 0, sy: 0, w: 0, hh: 0, h: 0 }
}

func isReporter(b) {
    var k = specOf(b.spec).kind
    return k == "rep" || k == "bool"
}

func lastOfChain(b) {
    while (b.next != null) { b = b.next }
    return b
}

// Глибока копія (дублювання блока; next не копіюється).
func cloneBlock(b) {
    var c = newBlock(b.spec)
    var k = 0
    while (k < len(b.args)) {
        if (typeOf(b.args[k]) == "struct") { c.args[k] = cloneChain(b.args[k]) } else { c.args[k] = b.args[k] }
        k = k + 1
    }
    if (b.body != null) { c.body = cloneChain(b.body) }
    if (b.body2 != null) { c.body2 = cloneChain(b.body2) }
    return c
}

func cloneChain(b) {
    var first = cloneBlock(b)
    var cur = first
    var src = b.next
    while (src != null) {
        cur.next = cloneBlock(src)
        cur = cur.next
        src = src.next
    }
    return first
}

// ---------- збереження (.nxb = JSON) ----------

func _blockToData(b) {
    if (b == null) { return null }
    var m = newMap()
    mapSet(m, "s", b.spec)
    var args = []
    for a in b.args {
        if (typeOf(a) == "struct") { append(args, _blockToData(a)) } else { append(args, a) }
    }
    mapSet(m, "a", args)
    if (b.body != null) { mapSet(m, "b", _blockToData(b.body)) }
    if (b.body2 != null) { mapSet(m, "e", _blockToData(b.body2)) }
    if (b.next != null) { mapSet(m, "n", _blockToData(b.next)) }
    mapSet(m, "x", b.x)
    mapSet(m, "y", b.y)
    return m
}

func _dataToBlock(m) {
    if (m == null) { return null }
    var id = mapGet(m, "s")
    if (specOf(id) == null) { return null }
    var b = newBlock(id)
    var args = mapGet(m, "a")
    var k = 0
    while (k < len(args) && k < len(b.args)) {
        var a = args[k]
        if (typeOf(a) == "map") { b.args[k] = _dataToBlock(a) } else { b.args[k] = toString(a) }
        if (b.args[k] == null) { b.args[k] = "" }
        k = k + 1
    }
    if (mapHas(m, "b")) { b.body = _dataToBlock(mapGet(m, "b")) }
    if (mapHas(m, "e")) { b.body2 = _dataToBlock(mapGet(m, "e")) }
    if (mapHas(m, "n")) { b.next = _dataToBlock(mapGet(m, "n")) }
    if (mapHas(m, "x")) { b.x = toInt(mapGet(m, "x")) }
    if (mapHas(m, "y")) { b.y = toInt(mapGet(m, "y")) }
    return b
}

func stacksToJson(stacks) {
    var arr = []
    for s in stacks { append(arr, _blockToData(s)) }
    var root = newMap()
    mapSet(root, "nyxBlocks", 1)
    mapSet(root, "stacks", arr)
    return toJson(root)
}

func stacksFromJson(text) {
    var stacks = []
    if (trim(text) == "") { return stacks }
    var root = fromJson(text)
    for d in mapGet(root, "stacks") {
        var b = _dataToBlock(d)
        if (b != null) { append(stacks, b) }
    }
    return stacks
}

// ---------- код з блоків ----------

var _genLines = []
var _genBlocks = []
var _genVars = null
var _genId = 0
var _usesDrawing = false
var _usesSprites = false
var _usesLists = false
var _genLists = null
var _reserved = null

func _isIdentChar(c, first) {
    var code = charCode(c)
    if ((code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code == 95 || (code >= 0x400 && code <= 0x4ff)) { return true }
    return !first && code >= 48 && code <= 57
}

// Назва змінної, яку ввів учень -> правильний ідентифікатор мови.
func varIdent(name) {
    if (_reserved == null) {
        _reserved = newMap()
        for k in ["func", "var", "if", "else", "while", "for", "return", "break", "continue", "in", "struct",
                  "self", "import", "extends", "super", "try", "catch", "throw", "true", "false", "null", "main"] {
            mapSet(_reserved, k, true)
        }
        for b in BUILTIN_NAMES { mapSet(_reserved, b, true) }
    }
    var t = trim(toString(name))
    var out = ""
    var i = 0
    while (i < len(t)) {
        var c = t[i]
        if (_isIdentChar(c, len(out) == 0)) { out = out + c }
        else if (c == " " || c == "-") { out = out + "_" }
        else if (c == "'" && len(out) > 0) { out = out + c }
        i = i + 1
    }
    if (out == "") { out = "змінна" }
    if (mapHas(_reserved, out)) { out = out + "_" }
    return out
}

func _quote(s) {
    s = replace(s, "\\", "\\\\")
    s = replace(s, "\"", "\\\"")
    s = replace(s, "\n", "\\n")
    // "${" у тексті учня інакше стало б інтерполяцією в згенерованому коді.
    // (У цьому файлі теж не можна писати "${" прямо - звідси "$" + "{".)
    s = replace(s, "$" + "{", "$\" + \"" + "{")
    return "\"" + s + "\""
}

func _isIntText(s) {
    if (s == "") { return false }
    var i = 0
    while (i < len(s)) {
        var code = charCode(s[i])
        if ((code < 48 || code > 57) && !(i == 0 && s[i] == "-")) { return false }
        i = i + 1
    }
    return true
}

func isNumberText(s) {
    s = trim(s)
    if (s == "" || s == "-" || s == ".") { return false }
    var dots = 0
    var i = 0
    while (i < len(s)) {
        var c = s[i]
        var code = charCode(c)
        if (c == "-" && i == 0) { i = i + 1  continue }
        if (c == ".") { dots = dots + 1 }
        else if (code < 48 || code > 57) { return false }
        i = i + 1
    }
    return dots <= 1
}

var COLOR_NAMES = ["чорний", "білий", "червоний", "зелений", "синій", "жовтий", "помаранчевий", "фіолетовий", "рожевий", "блакитний", "сірий", "коричневий"]
var COLOR_VALUES = [0x000000, 0xffffff, 0xe83030, 0x30c040, 0x3060e8, 0xf0d020, 0xf08c20, 0x8a40d0, 0xf080b0, 0x40c0f0, 0x808080, 0x8a5a30]

// Вираз з віконця типу t.
func _genArg(a, t) {
    if (typeOf(a) == "struct") { return _genExpr(a) }
    var s = toString(a)
    if (t == "v") { return _useVar(s) }
    if (t == "l") {
        var lid = _useVar(s)
        mapSet(_genLists, lid, true)
        _usesLists = true
        return lid
    }
    if (t == "b") { return "false" }
    if (t == "c") {
        var ci = indexOf(COLOR_NAMES, trim(toLower(s)))
        if (ci >= 0) { return toString(COLOR_VALUES[ci]) }
        if (isNumberText(s)) { return trim(s) }
        return "0xffffff"
    }
    if (t == "k" || t == "h") { return _quote(s) }
    if (t == "n") {
        if (isNumberText(s)) { return trim(s) }
        if (trim(s) == "") { return "0" }
        return _quote(s)
    }
    // Текстове віконце з числом ("5") - число: "запам'ятати 5", потім
    // "збільшити на 1" має дати 6, а не "51".
    if (isNumberText(s)) { return trim(s) }
    return _quote(s)
}

var _genParams = null

func _useVar(name) {
    var id = varIdent(name)
    // параметр власного блока - не змінна програми
    if (_genParams != null && mapHas(_genParams, id)) { return id }
    if (!mapHas(_genVars, id)) { mapSet(_genVars, id, true) }
    return id
}

// Шаблон коду -> код: $1..$9 - віконця, $ID - унікальний номер блока.
// Один прохід по шаблону (а не replace по черзі) - текст учня у віконці
// може містити "$1", і він не має підставлятися вдруге.
func _fill(sp, b) {
    var types = slotTypes(sp)
    var g = sp.gen
    var out = ""
    var i = 0
    while (i < len(g)) {
        var c = g[i]
        if (c == "$" && i + 1 < len(g)) {
            // $S1 - як текст, $I1 - як ціле: toString/toInt лише там, де
            // значення ще не того виду (код для учня - без зайвого шуму).
            var mode = ""
            var at = i + 1
            if (g[at] == "S" || g[at] == "I") {
                if (at + 1 < len(g) && charCode(g[at + 1]) >= 49 && charCode(g[at + 1]) <= 57) {
                    mode = g[at]
                    at = at + 1
                }
            }
            var d = charCode(g[at]) - 48
            if (d >= 1 && d <= 9 && d <= len(types)) {
                var expr = _genArg(b.args[d - 1], types[d - 1])
                // Вираз-оператор (a + b) усередині іншого оператора - у дужках;
                // у команді (сказати, якщо, поки) дужки не потрібні.
                var arg = b.args[d - 1]
                if ((sp.kind == "rep" || sp.kind == "bool") && typeOf(arg) == "struct" && contains(specOf(arg.spec).gen, " ")) {
                    expr = "(" + expr + ")"
                }
                if (mode == "S" && !startsWith(expr, "\"")) { expr = "toString(" + expr + ")" }
                if (mode == "I" && !_isIntText(expr)) { expr = "toInt(" + expr + ")" }
                out = out + expr
                i = at + 1
                continue
            }
            if (i + 2 < len(g) && g[i + 1] == "I" && g[i + 2] == "D") {
                out = out + toString(_genId)
                i = i + 3
                continue
            }
        }
        out = out + c
        i = i + 1
    }
    if (sp.cat == "Малювання") { _usesDrawing = true }
    if (sp.cat == "Рух" || sp.cat == "Вигляд") { _usesSprites = true }
    return out
}

func _genExpr(b) {
    return _fill(specOf(b.spec), b)
}

func _emit(line, b) {
    append(_genLines, line)
    append(_genBlocks, b)
}

func _genChain(b, indent) {
    var pad = repeat("    ", indent)
    while (b != null) {
        var sp = specOf(b.spec)
        if (sp.kind == "cmd") {
            // "збільшити на -1" -> "x = x - 1", а не "x + -1"
            for part in split(replace(_fill(sp, b), " + -", " - "), "\n") { _emit(pad + part, b) }
        } else if (sp.kind == "c" || sp.kind == "c2") {
            _genId = _genId + 1
            var head = _fill(sp, b)
            _emit(pad + head, b)
            _genChain(b.body, indent + 1)
            if (sp.kind == "c2") {
                _emit(pad + "} else {", b)
                _genChain(b.body2, indent + 1)
            }
            _emit(pad + "}", b)
        }
        b = b.next
    }
}

var PRELUDE_ANSWER = "// Відповідь-число стає числом (щоб з нею можна було рахувати).\nfunc _відповідь(t) {\n    var s = trim(t)\n    try {\n        return toDouble(s)\n    } catch (e) {\n        return s\n    }\n}\n"

// Код підтримки блоків лежить у src/prelude/*.nx (читається під час
// генерації). Шукаємо поруч з головним скриптом: IDE (src/), тести й
// інструменти (tests/, tools/ - тоді ../src/prelude).
func preludeText(name) {
    for p in [scriptDir() + "/prelude/" + name, scriptDir() + "/../src/prelude/" + name] {
        if (fileExists(p)) { return readFile(p) }
    }
    throw "Не знайдено прелюдію блоків " + name
}

// Програма з блоків -> [текст коду, масив блок-на-рядок (null для службових рядків)].
func generateCode(stacks, title) {
    initSpecs()
    _genLines = []
    _genBlocks = []
    _genVars = newMap()
    _genId = 0
    _usesDrawing = false
    _usesSprites = false
    _usesLists = false
    _genLists = newMap()

    _genParams = null

    // мої блоки -> функції (генеруються першими: їхні змінні теж мають
    // потрапити в оголошення)
    var funcs = []
    var funcBlocks = []
    var seen = newMap()
    for s in stacks {
        if (startsWith(s.spec, "def:")) {
            var cp = customParts(s.spec)
            var fid = customFuncIdent(cp[0])
            if (mapHas(seen, fid)) { continue }
            mapSet(seen, fid, true)
            _genParams = newMap()
            var pids = []
            for p in cp[1] {
                var pid = varIdent(p)
                append(pids, pid)
                mapSet(_genParams, pid, true)
            }
            _genLines = []
            _genBlocks = []
            _genChain(s.next, 1)
            append(funcs, "func " + fid + "(" + join(pids, ", ") + ") {")
            append(funcBlocks, s)
            for l in _genLines { append(funcs, l) }
            for bb in _genBlocks { append(funcBlocks, bb) }
            append(funcs, "}")
            append(funcBlocks, null)
            append(funcs, "")
            append(funcBlocks, null)
            _genParams = null
        }
    }

    var body = []
    var bodyBlocks = []
    for s in stacks {
        if (s.spec == "start") {
            _genLines = []
            _genBlocks = []
            _genChain(s.next, 1)
            for l in _genLines { append(body, l) }
            for bb in _genBlocks { append(bodyBlocks, bb) }
        }
    }

    var lines = ["// Програма з блоків «" + title + "» - код створено Nyx IDE.", ""]
    var blocks = [null, null]
    for l in split(PRELUDE_ANSWER, "\n") { append(lines, l)  append(blocks, null) }
    if (_usesDrawing || _usesSprites) {
        for l in split(preludeText("малювання.nx"), "\n") { append(lines, l)  append(blocks, null) }
    }
    if (_usesSprites) {
        for l in split(preludeText("спрайти.nx"), "\n") { append(lines, l)  append(blocks, null) }
    }
    if (_usesLists) {
        for l in split(preludeText("списки.nx"), "\n") { append(lines, l)  append(blocks, null) }
    }
    // з моїми блоками змінні спільні для всієї програми (як у Scratch):
    // оголошуються зовні, щоб їх бачили й функції
    var hasFuncs = len(funcs) > 0
    var vpad = "    "
    if (hasFuncs) { vpad = "" }
    var decl = []
    for v in mapKeys(_genVars) {
        if (mapHas(_genLists, v)) { append(decl, vpad + "var " + v + " = []") }
        else { append(decl, vpad + "var " + v + " = 0") }
    }
    if (hasFuncs) {
        for l in decl { append(lines, l)  append(blocks, null) }
        if (len(decl) > 0) { append(lines, "")  append(blocks, null) }
        var fk = 0
        while (fk < len(funcs)) {
            append(lines, funcs[fk])
            append(blocks, funcBlocks[fk])
            fk = fk + 1
        }
    }
    append(lines, "func main() {")
    append(blocks, null)
    if (!hasFuncs) {
        for l in decl { append(lines, l)  append(blocks, null) }
    }
    // герой видно одразу, ще до першого блока руху
    if (_usesSprites) {
        append(lines, "    _кадр()")
        append(blocks, null)
    }
    var k = 0
    while (k < len(body)) {
        append(lines, body[k])
        append(blocks, bodyBlocks[k])
        k = k + 1
    }
    if (_usesDrawing || _usesSprites) {
        // Сцена не закривається одразу після останнього блока.
        append(lines, "    while (_s != null && surfaceIsOpen(_s)) { _показати()  sleep(30) }")
        append(blocks, null)
    }
    append(lines, "}")
    append(blocks, null)
    return [join(lines, "\n") + "\n", blocks]
}
