// Текстовий редактор коду (режим "Код").
//
// Текст - масив рядків. Курсор (cx, cy) - стовпчик і рядок; виділення - від
// "якоря" (ax, ay) до курсора (ay = -1 - виділення нема). Скасування -
// знімки рядків (рядки незмінні, тож знімок - лише копія масиву посилань).

import "theme.nx"
import "ui.nx"
import "highlight.nx"
import "builtins.nx"
import "symbols.nx"
import "icons.nx"

struct Editor {
    lines: array
    cx: i32
    cy: i32
    ax: i32
    ay: i32
    wantCol: i32
    top: i32
    left: i32
    path: string
    dirty: bool
    undo: array
    redo: array
    lastKind: string
    lastTime: i32
    hlSrc: array
    hlIn: array
    hlTok: array
    hlOut: array
    errLine: i32
    fontSize: i32
    x: i32
    y: i32
    w: i32
    h: i32
    charW: i32
    lineH: i32
    gutterW: i32
    acOpen: bool
    acItems: array
    acSel: i32
    findOpen: bool
    findText: string
    plain: bool
    breaks: array
    dbgLine: i32
    marks: array
    hlOk: i32
    acNames: any
    acTime: i32
    replOpen: bool
    replText: string
    findField: i32
    folds: array
    foldR: array
    foldKey: string
    foldN: i32
    editLine: i32
    editSeq: i32
}

func newEditor(text, path) {
    var ed = Editor { lines: [], cx: 0, cy: 0, ax: 0, ay: -1, wantCol: 0, top: 0, left: 0,
        path: path, dirty: false, undo: [], redo: [], lastKind: "", lastTime: 0,
        hlSrc: [], hlIn: [], hlTok: [], hlOut: [], errLine: -1, fontSize: 16,
        x: 0, y: 0, w: 100, h: 100, charW: 8, lineH: 20, gutterW: 40,
        acOpen: false, acItems: [], acSel: 0, findOpen: false, findText: "", plain: false, breaks: [], dbgLine: -1, marks: [], hlOk: 0, acNames: null, acTime: 0, replOpen: false, replText: "", findField: 0,
        folds: [], foldR: [], foldKey: "", foldN: 0, editLine: 0, editSeq: 0 }
    edSetText(ed, text)
    return ed
}

// ---------- текст ----------

func cut(s, a, b) {
    var n = len(s)
    if (a < 0) { a = 0 }
    if (b > n) { b = n }
    if (b <= a) { return "" }
    return substring(s, a, b - a)
}

func leadingSpaces(s) {
    var i = 0
    while (i < len(s) && s[i] == " ") { i = i + 1 }
    return i
}

func normalizeText(text) {
    text = replace(text, "\r\n", "\n")
    text = replace(text, "\r", "\n")
    return replace(text, "\t", "    ")
}

// Підсвітка рядків до hlOk точно актуальна (великі файли: кадр не
// перевіряє всі 20 000 рядків). Зміна в рядку line - звідти перевіряти знову.
func _hlFrom(ed, line) {
    if (line < ed.hlOk) { ed.hlOk = max(0, line) }
}

func edSetText(ed, text) {
    ed.hlOk = 0
    ed.lines = split(normalizeText(text), "\n")
    if (len(ed.lines) == 0) { ed.lines = [""] }
    ed.cx = 0
    ed.cy = 0
    ed.ay = -1
    ed.top = 0
    ed.left = 0
    ed.folds = []
}

func edText(ed) { return join(ed.lines, "\n") }

// ---------- виділення ----------

// Емодзі й деякі рідкісні символи - дві "половинки" (сурогатна пара):
// стрілки, Backspace і Delete переступають і стирають їх разом, інакше
// лишилась би половинка, яку вже не збережеш у файл.
func _isHighSur(s, i) { return i >= 0 && i < len(s) && charCode(s[i]) >= 0xD800 && charCode(s[i]) <= 0xDBFF }
func _isLowSur(s, i) { return i >= 0 && i < len(s) && charCode(s[i]) >= 0xDC00 && charCode(s[i]) <= 0xDFFF }

func _clampSel(ed) {
    var n = len(ed.lines)
    if (n == 0) {
        ed.lines = [""]
        n = 1
    }
    ed.cy = clamp(ed.cy, 0, n - 1)
    ed.cx = clamp(ed.cx, 0, len(ed.lines[ed.cy]))
    // курсор не між половинками емодзі (клік мишею міг туди поставити)
    if (_isLowSur(ed.lines[ed.cy], ed.cx)) { ed.cx = ed.cx - 1 }
    if (ed.ay >= 0) {
        ed.ay = clamp(ed.ay, 0, n - 1)
        ed.ax = clamp(ed.ax, 0, len(ed.lines[ed.ay]))
    }
}

func edHasSel(ed) { return ed.ay >= 0 && (ed.ay != ed.cy || ed.ax != ed.cx) }

// [y1, x1, y2, x2] - початок і кінець виділення в порядку тексту.
func edSelRange(ed) {
    // межі - завжди в межах тексту (рядок під позначкою міг зникнути:
    // вирізали рядок, скасували правку...)
    _clampSel(ed)
    if (ed.ay < ed.cy || (ed.ay == ed.cy && ed.ax <= ed.cx)) { return [ed.ay, ed.ax, ed.cy, ed.cx] }
    return [ed.cy, ed.cx, ed.ay, ed.ax]
}

func edSelText(ed) {
    if (!edHasSel(ed)) { return "" }
    var r = edSelRange(ed)
    if (r[0] == r[2]) { return cut(ed.lines[r[0]], r[1], r[3]) }
    var parts = [cut(ed.lines[r[0]], r[1], len(ed.lines[r[0]]))]
    var y = r[0] + 1
    while (y < r[2]) { append(parts, ed.lines[y])  y = y + 1 }
    append(parts, cut(ed.lines[r[2]], 0, r[3]))
    return join(parts, "\n")
}

func edDeleteSel(ed) {
    _hlFrom(ed, min(ed.cy, max(ed.ay, 0)))
    if (!edHasSel(ed)) { ed.ay = -1  return }
    var r = edSelRange(ed)
    var first = ed.lines[r[0]]
    var last = ed.lines[r[2]]
    ed.lines[r[0]] = cut(first, 0, r[1]) + cut(last, r[3], len(last))
    var k = r[2] - r[0]
    while (k > 0) { removeAt(ed.lines, r[0] + 1)  k = k - 1 }
    ed.cy = r[0]
    ed.cx = r[1]
    ed.ay = -1
}

func edSelectAll(ed) {
    ed.ay = 0
    ed.ax = 0
    ed.cy = len(ed.lines) - 1
    ed.cx = len(ed.lines[ed.cy])
}

// ---------- скасування ----------

func edSnapshot(ed) { return [slice(ed.lines, 0), ed.cx, ed.cy] }

// Перед кожною зміною. Підряд набрані символи одного виду (kind) за
// секунду - одна дія скасування, як у звичайних редакторах.
func edBeginEdit(ed, kind) {
    _foldSync(ed)
    var first = ed.cy
    if (ed.ay >= 0) { first = min(first, ed.ay) }
    ed.editLine = first
    ed.editSeq = ed.editSeq + 1
    // Backspace на початку рядка міняє й попередній
    _hlFrom(ed, first - 1)
    var now = timeMs()
    if (kind != ed.lastKind || now - ed.lastTime > 1000 || kind == "other") {
        append(ed.undo, edSnapshot(ed))
        if (len(ed.undo) > 300) { removeAt(ed.undo, 0) }
    }
    ed.redo = []
    ed.lastKind = kind
    ed.lastTime = now
    ed.dirty = true
    ed.errLine = -1
}

func _restore(ed, snap) {
    ed.hlOk = 0
    ed.folds = []
    ed.lines = slice(snap[0], 0)
    ed.cy = min(snap[2], len(ed.lines) - 1)
    ed.cx = min(snap[1], len(ed.lines[ed.cy]))
    ed.ay = -1
    ed.dirty = true
    ed.lastKind = ""
}

func edUndo(ed) {
    if (len(ed.undo) == 0) { return }
    append(ed.redo, edSnapshot(ed))
    _restore(ed, pop(ed.undo))
}

func edRedo(ed) {
    if (len(ed.redo) == 0) { return }
    append(ed.undo, edSnapshot(ed))
    _restore(ed, pop(ed.redo))
}

// ---------- зміни тексту ----------

func edInsert(ed, text) {
    _hlFrom(ed, ed.cy - 1)
    edDeleteSel(ed)
    var parts = split(normalizeText(text), "\n")
    var line = ed.lines[ed.cy]
    var before = cut(line, 0, ed.cx)
    var after = cut(line, ed.cx, len(line))
    if (len(parts) == 1) {
        ed.lines[ed.cy] = before + parts[0] + after
        ed.cx = ed.cx + len(parts[0])
    } else {
        ed.lines[ed.cy] = before + parts[0]
        var k = 1
        while (k < len(parts) - 1) {
            insert(ed.lines, ed.cy + k, parts[k])
            k = k + 1
        }
        var lastPart = parts[len(parts) - 1]
        insert(ed.lines, ed.cy + k, lastPart + after)
        ed.cy = ed.cy + k
        ed.cx = len(lastPart)
    }
    ed.wantCol = ed.cx
}

// З налаштувань IDE: ширина відступу й автозакриття дужок/лапок.
var ED_TAB = 4
var ED_AUTOCLOSE = true

func edBackspace(ed) {
    _hlFrom(ed, ed.cy - 1)
    if (edHasSel(ed)) { edDeleteSel(ed)  return }
    var line = ed.lines[ed.cy]
    if (ed.cx > 0) {
        var n = 1
        // Лише пробіли перед курсором - стираємо до попереднього кроку відступу.
        if (leadingSpaces(line) >= ed.cx && ed.cx >= ED_TAB) {
            n = ed.cx % ED_TAB
            if (n == 0) { n = ED_TAB }
        } else {
            // Порожня пара () "" [] {} - стираємо обидва символи.
            var prev = line[ed.cx - 1]
            if (ed.cx < len(line) && ED_AUTOCLOSE) {
                var nxt = line[ed.cx]
                if ((prev == "(" && nxt == ")") || (prev == "[" && nxt == "]") || (prev == "{" && nxt == "}") || (prev == "\"" && nxt == "\"")) {
                    ed.lines[ed.cy] = cut(line, 0, ed.cx - 1) + cut(line, ed.cx + 1, len(line))
                    ed.cx = ed.cx - 1
                    return
                }
            }
        }
        if (n == 1 && _isLowSur(line, ed.cx - 1) && _isHighSur(line, ed.cx - 2)) { n = 2 }
        ed.lines[ed.cy] = cut(line, 0, ed.cx - n) + cut(line, ed.cx, len(line))
        ed.cx = ed.cx - n
    } else if (ed.cy > 0) {
        var prevLine = ed.lines[ed.cy - 1]
        ed.lines[ed.cy - 1] = prevLine + line
        removeAt(ed.lines, ed.cy)
        ed.cy = ed.cy - 1
        ed.cx = len(prevLine)
    }
    ed.wantCol = ed.cx
}

func edDelete(ed) {
    _hlFrom(ed, ed.cy - 1)
    if (edHasSel(ed)) { edDeleteSel(ed)  return }
    var line = ed.lines[ed.cy]
    if (ed.cx < len(line)) {
        var n = 1
        if (_isHighSur(line, ed.cx) && _isLowSur(line, ed.cx + 1)) { n = 2 }
        ed.lines[ed.cy] = cut(line, 0, ed.cx) + cut(line, ed.cx + n, len(line))
    } else if (ed.cy < len(ed.lines) - 1) {
        ed.lines[ed.cy] = line + ed.lines[ed.cy + 1]
        removeAt(ed.lines, ed.cy + 1)
    }
}

// Enter з автовідступом: новий рядок отримує відступ поточного, після "{" -
// ще +ED_TAB, а якщо курсор стоїть між { і } - дужка переїжджає на свій рядок.
func edNewline(ed) {
    _hlFrom(ed, ed.cy - 1)
    edDeleteSel(ed)
    var line = ed.lines[ed.cy]
    var indent = leadingSpaces(line)
    if (indent > ed.cx) { indent = ed.cx }
    var before = cut(line, 0, ed.cx)
    var after = trim(cut(line, ed.cx, len(line)))
    var extra = 0
    var tb = trim(before)
    if (len(tb) > 0 && (endsWith(tb, "{") || endsWith(tb, "[") || endsWith(tb, "("))) { extra = ED_TAB }
    ed.lines[ed.cy] = before
    var pad = repeat(" ", indent + extra)
    if (extra > 0 && (startsWith(after, "}") || startsWith(after, "]") || startsWith(after, ")"))) {
        insert(ed.lines, ed.cy + 1, pad)
        insert(ed.lines, ed.cy + 2, repeat(" ", indent) + after)
    } else {
        insert(ed.lines, ed.cy + 1, pad + after)
    }
    ed.cy = ed.cy + 1
    ed.cx = len(pad)
    ed.wantCol = ed.cx
}

func _selLines(ed) {
    if (!edHasSel(ed)) { return [ed.cy, ed.cy] }
    var r = edSelRange(ed)
    var y2 = r[2]
    if (r[3] == 0 && y2 > r[0]) { y2 = y2 - 1 }
    return [r[0], y2]
}

func edIndent(ed, outdent) {
    if (ed.ay >= 0) { _hlFrom(ed, min(ed.cy, ed.ay)) } else { _hlFrom(ed, ed.cy) }
    var ys = _selLines(ed)
    var multi = edHasSel(ed) && ys[1] > ys[0]
    if (!multi && !outdent) {
        edDeleteSel(ed)
        edInsert(ed, repeat(" ", ED_TAB - ed.cx % ED_TAB))
        return
    }
    var y = ys[0]
    while (y <= ys[1]) {
        var line = ed.lines[y]
        if (outdent) {
            var n = min(ED_TAB, leadingSpaces(line))
            ed.lines[y] = cut(line, n, len(line))
            if (y == ed.cy) { ed.cx = max(0, ed.cx - n) }
            if (y == ed.ay) { ed.ax = max(0, ed.ax - n) }
        } else if (len(trim(line)) > 0) {
            ed.lines[y] = repeat(" ", ED_TAB) + line
            if (y == ed.cy) { ed.cx = ed.cx + ED_TAB }
            if (y == ed.ay) { ed.ax = ed.ax + ED_TAB }
        }
        y = y + 1
    }
}

// Ctrl+/ - закоментувати/розкоментувати рядки.
func edToggleComment(ed) {
    if (ed.ay >= 0) { _hlFrom(ed, min(ed.cy, ed.ay)) } else { _hlFrom(ed, ed.cy) }
    var ys = _selLines(ed)
    var allCommented = true
    var minIndent = 100000
    var y = ys[0]
    while (y <= ys[1]) {
        var t = trim(ed.lines[y])
        if (len(t) > 0) {
            if (!startsWith(t, "//")) { allCommented = false }
            minIndent = min(minIndent, leadingSpaces(ed.lines[y]))
        }
        y = y + 1
    }
    if (minIndent == 100000) { minIndent = 0 }
    y = ys[0]
    while (y <= ys[1]) {
        var line = ed.lines[y]
        if (len(trim(line)) > 0) {
            if (allCommented) {
                var at = indexOf(line, "//")
                var drop = 2
                if (at + 2 < len(line) && line[at + 2] == " ") { drop = 3 }
                ed.lines[y] = cut(line, 0, at) + cut(line, at + drop, len(line))
            } else {
                ed.lines[y] = cut(line, 0, minIndent) + "// " + cut(line, minIndent, len(line))
            }
        }
        y = y + 1
    }
    ed.cx = min(ed.cx, len(ed.lines[ed.cy]))
    if (ed.ay >= 0) { ed.ax = min(ed.ax, len(ed.lines[ed.ay])) }
}

func edDuplicateLine(ed) {
    _hlFrom(ed, ed.cy)
    insert(ed.lines, ed.cy + 1, ed.lines[ed.cy])
    ed.cy = ed.cy + 1
}

// Alt+↑/↓ - перенести рядки (виділені або поточний) вище/нижче;
// copy (Alt+Shift) - скопіювати їх туди. Виділення їде разом з ними.
func edMoveLines(ed, dir, copy) {
    var r = _selLines(ed)
    var a = r[0]
    var b = r[1]
    var block = slice(ed.lines, a, b + 1)
    var n = b - a + 1
    if (copy) {
        _hlFrom(ed, a)
        var at = b + 1
        if (dir < 0) { at = a }
        var i = 0
        while (i < n) {
            insert(ed.lines, at + i, block[i])
            i = i + 1
        }
        if (dir > 0) {
            ed.cy = ed.cy + n
            if (ed.ay >= 0) { ed.ay = ed.ay + n }
        }
        return
    }
    if ((dir < 0 && a == 0) || (dir > 0 && b >= len(ed.lines) - 1)) { return }
    _hlFrom(ed, min(a, a + dir))
    if (dir < 0) {
        var up = ed.lines[a - 1]
        removeAt(ed.lines, a - 1)
        insert(ed.lines, b, up)
    } else {
        var down = ed.lines[b + 1]
        removeAt(ed.lines, b + 1)
        insert(ed.lines, a, down)
    }
    ed.cy = ed.cy + dir
    if (ed.ay >= 0) { ed.ay = ed.ay + dir }
}

// Чи символ рядка li на col - код (не рядок у лапках і не коментар).
func _isCodeAt(ed, li, col) {
    var toks = ed.hlTok[li]
    var q = 0
    while (q < len(toks)) {
        if (col >= toks[q] && col < toks[q + 1]) { return toks[q + 2] != HL_STRING && toks[q + 2] != HL_COMMENT }
        q = q + 3
    }
    return true
}

var _OPEN_BR = "([{"
var _CLOSE_BR = ")]}"

// Парна дужка до тієї, що біля курсора: [[y, x], [y, x]] або null.
// Шукає не далі 3000 рядків, дужки в лапках і коментарях не рахує.
func edMatchBracket(ed) {
    var line = ed.lines[ed.cy]
    var col = -1
    var ch = ""
    for c in [ed.cx, ed.cx - 1] {
        if (col < 0 && c >= 0 && c < len(line) && (indexOf(_OPEN_BR, line[c]) >= 0 || indexOf(_CLOSE_BR, line[c]) >= 0)) {
            col = c
            ch = line[c]
        }
    }
    if (col < 0) { return null }
    _warmTokens(ed, ed.cy)
    if (!_isCodeAt(ed, ed.cy, col)) { return null }
    var m = _scanMatch(ed, ed.cy, col)
    if (m == null) { return null }
    return [[ed.cy, col], m]
}

// Пара для дужки на (y, col): [y, x] або null.
func _scanMatch(ed, y0, col) {
    var ch = ed.lines[y0][col]
    var dir = 1
    var open = ch
    var close = ""
    var oi = indexOf(_OPEN_BR, ch)
    if (oi >= 0) { close = _CLOSE_BR[oi] }
    else {
        dir = -1
        close = ch
        open = _OPEN_BR[indexOf(_CLOSE_BR, ch)]
    }
    var depth = 0
    var y = y0
    var x = col
    var limit = 3000
    while (y >= 0 && y < len(ed.lines) && limit > 0) {
        var ln = ed.lines[y]
        if (dir > 0) { _warmTokens(ed, y) }
        while (x >= 0 && x < len(ln)) {
            var c2 = ln[x]
            if ((c2 == open || c2 == close) && _isCodeAt(ed, y, x)) {
                if (c2 == ch) { depth = depth + 1 } else { depth = depth - 1 }
                if (depth == 0) { return [y, x] }
            }
            x = x + dir
        }
        y = y + dir
        limit = limit - 1
        if (y >= 0 && y < len(ed.lines)) {
            if (dir > 0) { x = 0 } else { x = len(ed.lines[y]) - 1 }
        }
    }
    return null
}

// ---------- згортання коду ----------

var FOLD_COL = 16
//
// ed.folds - згорнуті рядки з { у кінці (сортовані); рядки між ними й
// парною } сховані, сама } видно (як у VS Code). ed.foldR - [[початок,
// кінець]] для поточного тексту. Після правки, що змінила кількість
// рядків, згортки нижче місця правки зсуваються (_foldSync).

// Рядок з парною } для { у кінці рядка li (після неї - лише пробіли чи
// коментар), або -1: нема такої { або ховати нічого.
func edFoldEnd(ed, li) {
    if (ed.plain || li < 0 || li >= len(ed.lines)) { return -1 }
    var line = ed.lines[li]
    _warmTokens(ed, li)
    var i = len(line) - 1
    while (i >= 0 && (line[i] == " " || !_isCodeAt(ed, li, i))) { i = i - 1 }
    if (i < 0 || line[i] != "{") { return -1 }
    var m = _scanMatch(ed, li, i)
    if (m == null || m[0] < li + 2) { return -1 }
    return m[0]
}

func edIsFolded(ed, li) { return indexOf(ed.folds, li) >= 0 }

// Згортка, у якій схований рядок li (зовнішня), або null.
func _hiddenIn(ed, li) {
    for r in ed.foldR { if (li > r[0] && li < r[1]) { return r } }
    return null
}

func _nextVis(ed, li) {
    if (len(ed.foldR) > 0) { for r in ed.foldR { if (r[0] == li) { return r[1] } } }
    return li + 1
}

func _prevVis(ed, li) {
    var p = li - 1
    if (len(ed.foldR) > 0) {
        var h = _hiddenIn(ed, p)
        if (h != null) { return h[0] }
    }
    return p
}

// Скільки видимих рядків від a до b (a <= b, обидва видимі).
func _rowsBetween(ed, a, b) {
    if (len(ed.foldR) == 0) { return b - a }
    var n = 0
    var li = a
    while (li < b) {
        li = _nextVis(ed, li)
        n = n + 1
    }
    return n
}

// Рядок тексту на row-му видимому рядку від верху.
func _rowLine(ed, row) {
    if (len(ed.foldR) == 0) { return clamp(ed.top + row, 0, len(ed.lines) - 1) }
    var li = ed.top
    var r = 0
    while (r < row && _nextVis(ed, li) < len(ed.lines)) {
        li = _nextVis(ed, li)
        r = r + 1
    }
    return li
}

func _foldSync(ed) {
    if (len(ed.folds) == 0) {
        ed.foldR = []
        return
    }
    var n = len(ed.lines)
    if (n != ed.foldN) {
        var d = n - ed.foldN
        var moved = []
        for f in ed.folds {
            var f2 = f
            if (f > ed.editLine) {
                f2 = f + d
                if (f2 <= ed.editLine) { f2 = -1 }
            } else if (f == ed.editLine && d > 0 && f + d < n && edFoldEnd(ed, f) < 0 && edFoldEnd(ed, f + d) >= 0) {
                // Enter на початку рядка згортки - вона їде вниз разом з ним
                f2 = f + d
            }
            if (f2 >= 0 && f2 < n && indexOf(moved, f2) < 0) { append(moved, f2) }
        }
        ed.folds = sort(moved)
        ed.foldN = n
    }
    var key = toString(ed.editSeq) + ":" + join(ed.folds, ",")
    if (key != ed.foldKey) {
        var keep = []
        var rs = []
        for f in ed.folds {
            var e = edFoldEnd(ed, f)
            if (e >= 0) {
                append(keep, f)
                append(rs, [f, e])
            }
        }
        ed.folds = keep
        ed.foldR = rs
        ed.foldKey = toString(ed.editSeq) + ":" + join(ed.folds, ",")
    }
    // курсор не ховається: його згортки розгортаються
    var h = _hiddenIn(ed, ed.cy)
    while (h != null) {
        removeAt(ed.folds, indexOf(ed.folds, h[0]))
        _foldSync(ed)
        h = _hiddenIn(ed, ed.cy)
    }
    var ht = _hiddenIn(ed, ed.top)
    if (ht != null) { ed.top = ht[0] }
}

// Згорнути / розгорнути блок, що починається на рядку li.
func edToggleFold(ed, li) {
    var i = indexOf(ed.folds, li)
    if (i >= 0) {
        removeAt(ed.folds, i)
        _foldSync(ed)
        return true
    }
    var e = edFoldEnd(ed, li)
    if (e < 0) { return false }
    if (len(ed.folds) == 0) { ed.foldN = len(ed.lines) }
    append(ed.folds, li)
    ed.folds = sort(ed.folds)
    // курсор усередині - на початок блоку
    if (ed.cy > li && ed.cy < e) {
        ed.cy = li
        ed.cx = min(ed.cx, len(ed.lines[li]))
        ed.ay = -1
    }
    _foldSync(ed)
    return true
}

// Ctrl+Shift+[ - згорнути найближчий блок, у якому курсор.
func edFoldAtCursor(ed) {
    var li = ed.cy
    var limit = 3000
    while (li >= 0 && limit > 0) {
        if (!edIsFolded(ed, li)) {
            var e = edFoldEnd(ed, li)
            if (e >= 0 && (li == ed.cy || e >= ed.cy)) { return edToggleFold(ed, li) }
        }
        li = li - 1
        limit = limit - 1
    }
    return false
}

// Ctrl+Shift+] - розгорнути блок на рядку курсора.
func edUnfoldAtCursor(ed) {
    if (edIsFolded(ed, ed.cy)) { return edToggleFold(ed, ed.cy) }
    return false
}

func edFoldAll(ed) {
    var li = 0
    var fs = []
    while (li < len(ed.lines)) {
        if (edFoldEnd(ed, li) >= 0) { append(fs, li) }
        li = li + 1
    }
    if (len(fs) == 0) { return }
    // курсор у блоці - на початок зовнішнього (інакше той розгорнувся б)
    for f in fs {
        if (ed.cy > f && ed.cy < edFoldEnd(ed, f)) {
            ed.cy = f
            ed.cx = min(ed.cx, len(ed.lines[f]))
            break
        }
    }
    ed.foldN = len(ed.lines)
    ed.folds = fs
    _foldSync(ed)
    ed.ay = -1
}

// Показати рядок li (розгорнути згортки, що його ховають).
func edReveal(ed, li) {
    _foldSync(ed)
    var h = _hiddenIn(ed, li)
    while (h != null) {
        removeAt(ed.folds, indexOf(ed.folds, h[0]))
        _foldSync(ed)
        h = _hiddenIn(ed, li)
    }
}

func edUnfoldAll(ed) {
    ed.folds = []
    _foldSync(ed)
}

// ---------- заміна (Ctrl+H) ----------

// Замінити поточний збіг (якщо виділено саме його) і перейти до наступного.
func edReplaceOne(ed) {
    if (ed.findText == "") { return false }
    if (edHasSel(ed) && toLower(edSelText(ed)) == toLower(ed.findText)) {
        edBeginEdit(ed, "other")
        edInsert(ed, ed.replText)
    }
    edFindNext(ed, 1)
    return true
}

// Замінити всі збіги у файлі (без різниці великих/малих літер) - одна дія Ctrl+Z.
func edReplaceAll(ed) {
    var q = ed.findText
    if (q == "") { return 0 }
    var r = replaceAllIn(ed.lines, q, ed.replText)
    if (r[1] > 0) { edReplaceLines(ed, r[0]) }
    return r[1]
}

// Усі входження q (без різниці великих/малих) у рядках - на rep:
// [нові рядки, скільки замінено]. Для Ctrl+H і заміни в усіх файлах.
func replaceAllIn(lines, q, rep) {
    var lq = toLower(q)
    var count = 0
    var out = []
    for l in lines {
        var low = toLower(l)
        var res = ""
        var pos = 0
        while (true) {
            var at = indexOf(cut(low, pos, len(low)), lq)
            if (at < 0) { break }
            res = res + cut(l, pos, pos + at) + rep
            pos = pos + at + len(lq)
            count = count + 1
        }
        append(out, res + cut(l, pos, len(l)))
    }
    return [out, count]
}

// Набраний символ (подія "text"): автопари дужок і лапок.
func edType(ed, t) {
    _hlFrom(ed, ed.cy - 1)
    var line = ed.lines[ed.cy]
    var nxt = ""
    if (ed.cx < len(line)) { nxt = line[ed.cx] }
    if (ED_AUTOCLOSE && !edHasSel(ed) && (t == ")" || t == "]" || t == "}" || t == "\"") && nxt == t) {
        ed.cx = ed.cx + 1
        return
    }
    if (t == "}" && !edHasSel(ed) && leadingSpaces(line) == len(line) && len(line) >= ED_TAB) {
        ed.lines[ed.cy] = repeat(" ", len(line) - ED_TAB)
        ed.cx = len(line) - ED_TAB
    }
    var freeAfter = nxt == "" || nxt == " " || nxt == ")" || nxt == "]" || nxt == "}" || nxt == ","
    var close = ""
    if (t == "(") { close = ")" }
    if (t == "[") { close = "]" }
    if (t == "{") { close = "}" }
    if (t == "\"") {
        var prevCh = ""
        if (ed.cx > 0) { prevCh = line[ed.cx - 1] }
        if (prevCh != "\\" && !isIdentPart(charCode(prevCh + " "))) { close = "\"" }
    }
    if (!ED_AUTOCLOSE) { close = "" }
    // виділено одним рядком і набрано ( [ { " - обгорнути виділене
    if (close != "" && edHasSel(ed)) {
        var r = edSelRange(ed)
        if (r[0] == r[2]) {
            var inner = edSelText(ed)
            edDeleteSel(ed)
            edInsert(ed, t + inner + close)
            ed.ay = ed.cy
            ed.ax = ed.cx - 1 - len(inner)
            ed.cx = ed.cx - 1
            return
        }
    }
    if (close != "" && freeAfter && !edHasSel(ed)) {
        edInsert(ed, t + close)
        ed.cx = ed.cx - 1
        return
    }
    edInsert(ed, t)
}

// ---------- рух курсора ----------

func _isWordAt(line, i) { return i >= 0 && i < len(line) && isIdentPart(charCode(line[i])) }

func edWordLeft(ed) {
    var line = ed.lines[ed.cy]
    var i = ed.cx
    if (i == 0) {
        if (ed.cy > 0) { ed.cy = ed.cy - 1  ed.cx = len(ed.lines[ed.cy]) }
        return
    }
    while (i > 0 && line[i - 1] == " ") { i = i - 1 }
    if (_isWordAt(line, i - 1)) { while (_isWordAt(line, i - 1)) { i = i - 1 } }
    else if (i > 0) { i = i - 1 }
    ed.cx = i
}

func edWordRight(ed) {
    var line = ed.lines[ed.cy]
    var i = ed.cx
    if (i >= len(line)) {
        if (ed.cy < len(ed.lines) - 1) { ed.cy = ed.cy + 1  ed.cx = 0 }
        return
    }
    if (_isWordAt(line, i)) { while (_isWordAt(line, i)) { i = i + 1 } }
    else { i = i + 1 }
    while (i < len(line) && line[i] == " ") { i = i + 1 }
    ed.cx = i
}

func edSelectWord(ed) {
    var line = ed.lines[ed.cy]
    var a = ed.cx
    var b = ed.cx
    if (!_isWordAt(line, a) && _isWordAt(line, a - 1)) { a = a - 1  b = a }
    if (!_isWordAt(line, a)) { return }
    while (_isWordAt(line, a - 1)) { a = a - 1 }
    while (_isWordAt(line, b)) { b = b + 1 }
    ed.ay = ed.cy
    ed.ax = a
    ed.cx = b
}

func _visibleRows(ed) { return max(1, toInt(ed.h / ed.lineH)) }

// Рух з/без Shift: з Shift виділення розтягується від якоря.
func _beginMove(ed, shift) {
    if (shift) { if (ed.ay < 0) { ed.ay = ed.cy  ed.ax = ed.cx } }
    else { ed.ay = -1 }
}

func edMoveKey(ed, key, ctrl, shift) {
    _foldSync(ed)
    var hadSel = edHasSel(ed)
    var r = edSelRange(ed)
    _beginMove(ed, shift)
    var keepWant = false
    if (key == "Left") {
        if (hadSel && !shift) { ed.cy = r[0]  ed.cx = r[1] }
        else if (ctrl) { edWordLeft(ed) }
        else if (ed.cx > 0) {
            ed.cx = ed.cx - 1
            if (_isLowSur(ed.lines[ed.cy], ed.cx) && _isHighSur(ed.lines[ed.cy], ed.cx - 1)) { ed.cx = ed.cx - 1 }
        }
        else if (ed.cy > 0) { ed.cy = _prevVis(ed, ed.cy)  ed.cx = len(ed.lines[ed.cy]) }
    } else if (key == "Right") {
        if (hadSel && !shift) { ed.cy = r[2]  ed.cx = r[3] }
        else if (ctrl) { edWordRight(ed) }
        else if (ed.cx < len(ed.lines[ed.cy])) {
            ed.cx = ed.cx + 1
            if (_isLowSur(ed.lines[ed.cy], ed.cx)) { ed.cx = ed.cx + 1 }
        }
        else if (ed.cy < len(ed.lines) - 1) { ed.cy = min(_nextVis(ed, ed.cy), len(ed.lines) - 1)  ed.cx = 0 }
    } else if (key == "Up" || key == "Down" || key == "PageUp" || key == "PageDown") {
        var step = 1
        if (key == "PageUp" || key == "PageDown") { step = _visibleRows(ed) - 1 }
        if (key == "Up" || key == "PageUp") { step = -step }
        if (ctrl && (key == "Up" || key == "Down")) {
            edScroll(ed, step)
            return
        }
        if (len(ed.foldR) == 0) { ed.cy = clamp(ed.cy + step, 0, len(ed.lines) - 1) }
        else {
            var k = 0
            while (k < abs(step)) {
                if (step > 0 && _nextVis(ed, ed.cy) < len(ed.lines)) { ed.cy = _nextVis(ed, ed.cy) }
                if (step < 0 && ed.cy > 0) { ed.cy = _prevVis(ed, ed.cy) }
                k = k + 1
            }
        }
        ed.cx = min(ed.wantCol, len(ed.lines[ed.cy]))
        keepWant = true
    } else if (key == "Home") {
        if (ctrl) { ed.cy = 0  ed.cx = 0 }
        else {
            var ind = leadingSpaces(ed.lines[ed.cy])
            if (ed.cx == ind) { ed.cx = 0 } else { ed.cx = ind }
        }
    } else if (key == "End") {
        if (ctrl) { ed.cy = len(ed.lines) - 1 }
        ed.cx = len(ed.lines[ed.cy])
    }
    if (!keepWant) { ed.wantCol = ed.cx }
}

func edEnsureVisible(ed) {
    _foldSync(ed)
    var rows = _visibleRows(ed)
    if (ed.cy < ed.top) { ed.top = ed.cy }
    if (len(ed.foldR) == 0) {
        if (ed.cy > ed.top + rows - 2) { ed.top = max(0, ed.cy - rows + 2) }
    } else {
        var between = _rowsBetween(ed, ed.top, ed.cy)
        while (between > rows - 2) {
            ed.top = _nextVis(ed, ed.top)
            between = between - 1
        }
    }
    var cols = max(4, toInt((ed.w - ed.gutterW - 12) / ed.charW))
    if (ed.cx < ed.left) { ed.left = max(0, ed.cx - 4) }
    if (ed.cx > ed.left + cols - 2) { ed.left = ed.cx - cols + 2 }
}

func edScroll(ed, lines) {
    _foldSync(ed)
    if (len(ed.foldR) == 0) {
        ed.top = clamp(ed.top + lines, 0, max(0, len(ed.lines) - 3))
        return
    }
    var k = 0
    while (k < abs(lines)) {
        if (lines > 0 && _nextVis(ed, ed.top) < len(ed.lines) - 2) { ed.top = _nextVis(ed, ed.top) }
        if (lines < 0 && ed.top > 0) { ed.top = _prevVis(ed, ed.top) }
        k = k + 1
    }
}

// Ім'я під курсором: [початок, кінець, слово] або null.
func edWordAtCursor(ed) {
    if (ed.plain || ed.cy >= len(ed.lines)) { return null }
    _warmTokens(ed, ed.cy)
    return symWordAt(ed.lines[ed.cy], ed.hlTok[ed.cy], ed.cx)
}

// Токени всіх рядків (підсвітка вже рахує їх і кешує).
func edAllTokens(ed) {
    _warmTokens(ed, len(ed.lines) - 1)
    return ed.hlTok
}

// Курсор на (рядок, стовпець), рядок - приблизно на третині екрана.
func edJumpTo(ed, line, col) {
    edGoToLine(ed, line)
    ed.cx = clamp(col, 0, len(ed.lines[ed.cy]))
    ed.wantCol = ed.cx
}

// Нові рядки однією дією скасування (перейменування тощо).
func edReplaceLines(ed, lines) {
    edBeginEdit(ed, "other")
    if (len(lines) != len(ed.lines)) { ed.folds = [] }
    ed.hlOk = 0
    ed.lines = lines
    ed.cy = min(ed.cy, len(ed.lines) - 1)
    ed.cx = min(ed.cx, len(ed.lines[ed.cy]))
    ed.ay = -1
}

func edGoToLine(ed, line) {
    ed.cy = clamp(line, 0, len(ed.lines) - 1)
    ed.cx = leadingSpaces(ed.lines[ed.cy])
    ed.ay = -1
    var rows = _visibleRows(ed)
    _foldSync(ed)
    if (len(ed.foldR) == 0) {
        if (ed.cy < ed.top || ed.cy >= ed.top + rows - 1) { ed.top = max(0, ed.cy - toInt(rows / 3)) }
    } else if (ed.cy < ed.top || _rowsBetween(ed, ed.top, ed.cy) >= rows - 1) {
        ed.top = ed.cy
        var k = 0
        while (k < toInt(rows / 3) && ed.top > 0) {
            ed.top = _prevVis(ed, ed.top)
            k = k + 1
        }
    }
}

// Точка зупинки на рядку під мишею (клік по жолобу).
func edToggleBreakAt(ed, my) {
    var vr = toInt(floor((my - ed.y - 4) / ed.lineH))
    if (vr < 0) { return }
    var row = _rowLine(ed, vr)
    if (row < 0 || row >= len(ed.lines)) { return }
    var i = indexOf(ed.breaks, row)
    if (i >= 0) { removeAt(ed.breaks, i) } else { append(ed.breaks, row) }
}

// Номери рядків точок зупинки (з 1, для налагоджувача).
func edBreakLines(ed) {
    var out = []
    for b in ed.breaks { append(out, b + 1) }
    return out
}

// Пікселі -> позиція в тексті.
func edPosAt(ed, mx, my) {
    var row = _rowLine(ed, max(0, toInt(floor((my - ed.y - 4) / ed.lineH))))
    var col = toInt(round((mx - ed.x - ed.gutterW) / ed.charW)) + ed.left
    col = clamp(col, 0, len(ed.lines[row]))
    return [row, col]
}

// ---------- автодоповнення ----------

var _acKeywords = ["func", "var", "if", "else", "while", "for", "return", "break", "continue",
                   "in", "struct", "self", "import", "extends", "super", "try", "catch", "throw",
                   "true", "false", "null"]

// Слово (назва) перед курсором: [початок, текст].
func _wordBefore(ed) {
    var line = ed.lines[ed.cy]
    var a = ed.cx
    while (a > 0 && (isIdentPart(charCode(line[a - 1])) || (line[a - 1] == "'" && a > 1 && isIdentPart(charCode(line[a - 2]))))) { a = a - 1 }
    return [a, cut(line, a, ed.cx)]
}

// Назви з усього файлу (з кешу підсвітки - перераховуються лише змінені рядки).
func _fileNames(ed) {
    // великий файл: назви збираються не частіше ніж раз на 1.5 с
    if (len(ed.lines) > 2000 && ed.acNames != null && timeMs() - ed.acTime < 1500) { return ed.acNames }
    _warmTokens(ed, len(ed.lines) - 1)
    var names = []
    var seen = newMap()
    var i = 0
    while (i < len(ed.lines)) {
        var t = ed.hlTok[i]
        var k = 0
        while (k < len(t)) {
            var kind = t[k + 2]
            if (kind == HL_TEXT || kind == HL_FUNC || kind == HL_TYPE) {
                var w = substring(ed.lines[i], t[k], t[k + 1] - t[k])
                // слово, яке зараз набирається, у підказки не йде
                if (!(i == ed.cy && t[k + 1] == ed.cx) && !mapHas(seen, w)) {
                    mapSet(seen, w, true)
                    append(names, [w, kind])
                }
            }
            k = k + 3
        }
        i = i + 1
    }
    ed.acNames = names
    ed.acTime = timeMs()
    return names
}

func edUpdateCompletion(ed) {
    var wb = _wordBefore(ed)
    var prefix = wb[1]
    ed.acOpen = false
    if (len(prefix) < 2) { return }
    var low = toLower(prefix)
    var items = []
    var seen = newMap()
    for nk in _fileNames(ed) {
        var w = nk[0]
        if (w != prefix && startsWith(toLower(w), low) && !mapHas(seen, w)) {
            mapSet(seen, w, true)
            var kindName = "назва"
            if (nk[1] == HL_FUNC) { kindName = "функція" }
            if (nk[1] == HL_TYPE) { kindName = "структура" }
            append(items, [w, kindName])
        }
    }
    for w in _acKeywords {
        if (w != prefix && startsWith(w, low) && !mapHas(seen, w)) {
            mapSet(seen, w, true)
            append(items, [w, "слово мови"])
        }
    }
    for w in BUILTIN_NAMES {
        if (w != prefix && startsWith(toLower(w), low) && !mapHas(seen, w)) {
            mapSet(seen, w, true)
            append(items, [w, "вбудована"])
        }
        if (len(items) >= 40) { break }
    }
    if (len(items) == 0) { return }
    ed.acItems = slice(items, 0, min(len(items), 8))
    ed.acSel = 0
    ed.acOpen = true
}

func edAcceptCompletion(ed) {
    _hlFrom(ed, ed.cy)
    var item = ed.acItems[ed.acSel]
    var wb = _wordBefore(ed)
    var line = ed.lines[ed.cy]
    var ins = item[0]
    var after = cut(line, ed.cx, len(line))
    // вбудована функція - одразу з дужками, курсор усередині
    var addParen = item[1] == "вбудована" && !startsWith(after, "(")
    ed.lines[ed.cy] = cut(line, 0, wb[0]) + ins + after
    ed.cx = wb[0] + len(ins)
    if (addParen) {
        ed.lines[ed.cy] = cut(ed.lines[ed.cy], 0, ed.cx) + "()" + cut(ed.lines[ed.cy], ed.cx, len(ed.lines[ed.cy]))
        ed.cx = ed.cx + 1
    }
    ed.wantCol = ed.cx
    ed.acOpen = false
    ed.dirty = true
}

// ---------- пошук (Ctrl+F) ----------

// Наступний (dir = 1) чи попередній (-1) збіг після курсора - з виділенням.
func edFindNext(ed, dir) {
    var q = ed.findText
    if (q == "") { return false }
    var lq = toLower(q)
    var n = len(ed.lines)
    var startLine = ed.cy
    var startCol = ed.cx
    if (dir < 0 && edHasSel(ed)) { startCol = edSelRange(ed)[1] }
    var step = 0
    while (step <= n) {
        var li = ((startLine + dir * step) % n + n) % n
        var line = toLower(ed.lines[li])
        var found = -1
        if (dir > 0) {
            var from = 0
            if (step == 0) { from = startCol }
            var rest = cut(line, from, len(line))
            var at = indexOf(rest, lq)
            if (at >= 0) { found = from + at }
        } else {
            var limit = len(line)
            if (step == 0) { limit = startCol }
            var pos = 0
            while (true) {
                var at2 = indexOf(cut(line, pos, len(line)), lq)
                if (at2 < 0 || pos + at2 + len(lq) > limit) { break }
                found = pos + at2
                pos = found + 1
            }
        }
        if (found >= 0) {
            ed.ay = li
            ed.ax = found
            ed.cy = li
            ed.cx = found + len(q)
            edEnsureVisible(ed)
            return true
        }
        step = step + 1
    }
    return false
}

func edFindCount(ed) {
    if (ed.findText == "") { return 0 }
    var lq = toLower(ed.findText)
    var c = 0
    for l in ed.lines {
        var line = toLower(l)
        var pos = 0
        while (true) {
            var at = indexOf(cut(line, pos, len(line)), lq)
            if (at < 0) { break }
            c = c + 1
            pos = pos + at + len(lq)
        }
    }
    return c
}

// Поле в рядку пошуку/заміни; курсор - лише в активному.
func _findField(text, hint, on, x, y, w, id) {
    if (on) { surfaceRoundRect(S, x - 1, y - 1, w + 2, 30, 7, C_ACCENT) }
    surfaceRoundRect(S, x, y, w, 28, 6, C_BG)
    surfaceClip(S, x + 4, y, w - 8, 28)
    var tw = surfaceText(S, text, x + 8, y + 6, 16, C_TEXT)
    if (on) { surfaceRect(S, x + 9 + tw, y + 4, 2, 20, C_ACCENT) }
    if (text == "") { surfaceText(S, hint, x + 14, y + 6, 16, C_DIM) }
    surfaceUnclip(S)
    uiRegion(id, x, y, w, 28)
}

// ---------- клавіатура ----------

// Повертає true, якщо клавішу оброблено.
func edKey(ed, e) {
    var k = e.key
    if (e.ctrl && (k == "f" || k == "h")) {
        ed.findOpen = true
        ed.replOpen = k == "h"
        ed.findField = 0
        if (k == "h" && ed.findText != "") { ed.findField = 1 }
        ed.acOpen = false
        if (edHasSel(ed)) {
            var r0 = edSelRange(ed)
            if (r0[0] == r0[2]) { ed.findText = edSelText(ed) }
        }
        return true
    }
    if (ed.findOpen) {
        if (k == "Escape") {
            ed.findOpen = false
            return true
        }
        if (k == "Tab" && ed.replOpen) {
            ed.findField = 1 - ed.findField
            return true
        }
        if (k == "Enter" && ed.replOpen && e.ctrl) {
            edReplaceAll(ed)
            edEnsureVisible(ed)
            return true
        }
        if (k == "Enter" && ed.replOpen && ed.findField == 1) {
            edReplaceOne(ed)
            return true
        }
        if (k == "Enter") {
            var dir = 1
            if (e.shift) { dir = -1 }
            edFindNext(ed, dir)
            return true
        }
        if (k == "Backspace") {
            if (ed.findField == 1) {
                if (len(ed.replText) > 0) { ed.replText = uiDropLast(ed.replText) }
            } else if (len(ed.findText) > 0) { ed.findText = uiDropLast(ed.findText) }
            return true
        }
        if (e.ctrl && k == "v") {
            var clip = replace(clipboardGet(), "\n", " ")
            if (ed.findField == 1) { ed.replText = ed.replText + clip } else { ed.findText = ed.findText + clip }
            return true
        }
        return true
    }
    if (ed.acOpen) {
        if (k == "Down") {
            ed.acSel = (ed.acSel + 1) % len(ed.acItems)
            return true
        }
        if (k == "Up") {
            ed.acSel = (ed.acSel - 1 + len(ed.acItems)) % len(ed.acItems)
            return true
        }
        if (k == "Enter" || k == "Tab") {
            edBeginEdit(ed, "other")
            edAcceptCompletion(ed)
            return true
        }
        if (k == "Escape") {
            ed.acOpen = false
            return true
        }
        if (k != "Shift" && k != "Backspace") { ed.acOpen = false }
    }
    if (e.ctrl) {
        if (k == "a") { edSelectAll(ed)  return true }
        if (k == "c") {
            if (edHasSel(ed)) { clipboardSet(edSelText(ed)) }
            else { clipboardSet(ed.lines[ed.cy] + "\n") }
            return true
        }
        if (k == "x") {
            edBeginEdit(ed, "other")
            if (edHasSel(ed)) {
                clipboardSet(edSelText(ed))
                edDeleteSel(ed)
            } else {
                clipboardSet(ed.lines[ed.cy] + "\n")
                ed.ay = -1
                if (len(ed.lines) > 1) {
                    removeAt(ed.lines, ed.cy)
                    ed.cy = min(ed.cy, len(ed.lines) - 1)
                } else { ed.lines[0] = "" }
                ed.cx = min(ed.cx, len(ed.lines[ed.cy]))
            }
            edEnsureVisible(ed)
            return true
        }
        if (k == "v") {
            var t = clipboardGet()
            if (len(t) > 0) {
                edBeginEdit(ed, "other")
                edInsert(ed, t)
                edEnsureVisible(ed)
            }
            return true
        }
        if (k == "z" && !e.shift) { edUndo(ed)  edEnsureVisible(ed)  return true }
        if (k == "y" || (k == "z" && e.shift)) { edRedo(ed)  edEnsureVisible(ed)  return true }
        if (k == "d") { edBeginEdit(ed, "other")  edDuplicateLine(ed)  edEnsureVisible(ed)  return true }
        if (k == "/") { edBeginEdit(ed, "other")  edToggleComment(ed)  return true }
        if (k == "=" || k == "+") { edZoom(ed, 1)  return true }
        if (k == "-") { edZoom(ed, -1)  return true }
    }
    if (e.ctrl && e.shift && (k == "[" || k == "{" || k == "х" || k == "Х")) { edFoldAtCursor(ed)  edEnsureVisible(ed)  return true }
    if (e.ctrl && e.shift && (k == "]" || k == "}" || k == "ї" || k == "Ї")) { edUnfoldAtCursor(ed)  return true }
    if (e.alt && !e.ctrl && (k == "Up" || k == "Down")) {
        var md = 1
        if (k == "Up") { md = -1 }
        edBeginEdit(ed, "other")
        edMoveLines(ed, md, e.shift)
        edEnsureVisible(ed)
        return true
    }
    if (k == "Left" || k == "Right" || k == "Up" || k == "Down" || k == "Home" || k == "End" || k == "PageUp" || k == "PageDown") {
        edMoveKey(ed, k, e.ctrl, e.shift)
        if (!(e.ctrl && (k == "Up" || k == "Down"))) { edEnsureVisible(ed) }
        return true
    }
    if (k == "Backspace") {
        edBeginEdit(ed, "del")
        edBackspace(ed)
        edEnsureVisible(ed)
        if (ed.acOpen) { edUpdateCompletion(ed) }
        return true
    }
    if (k == "Delete") { edBeginEdit(ed, "del")  edDelete(ed)  edEnsureVisible(ed)  return true }
    if (k == "Enter") { edBeginEdit(ed, "other")  edNewline(ed)  edEnsureVisible(ed)  return true }
    if (k == "Tab") { edBeginEdit(ed, "other")  edIndent(ed, e.shift)  edEnsureVisible(ed)  return true }
    if (k == "Escape" && edHasSel(ed)) { ed.ay = -1  return true }
    return false
}

func edTextInput(ed, t) {
    if (ed.findOpen && ed.findField == 1) {
        ed.replText = ed.replText + t
        return
    }
    if (ed.findOpen) {
        ed.findText = ed.findText + t
        // пошук "на льоту" - з початку поточного збігу
        if (edHasSel(ed)) {
            var r = edSelRange(ed)
            ed.cy = r[0]
            ed.cx = r[1]
        }
        ed.ay = -1
        edFindNext(ed, 1)
        return
    }
    edBeginEdit(ed, "type")
    edType(ed, t)
    edEnsureVisible(ed)
    if (!ed.plain && isIdentPart(charCode(t))) { edUpdateCompletion(ed) } else { ed.acOpen = false }
}

var ZOOM_SIZES = [12, 14, 16, 20, 24, 28, 32]

func edZoom(ed, dir) {
    var i = indexOf(ZOOM_SIZES, ed.fontSize)
    if (i < 0) { i = 2 }
    i = clamp(i + dir, 0, len(ZOOM_SIZES) - 1)
    ed.fontSize = ZOOM_SIZES[i]
}

// ---------- малювання ----------

// Кеш підсвітки: токени перераховуються лише для змінених рядків (і тих,
// чий стан "всередині /* */" на вході змінився). Прохід зверху до
// останнього видимого рядка - щоб стан коментаря був правильним.
func _warmTokens(ed, upTo) {
    ed.hlOk = min(ed.hlOk, len(ed.lines))
    var i = ed.hlOk
    if (i > upTo) { return }
    while (i <= upTo && i < len(ed.lines)) {
        while (len(ed.hlSrc) < len(ed.lines)) {
            append(ed.hlSrc, null) append(ed.hlIn, false) append(ed.hlTok, []) append(ed.hlOut, false)
        }
        var inState = false
        if (i > 0) { inState = ed.hlOut[i - 1] }
        if (ed.hlSrc[i] != ed.lines[i] || ed.hlIn[i] != inState) {
            // звичайний текст (.md, .txt, ...) - без підсвітки синтаксису
            var r = [[0, len(ed.lines[i]), HL_TEXT], false]
            if (!ed.plain) { r = hlLine(ed.lines[i], inState) }
            ed.hlSrc[i] = ed.lines[i]
            ed.hlIn[i] = inState
            ed.hlTok[i] = r[0]
            ed.hlOut[i] = r[1]
        }
        i = i + 1
    }
    ed.hlOk = max(ed.hlOk, min(upTo + 1, len(ed.lines)))
}

func edDraw(ed, x, y, w, h, focused) {
    // код - моноширинним (якщо не вибрано піксельний шрифт)
    var prevFont = surfaceFont("mono")
    if (prevFont == "pixel") { surfaceFont("pixel") }
    ed.x = x
    ed.y = y
    ed.w = w
    ed.h = h
    var fs = ed.fontSize
    ed.charW = textWidth("M", fs)
    ed.lineH = textHeight(fs) + 4
    var digits = len(toString(len(ed.lines)))
    // + колонка стрілок згортання між номерами й текстом
    ed.gutterW = (max(digits, 2) + 2) * ed.charW + 8 + FOLD_COL
    var cw = ed.charW
    var lh = ed.lineH
    var textX = x + ed.gutterW

    surfaceRect(S, x, y, w, h, C_BG)
    surfaceRect(S, x, y, ed.gutterW - 6, h, C_PANEL)
    surfaceClip(S, x, y, w, h)

    var rows = toInt(h / lh) + 1
    _foldSync(ed)
    var last = min(len(ed.lines) - 1, ed.top + rows)
    if (len(ed.foldR) > 0) { last = _rowLine(ed, rows) }
    _warmTokens(ed, last)
    var sel = [-1, 0, -1, 0]
    if (edHasSel(ed)) { sel = edSelRange(ed) }
    var hiWord = ""
    var hiFrom = 0
    var hiTo = len(ed.lines)
    if (focused && !edHasSel(ed)) {
        var wa = edWordAtCursor(ed)
        if (wa != null) {
            hiWord = wa[2]
            // локальна змінна - лише в своїй функції
            _warmTokens(ed, max(last, ed.cy))
            var ld = symLocalDef(ed.lines, ed.hlTok, hiWord, ed.cy)
            if (ld != null) {
                hiFrom = ld[2][0]
                hiTo = ld[2][1]
            }
        }
    }

    // парна дужка до тієї, що біля курсора
    var br = null
    if (focused && !edHasSel(ed)) { br = edMatchBracket(ed) }

    // стрілки згортання - коли миша над жолобом (згорнуті - завжди)
    var gutHover = uiHover(x, y, ed.gutterW, h)
    var drawn = []
    var foldHits = []
    var curRow = -1
    var row = 0
    var li = ed.top
    while (row < rows) {
        if (li >= len(ed.lines)) { break }
        append(drawn, li)
        if (li == ed.cy) { curRow = row }
        var ly = y + 4 + row * lh
        var line = ed.lines[li]
        if (li == ed.dbgLine) { surfaceRect(S, textX - 4, ly - 2, w, lh, C_DBGLINE) }
        else if (li == ed.errLine) { surfaceRect(S, textX - 4, ly - 2, w, lh, C_ERRLINE) }
        else if (li == ed.cy && focused && !edHasSel(ed)) { surfaceRect(S, textX - 4, ly - 2, w, lh, C_CURLINE) }

        // виділення
        if (sel[0] >= 0 && li >= sel[0] && li <= sel[2]) {
            var sx = 0
            var ex = len(line) + 1
            if (li == sel[0]) { sx = sel[1] }
            if (li == sel[2]) { ex = sel[3] }
            if (ex > sx) {
                surfaceRect(S, textX + (sx - ed.left) * cw, ly - 2, (ex - sx) * cw, lh, C_SELECTION)
            }
        }

        // інші входження імені під курсором (як у VS Code)
        var toks = ed.hlTok[li]
        if (hiWord != "" && li >= hiFrom && li <= hiTo) {
            var q = 0
            while (q < len(toks)) {
                if (toks[q + 1] - toks[q] == len(hiWord) && (toks[q + 2] == HL_TEXT || toks[q + 2] == HL_FUNC || toks[q + 2] == HL_TYPE)
                    && substring(line, toks[q], len(hiWord)) == hiWord && toks[q + 1] > ed.left) {
                    surfaceRect(S, textX + (toks[q] - ed.left) * cw, ly - 2, len(hiWord) * cw, lh, C_WORDHI)
                }
                q = q + 3
            }
        }

        if (br != null) {
            for bp in br {
                if (bp[0] == li && bp[1] >= ed.left) {
                    var bx = textX + (bp[1] - ed.left) * cw
                    surfaceRect(S, bx, ly - 2, cw, lh, C_WORDHI)
                    surfaceRect(S, bx, ly + lh - 4, cw, 2, C_ACCENT)
                }
            }
        }

        // текст за токенами
        surfaceClip(S, textX - 2, y, w - ed.gutterW + 2, h)
        var k = 0
        var nt = len(toks)
        while (k < nt) {
            var ts = toks[k]
            var te = toks[k + 1]
            if (te > ed.left) {
                surfaceText(S, substring(line, ts, te - ts), textX + (ts - ed.left) * cw, ly, fs, HL_COLORS[toks[k + 2]])
            }
            k = k + 3
        }
        surfaceUnclip(S)

        // номер рядка
        var num = toString(li + 1)
        var numColor = C_DIM
        if (li == ed.cy) { numColor = C_SUBTEXT }
        if (li == ed.errLine) {
            numColor = C_RED
            surfaceCircle(S, x + 8, ly + toInt(lh / 2) - 2, 4, C_RED)
        }
        // знахідки розширень (Anylint...) - кольорова смужка біля тексту
        for mk in ed.marks {
            if (mk[0] == li) {
                var mc = C_YELLOW
                if (mk[1] == "error") { mc = C_RED }
                if (mk[1] == "info") { mc = C_ACCENT }
                surfaceRect(S, x + ed.gutterW - 10, ly - 1, 3, lh - 2, mc)
            }
        }
        // точка зупинки - червоне коло на жолобі; поточний рядок паузи - жовта стрілка
        if (indexOf(ed.breaks, li) >= 0) { surfaceCircle(S, x + 9, ly + toInt(lh / 2) - 1, 6, 0xe5484d) }
        if (li == ed.dbgLine) {
            var ay = ly + toInt(lh / 2) - 1
            surfacePolygon(S, [x + 3, ay - 6, x + 11, ay - 6, x + 17, ay, x + 11, ay + 6, x + 3, ay + 6], C_YELLOW)
        }
        surfaceText(S, num, x + ed.gutterW - 14 - FOLD_COL - len(num) * cw, ly, fs, numColor)
        var folded = edIsFolded(ed, li)
        if (folded || (gutHover && edFoldEnd(ed, li) >= 0)) {
            var fx0 = x + ed.gutterW - FOLD_COL - 12
            iconChevron(fx0, ly + toInt(lh / 2) - 9, 18, !folded, C_SUBTEXT)
            append(foldHits, ["fold:" + toString(li), fx0, ly - 2, FOLD_COL, lh])
        }
        if (folded) {
            // «...» після рядка - клік розгортає
            var ex2 = textX + (len(line) + 1 - ed.left) * cw
            if (ex2 >= textX) {
                surfaceRoundRect(S, ex2, ly, 3 * cw, lh - 4, 4, C_SURFACE2)
                surfaceText(S, "...", ex2, ly - 3, fs, C_SUBTEXT)
                append(foldHits, ["fold:" + toString(li), ex2, ly, 3 * cw, lh - 4])
            }
        }
        row = row + 1
        li = _nextVis(ed, li)
    }

    // курсор
    if (focused && curRow >= 0) {
        var cxp = textX + (ed.cx - ed.left) * cw
        if (cxp >= textX - 1) {
            surfaceRect(S, cxp, y + 4 + curRow * lh - 1, 2, lh - 2, C_ACCENT)
        }
    }

    // збіги пошуку на видимих рядках
    if (ed.findOpen && ed.findText != "") {
        var lq = toLower(ed.findText)
        var r2 = 0
        while (r2 < len(drawn)) {
            var ln = toLower(ed.lines[drawn[r2]])
            var pos = 0
            while (true) {
                var at = indexOf(cut(ln, pos, len(ln)), lq)
                if (at < 0) { break }
                var mx = textX + (pos + at - ed.left) * cw
                surfaceRect(S, mx, y + 4 + r2 * lh - 2, len(lq) * cw, lh, 0x50f9e2af)
                pos = pos + at + len(lq)
            }
            r2 = r2 + 1
        }
    }

    // смуга прокрутки
    if (len(ed.lines) > rows - 1) {
        var total = len(ed.lines) + rows - 2
        var barH = max(24, toInt(h * (rows - 1) / total))
        var barY = y + toInt((h - barH) * ed.top / max(1, len(ed.lines) - 1))
        surfaceRoundRect(S, x + w - 8, barY, 6, barH, 3, C_SURFACE2)
    }
    surfaceUnclip(S)
    uiRegion("editor", x, y, w, h)
    // жолоб з номерами рядків - клік ставить/знімає точку зупинки
    uiRegion("gutter", x, y, ed.gutterW - 6, h)
    // стрілки й «...» згортання - поверх редактора й жолоба
    for fh in foldHits { uiRegion(fh[0], fh[1], fh[2], fh[3], fh[4]) }

    // рядок пошуку
    if (ed.findOpen) {
        var fw = min(420, w - 32)
        var fx = x + w - fw - 16
        var fy = y + 8
        var fh = 40
        if (ed.replOpen) { fh = 76 }
        surfaceRoundRect(S, fx + 3, fy + 3, fw, fh, 8, 0x44000000)
        surfaceRoundRect(S, fx, fy, fw, fh, 8, C_SURFACE)
        uiRegion("ed.findbar", fx, fy, fw, fh)
        var fieldW = fw - 130
        _findField(ed.findText, "Знайти…", ed.findField == 0, fx + 8, fy + 6, fieldW, "ed.findf:0")
        var cnt = edFindCount(ed)
        var info = toString(cnt) + " збіг."
        if (cnt == 0 && ed.findText != "") { info = "нема" }
        surfaceText(S, info, fx + fieldW + 16, fy + 12, 14, C_SUBTEXT)
        surfaceText(S, "Esc", fx + fw - 36, fy + 12, 14, C_DIM)
        if (ed.replOpen) {
            _findField(ed.replText, "Замінити на…", ed.findField == 1, fx + 8, fy + 42, fieldW, "ed.findf:1")
            uiButton("ed.replone", "Одне", fx + fieldW + 14, fy + 42, 50, 28, "flat")
            uiButton("ed.replall", "Усі", fx + fieldW + 66, fy + 42, 50, 28, "flat")
        }
    }

    // список автодоповнення під курсором
    if (ed.acOpen && focused && curRow >= 0) {
        var wb = _wordBefore(ed)
        var px = textX + (wb[0] - ed.left) * cw - 4
        var py = y + 4 + (curRow + 1) * lh
        var pw = 0
        for it in ed.acItems { pw = max(pw, textWidth(it[0], fs) + textWidth(it[1], 12) + 40) }
        var ph = len(ed.acItems) * (lh + 2) + 8
        if (py + ph > y + h) { py = y + 4 + curRow * lh - ph }
        px = min(px, x + w - pw - 8)
        surfaceRoundRect(S, px + 3, py + 3, pw, ph, 8, 0x66000000)
        surfaceRoundRect(S, px, py, pw, ph, 8, C_SURFACE)
        var iy = py + 4
        var i = 0
        while (i < len(ed.acItems)) {
            var it2 = ed.acItems[i]
            if (i == ed.acSel) { surfaceRoundRect(S, px + 4, iy, pw - 8, lh + 2, 6, C_SURFACE2) }
            var col = C_TEXT
            if (it2[1] == "функція" || it2[1] == "вбудована") { col = C_YELLOW }
            if (it2[1] == "слово мови") { col = C_MAUVE }
            surfaceText(S, it2[0], px + 12, iy + 2, fs, col)
            surfaceText(S, it2[1], px + pw - textWidth(it2[1], 12) - 12, iy + 5, 12, C_DIM)
            iy = iy + lh + 2
            i = i + 1
        }
    }
    surfaceFont(prevFont)
}
