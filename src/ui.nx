// Базові елементи інтерфейсу поверх полотна surface*.
//
// Підхід "immediate mode": кожен кадр інтерфейс малюється заново, і кожна
// кнопка під час малювання реєструє свою область (uiRegion). Клік потім
// шукає, у чию область потрапив (uiHit) - ніяких об'єктів-віджетів, які
// треба синхронізувати зі станом програми.

import "theme.nx"

var S = null                 // полотно (surface)
var _regions = []            // [x, y, w, h, id, ...]
var uiMouseX = -1
var uiMouseY = -1
var uiPressedId = ""         // кнопка, на якій натиснули мишу

var FONT = 16                // розмір шрифту інтерфейсу
var CHAR_W = 8               // ширина символу шрифту FONT

func uiInit(surface) {
    S = surface
    CHAR_W = textWidth("M", FONT)
}

func uiBegin() {
    _regions = []
    uiAnimating = false
}

// ---------- анімації ----------
//
// uiAnim(id, ціль, мс) - значення, що плавно (за мс) іде до цілі; поки
// хоч одне не дійшло, uiAnimating = true і IDE малює наступний кадр
// (інакше кадри малюються лише на події - IDE не їсть процесор).
var _anims = newMap()
var uiAnimating = false

func uiAnim(id, target, ms) {
    var now = timeMs()
    if (!mapHas(_anims, id)) {
        mapSet(_anims, id, [target, now])
        return target
    }
    var a = mapGet(_anims, id)
    var step = (now - a[1]) / max(1, ms)
    a[1] = now
    if (a[0] < target) { a[0] = min(target, a[0] + step) }
    else if (a[0] > target) { a[0] = max(target, a[0] - step) }
    if (a[0] != target) { uiAnimating = true }
    return a[0]
}

// Колір між c1 і c2 (t від 0 до 1).
func uiMix(c1, c2, t) {
    if (t <= 0) { return c1 }
    if (t >= 1) { return c2 }
    var r = toInt(((c1 >> 16) % 256) * (1 - t) + ((c2 >> 16) % 256) * t)
    var g = toInt(((c1 >> 8) % 256) * (1 - t) + ((c2 >> 8) % 256) * t)
    var b = toInt((c1 % 256) * (1 - t) + (c2 % 256) * t)
    return r * 65536 + g * 256 + b
}

func uiRegion(id, x, y, w, h) {
    append(_regions, x) append(_regions, y) append(_regions, w) append(_regions, h) append(_regions, id)
}

// id області під точкою (остання намальована - зверху) або "".
func uiHit(x, y) {
    var k = len(_regions) - 5
    while (k >= 0) {
        if (x >= _regions[k] && y >= _regions[k + 1] && x < _regions[k] + _regions[k + 2] && y < _regions[k + 1] + _regions[k + 3]) {
            return _regions[k + 4]
        }
        k = k - 5
    }
    return ""
}

// Де намальовано область id: [x, y, w, h] або null.
func uiFind(id) {
    var k = len(_regions) - 5
    while (k >= 0) {
        if (_regions[k + 4] == id) { return [_regions[k], _regions[k + 1], _regions[k + 2], _regions[k + 3]] }
        k = k - 5
    }
    return null
}

func uiHover(x, y, w, h) {
    return uiMouseX >= x && uiMouseY >= y && uiMouseX < x + w && uiMouseY < y + h
}

// Кнопка. kind: "normal" | "primary" (зелена) | "danger" (червона) |
// "tab" | "tabOn" (вкладка) | "flat" (без фону, лише під мишею).
func uiButton(id, label, x, y, w, h, kind) {
    var hover = uiHover(x, y, w, h)
    var bg = C_SURFACE
    var fg = C_TEXT
    var hbg = C_SURFACE2
    if (kind == "primary") {
        bg = 0x40a060
        hbg = 0x4cb870
        fg = 0xffffff
    }
    if (kind == "danger") {
        bg = 0xc0506a
        hbg = 0xd8607c
        fg = 0xffffff
    }
    if (kind == "tab") {
        bg = C_PANEL2
        fg = C_SUBTEXT
    }
    if (kind == "tabOn") {
        bg = C_BG
        hbg = C_BG
        fg = C_TEXT
    }
    // наведення - плавно (120 мс), а не стрибком
    var ht = 0
    if (hover) { ht = 1 }
    ht = uiAnim("b:" + id, ht, 120)
    if (kind == "flat") {
        // без фону: підсвітка проступає прозорістю поверх того, що під кнопкою
        bg = -1
        fg = uiMix(C_SUBTEXT, C_TEXT, ht)
        if (ht > 0) { surfaceRoundRect(S, x, y, w, h, 6, C_SURFACE2 + toInt(ht * 255) * 16777216) }
    } else {
        bg = uiMix(bg, hbg, ht)
        if (kind == "normal" || kind == "tab") { fg = uiMix(fg, C_TEXT, ht) }
    }
    if (uiPressedId == id && hover) { bg = C_DIM }
    if (bg >= 0) {
        if (kind == "tab" || kind == "tabOn") { surfaceRect(S, x, y, w, h, bg) }
        else { surfaceRoundRect(S, x, y, w, h, 6, bg) }
    }
    if (kind == "tabOn") { surfaceRect(S, x, y + h - 2, w, 2, C_ACCENT) }
    // "‹" / "›" - стрілка-шеврон (згорнути / розгорнути панель).
    if (label == "‹" || label == "›") {
        var mx = x + toInt(w / 2)
        var my = y + toInt(h / 2)
        if (label == "‹") {
            surfaceLine(S, mx + 3, my - 6, mx - 3, my, fg, 2)
            surfaceLine(S, mx - 3, my, mx + 3, my + 6, fg, 2)
        } else {
            surfaceLine(S, mx - 3, my - 6, mx + 3, my, fg, 2)
            surfaceLine(S, mx + 3, my, mx - 3, my + 6, fg, 2)
        }
        uiRegion(id, x, y, w, h)
        return
    }
    // "▶ " / "■ " на початку підпису - іконка фігурою (гліфи шрифту дрібні).
    var icon = ""
    if (startsWith(label, "▶ ") || startsWith(label, "■ ")) {
        icon = label[0]
        label = substring(label, 2, len(label) - 2)
    }
    var tw = textWidth(label, FONT)
    var iconW = 0
    if (icon != "") { iconW = 18 }
    var tx = x + toInt((w - tw - iconW) / 2)
    var midY = y + toInt(h / 2)
    if (icon == "▶") { surfacePolygon(S, [tx, midY - 6, tx + 11, midY, tx, midY + 6], fg) }
    if (icon == "■") { surfaceRect(S, tx, midY - 5, 10, 10, fg) }
    surfaceText(S, label, tx + iconW, y + toInt((h - textHeight(FONT)) / 2), FONT, fg)
    uiRegion(id, x, y, w, h)
}

// Рядок без останнього символу (Backspace у полі вводу): емодзі - дві
// "половинки" в рядку, стираються разом.
func uiDropLast(s) {
    var n = len(s)
    if (n == 0) { return s }
    var k = 1
    if (n >= 2 && charCode(s[n - 1]) >= 0xDC00 && charCode(s[n - 1]) <= 0xDFFF && charCode(s[n - 2]) >= 0xD800 && charCode(s[n - 2]) <= 0xDBFF) { k = 2 }
    return substring(s, 0, n - k)
}

// Ширина кнопки під підпис з полями.
func uiButtonW(label) { return textWidth(label, FONT) + 24 }

// Обрізає текст справа "…", щоб влазив у maxW пікселів.
func uiFit(text, maxW, size) {
    if (textWidth(text, size) <= maxW) { return text }
    var cw = textWidth("M", size)
    var n = maxW / cw - 1
    if (n < 1) { return "" }
    return substring(text, 0, toInt(n)) + "…"
}

// Підказка-плашка біля миші.
func uiTooltip(text) {
    var w = textWidth(text, 14) + 16
    var x = min(uiMouseX + 12, surfaceWidth(S) - w - 4)
    var y = uiMouseY + 20
    surfaceRoundRect(S, x, y, w, 24, 6, C_SURFACE2)
    surfaceText(S, text, x + 8, y + 5, 14, C_TEXT)
}
