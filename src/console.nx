// Консоль: запуск програми, її вивід, введення (readLine) і помилки.
//
// Програма запускається окремим процесом тим самим nx, що й IDE (nxPath()),
// з interactive: true - вивід приходить посимвольно, а рядок, набраний у
// полі вводу консолі, йде програмі в stdin.

import "theme.nx"
import "ui.nx"

struct Console {
    lines: array
    proc: any
    outLen: i32
    errLen: i32
    running: bool
    startMs: i32
    scroll: i32
    errLine: i32
    input: string
    focused: bool
    runs: i32
    lastOk: bool
    lastOutput: string
    debug: bool
    dbgStart: string
    dbgBreaks: array
    paused: bool
    pauseLine: i32
    pauseFunc: string
    pauses: i32
    locals: array
    globals: array
    errBuf: string
    stageDir: string
    x: i32
    y: i32
    w: i32
    h: i32
}

func newConsole() {
    return Console { lines: [], proc: null, outLen: 0, errLen: 0, running: false, startMs: 0,
        scroll: 0, errLine: -1, input: "", focused: false, runs: 0, lastOk: false, lastOutput: "",
        debug: false, dbgStart: "", dbgBreaks: [], paused: false, pauseLine: -1, pauseFunc: "", pauses: 0,
        locals: [], globals: [], errBuf: "", stageDir: "", x: 0, y: 0, w: 0, h: 0 }
}

// Рядок консолі - [текст, вид]; вид: "out" | "err" | "info" | "ok" | "in".
func conAdd(con, text, kind) {
    append(con.lines, [text, kind, true])
    if (len(con.lines) > 2000) { removeAt(con.lines, 0) }
}

// Шматок виводу: дописується до останнього незавершеного рядка того ж виду.
func _conChunk(con, chunk, kind) {
    chunk = replace(chunk, "\r", "")
    var parts = split(chunk, "\n")
    var i = 0
    while (i < len(parts)) {
        var n = len(con.lines)
        if (i == 0 && n > 0 && con.lines[n - 1][1] == kind && con.lines[n - 1][2] == null) {
            con.lines[n - 1][0] = con.lines[n - 1][0] + parts[0]
        } else if (i < len(parts) - 1 || len(parts[i]) > 0) {
            append(con.lines, [parts[i], kind, null])
        }
        // Завершений рядок (після нього був \n) - позначаємо третім полем.
        if (i < len(parts) - 1) {
            var last = con.lines[len(con.lines) - 1]
            if (len(last) == 3) { last[2] = true }
        }
        i = i + 1
    }
    var isErrText = false
    for p in parts {
        if (startsWith(p, "Runtime Error") || contains(p, "рядок ") || contains(p, "рядку ")) { isErrText = true }
    }
    if (isErrText) { _conFindErrorLine(con) }
}

// Номер рядка з помилки: беремо ОСТАННЄ "рядок N" (найглибший виклик).
func _conFindErrorLine(con) {
    var i = len(con.lines) - 1
    var stop = max(0, len(con.lines) - 30)
    while (i >= stop) {
        var t = con.lines[i][0]
        // "рядок 12: ..." (виконання/компіляція) або "на рядку 14" (парсер)
        var at = indexOf(t, "рядок ")
        if (at < 0) { at = indexOf(t, "рядку ") }
        if (at >= 0) {
            var j = at + 6
            var num = ""
            while (j < len(t) && charCode(t[j]) >= 48 && charCode(t[j]) <= 57) {
                num = num + t[j]
                j = j + 1
            }
            if (len(num) > 0) {
                con.errLine = toInt(num) - 1
                return
            }
        }
        i = i - 1
    }
}

func conClear(con) {
    con.lines = []
    con.scroll = 0
}

// debugMode: "" - звичайний запуск; "step" - з паузою на першому рядку;
// "cont" - до першої точки зупинки (breaks - номери рядків, з 1).
// stageDir - тека сцени (NX_STAGE_DIR): вікно програми показується в IDE.
func conRun(con, path, dir, debugMode, breaks, stageDir) {
    if (con.running) { conStop(con) }
    conClear(con)
    con.errLine = -1
    con.input = ""
    con.debug = debugMode != ""
    con.dbgStart = debugMode
    con.dbgBreaks = breaks
    con.paused = false
    con.pauseLine = -1
    con.pauses = 0
    con.locals = []
    con.globals = []
    con.errBuf = ""
    var parts = split(replace(path, "\\", "/"), "/")
    var name = parts[len(parts) - 1]
    if (con.debug) { conAdd(con, "» Покроковий запуск " + name, "info") }
    else { conAdd(con, "» Запуск " + name, "info") }
    var opts = newMap()
    mapSet(opts, "interactive", true)
    mapSet(opts, "cwd", dir)
    var env = newMap()
    // програма завершиться сама, якщо IDE закриється аварійно
    mapSet(env, "NX_EXIT_WITH_PARENT", "1")
    if (con.debug) { mapSet(env, "NX_DEBUG", "1") }
    con.stageDir = stageDir
    if (stageDir != "") {
        if (!dirExists(stageDir)) { makeDir(stageDir) }
        // старий кадр і ввід попереднього запуску - геть
        deleteFile(stageDir + "/frame.raw")
        writeFile(stageDir + "/input.txt", "")
        mapSet(env, "NX_STAGE_DIR", stageDir)
    }
    mapSet(opts, "env", env)
    try {
        con.proc = procStart(nxPath(), [path], opts)
        con.running = true
        con.outLen = 0
        con.errLen = 0
        con.startMs = timeMs()
        con.focused = true
    } catch (e) {
        conAdd(con, "Не вдалося запустити: " + toString(e), "err")
    }
}

// Команда налагоджувачу (лише в паузі): "s" крок, "n" через, "o" вийти, "c" далі.
func conDebug(con, cmd) {
    if (!con.running || !con.paused) { return }
    con.paused = false
    con.pauseLine = -1
    procWrite(con.proc, cmd + "\n")
}

// Точки зупинки на ходу (у паузі): нові діють з наступної команди.
func conSetBreaks(con, breaks) {
    con.dbgBreaks = breaks
    if (con.running && con.paused) { procWrite(con.proc, "b " + _joinNums(breaks) + "\n") }
}

func _joinNums(arr) {
    var parts = []
    for n in arr { append(parts, toString(n)) }
    return join(parts, ",")
}

// stderr: рядки з префіксом \u0001NXDBG - події налагоджувача, решта - помилки.
func _errChunk(con, chunk) {
    var marker = fromCharCode(1) + "NXDBG "
    con.errBuf = con.errBuf + replace(chunk, "\r", "")
    var lines = split(con.errBuf, "\n")
    con.errBuf = lines[len(lines) - 1]
    var i = 0
    while (i < len(lines) - 1) {
        var l = lines[i]
        if (startsWith(l, marker)) { _dbgEvent(con, substring(l, len(marker), len(l) - len(marker))) }
        else { _conChunk(con, l + "\n", "err") }
        i = i + 1
    }
}

func _dbgEvent(con, json) {
    var ev = null
    try { ev = fromJson(json) } catch (e) { return }
    var kind = mapGet(ev, "event")
    if (kind == "ready") {
        procWrite(con.proc, "b " + _joinNums(con.dbgBreaks) + "\n")
        if (con.dbgStart == "cont") { procWrite(con.proc, "c\n") } else { procWrite(con.proc, "s\n") }
        return
    }
    if (kind == "paused") {
        con.paused = true
        con.pauses = con.pauses + 1
        con.pauseLine = toInt(mapGet(ev, "line")) - 1
        con.pauseFunc = toString(mapGet(ev, "func"))
        con.locals = mapGet(ev, "locals")
        con.globals = mapGet(ev, "globals")
    }
}

// Подія для програми на сцені (рядок у input.txt).
func conStageInput(con, line) {
    if (!con.running || con.stageDir == "") { return }
    appendFile(con.stageDir + "/input.txt", line + "\n")
}

func conStop(con) {
    if (!con.running) { return }
    con.paused = false
    procKill(con.proc)
    conPoll(con)
    con.running = false
    conAdd(con, "■ Зупинено", "info")
}

// Забрати новий вивід. true - щось змінилось (треба перемалювати).
func conPoll(con) {
    if (con.proc == null) { return false }
    var changed = false
    var out = procOutput(con.proc)
    if (len(out) > con.outLen) {
        _conChunk(con, substring(out, con.outLen, len(out) - con.outLen), "out")
        con.outLen = len(out)
        changed = true
    }
    var err = procErrorOutput(con.proc)
    if (len(err) > con.errLen) {
        _errChunk(con, substring(err, con.errLen, len(err) - con.errLen))
        con.errLen = len(err)
        changed = true
    }
    if (con.running && !procIsRunning(con.proc)) {
        // Процес завершився - ще раз забрати залишок виводу.
        sleep(30)
        out = procOutput(con.proc)
        if (len(out) > con.outLen) { _conChunk(con, substring(out, con.outLen, len(out) - con.outLen), "out")  con.outLen = len(out) }
        err = procErrorOutput(con.proc)
        if (len(err) > con.errLen) { _errChunk(con, substring(err, con.errLen, len(err) - con.errLen))  con.errLen = len(err) }
        if (con.errBuf != "") {
            _conChunk(con, con.errBuf, "err")
            con.errBuf = ""
        }
        con.paused = false
        con.pauseLine = -1
        con.running = false
        con.focused = false
        var code = procExitCode(con.proc)
        // для уроків: чи запуск вдався і що програма вивела
        con.runs = con.runs + 1
        con.lastOk = code == 0
        con.lastOutput = out
        var secs = toFixed((timeMs() - con.startMs) / 1000, 2)
        if (code == 0) { conAdd(con, "√ Готово за " + secs + " с", "ok") }
        else {
            _conFindErrorLine(con)
            var where = ""
            if (con.errLine >= 0) { where = " - дивись рядок " + toString(con.errLine + 1) }
            conAdd(con, "✗ Програма зупинилась з помилкою" + where, "err")
        }
        changed = true
    }
    if (changed) { con.scroll = 0 }
    return changed
}

// Enter у полі вводу - рядок іде програмі (для readLine).
func conSubmit(con) {
    if (!con.running) { return }
    conAdd(con, con.input, "in")
    procWrite(con.proc, con.input + "\n")
    con.input = ""
}

func conKey(con, e) {
    if (e.key == "Enter") { conSubmit(con)  return true }
    if (e.key == "Backspace") {
        if (len(con.input) > 0) { con.input = substring(con.input, 0, len(con.input) - 1) }
        return true
    }
    if (e.ctrl && e.key == "v") { con.input = con.input + replace(clipboardGet(), "\n", " ")  return true }
    return false
}

// Тіло консолі (заголовок з вкладками малює нижня панель IDE).
func conDraw(con, x, y, w, h) {
    con.x = x
    con.y = y
    con.w = w
    con.h = h
    surfaceRect(S, x, y, w, h, C_PANEL2)
    uiRegion("con.area", x, y, w, h)
    var bw = uiButtonW("Очистити")
    uiButton("con.clear", "Очистити", x + w - bw - 8, y + 2, bw, 24, "flat")
    var prevFont = surfaceFont("mono")
    if (prevFont == "pixel") { surfaceFont("pixel") }

    var inputH = 0
    if (con.running) { inputH = 34 }
    var lh = 18
    var top = y + 6
    var areaH = h - 6 - inputH - 4
    var rows = max(1, toInt(areaH / lh))
    surfaceClip(S, x, top, w, areaH)
    var first = max(0, len(con.lines) - rows - con.scroll)
    var i = first
    var row = 0
    while (i < len(con.lines) && row < rows) {
        var item = con.lines[i]
        var color = C_TEXT
        if (item[1] == "err" || startsWith(item[0], "Runtime Error")) { color = C_RED }
        if (item[1] == "info") { color = C_ACCENT }
        if (item[1] == "ok") { color = C_GREEN }
        if (item[1] == "in") { color = C_YELLOW }
        if (item[1] == "hint") { color = C_YELLOW }
        var text = item[0]
        if (item[1] == "in") { text = "> " + text }
        surfaceText(S, text, x + 12, top + row * lh, 16, color)
        i = i + 1
        row = row + 1
    }
    surfaceUnclip(S)
    uiRegion("console", x, top, w, areaH)

    if (con.running) {
        var iy = y + h - inputH - 2
        var border = C_SURFACE
        if (con.focused) { border = C_ACCENT }
        surfaceRoundRect(S, x + 8, iy, w - 16, inputH - 4, 6, border)
        surfaceRoundRect(S, x + 9, iy + 1, w - 18, inputH - 6, 6, C_BG)
        if (len(con.input) == 0 && !con.focused) {
            surfaceText(S, "Сюди можна писати відповідь програмі (Enter - надіслати)", x + 18, iy + 7, 16, C_DIM)
        } else {
            var tw = surfaceText(S, con.input, x + 18, iy + 7, 16, C_YELLOW)
            if (con.focused) { surfaceRect(S, x + 18 + tw + 1, iy + 6, 2, 18, C_ACCENT) }
        }
        uiRegion("con.input", x + 8, iy, w - 16, inputH - 4)
    }
    surfaceFont(prevFont)
}
