// Код -> блоки: проста програма мовою NyxilumLang стає програмою з блоків.
//
// Працює для коду, який можна скласти з блоків: print, змінні, повторення,
// умови, малювання, герой, списки, свої функції (-> «Мої блоки»). Блоки
// шукаються за їхніми ж шаблонами коду (Spec.gen), тож новий блок у
// blocks_model.nx одразу розпізнається і тут. Чого блоками не скласти
// (struct, import, return, лічильник циклу в тілі...) - зрозуміла помилка
// з номером рядка.
//
// Вирази розбираються в дерево (масиви):
//   ["num", "5"]  ["str", "текст"]  ["id", "x"]  ["call", "f", [аргументи]]
//   ["bin", "+", ліве, праве]  ["un", "!", вираз]  ["list", [елементи]]

import "blocks_model.nx"

// ---------- лексер ----------

func _cbIdentChar(c, first) {
    var code = charCode(c)
    if ((code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code == 95 || (code >= 0x400 && code <= 0x4ff)) { return true }
    if (first) { return false }
    return (code >= 48 && code <= 57) || c == "'"
}

func _cbDigit(c) {
    var code = charCode(c)
    return code >= 48 && code <= 57
}

// Токени рядка: [вид, текст]; вид "num" | "str" | "id" | "op".
func cbTokens(line) {
    var out = []
    var i = 0
    var n = len(line)
    while (i < n) {
        var c = line[i]
        if (c == " " || c == "\t" || c == "\r") {
            i = i + 1
            continue
        }
        if (c == "/" && i + 1 < n && line[i + 1] == "/") { break }
        if (c == "\"") {
            var s = ""
            i = i + 1
            while (i < n && line[i] != "\"") {
                if (line[i] == "\\" && i + 1 < n) {
                    var e = line[i + 1]
                    if (e == "n") { s = s + "\n" }
                    else if (e == "t") { s = s + "\t" }
                    else { s = s + e }
                    i = i + 2
                } else {
                    s = s + line[i]
                    i = i + 1
                }
            }
            if (i >= n) { throw "незакриті лапки" }
            append(out, ["str", s])
            i = i + 1
            continue
        }
        if (_cbDigit(c)) {
            var num = ""
            if (c == "0" && i + 1 < n && (line[i + 1] == "x" || line[i + 1] == "X")) {
                i = i + 2
                var hex = ""
                while (i < n && (_cbDigit(line[i]) || indexOf("abcdefABCDEF", line[i]) >= 0)) {
                    hex = hex + line[i]
                    i = i + 1
                }
                append(out, ["num", toString(parseHex(hex))])
                continue
            }
            while (i < n && (_cbDigit(line[i]) || (line[i] == "." && i + 1 < n && _cbDigit(line[i + 1])))) {
                num = num + line[i]
                i = i + 1
            }
            append(out, ["num", num])
            continue
        }
        if (_cbIdentChar(c, true)) {
            var id = ""
            while (i < n && _cbIdentChar(line[i], id == "")) {
                id = id + line[i]
                i = i + 1
            }
            append(out, ["id", id])
            continue
        }
        if (i + 1 < n) {
            var two = c + line[i + 1]
            if (two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == "..") {
                append(out, ["op", two])
                i = i + 2
                continue
            }
        }
        if (indexOf("+-*/%<>!(),[]{}=.", c) >= 0) {
            append(out, ["op", c])
            i = i + 1
            continue
        }
        throw "незрозумілий символ «" + c + "»"
    }
    return out
}

func parseHex(h) {
    var v = 0
    for c in toLower(h) {
        var d = indexOf("0123456789abcdef", c)
        v = v * 16 + d
    }
    return v
}

// ---------- розбір виразів ----------

var _ct = []      // токени
var _cp = 0       // позиція

func _peek() {
    if (_cp < len(_ct)) { return _ct[_cp] }
    return ["end", ""]
}

func _isOp(t) {
    var p = _peek()
    return p[0] == "op" && p[1] == t
}

func _expect(t) {
    if (!_isOp(t)) { throw "очікувалось «" + t + "»" }
    _cp = _cp + 1
}

var _binLevels = [["||"], ["&&"], ["==", "!="], ["<", ">", "<=", ">="], ["+", "-"], ["*", "/", "%"]]

func _parseLevel(lv) {
    if (lv >= len(_binLevels)) { return _parseUnary() }
    var left = _parseLevel(lv + 1)
    while (true) {
        var p = _peek()
        if (p[0] == "op" && indexOf(_binLevels[lv], p[1]) >= 0) {
            _cp = _cp + 1
            var right = _parseLevel(lv + 1)
            left = ["bin", p[1], left, right]
        } else { break }
    }
    return left
}

func _parseUnary() {
    if (_isOp("!") || _isOp("-")) {
        var op = _peek()[1]
        _cp = _cp + 1
        var e = _parseUnary()
        if (op == "-" && e[0] == "num") { return ["num", "-" + e[1]] }
        return ["un", op, e]
    }
    return _parsePrimary()
}

func _parseArgs(close) {
    var args = []
    if (_isOp(close)) {
        _cp = _cp + 1
        return args
    }
    while (true) {
        append(args, _parseLevel(0))
        if (_isOp(",")) { _cp = _cp + 1 }
        else {
            _expect(close)
            return args
        }
    }
}

func _parsePrimary() {
    var t = _peek()
    _cp = _cp + 1
    if (t[0] == "num" || t[0] == "str") { return t }
    if (t[0] == "op" && t[1] == "(") {
        var e = _parseLevel(0)
        _expect(")")
        return e
    }
    if (t[0] == "op" && t[1] == "[") { return ["list", _parseArgs("]")] }
    if (t[0] == "id") {
        if (_isOp("(")) {
            _cp = _cp + 1
            return ["call", t[1], _parseArgs(")")]
        }
        if (_isOp("[") || _isOp(".")) { throw "доступ до елемента чи поля (x[0], x.поле) блоками не скласти" }
        return ["id", t[1]]
    }
    if (t[0] == "end") { throw "рядок обірвався посередині виразу" }
    throw "неочікуване «" + t[1] + "»"
}

// Увесь список токенів - один вираз.
func cbParseExpr(tokens) {
    _ct = tokens
    _cp = 0
    var e = _parseLevel(0)
    if (_cp < len(_ct)) { throw "зайве «" + _ct[_cp][1] + "» після виразу" }
    return e
}

// Вираз назад у текст (як його пише генератор) - для шаблонів без віконець.
func cbExprText(e) {
    if (e[0] == "num") { return e[1] }
    if (e[0] == "str") { return "\"" + e[1] + "\"" }
    if (e[0] == "id") { return e[1] }
    if (e[0] == "call") {
        var parts = []
        for a in e[2] { append(parts, cbExprText(a)) }
        return e[1] + "(" + join(parts, ", ") + ")"
    }
    if (e[0] == "bin") { return cbExprText(e[2]) + " " + e[1] + " " + cbExprText(e[3]) }
    if (e[0] == "un") { return e[1] + cbExprText(e[2]) }
    return "?"
}

// ---------- шаблони блоків ----------

// Шаблон "f($1, $S2)" -> [f, [1, 2]]; інакше null.
func _callTemplate(gen) {
    var p = indexOf(gen, "(")
    if (p <= 0 || !endsWith(gen, ")") || contains(gen, "\n")) { return null }
    var name = substring(gen, 0, p)
    for c in name { if (!_cbIdentChar(c, false)) { return null } }
    var inner = substring(gen, p + 1, len(gen) - p - 2)
    var holes = []
    if (trim(inner) == "") { return [name, holes] }
    for part in split(inner, ",") {
        var t = trim(part)
        if (startsWith(t, "$S") || startsWith(t, "$I")) { t = "$" + substring(t, 2, len(t) - 2) }
        if (len(t) != 2 || t[0] != "$" || !_cbDigit(t[1])) { return null }
        append(holes, toInt(t[1]))
    }
    return [name, holes]
}

var _cbCalls = null    // назва функції -> [[spec id, номери віконець], ...]
var _cbExact = null    // текст шаблону без віконець -> spec id

func _cbInit() {
    if (_cbCalls != null) { return }
    initSpecs()
    _cbCalls = newMap()
    _cbExact = newMap()
    for sp in SPECS {
        if (sp.gen == "" || sp.kind == "hat" || sp.kind == "c" || sp.kind == "c2") { continue }
        if (!contains(sp.gen, "$")) {
            mapSet(_cbExact, sp.gen, sp.id)
            continue
        }
        var ct = _callTemplate(sp.gen)
        if (ct == null) { continue }
        if (!mapHas(_cbCalls, ct[0])) { mapSet(_cbCalls, ct[0], []) }
        append(mapGet(_cbCalls, ct[0]), [sp.id, ct[1]])
    }
}

// ---------- стан перетворення ----------

var _cbLists = null     // назви змінних-списків (ідентифікатори)
var _cbParams = null    // параметри поточної функції
var _cbLoopVars = []    // лічильники циклів (у блоках їх нема)
var _cbFuncs = null     // свої функції: ідентифікатор -> [назва, [параметри]]

func identName(id) { return replace(id, "_", " ") }

func _cbFail(msg) { throw msg }

// ---------- вираз -> блок / значення віконця ----------

// Значення для віконця типу t: рядок або блок.
func cbArg(e, t) {
    if (e[0] == "call" && (e[1] == "toString" || e[1] == "toInt" || e[1] == "toDouble") && len(e[2]) == 1) {
        return cbArg(e[2][0], t)
    }
    if (t == "v" || t == "l") {
        if (e[0] != "id") { _cbFail("тут має бути назва змінної") }
        if (t == "l" && !mapHas(_cbLists, e[1])) { _cbFail(e[1] + " - не список") }
        return identName(e[1])
    }
    if (t == "h" || t == "k") {
        if (e[0] == "str") { return e[1] }
        _cbFail("тут має бути текст у лапках")
    }
    if (t == "c" && e[0] == "num") {
        var ci = indexOf(COLOR_VALUES, toInt(toDouble(e[1])))
        if (ci >= 0) { return COLOR_NAMES[ci] }
        return e[1]
    }
    if (t == "b") {
        if (e[0] == "id" && e[1] == "false") { return "" }
        var bb = cbBlock(e)
        if (specOf(bb.spec).kind != "bool") { _cbFail("тут має бути умова (так/ні)") }
        return bb
    }
    if (e[0] == "num") { return e[1] }
    if (e[0] == "str") { return e[1] }
    return cbBlock(e)
}

func _withArgs(id, vals) {
    var b = newBlock(id)
    var k = 0
    while (k < len(vals) && k < len(b.args)) {
        b.args[k] = vals[k]
        k = k + 1
    }
    return b
}

// Чи вираз - текст (тоді "+" - це «з'єднати»).
func _isTextExpr(e) {
    if (e[0] == "str") { return true }
    if (e[0] == "call" && e[1] == "toString") { return true }
    if (e[0] == "bin" && e[1] == "+") { return _isTextExpr(e[2]) || _isTextExpr(e[3]) }
    return false
}

var _binSpecs = ["-", "sub", "*", "mul", "/", "div", "%", "mod", "==", "eq", "<", "lt", ">", "gt", "&&", "and", "||", "or"]

// Блок-значення (rep/bool) з виразу.
func cbBlock(e) {
    _cbInit()
    var k0 = e[0]
    if (k0 == "id") {
        var name = e[1]
        if (indexOf(_cbLoopVars, name) >= 0) { _cbFail("лічильник циклу «" + name + "» блоками не скласти (у блоці «повторити» його нема)") }
        if (name == "true" || name == "false" || name == "null") { _cbFail("«" + name + "» блоками не скласти") }
        if (mapHas(_cbExact, name)) { return newBlock(mapGet(_cbExact, name)) }
        if (_cbParams != null && mapHas(_cbParams, name)) { return _withArgs("param", [identName(name)]) }
        if (mapHas(_cbLists, name)) { return _withArgs("list", [identName(name)]) }
        return _withArgs("var", [identName(name)])
    }
    if (k0 == "num" || k0 == "str") {
        // число чи текст там, де потрібен блок: «з'єднати» з порожнім
        return _withArgs("join", [e[1], ""])
    }
    if (k0 == "un") {
        if (e[1] == "!") { return _withArgs("not", [cbArg(e[2], "b")]) }
        return _withArgs("sub", ["0", cbArg(e[2], "n")])
    }
    if (k0 == "bin") {
        var op = e[1]
        if (op == "+") {
            if (_isTextExpr(e)) { return _withArgs("join", [cbArg(e[2], "s"), cbArg(e[3], "s")]) }
            return _withArgs("add", [cbArg(e[2], "n"), cbArg(e[3], "n")])
        }
        if (op == "!=") { return _withArgs("not", [_withArgs("eq", [cbArg(e[2], "s"), cbArg(e[3], "s")])]) }
        if (op == "<=") { return _withArgs("not", [_withArgs("gt", [cbArg(e[2], "n"), cbArg(e[3], "n")])]) }
        if (op == ">=") { return _withArgs("not", [_withArgs("lt", [cbArg(e[2], "n"), cbArg(e[3], "n")])]) }
        var bi = indexOf(_binSpecs, op)
        if (bi >= 0) {
            var id = _binSpecs[bi + 1]
            var types = slotTypes(specOf(id))
            return _withArgs(id, [cbArg(e[2], types[0]), cbArg(e[3], types[1])])
        }
        _cbFail("оператор «" + op + "» блоками не скласти")
    }
    if (k0 == "call") {
        var b = cbCall(e, false)
        if (b == null) { _cbFail("«" + e[1] + "(...)» блоками не скласти") }
        return b
    }
    if (k0 == "list") { _cbFail("список [ ... ] прямо у виразі блоками не скласти") }
    _cbFail("цей вираз блоками не скласти")
}

// Виклик функції -> блок за шаблоном. statement: команда (cmd) чи значення.
// null - нема такого блока.
func cbCall(e, statement) {
    _cbInit()
    var exact = cbExprText(e)
    if (mapHas(_cbExact, exact)) {
        var sid = mapGet(_cbExact, exact)
        var isCmd = specOf(sid).kind == "cmd"
        if (isCmd == statement) { return newBlock(sid) }
    }
    if (_cbFuncs != null && mapHas(_cbFuncs, e[1])) {
        if (!statement) { _cbFail("свій блок «" + identName(e[1]) + "» - команда, а не значення") }
        var f = mapGet(_cbFuncs, e[1])
        var cid = customId("call", f[0], f[1])
        if (len(e[2]) != len(f[1])) { _cbFail("«" + f[0] + "» чекає " + toString(len(f[1])) + " значень") }
        var vals = []
        for a in e[2] { append(vals, cbArg(a, "s")) }
        return _withArgs(cid, vals)
    }
    if (!mapHas(_cbCalls, e[1])) { return null }
    var lastErr = ""
    for cand in mapGet(_cbCalls, e[1]) {
        var sp = specOf(cand[0])
        var isCmd2 = sp.kind == "cmd"
        if (isCmd2 != statement || len(cand[1]) != len(e[2])) { continue }
        var types = slotTypes(sp)
        try {
            var b = newBlock(sp.id)
            var k = 0
            while (k < len(cand[1])) {
                var slot = cand[1][k] - 1
                b.args[slot] = cbArg(e[2][k], types[slot])
                k = k + 1
            }
            return b
        } catch (err) { lastErr = toString(err) }
    }
    if (lastErr != "") { _cbFail(lastErr) }
    return null
}

// ---------- оператори (рядки) ----------

// Розбір рядка-оператора у вже зібраний ланцюжок.
struct CbFrame {
    block: any      // c/c2-блок, у тіло якого додаємо (null - верхній рівень)
    first: any
    last: any
    inElse: bool
    loopVar: string
}

var _cbStack = []

func _cbAdd(b) {
    var fr = _cbStack[len(_cbStack) - 1]
    if (fr.first == null) { fr.first = b }
    else { fr.last.next = b }
    fr.last = b
}

func _cbPush(block, loopVar) {
    _cbAdd(block)
    append(_cbStack, CbFrame { block: block, first: null, last: null, inElse: false, loopVar: loopVar })
    if (loopVar != "") { append(_cbLoopVars, loopVar) }
}

// Закрити тіло: перший блок тіла - у body/body2.
func _cbCloseBody() {
    var fr = _cbStack[len(_cbStack) - 1]
    if (fr.inElse) { fr.block.body2 = fr.first }
    else { fr.block.body = fr.first }
}

// Знайти токени між "(" після ключового слова і ") {" в кінці.
func _cbCond(tokens, from) {
    if (len(tokens) < from + 3 || tokens[from][1] != "(" || tokens[len(tokens) - 1][1] != "{" || tokens[len(tokens) - 2][1] != ")") {
        _cbFail("очікувалось «(умова) {»")
    }
    return cbParseExpr(slice(tokens, from + 1, len(tokens) - 2))
}

func _isReadLine(e) {
    if (e[0] == "call" && e[1] == "readLine" && len(e[2]) == 0) { return true }
    if (e[0] == "call" && (e[1] == "_відповідь" || e[1] == "toInt" || e[1] == "toDouble" || e[1] == "trim") && len(e[2]) == 1) {
        return _isReadLine(e[2][0])
    }
    return false
}

func _cbAssign(name, e) {
    var vn = identName(name)
    if (indexOf(_cbLoopVars, name) >= 0) { _cbFail("лічильник циклу змінювати блоками не можна") }
    if (_isReadLine(e)) {
        // «запитати»: попередній «сказати в той самий рядок» - питання
        var q = ""
        var fr = _cbStack[len(_cbStack) - 1]
        if (fr.last != null && fr.last.spec == "saynl") {
            var qa = fr.last.args[0]
            if (typeOf(qa) == "struct" && qa.spec == "join" && typeOf(qa.args[1]) == "string" && trim(qa.args[1]) == "") { qa = qa.args[0] }
            if (typeOf(qa) == "string") { q = trim(qa) }
            else { q = qa }
            // прибрати "сказати в той самий рядок" - питання тепер у «запитати»
            if (fr.first == fr.last) {
                fr.first = null
                fr.last = null
            } else {
                var p = fr.first
                while (p.next != fr.last) { p = p.next }
                p.next = null
                fr.last = p
            }
        }
        _cbAdd(_withArgs("ask", [q, vn]))
        return
    }
    if (e[0] == "list" && len(e[1]) == 0) {
        mapSet(_cbLists, name, true)
        _cbAdd(_withArgs("listclear", [vn]))
        return
    }
    // x = x + 1 / x = x - 1 -> «збільшити»
    if (e[0] == "bin" && (e[1] == "+" || e[1] == "-") && e[2][0] == "id" && e[2][1] == name && !_isTextExpr(e)) {
        var by = cbArg(e[3], "n")
        if (e[1] == "-") {
            if (typeOf(by) == "string") {
                if (startsWith(by, "-")) { by = substring(by, 1, len(by) - 1) } else { by = "-" + by }
            } else { by = _withArgs("sub", ["0", by]) }
        }
        _cbAdd(_withArgs("change", [vn, by]))
        return
    }
    _cbAdd(_withArgs("set", [vn, cbArg(e, "s")]))
}

func cbStatement(tokens) {
    if (len(tokens) == 0) { return }
    var t0 = tokens[0]
    var last = tokens[len(tokens) - 1]
    // } / } else {
    if (t0[0] == "op" && t0[1] == "}") {
        if (len(_cbStack) < 2) { _cbFail("зайва «}»") }
        _cbCloseBody()
        var fr = _cbStack[len(_cbStack) - 1]
        if (len(tokens) == 1) {
            if (fr.loopVar != "") { removeAt(_cbLoopVars, len(_cbLoopVars) - 1) }
            removeAt(_cbStack, len(_cbStack) - 1)
            return
        }
        if (len(tokens) == 3 && tokens[1][1] == "else" && tokens[2][1] == "{") {
            if (fr.inElse || fr.block.spec != "if") { _cbFail("«else» не на своєму місці") }
            // «якщо» -> «якщо ... інакше»
            fr.block.spec = "ifelse"
            fr.inElse = true
            fr.first = null
            fr.last = null
            return
        }
        if (len(tokens) >= 4 && tokens[1][1] == "else" && tokens[2][1] == "if") { _cbFail("«else if» - постав «якщо» всередину «інакше»") }
        _cbFail("після «}» нічого не має бути")
    }
    if (t0[0] == "id" && t0[1] == "if") {
        _cbPush(_withArgs("if", [cbArg(_cbCond(tokens, 1), "b")]), "")
        return
    }
    if (t0[0] == "id" && t0[1] == "while") {
        var c = _cbCond(tokens, 1)
        if (c[0] == "id" && c[1] == "true") { _cbPush(newBlock("forever"), "") }
        else { _cbPush(_withArgs("while", [cbArg(c, "b")]), "") }
        return
    }
    if (t0[0] == "id" && t0[1] == "for") {
        // for i in A..B {
        if (len(tokens) < 6 || tokens[1][0] != "id" || tokens[2][1] != "in" || last[1] != "{") { _cbFail("цикл for: очікувалось «for i in 0..10 {»") }
        var rest = slice(tokens, 3, len(tokens) - 1)
        var dots = -1
        var k = 0
        while (k < len(rest)) {
            if (rest[k][1] == ".." && rest[k][0] == "op") { dots = k }
            k = k + 1
        }
        if (dots < 0) { _cbFail("«for ... in» по списку блоками не скласти - лише «for i in 0..10»") }
        var from = cbParseExpr(slice(rest, 0, dots))
        var to = cbParseExpr(slice(rest, dots + 1))
        var count = null
        if (from[0] == "num" && toDouble(from[1]) == 0) { count = cbArg(to, "n") }
        else if (from[0] == "num" && to[0] == "num") { count = toString(toInt(toDouble(to[1]) - toDouble(from[1]))) }
        else { count = _withArgs("sub", [cbArg(to, "n"), cbArg(from, "n")]) }
        _cbPush(_withArgs("repeat", [count]), tokens[1][1])
        return
    }
    if (t0[0] == "id" && (t0[1] == "return" || t0[1] == "break" || t0[1] == "continue" || t0[1] == "try" || t0[1] == "throw")) {
        _cbFail("«" + t0[1] + "» блоками не скласти")
    }
    // var x = вираз / x = вираз
    var at = 0
    if (t0[0] == "id" && t0[1] == "var") { at = 1 }
    if (len(tokens) > at + 2 && tokens[at][0] == "id" && tokens[at + 1][0] == "op" && tokens[at + 1][1] == "=") {
        _cbAssign(tokens[at][1], cbParseExpr(slice(tokens, at + 2)))
        return
    }
    if (at == 1) { _cbFail("очікувалось «var назва = значення»") }
    // команда-виклик
    var e = cbParseExpr(tokens)
    if (e[0] != "call") { _cbFail("це не команда") }
    // sleep(toInt(с * 1000)) / sleep(мс) -> «чекати»
    if (e[1] == "sleep" && len(e[2]) == 1) {
        var a = e[2][0]
        if (a[0] == "call" && a[1] == "toInt" && len(a[2]) == 1) { a = a[2][0] }
        if (a[0] == "bin" && a[1] == "*" && a[3][0] == "num" && a[3][1] == "1000") {
            _cbAdd(_withArgs("wait", [cbArg(a[2], "n")]))
            return
        }
        if (a[0] == "num") {
            _cbAdd(_withArgs("wait", [toString(toDouble(a[1]) / 1000)]))
            return
        }
        _cbAdd(_withArgs("wait", [_withArgs("div", [cbArg(a, "n"), "1000"])]))
        return
    }
    var b = cbCall(e, true)
    if (b == null) { _cbFail("«" + e[1] + "(...)» блоками не скласти") }
    _cbAdd(b)
}

// ---------- програма ----------

// Скільки "{" мінус "}" у рядку (поза лапками).
func _braceDelta(line) {
    var d = 0
    var inStr = false
    var i = 0
    while (i < len(line)) {
        var c = line[i]
        if (inStr) {
            if (c == "\\") { i = i + 1 }
            else if (c == "\"") { inStr = false }
        } else {
            if (c == "\"") { inStr = true }
            else if (c == "/" && i + 1 < len(line) && line[i + 1] == "/") { break }
            else if (c == "{") { d = d + 1 }
            else if (c == "}") { d = d - 1 }
        }
        i = i + 1
    }
    return d
}

// Службові рядки, які генератор блоків сам додає в main.
func _cbServiceLine(t) {
    return t == "_кадр()" || startsWith(t, "while (_s != null && surfaceIsOpen(_s))")
}

// Тіло функції (рядки між "{" і "}") -> перший блок ланцюжка.
func _cbBody(lines, startNo, skipDecl) {
    _cbStack = [CbFrame { block: null, first: null, last: null, inElse: false, loopVar: "" }]
    _cbLoopVars = []
    var decl = skipDecl
    var k = 0
    while (k < len(lines)) {
        var t = trim(lines[k])
        if (t == "" || startsWith(t, "//") || _cbServiceLine(t)) {
            k = k + 1
            continue
        }
        try {
            var toks = cbTokens(t)
            // оголошення "var x = 0" / "var x = []" на початку main -
            // це змінні блоків, а не блоки
            if (decl && len(toks) == 4 && toks[0][1] == "var" && toks[2][1] == "=" && toks[3][0] == "num" && toks[3][1] == "0") {
                k = k + 1
                continue
            }
            if (decl && len(toks) == 5 && toks[0][1] == "var" && toks[2][1] == "=" && toks[3][1] == "[" && toks[4][1] == "]") {
                mapSet(_cbLists, toks[1][1], true)
                k = k + 1
                continue
            }
            decl = false
            cbStatement(toks)
        } catch (err) {
            throw "Рядок " + toString(startNo + k) + ": " + toString(err)
        }
        k = k + 1
    }
    if (len(_cbStack) != 1) { throw "Рядок " + toString(startNo + len(lines)) + ": не вистачає «}»" }
    return _cbStack[0].first
}

// Код -> [стеки блоків, помилка]. Помилка "" - вийшло.
func codeToBlocks(text) {
    _cbInit()
    _cbLists = newMap()
    _cbFuncs = newMap()
    _cbParams = null
    var lines = split(replace(text, "\r", ""), "\n")
    // функції верхнього рівня: [назва, параметри, перший рядок тіла, рядки]
    var funcs = []
    var k = 0
    try {
        while (k < len(lines)) {
            var t = trim(lines[k])
            if (t == "" || startsWith(t, "//")) {
                k = k + 1
                continue
            }
            // однорядкова функція "func _f(x) { ... }" - лише службова
            if (startsWith(t, "func _") && _braceDelta(t) == 0) {
                k = k + 1
                continue
            }
            if (startsWith(t, "func ") && endsWith(t, "{")) {
                var toks = cbTokens(t)
                if (len(toks) < 5 || toks[1][0] != "id" || toks[2][1] != "(") { throw "Рядок " + toString(k + 1) + ": незрозуміла функція" }
                var params = []
                var j = 3
                while (j < len(toks) && toks[j][1] != ")") {
                    if (toks[j][0] == "id") { append(params, toks[j][1]) }
                    j = j + 1
                }
                var depth = _braceDelta(t)
                var body = []
                var start = k + 2
                k = k + 1
                while (k < len(lines) && depth > 0) {
                    var d = _braceDelta(lines[k])
                    if (depth + d <= 0) { break }
                    depth = depth + d
                    append(body, lines[k])
                    k = k + 1
                }
                if (k >= len(lines)) { throw "Рядок " + toString(start - 1) + ": функцію не закрито «}»" }
                // службові функції блоків (_сцена, _іти, ...) - пропускаємо
                if (!startsWith(toks[1][1], "_")) { append(funcs, [toks[1][1], params, start, body]) }
                k = k + 1
                continue
            }
            if (startsWith(t, "var ")) {
                var vt = cbTokens(t)
                var vname = vt[1][1]
                if (!startsWith(vname, "_")) {
                    if (len(vt) == 5 && vt[3][1] == "[" && vt[4][1] == "]") { mapSet(_cbLists, vname, true) }
                    else if (!(len(vt) == 4 && vt[3][0] == "num")) { throw "Рядок " + toString(k + 1) + ": змінну поза main блоками не скласти (лише «var x = 0» чи «var x = []»)" }
                }
                k = k + 1
                continue
            }
            var first = split(t, " ")[0]
            throw "Рядок " + toString(k + 1) + ": «" + first + "» блоками не скласти"
        }
    } catch (err) { return [[], toString(err)] }

    var mainF = null
    for f in funcs {
        if (f[0] == "main") { mainF = f }
        else {
            var pnames = []
            for p in f[1] { append(pnames, identName(p)) }
            mapSet(_cbFuncs, f[0], [identName(f[0]), pnames])
        }
    }
    if (mainF == null) { return [[], "Нема func main() - з чого почати програму?"] }

    var stacks = []
    try {
        var start = newBlock("start")
        start.x = 40
        start.y = 40
        start.next = _cbBody(mainF[3], mainF[2], true)
        append(stacks, start)
        var fy = 40
        for f in funcs {
            if (f[0] == "main") { continue }
            var info = mapGet(_cbFuncs, f[0])
            _cbParams = newMap()
            for p in f[1] { mapSet(_cbParams, p, true) }
            var def = newBlock(customId("def", info[0], info[1]))
            def.x = 560
            def.y = fy
            def.next = _cbBody(f[3], f[2], false)
            _cbParams = null
            append(stacks, def)
            fy = fy + 60 + 44 * _chainLen(def)
        }
    } catch (err2) {
        _cbParams = null
        return [[], toString(err2)]
    }
    return [stacks, ""]
}

func _chainLen(b) {
    var n = 0
    while (b != null) {
        n = n + 1
        if (b.body != null) { n = n + _chainLen(b.body) }
        if (b.body2 != null) { n = n + _chainLen(b.body2) }
        b = b.next
    }
    return n
}
