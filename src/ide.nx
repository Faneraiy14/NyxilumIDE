// Nyx IDE - середовище програмування для NyxilumLang, написане на NyxilumLang.
//
//   nx ide.nx [тека-з-програмами]
//
// Без аргументу програми лежать у ~/NyxПрограми (створюється з прикладом).

import "theme.nx"
import "ui.nx"
import "editor.nx"
import "console.nx"
import "blocks_model.nx"
import "blocks_view.nx"
import "guide.nx"
import "history.nx"
import "tour.nx"
import "explain.nx"

var TOP_H = 48
var LEFT_W = 230          // панель "Мої програми" (36, коли згорнута)
var FILES_W = 230
var FILES_COLLAPSED_W = 36
var STATUS_H = 26

struct App {
    mode: string
    dir: string
    files: array
    editors: map
    current: string
    blocks: map
    currentB: string
    genMap: array
    guideOpen: bool
    guideTab: string
    guideLesson: i32
    done: array
    demo: any
    cursorX: i32
    cursorY: i32
    filesCollapsed: bool
    hintRun: i32
    tour: i32
    tourFirstRun: bool
    histOpen: bool
    histSel: i32
    histScroll: i32
    histList: array
    histCounts: array
    histDiff: array
    histDiffKey: string
    con: any
    focus: string
    drag: string
    consoleH: i32
    lastClickTime: i32
    lastClickX: i32
    lastClickY: i32
    clickCount: i32
    dialog: any
    status: string
    statusTime: i32
}

var app = null

// ---------- файли ----------

func homeDir() {
    var h = osEnv("HOME")
    if (h == null || h == "") { h = osEnv("USERPROFILE") }
    if (h == null || h == "") { h = osCwd() }
    return h
}

func joinPath(dir, name) {
    if (endsWith(dir, "/") || endsWith(dir, "\\")) { return dir + name }
    return dir + "/" + name
}

func fileName(path) {
    var parts = split(replace(path, "\\", "/"), "/")
    return parts[len(parts) - 1]
}

func ext() {
    if (app.mode == "blocks") { return ".nxb" }
    return ".nx"
}

// Тека IDE (там, де лежить src/): приклади, гайд.
func ideHome() { return joinPath(scriptDir(), "..") }

func refreshFiles() {
    var names = []
    for n in listDir(app.dir) {
        if (endsWith(n, ext()) && fileExists(joinPath(app.dir, n))) { append(names, n) }
    }
    app.files = sort(names)
}

func currentEditor() {
    if (app.current == "") { return null }
    return mapGet(app.editors, app.current)
}

func currentBlocks() {
    if (app.currentB == "") { return null }
    return mapGet(app.blocks, app.currentB)
}

func openBlocks(path) {
    app.histSel = -1
    if (!mapHas(app.blocks, path)) {
        var text = ""
        if (fileExists(path)) { text = readFile(path) }
        mapSet(app.blocks, path, newBlocksWs(path, text))
    }
    app.currentB = path
    surfaceTitle(S, "Nyx IDE — " + fileName(path))
}

// Перейти в режим (вкладка Блоки/Код): свій список файлів, свій відкритий файл.
func setMode(mode) {
    saveAll()
    app.mode = mode
    refreshFiles()
    if (mode == "blocks") {
        if (app.currentB == "") {
            if (len(app.files) == 0) {
                writeFile(joinPath(app.dir, "мої блоки.nxb"), starterBlocksJson())
                refreshFiles()
            }
            openBlocks(joinPath(app.dir, app.files[0]))
        } else { surfaceTitle(S, "Nyx IDE — " + fileName(app.currentB)) }
    } else if (app.current != "") {
        surfaceTitle(S, "Nyx IDE — " + fileName(app.current))
    }
}

func openFile(path) {
    app.histSel = -1
    if (!mapHas(app.editors, path)) {
        var text = ""
        if (fileExists(path)) { text = readFile(path) }
        mapSet(app.editors, path, newEditor(text, path))
    }
    app.current = path
    app.focus = "editor"
    surfaceTitle(S, "Nyx IDE — " + fileName(path))
}

func saveEditor(ed) {
    if (ed == null || !ed.dirty) { return }
    writeFile(ed.path, edText(ed))
    ed.dirty = false
}

func saveAll() {
    for p in mapKeys(app.editors) { saveEditor(mapGet(app.editors, p)) }
    for p in mapKeys(app.blocks) {
        var ws = mapGet(app.blocks, p)
        if (ws.dirty) {
            writeFile(ws.path, stacksToJson(ws.stacks))
            ws.dirty = false
        }
    }
}

func setStatus(text) {
    app.status = text
    app.statusTime = timeMs()
}

func newFile(name) {
    name = trim(name)
    if (name == "") { return }
    if (!endsWith(name, ext())) { name = name + ext() }
    var path = joinPath(app.dir, name)
    if (fileExists(path)) {
        setStatus("Файл " + name + " вже є - відкрито його")
    } else if (app.mode == "blocks") {
        writeFile(path, starterBlocksJson())
    } else {
        writeFile(path, "func main() {\n    print(\"Привіт!\")\n}\n")
    }
    refreshFiles()
    if (app.mode == "blocks") { openBlocks(path) } else { openFile(path) }
}

func freeName() {
    var i = 1
    while (fileExists(joinPath(app.dir, "програма" + toString(i) + ext()))) { i = i + 1 }
    return "програма" + toString(i)
}

// ---------- запуск ----------

func blocksTitle(ws) {
    var n = fileName(ws.path)
    return substring(n, 0, len(n) - 4)
}

func runCurrent() {
    saveAll()
    if (app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws == null) { return }
        ws.errBlock = null
        var g = generateCode(ws.stacks, blocksTitle(ws))
        app.genMap = g[1]
        var genDir = joinPath(app.dir, ".nyx")
        if (!dirExists(genDir)) { makeDir(genDir) }
        var genPath = joinPath(genDir, blocksTitle(ws) + ".nx")
        writeFile(genPath, g[0])
        conRun(app.con, genPath, app.dir)
        app.focus = "console"
        return
    }
    var ed = currentEditor()
    if (ed == null) { return }
    ed.errLine = -1
    conRun(app.con, ed.path, app.dir)
    app.focus = "console"
}

// "Відкрити як код": код з блоків стає звичайною програмою .nx.
func blocksToCode() {
    var ws = currentBlocks()
    if (ws == null) { return }
    var g = generateCode(ws.stacks, blocksTitle(ws))
    var base = blocksTitle(ws) + " (код)"
    var name = base + ".nx"
    var i = 2
    while (fileExists(joinPath(app.dir, name))) {
        name = base + " " + toString(i) + ".nx"
        i = i + 1
    }
    writeFile(joinPath(app.dir, name), g[0])
    setMode("code")
    openFile(joinPath(app.dir, name))
    setStatus("Код з блоків відкрито як " + name)
}

// Після невдалого запуску - підказка простими словами (один раз на запуск).
func addErrorHints() {
    var con = app.con
    if (con.running || con.lastOk || con.runs == app.hintRun || con.runs == 0) { return }
    app.hintRun = con.runs
    var errText = ""
    for l in con.lines {
        if (l[1] == "err" || l[1] == "out") { errText = errText + l[0] + "\n" }
    }
    var code = ""
    if (app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws != null) { code = generateCode(ws.stacks, "")[0] }
    } else {
        var ed = currentEditor()
        if (ed != null) { code = edText(ed) }
    }
    var hints = explainError(errText, code)
    var first = true
    var maxW = max(300, con.w - 40)
    for h in hints {
        var prefix = "          "
        if (first) { prefix = "Підказка: " }
        // перенос по ширині консолі (вона сама рядки не переносить)
        for l in wrapLines(h, maxW - textWidth(prefix, 16), 16) {
            conAdd(con, prefix + l, "hint")
            prefix = "          "
        }
        first = false
    }
}

// Після завершення з помилкою - підсвітити рядок у редакторі й перейти до нього.
func afterPoll() {
    var con = app.con
    addErrorHints()
    if (!con.running && con.errLine >= 0 && app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws != null && con.errLine < len(app.genMap)) {
            ws.errBlock = app.genMap[con.errLine]
            if (ws.errBlock != null) { setStatus("Помилка в блоці, що обведений червоним") }
        }
        con.errLine = -1
        return
    }
    if (!con.running && con.errLine >= 0) {
        var ed = currentEditor()
        if (ed != null) {
            ed.errLine = con.errLine
            if (ed.errLine < len(ed.lines)) { edGoToLine(ed, ed.errLine) }
            app.focus = "editor"
        }
        con.errLine = -1
    }
}

// ---------- діалог (назва нової програми) ----------

struct Dialog {
    title: string
    text: string
    action: string
    okLabel: string
    suffix: string
}

func openDialog(title, text, action) {
    var okLabel = "Створити"
    var suffix = ext()
    if (action == "version") {
        okLabel = "Зберегти"
        suffix = ""
    }
    app.dialog = Dialog { title: title, text: text, action: action, okLabel: okLabel, suffix: suffix }
    app.focus = "dialog"
}

func closeDialog(ok) {
    var d = app.dialog
    app.dialog = null
    app.focus = "editor"
    if (ok && d.action == "new") { newFile(d.text) }
    if (ok && d.action == "version") { saveVersion(d.text) }
}

func drawDialog() {
    var d = app.dialog
    var W = surfaceWidth(S)
    var H = surfaceHeight(S)
    surfaceRect(S, 0, 0, W, H, 0x99000000)
    var w = 460
    var h = 170
    var x = toInt((W - w) / 2)
    var y = toInt((H - h) / 2)
    surfaceRoundRect(S, x, y, w, h, 10, C_PANEL)
    surfaceText(S, d.title, x + 20, y + 18, 20, C_TEXT, true)
    surfaceRoundRect(S, x + 20, y + 58, w - 40, 36, 6, C_ACCENT)
    surfaceRoundRect(S, x + 21, y + 59, w - 42, 34, 6, C_BG)
    var tw = surfaceText(S, d.text, x + 32, y + 68, 16, C_TEXT)
    surfaceRect(S, x + 33 + tw, y + 66, 2, 20, C_ACCENT)
    surfaceText(S, d.suffix, x + w - 30 - textWidth(d.suffix, 16), y + 68, 16, C_DIM)
    uiButton("dialog.cancel", "Скасувати", x + w - 250, y + h - 52, 110, 34, "normal")
    uiButton("dialog.ok", d.okLabel, x + w - 130, y + h - 52, 110, 34, "primary")
}

func dialogKey(e) {
    var d = app.dialog
    if (e.key == "Enter") {
        closeDialog(true)
        return
    }
    if (e.key == "Escape") {
        closeDialog(false)
        return
    }
    if (e.key == "Backspace" && len(d.text) > 0) { d.text = substring(d.text, 0, len(d.text) - 1) }
}

// ---------- малювання ----------

func drawTopBar(W) {
    surfaceRect(S, 0, 0, W, TOP_H, C_PANEL2)
    surfaceText(S, "Nyx", 16, 12, 24, C_ACCENT, true)
    surfaceText(S, "IDE", 16 + textWidth("Nyx ", 24, true), 12, 24, C_TEXT)

    // вкладки не наїжджають на назву "Nyx IDE", коли панель програм згорнута
    var tx = max(LEFT_W, 160)
    var blocksKind = "tab"
    var codeKind = "tab"
    if (app.mode == "blocks") { blocksKind = "tabOn" } else { codeKind = "tabOn" }
    uiButton("mode.blocks", "Блоки", tx, 0, 110, TOP_H, blocksKind)
    uiButton("mode.code", "Код", tx + 110, 0, 110, TOP_H, codeKind)

    var x = W - 16
    var helpW = uiButtonW("Навчання")
    x = x - helpW
    var helpKind = "normal"
    if (app.guideOpen) { helpKind = "primary" }
    uiButton("help", "Навчання", x, 8, helpW, 32, helpKind)
    var histW = uiButtonW("Історія")
    x = x - histW - 8
    var histKind = "normal"
    if (app.histOpen) { histKind = "primary" }
    uiButton("history", "Історія", x, 8, histW, 32, histKind)
    var saveW = uiButtonW("Зберегти")
    x = x - saveW - 8
    uiButton("save", "Зберегти", x, 8, saveW, 32, "normal")
    if (app.con.running) {
        var stopW = uiButtonW("■ Зупинити")
        x = x - stopW - 8
        uiButton("stop", "■ Зупинити", x, 8, stopW, 32, "danger")
    } else {
        var runW = uiButtonW("▶ Запустити")
        x = x - runW - 8
        uiButton("run", "▶ Запустити", x, 8, runW, 32, "primary")
    }
}

func drawFiles(H) {
    var y0 = TOP_H
    var h = H - TOP_H - STATUS_H
    surfaceRect(S, 0, y0, LEFT_W, h, C_PANEL)
    uiRegion("files.panel", 0, y0, LEFT_W, h)
    if (app.filesCollapsed) {
        // згорнута: лише стрілка "розгорнути" і "+"
        uiButton("files.toggle", "›", 4, y0 + 8, 28, 28, "flat")
        uiButton("newfile", "+", 4, y0 + h - 40, 28, 30, "normal")
        return
    }
    surfaceText(S, "Мої програми", 16, y0 + 14, 16, C_SUBTEXT, true)
    uiButton("files.toggle", "‹", LEFT_W - 36, y0 + 8, 28, 28, "flat")
    var y = y0 + 44
    for name in app.files {
        var path = joinPath(app.dir, name)
        var on = path == app.current || path == app.currentB
        var hover = uiHover(0, y, LEFT_W, 30)
        if (on) { surfaceRect(S, 0, y, LEFT_W, 30, C_SURFACE) }
        else if (hover) { surfaceRect(S, 0, y, LEFT_W, 30, C_BG) }
        if (on) { surfaceRect(S, 0, y, 3, 30, C_ACCENT) }
        var label = substring(name, 0, len(name) - len(ext()))
        var color = C_SUBTEXT
        if (on) { color = C_TEXT }
        surfaceText(S, uiFit(label, LEFT_W - 50, 16), 20, y + 7, 16, color)
        var on2 = (mapHas(app.editors, path) && mapGet(app.editors, path).dirty) || (mapHas(app.blocks, path) && mapGet(app.blocks, path).dirty)
        if (on2) {
            surfaceCircle(S, LEFT_W - 20, y + 15, 4, C_PEACH)
        }
        uiRegion("file:" + path, 0, y, LEFT_W, 30)
        y = y + 30
        if (y > y0 + h - 60) { break }
    }
    uiButton("newfile", "+ Нова програма", 12, y0 + h - 46, LEFT_W - 24, 34, "normal")
}

func drawStatus(W, H) {
    var y = H - STATUS_H
    surfaceRect(S, 0, y, W, STATUS_H, C_PANEL2)
    var ed = currentEditor()
    var left = ""
    if (app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws != null) {
            left = fileName(ws.path)
            if (ws.dirty) { left = left + "   • не збережено" } else { left = left + "   √ збережено" }
        }
    } else if (ed != null) {
        left = fileName(ed.path) + "   рядок " + toString(ed.cy + 1) + ", стовпчик " + toString(ed.cx + 1)
        if (ed.dirty) { left = left + "   • не збережено" } else { left = left + "   √ збережено" }
    }
    surfaceText(S, left, 12, y + 5, 14, C_SUBTEXT)
    var msg = "F5 - запустити   Ctrl+S - зберегти   Ctrl+Z - скасувати   Ctrl+/ - коментар   Ctrl+= / Ctrl+- - шрифт"
    if (app.mode == "blocks") { msg = "Тягни блоки мишею   Права кнопка - меню блока   F5 - запустити   Ctrl+Z - скасувати" }
    if (app.status != "" && timeMs() - app.statusTime < 4000) { msg = app.status }
    var mw = textWidth(msg, 14)
    surfaceText(S, msg, W - mw - 12, y + 5, 14, C_DIM)
}

func layoutConsoleH(H) {
    var maxH = H - TOP_H - STATUS_H - 120
    app.consoleH = clamp(app.consoleH, 90, max(90, maxH))
    return app.consoleH
}

func draw() {
    var W = surfaceWidth(S)
    var H = surfaceHeight(S)
    if (app.filesCollapsed) { LEFT_W = FILES_COLLAPSED_W } else { LEFT_W = FILES_W }
    uiBegin()
    surfaceClear(S, C_BG)
    drawTopBar(W)
    drawFiles(H)

    var cx = LEFT_W
    var cw = W - LEFT_W
    if (app.guideOpen) { cw = cw - GUIDE_W }
    if (app.histOpen) { cw = cw - HISTORY_W }
    var conH = layoutConsoleH(H)
    var edY = TOP_H
    var edH = H - TOP_H - STATUS_H - conH
    var ed = currentEditor()
    if (app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws != null) { blocksDraw(ws, cx, edY, cw, edH, blocksTitle(ws)) }
    } else if (ed != null) {
        edDraw(ed, cx, edY, cw, edH, app.focus == "editor" && app.dialog == null)
    }
    conDraw(app.con, cx, edY + edH, cw, conH)
    uiRegion("split", cx, edY + edH - 3, cw, 7)
    if (app.guideOpen) {
        checkLessons()
        drawGuide(app.guideTab, app.guideLesson, app.done, lessonCtx(), W - GUIDE_W, TOP_H, H - TOP_H - STATUS_H)
    }
    if (app.histOpen) {
        refreshHistoryDiff()
        drawHistory(curPath(), app.histList, app.histCounts, app.histSel, app.histDiff, app.histScroll, W - HISTORY_W, TOP_H, H - TOP_H - STATUS_H)
    }
    drawStatus(W, H)
    if (app.dialog != null) { drawDialog() }
    if (app.tour >= 0) { drawTour(app.tour) }
    if (app.demo != null) { drawDemoCursor() }
    surfacePresent(S)
}

// ---------- події ----------

func doAction(id) {
    if (id == "run") { runCurrent() }
    else if (id == "stop") { conStop(app.con) }
    else if (id == "save") {
        saveAll()
        setStatus("Збережено √")
    }
    else if (id == "mode.blocks") { setMode("blocks") }
    else if (id == "mode.code") { setMode("code") }
    else if (id == "btogglecode") {
        var ws = currentBlocks()
        if (ws != null) { ws.showCode = !ws.showCode }
    }
    else if (id == "bopencode") { blocksToCode() }
    else if (id == "bclear") {
        var ws = currentBlocks()
        if (ws != null) {
            blocksClear(ws)
            setStatus("Почали спочатку (Ctrl+Z - повернути блоки)")
        }
    }
    else if (id == "newfile") { openDialog("Назва нової програми", freeName(), "new") }
    else if (id == "con.clear") { conClear(app.con) }
    else if (id == "dialog.ok") { closeDialog(true) }
    else if (id == "dialog.cancel") { closeDialog(false) }
    else if (id == "help") {
        app.guideOpen = !app.guideOpen
        if (app.guideOpen) { app.histOpen = false }
    }
    else if (id == "files.toggle") { app.filesCollapsed = !app.filesCollapsed }
    else if (id == "history") {
        app.histOpen = !app.histOpen
        if (app.histOpen) {
            app.guideOpen = false
            app.histSel = -1
            loadHistory()
        }
    }
    else if (startsWith(id, "h.")) { historyAction(id) }
    else if (id == "t.next") { tourGo(app.tour + 1) }
    else if (id == "t.prev") { tourGo(app.tour - 1) }
    else if (id == "t.skip") { endTour() }

    else if (startsWith(id, "g.")) { guideAction(id) }
    else if (startsWith(id, "file:")) {
        saveAll()
        var path = substring(id, 5, len(id) - 5)
        if (app.mode == "blocks") { openBlocks(path) } else { openFile(path) }
    }
}

func onMouseDown(e) {
    uiMouseX = e.x
    uiMouseY = e.y
    var id = uiHit(e.x, e.y)
    if (app.tour >= 0 && !_synthetic) {
        // під час екскурсії працюють лише її кнопки
        if (startsWith(id, "t.")) { uiPressedId = id }
        return
    }
    if (app.dialog != null && !startsWith(id, "dialog.")) { return }

    // подвійний/потрійний клік: те саме місце (±4 px) протягом 400 мс
    if (timeMs() - app.lastClickTime < 400 && abs(e.x - app.lastClickX) < 5 && abs(e.y - app.lastClickY) < 5) {
        app.clickCount = app.clickCount + 1
    } else { app.clickCount = 1 }
    app.lastClickTime = timeMs()
    app.lastClickX = e.x
    app.lastClickY = e.y

    var bws = currentBlocks()
    if (app.mode == "blocks" && bws != null && (startsWith(id, "b") || len(bws.menu) > 0)) {
        if (blocksMouseDown(bws, e, id)) {
            app.focus = "blocks"
            app.con.focused = false
            return
        }
    }

    if (e.button != 1) { return }
    var ed = currentEditor()
    if (id == "editor" && ed != null) {
        app.focus = "editor"
        ed.acOpen = false
        app.con.focused = false
        var pos = edPosAt(ed, e.x, e.y)
        var shift = e.shift == true
        if (shift) {
            if (ed.ay < 0) {
                ed.ay = ed.cy
                ed.ax = ed.cx
            }
        } else { ed.ay = -1 }
        ed.cy = pos[0]
        ed.cx = pos[1]
        ed.wantCol = ed.cx
        if (app.clickCount == 2) { edSelectWord(ed) }
        else if (app.clickCount >= 3) {
            ed.ay = ed.cy
            ed.ax = 0
            ed.cx = len(ed.lines[ed.cy])
        } else {
            if (!shift) {
                ed.ay = ed.cy
                ed.ax = ed.cx
            }
            app.drag = "editor"
        }
        return
    }
    if (id == "split") {
        app.drag = "split"
        return
    }
    if (id == "con.input") {
        app.focus = "console"
        app.con.focused = true
        return
    }
    uiPressedId = id
}

func onMouseUp(e) {
    var bws = currentBlocks()
    if (app.mode == "blocks" && bws != null) { blocksMouseUp(bws, e) }
    var id = uiHit(e.x, e.y)
    if (uiPressedId != "" && id == uiPressedId) { doAction(id) }
    uiPressedId = ""
    app.drag = ""
}

func onMouseMove(e) {
    uiMouseX = e.x
    uiMouseY = e.y
    var bws = currentBlocks()
    if (app.mode == "blocks" && bws != null) { blocksMouseMove(bws, e) }
    var ed = currentEditor()
    if (app.drag == "editor" && ed != null) {
        var pos = edPosAt(ed, e.x, e.y)
        ed.cy = pos[0]
        ed.cx = pos[1]
        if (e.y < ed.y) { edScroll(ed, -1) }
        if (e.y > ed.y + ed.h) { edScroll(ed, 1) }
    }
    if (app.drag == "split") {
        app.consoleH = surfaceHeight(S) - STATUS_H - e.y
    }
}

func onWheel(e) {
    var id = uiHit(e.x, e.y)
    if (id == "h.diff") {
        app.histScroll = max(0, app.histScroll + e.dy * 3)
        return
    }
    var bws = currentBlocks()
    if (app.mode == "blocks" && bws != null && startsWith(id, "b")) {
        blocksWheel(bws, e)
        return
    }
    var ed = currentEditor()
    if (id == "editor" && ed != null) {
        if (e.ctrl) { edZoom(ed, -e.dy) } else { edScroll(ed, e.dy * 3) }
    } else if (id == "console") {
        app.con.scroll = max(0, app.con.scroll - e.dy * 3)
    }
}

func onKey(e) {
    var k = e.key
    if (app.demo != null && !_synthetic) {
        if (k == "Escape") {
            app.demo = null
            setStatus("Показ зупинено")
        }
        return
    }
    if (app.dialog != null) {
        dialogKey(e)
        return
    }
    if (k == "F5" || (e.ctrl && k == "r")) {
        if (app.con.running) { conStop(app.con) } else { runCurrent() }
        return
    }
    if (app.tour >= 0) {
        if (k == "Escape") { endTour() }
        else if (k == "Right" || k == "Enter" || k == "Space") { tourGo(app.tour + 1) }
        else if (k == "Left") { tourGo(app.tour - 1) }
        return
    }
    if (e.ctrl && k == "s") {
        saveAll()
        setStatus("Збережено √")
        return
    }
    if (e.ctrl && k == "n") {
        doAction("newfile")
        return
    }
    if (app.focus == "console" && app.con.running) {
        if (k == "Escape") {
            app.focus = "editor"
            app.con.focused = false
            return
        }
        conKey(app.con, e)
        return
    }
    if (app.mode == "blocks") {
        var bws = currentBlocks()
        if (bws != null) { blocksKey(bws, e) }
        return
    }
    var ed = currentEditor()
    if (ed != null && app.mode == "code") { edKey(ed, e) }
}

func onText(e) {
    if (app.dialog != null) {
        if (app.dialog.action != "new" || (e.text != "/" && e.text != "\\")) { app.dialog.text = app.dialog.text + e.text }
        return
    }
    if (app.focus == "console" && app.con.running) {
        app.con.input = app.con.input + e.text
        return
    }
    if (app.mode == "blocks") {
        var bws = currentBlocks()
        if (bws != null) { blocksText(bws, e.text) }
        return
    }
    var ed = currentEditor()
    if (ed != null && app.mode == "code") { edTextInput(ed, e.text) }
}

func handle(e) {
    var t = e.type
    // Під час "Покажи мені" миша й клавіші людини ігноруються (крім Escape).
    if (app.demo != null && !_synthetic && t != "key") { return }
    if (t == "mousemove") { onMouseMove(e) }
    else if (t == "mousedown") { onMouseDown(e) }
    else if (t == "mouseup") { onMouseUp(e) }
    else if (t == "wheel") { onWheel(e) }
    else if (t == "key") { onKey(e) }
    else if (t == "text") { onText(e) }
}

// ---------- екскурсія ----------

func startTour(firstRun) {
    app.tourFirstRun = firstRun
    app.guideOpen = false
    app.histOpen = false
    app.filesCollapsed = false
    app.demo = null
    if (app.mode != "blocks") { setMode("blocks") }
    tourGo(0)
}

func tourGo(step) {
    if (step < 0) { return }
    if (step >= len(TOUR)) {
        endTour()
        return
    }
    app.tour = step
    app.demo = null
    app.filesCollapsed = false
    if (len(TOUR[step][3]) > 0) { startDemo(TOUR[step][3], false) }
}

func endTour() {
    app.tour = -1
    app.demo = null
    app.filesCollapsed = false
    app.guideOpen = true
    if (app.tourFirstRun) {
        app.guideTab = "lessons"
        openLesson(0)
    }
}

// ---------- історія версій ----------

func curPath() {
    if (app.mode == "blocks") { return app.currentB }
    return app.current
}

func curText() {
    if (app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws == null) { return "" }
        return stacksToJson(ws.stacks)
    }
    var ed = currentEditor()
    if (ed == null) { return "" }
    return edText(ed)
}

func loadHistory() {
    var file = curPath()
    app.histList = historyLoad(historyPath(app.dir, file))
    app.histCounts = []
    var prev = ""
    for v in app.histList {
        var now = readableText(file, v[2])
        append(app.histCounts, diffCounts(diffLines(prev, now)))
        prev = now
    }
    app.histDiffKey = ""
}

// Порівняння вибраної версії з поточним станом - лише коли щось змінилось.
func refreshHistoryDiff() {
    if (app.histSel < 0 || app.histSel >= len(app.histList)) { return }
    var cur = curText()
    var key = toString(app.histSel) + "|" + cur
    if (key == app.histDiffKey) { return }
    var file = curPath()
    app.histDiff = diffLines(readableText(file, app.histList[app.histSel][2]), readableText(file, cur))
    app.histDiffKey = key
}

func saveVersion(msg) {
    saveAll()
    if (historyAdd(historyPath(app.dir, curPath()), curText(), msg)) {
        setStatus("Версію збережено: " + msg)
    } else {
        setStatus("Нічого не змінилось від останньої версії")
    }
    loadHistory()
}

func historyAction(id) {
    if (id == "h.close") { app.histOpen = false }
    else if (id == "h.save") { openDialog("Що змінилось у цій версії?", "", "version") }
    else if (id == "h.back") { app.histSel = -1 }
    else if (startsWith(id, "h.sel:")) {
        app.histSel = toInt(substring(id, 6, len(id) - 6))
        app.histScroll = 0
    }
    else if (id == "h.restore") {
        var v = app.histList[app.histSel]
        // поточний стан - теж версією, щоб повернення можна було скасувати
        historyAdd(historyPath(app.dir, curPath()), curText(), "Перед поверненням до «" + v[1] + "»")
        if (app.mode == "blocks") {
            var ws = currentBlocks()
            wsSnapshot(ws)
            ws.stacks = stacksFromJson(v[2])
        } else {
            var ed = currentEditor()
            edBeginEdit(ed, "other")
            var cy = ed.cy
            edSetText(ed, v[2])
            ed.cy = min(cy, len(ed.lines) - 1)
            ed.dirty = true
        }
        saveAll()
        loadHistory()
        app.histSel = -1
        setStatus("Повернуто версію «" + v[1] + "»")
    }
}

// ---------- навчання ----------

func lessonCtx() {
    var stacks = []
    var ws = currentBlocks()
    if (ws != null) { stacks = ws.stacks }
    var code = ""
    var ed = currentEditor()
    if (ed != null) { code = edText(ed) }
    var cur = app.current
    if (app.mode == "blocks") { cur = app.currentB }
    return [stacks, code, app.con.lastOk, app.con.lastOutput, app.mode, fileName(cur), app.con.runs]
}

// Позначити виконані уроки (перевіряється відкритий урок).
func checkLessons() {
    if (app.guideLesson < 0) { return }
    initLessons()
    var les = LESSONS[app.guideLesson]
    if (indexOf(app.done, les.title) < 0 && lessonDone(les, lessonCtx())) {
        append(app.done, les.title)
        saveProgress(joinPath(joinPath(app.dir, ".nyx"), "уроки.json"), app.done)
        setStatus("Урок пройдено: " + les.title + "!")
    }
}

// Кожен урок - своя чиста програма ("Урок 2.nxb" лише з шапкою), щоб
// блоки різних уроків не накладались, а зроблене раніше не пропадало.
func openLesson(i) {
    initLessons()
    app.guideLesson = i
    var les = LESSONS[i]
    if (les.mode != app.mode) { setMode(les.mode) }
    if (les.check == "tocode") { return }   // урок 7 - про ту саму програму з блоків
    var num = substring(les.title, 0, indexOf(les.title, "."))
    var path = joinPath(app.dir, "Урок " + num + ext())
    if (!fileExists(path)) {
        if (les.mode == "blocks") {
            var start = newBlock("start")
            start.x = 40
            start.y = 40
            writeFile(path, stacksToJson([start]))
        } else {
            writeFile(path, "func main() {\n    \n}\n")
        }
    }
    refreshFiles()
    if (les.mode == "blocks") { openBlocks(path) } else {
        openFile(path)
        var ed = currentEditor()
        if (len(ed.lines) == 3 && trim(ed.lines[1]) == "") {
            ed.cy = 1
            ed.cx = 4
        }
    }
}

func openExample(name) {
    var src = joinPath(joinPath(ideHome(), "examples"), name)
    if (!fileExists(src)) {
        setStatus("Нема прикладу " + name)
        return
    }
    var dot = indexOf(name, ".")
    var base = substring(name, 0, dot)
    var extn = substring(name, dot, len(name) - dot)
    var target = name
    var i = 2
    while (fileExists(joinPath(app.dir, target))) {
        target = base + " " + toString(i) + extn
        i = i + 1
    }
    writeFile(joinPath(app.dir, target), readFile(src))
    if (extn == ".nxb") {
        setMode("blocks")
        refreshFiles()
        openBlocks(joinPath(app.dir, target))
    } else {
        setMode("code")
        refreshFiles()
        openFile(joinPath(app.dir, target))
    }
    setStatus("Приклад «" + base + "» відкрито - натисни «Запустити»!")
}

func guideAction(id) {
    initLessons()
    if (id == "g.close") { app.guideOpen = false }
    else if (id == "g.tour") { startTour(false) }
    else if (id == "g.tab.lessons") { app.guideTab = "lessons" }
    else if (id == "g.tab.examples") { app.guideTab = "examples" }
    else if (id == "g.back") { app.guideLesson = -1 }
    else if (startsWith(id, "g.open:")) { openLesson(toInt(substring(id, 7, len(id) - 7))) }
    else if (id == "g.next") { openLesson(min(app.guideLesson + 1, len(LESSONS) - 1)) }
    else if (id == "g.demo") { startDemo(LESSONS[app.guideLesson].demo, true) }
    else if (startsWith(id, "g.ex:")) { openExample(substring(id, 5, len(id) - 5)) }
}

// ---------- "Покажи мені": IDE сама рухає курсор ----------
//
// Кожен крок уроку розкладається на прості дії (рух курсора, натиснути,
// відпустити, надрукувати), які подаються в ТІ САМІ обробники, що й
// справжня миша - тож показ і справжня робота не розходяться.

struct Ev {
    type: string
    x: i32
    y: i32
    button: i32
    shift: bool
    ctrl: bool
    alt: bool
    dx: i32
    dy: i32
    key: string
    text: string
}

// true, поки demoTick подає власні (штучні) події в handle().
var _synthetic = false

func _feed(e) {
    _synthetic = true
    handle(e)
    _synthetic = false
}

struct Demo {
    steps: array
    i: i32
    queue: array
    t0: i32
    fromX: i32
    fromY: i32
}

func _ev(type, x, y) {
    return Ev { type: type, x: x, y: y, button: 1, shift: false, ctrl: false, alt: false, dx: 0, dy: 0, key: "", text: "" }
}

func startDemo(steps, panToProgram) {
    if (len(steps) == 0) { return }
    if (panToProgram && app.mode != "blocks") { setMode("blocks") }
    // програма уроку - біля лівого верхнього кута робочої області, щоб усе
    // потрібне для показу було видно
    var ws = currentBlocks()
    if (panToProgram && ws != null) {
        for s in ws.stacks {
            if (s.spec == "start") {
                ws.panX = 30 - s.x
                ws.panY = 30 - s.y
            }
        }
    }
    app.demo = Demo { steps: steps, i: 0, queue: [], t0: timeMs(), fromX: uiMouseX, fromY: uiMouseY }
    app.cursorX = max(uiMouseX, LEFT_W + 200)
    app.cursorY = max(uiMouseY, TOP_H + 200)
    if (app.tour < 0) { setStatus("Дивись! (Escape - зупинити)") }
}

// Останній блок ланцюжка під першою шапкою.
func _demoChainEnd(ws) {
    for s in ws.stacks {
        if (s.spec == "start") { return lastOfChain(s) }
    }
    return null
}

// Останній "обіймаючий" блок у ланцюжку під шапкою.
func _demoLastC(ws) {
    var found = null
    for s in ws.stacks {
        if (s.spec == "start") {
            var b = s
            while (b != null) {
                var k = specOf(b.spec).kind
                if (k == "c" || k == "c2") { found = b }
                b = b.next
            }
        }
    }
    return found
}

func _demoRef(ws, ref) {
    if (ref == "end") { return _demoChainEnd(ws) }
    if (ref == "body") {
        var c = _demoLastC(ws)
        if (c == null) { return null }
        return c.body
    }
    for b in liveBlocks(ws.stacks) { if (b.spec == ref) { return b } }
    return null
}

func _palPos(id) {
    var k = 0
    while (k < len(_pHits)) {
        if (_pHits[k] == id) { return [_pHits[k + 1], _pHits[k + 2]] }
        k = k + 5
    }
    return null
}

func _slotCenter(b, idx) {
    var k = 0
    while (k < len(_sHits)) {
        if (_sHits[k] == b && _sHits[k + 1] == idx) { return [_sHits[k + 3], _sHits[k + 4], _sHits[k + 5], _sHits[k + 6]] }
        k = k + 7
    }
    return null
}

// Наступний крок уроку -> черга простих дій.
func _demoPlan(step) {
    var ws = currentBlocks()
    var q = []
    var kind = step[0]
    if (kind == "cat") {
        var ci = indexOf(CATEGORIES, step[1])
        append(q, ["move", LEFT_W + 42, TOP_H + 10 + ci * 62 + 14, 500])
        append(q, ["down"]) append(q, ["up"]) append(q, ["wait", 300])
    } else if (kind == "drag") {
        var src = _palPos(step[1])
        var anchor = null
        if (step[2] == "end") {
            var last = _demoChainEnd(ws)
            anchor = [last.sx, last.sy + last.h]
        } else {
            var c = _demoLastC(ws)
            anchor = [c.sx + ARM_W, c.sy + c.hh]
        }
        if (src == null || anchor == null) { return q }
        append(q, ["move", src[0] + 10, src[1] + 10, 600])
        append(q, ["down"])
        append(q, ["move", anchor[0] + 12, anchor[1] + 14, 900])
        append(q, ["up"]) append(q, ["wait", 300])
    } else if (kind == "dropin") {
        var src2 = _palPos(step[1])
        var host = _demoRef(ws, step[2])
        if (src2 == null || host == null) { return q }
        var sl = _slotCenter(host, step[3])
        if (sl == null) { return q }
        append(q, ["move", src2[0] + 5, src2[1] + 10, 600])
        append(q, ["down"])
        append(q, ["move", sl[0] + 4, sl[1] + toInt(sl[3] / 2) - 4, 900])
        append(q, ["up"]) append(q, ["wait", 300])
    } else if (kind == "type") {
        var host2 = _demoRef(ws, step[1])
        if (host2 == null) { return q }
        var sl2 = _slotCenter(host2, step[2])
        if (sl2 == null) { return q }
        append(q, ["move", sl2[0] + toInt(sl2[2] / 2), sl2[1] + toInt(sl2[3] / 2), 600])
        append(q, ["down"]) append(q, ["up"])
        var old = toString(host2.args[step[2]])
        var n = 0
        while (n < len(old)) {
            append(q, ["key", "Backspace"])
            n = n + 1
        }
        var t = step[3]
        var j = 0
        while (j < len(t)) {
            append(q, ["text", t[j]]) append(q, ["wait", 60])
            j = j + 1
        }
        append(q, ["key", "Enter"]) append(q, ["wait", 300])
    } else if (kind == "click") {
        var r = uiFind(step[1])
        if (r == null) { return q }
        append(q, ["move", r[0] + toInt(r[2] / 2), r[1] + toInt(r[3] / 2), 700])
        append(q, ["down"]) append(q, ["up"]) append(q, ["wait", 400])
    }
    return q
}

func demoTick() {
    var d = app.demo
    if (len(d.queue) == 0) {
        if (d.i >= len(d.steps)) {
            app.demo = null
            if (app.tour < 0) { setStatus("Ось так! Тепер спробуй сам(а).") }
            return
        }
        d.queue = _demoPlan(d.steps[d.i])
        d.i = d.i + 1
        d.t0 = timeMs()
        d.fromX = app.cursorX
        d.fromY = app.cursorY
        return
    }
    var a = d.queue[0]
    var done = true
    if (a[0] == "move") {
        var t = min(1, (timeMs() - d.t0) / a[3])
        // плавний старт і зупинка
        var e = t * t * (3 - 2 * t)
        app.cursorX = toInt(d.fromX + (a[1] - d.fromX) * e)
        app.cursorY = toInt(d.fromY + (a[2] - d.fromY) * e)
        _feed(_ev("mousemove", app.cursorX, app.cursorY))
        done = t >= 1
    } else if (a[0] == "down") {
        _feed(_ev("mousedown", app.cursorX, app.cursorY))
    } else if (a[0] == "up") {
        _feed(_ev("mouseup", app.cursorX, app.cursorY))
    } else if (a[0] == "key") {
        var ke = _ev("key", 0, 0)
        ke.key = a[1]
        _feed(ke)
    } else if (a[0] == "text") {
        var te = _ev("text", 0, 0)
        te.text = a[1]
        _feed(te)
    } else if (a[0] == "wait") {
        done = timeMs() - d.t0 >= a[1]
    }
    if (done && app.demo != null) {
        removeAt(d.queue, 0)
        d.t0 = timeMs()
        d.fromX = app.cursorX
        d.fromY = app.cursorY
    }
}

func drawDemoCursor() {
    var x = app.cursorX
    var y = app.cursorY
    surfacePolygon(S, [x + 2, y + 2, x + 2, y + 26, x + 9, y + 20, x + 14, y + 31, x + 19, y + 29, x + 14, y + 18, x + 23, y + 18], 0x66000000)
    surfacePolygon(S, [x, y, x, y + 24, x + 7, y + 18, x + 12, y + 29, x + 17, y + 27, x + 12, y + 16, x + 21, y + 16], C_YELLOW)
    surfaceCircleLine(S, x, y, 14, 0x88f9e2af, 2)
}

// ---------- старт і цикл ----------

func ideInit(dir) {
    if (!dirExists(dir)) { makeDir(dir) }
    app = App { mode: "code", dir: dir, files: [], editors: newMap(), current: "", blocks: newMap(), currentB: "", genMap: [], guideOpen: false, guideTab: "lessons", guideLesson: -1, done: [], demo: null,
        cursorX: 0, cursorY: 0, filesCollapsed: false, hintRun: 0, tour: -1, tourFirstRun: false, histOpen: false, histSel: -1, histScroll: 0, histList: [], histCounts: [],
        histDiff: [], histDiffKey: "", con: newConsole(),
        focus: "editor", drag: "", consoleH: 220, lastClickTime: 0, lastClickX: 0, lastClickY: 0,
        clickCount: 0, dialog: null, status: "", statusTime: 0 }

    var s = surfaceOpen("Nyx IDE", 1280, 800)
    uiInit(s)
    refreshFiles()
    if (len(app.files) == 0) {
        var example = joinPath(ideHome(), "examples/привіт.nx")
        var text = "func main() {\n    print(\"Привіт, світе!\")\n}\n"
        if (fileExists(example)) { text = readFile(example) }
        writeFile(joinPath(dir, "привіт.nx"), text)
        refreshFiles()
    }
    openFile(joinPath(dir, app.files[0]))
    // прогрес уроків; перший запуск - одразу відкрити перший урок у блоках
    var progressPath = joinPath(joinPath(dir, ".nyx"), "уроки.json")
    if (fileExists(progressPath)) { app.done = loadProgress(progressPath) }
    else {
        setMode("blocks")
        openLesson(0)
        startTour(true)
        if (!dirExists(joinPath(dir, ".nyx"))) { makeDir(joinPath(dir, ".nyx")) }
        saveProgress(progressPath, [])
    }
    draw()
    return s
}

// Один крок циклу: дочекатися подій (wait мс, -1 - безкінечно), обробити
// ВСІ, що назбирались, і лише потім один раз перемалювати.
// false - вікно закрили.
func ideStep(wait) {
    if (app.con.running && (wait < 0 || wait > 40)) { wait = 40 }
    if (app.demo != null && (wait < 0 || wait > 16)) { wait = 16 }
    var e = surfaceNextEvent(S, wait)
    var dirty = false
    while (e != null) {
        if (e.type == "close") { return false }
        handle(e)
        dirty = true
        e = surfaceNextEvent(S, 0)
    }
    if (app.con.proc != null && (app.con.running || dirty)) {
        if (conPoll(app.con)) { dirty = true }
        afterPoll()
    }
    if (app.demo != null) {
        demoTick()
        dirty = true
    }
    if (app.status != "" && timeMs() - app.statusTime > 4000 && timeMs() - app.statusTime < 4100) { dirty = true }
    if (dirty) { draw() }
    return surfaceIsOpen(S)
}

func ideShutdown() {
    saveAll()
    if (app.con.running) { conStop(app.con) }
}

func main() {
    var args = scriptArgs()
    var dir = joinPath(homeDir(), "NyxПрограми")
    if (len(args) > 0) { dir = args[0] }
    ideInit(dir)
    while (ideStep(-1)) { }
    ideShutdown()
}
