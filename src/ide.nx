        i = i + 1
    }
    cy = cy + 44
    surfaceText(S, "Що показувати", x + 14, cy, 14, C_SUBTEXT, true)
    cy = cy + 24
    _toggle("set.blocks", "Режим блоків", c.blocks, x + 6, cy, w - 12)
    cy = cy + 34
    _toggle("set.lessons", "Уроки й навчання", c.lessons, x + 6, cy, w - 12)
    cy = cy + 34
    _toggle("set.hints", "Підказки до помилок", c.hints, x + 6, cy, w - 12)
    cy = cy + 34
    _toggle("set.offers", "Пропонувати гайд", c.offers, x + 6, cy, w - 12)
    cy = cy + 34
    _toggle("set.pixelfont", "Піксельний шрифт", c.pixelFont, x + 6, cy, w - 12)
    cy = cy + 34
    _toggle("set.updcheck", "Перевіряти оновлення", c.updCheck, x + 6, cy, w - 12)
    cy = cy + 34
    var vlabel = "Nx IDE " + IDE_VERSION
    var vw = surfaceText(S, vlabel, x + 16, cy + 7, 14, C_DIM)
    uiButton("upd.check", "Перевірити зараз", x + w - 170, cy, 156, 28, "flat")
    cy = cy + 40
    surfaceText(S, "Тема", x + 14, cy, 14, C_SUBTEXT, true)
    cy = cy + 22
    var tw3 = toInt((w - 28) / len(THEMES))
    var ti = 0
    while (ti < len(THEMES)) {
        var tk = "normal"
        if (c.theme == THEMES[ti][0]) { tk = "primary" }
        uiButton("set.theme:" + THEMES[ti][0], THEMES[ti][1], x + 14 + ti * tw3, cy, tw3 - 4, 28, tk)
        ti = ti + 1
    }
    cy = cy + 40
    surfaceText(S, "Масштаб інтерфейсу", x + 14, cy, 14, C_SUBTEXT, true)
    cy = cy + 22
    var scales = [100, 125, 150, 175, 200]
    var sw = toInt((w - 28) / len(scales))
    var si = 0
    while (si < len(scales)) {
        var sk = "normal"
        if (c.uiScale == scales[si]) { sk = "primary" }
        uiButton("set.scale:" + toString(scales[si]), toString(scales[si]) + "%", x + 14 + si * sw, cy, sw - 4, 28, sk)
        si = si + 1
    }
    cy = cy + 46
    uiButton("set.resetoffers", "Показувати пропозиції знову", x + 14, cy, w - 28, 30, "flat")
    cy = cy + 40
    uiButton("g.tour", "Екскурсія по IDE", x + 14, cy, w - 28, 30, "normal")
    cy = cy + 46
    for l in wrapLines("Налаштування спільні для всіх тек: " + configPath(), w - 28, 12) {
        surfaceText(S, l, x + 14, cy, 12, C_DIM)
        cy = cy + 16
    }
}

func settingsAction(id) {
    var c = app.cfg
    if (startsWith(id, "set.level:")) {
        applyLevel(substring(id, 10, len(id) - 10), false)
        setStatus("Рівень змінено - налаштування виставлено під нього")
        return
    }
    if (id == "set.blocks") { c.blocks = !c.blocks }
    if (id == "set.lessons") {
        c.lessons = !c.lessons
        if (!c.lessons && app.side == "learn") { app.side = "" }
    }
    if (id == "set.hints") { c.hints = !c.hints }
    if (id == "set.offers") { c.offers = !c.offers }
    if (id == "set.pixelfont") { c.pixelFont = !c.pixelFont }
    if (id == "set.updcheck") {
        c.updCheck = !c.updCheck
        if (!c.updCheck) { app.updInfo = null }
    }
    if (startsWith(id, "set.theme:")) {
        c.theme = substring(id, 10, len(id) - 10)
        applyTheme(c.theme)
    }
    if (startsWith(id, "set.scale:")) {
        c.uiScale = toInt(substring(id, 10, len(id) - 10))
        surfaceScale(c.uiScale / 100)
    }
    if (id == "set.resetoffers") {
        c.seen = []
        c.offers = true
        setStatus("Пропозиції гайду показуватимуться знову")
    }
    saveSettings()
    refreshFiles()
}

// ---------- малювання ----------

func drawTitleBar(W) {
    surfaceRect(S, 0, 0, W, TITLE_H, C_PANEL2)
    surfaceText(S, "Nyx", 14, 8, 20, C_ACCENT, true)
    surfaceText(S, "IDE", 14 + textWidth("Nyx ", 20, true), 8, 20, C_TEXT)
    // поле "палітри команд" по центру, як у VS Code
    // поле команд звужується, коли праворуч панель налагодження
    var rightW = 420
    if (app.con.running && app.con.debug && app.con.paused) { rightW = 900 }
    var cw = min(440, W - rightW)
    if (cw > 160) {
        var cx = toInt((W - cw) / 2)
        var bg = C_BG
        if (uiHover(cx, 6, cw, 24)) { bg = C_SURFACE }
        surfaceRoundRect(S, cx, 6, cw, 24, 6, bg)
        surfaceRectLine(S, cx, 6, cw, 24, C_BORDER, 1)
        iconSearch(cx + 8, 9, 18, C_DIM)
        var label = "Команди й файли  (Ctrl+Shift+P)"
        surfaceText(S, uiFit(label, cw - 40, 14), cx + 32, 11, 14, C_DIM)
        uiRegion("cmd.open", cx, 6, cw, 24)
    }
    var runnable = app.active != "" && fileKind(app.active) != "text"
    var rx = W - 10
    if (app.con.running) {
        var stopW = uiButtonW("■ Зупинити")
        rx = rx - stopW
        uiButton("stop", "■ Зупинити", rx, 4, stopW, 28, "danger")
        if (app.con.debug && app.con.paused) {
            // панель налагодження, як у VS Code
            var btns = [["dbg.out", "Вийти", "Shift+F11 - вийти з функції"], ["dbg.into", "Всередину", "F11 - крок усередину функції"],
                        ["dbg.over", "Крок", "F10 - наступний рядок"], ["dbg.cont", "▶ Далі", "F5 - продовжити до точки зупинки"]]
            for bt in btns {
                var bw2 = uiButtonW(bt[1])
                rx = rx - bw2 - 6
                var kind = "normal"
                if (bt[0] == "dbg.over") { kind = "primary" }
                uiButton(bt[0], bt[1], rx, 4, bw2, 28, kind)
                if (uiHover(rx, 4, bw2, 28)) { app.tooltip = bt[2] }
            }
        }
    } else if (runnable) {
        var runW = uiButtonW("▶ Запустити")
        rx = rx - runW
        uiButton("run", "▶ Запустити", rx, 4, runW, 28, "primary")
        var dw = uiButtonW("Крок за кроком")
        rx = rx - dw - 6
        uiButton("debug", "Крок за кроком", rx, 4, dw, 28, "normal")
        if (uiHover(rx, 4, dw, 28)) { app.tooltip = "F10 - запустити покроково: програма зупиняється на кожному рядку, видно змінні" }
    }
}

var ALL_ACTIVITIES = [["files", "Провідник"], ["search", "Пошук у файлах"], ["history", "Історія версій"], ["git", "Git"], ["learn", "Навчання"], ["ext", "Розширення"], ["settings", "Налаштування"]]

// Видимі дії (без "Навчання", якщо уроки вимкнено; налаштування - окремо внизу).
func activities() {
    var list = []
    for a in ALL_ACTIVITIES {
        if (a[0] == "settings") { continue }
        if (a[0] == "learn" && app.cfg != null && !app.cfg.lessons) { continue }
        append(list, a)
    }
    return list
}

func drawActivityBar(y, h) {
    surfaceRect(S, 0, y, ACT_W, h, C_PANEL2)
    var acts = activities()
    // шестерня налаштувань - внизу, як у VS Code
    var gy = y + h - ACT_W
    var gon = app.side == "settings"
    var gc = C_DIM
    if (uiHover(0, gy, ACT_W, ACT_W)) {
        gc = C_SUBTEXT
        app.tooltip = "Налаштування"
    }
    if (gon) {
        gc = C_TEXT
        surfaceRect(S, 0, gy, 2, ACT_W, C_ACCENT)
    }
    iconGear(toInt((ACT_W - 24) / 2), gy + 12, 24, gc)
    uiRegion("act:settings", 0, gy, ACT_W, ACT_W)
    var i = 0
    while (i < len(acts)) {
        var a = acts[i]
        var iy = y + i * ACT_W
        var on = app.side == a[0]
        var hover = uiHover(0, iy, ACT_W, ACT_W)
        var c = C_DIM
        if (hover) {
            c = C_SUBTEXT
            app.tooltip = a[1]
        }
        if (on) {
            c = C_TEXT
            surfaceRect(S, 0, iy, 2, ACT_W, C_ACCENT)
        }
        var ix = toInt((ACT_W - 24) / 2)
        if (a[0] == "files") { iconFiles(ix, iy + 12, 24, c) }
        if (a[0] == "search") { iconSearch(ix, iy + 12, 24, c) }
        if (a[0] == "history") { iconHistory(ix, iy + 12, 24, c) }
        if (a[0] == "git") { iconBranch(ix, iy + 12, 24, c) }
        if (a[0] == "learn") { iconLearn(ix, iy + 12, 24, c) }
        if (a[0] == "ext") { iconExt(ix, iy + 12, 24, c) }
        uiRegion("act:" + a[0], 0, iy, ACT_W, ACT_W)
        i = i + 1
    }
}

func _sideTitle(view) {
    for a in ALL_ACTIVITIES { if (a[0] == view) { return toUpper(a[1]) } }
    return ""
}

func drawSidebar(x, y, w, h) {
    surfaceRect(S, x, y, w, h, C_PANEL)
    uiRegion("side.panel", x, y, w, h)
    surfaceText(S, _sideTitle(app.side), x + 14, y + 10, 14, C_SUBTEXT, true)
    uiButton("side.collapse", "‹", x + w - 32, y + 4, 26, 26, "flat")
    var cy = y + 34
    var ch = h - 34
    if (app.side == "files") { drawExplorer(x, cy, w, ch) }
    else if (app.side == "search") { drawSearchView(x, cy, w, ch) }
    else if (app.side == "history") {
        refreshHistoryDiff()
        if (app.active == "") { surfaceText(S, "Відкрий файл, щоб бачити його версії.", x + 14, cy + 8, 14, C_DIM) }
        else { drawHistory(curPath(), app.histList, app.histCounts, app.histSel, app.histDiff, app.histScroll, x, cy, w, ch) }
    }
    else if (app.side == "learn") {
        checkLessons()
        drawGuide(app.guideTab, app.guideLesson, app.done, lessonCtx(), x, cy, w, ch)
    }
    else if (app.side == "ext") { drawExtensionsView(x, cy, w, ch) }
    else if (app.side == "git") {
        if (app.git.stale || timeMs() - app.git.last > 3000) { gitRefresh(app.git, app.dir) }
        uiRegion("git.panel", x, cy, w, ch)
        drawGit(app.git, x, cy, w, ch)
        if (GIT_TIP != "") { app.tooltip = GIT_TIP }
    }
    else if (app.side == "settings") { drawSettingsView(x, cy, w, ch) }
}

func _isDirty(path) {
    if (mapHas(app.editors, path) && mapGet(app.editors, path).dirty) { return true }
    if (mapHas(app.blocks, path) && mapGet(app.blocks, path).dirty) { return true }
    return false
}

// ---------- Провідник (як у VS Code) ----------

struct Entry {
    mode: string
    dir: string
    text: string
    target: string
}

func parentDir(path) {
    var p = replace(path, "\\", "/")
    var i = len(p) - 1
    while (i > 0 && p[i] != "/") { i = i - 1 }
    if (i <= 0) { return app.dir }
    return substring(path, 0, i)
}

// Тека для нового файла: виділена тека, тека виділеного файла, інакше корінь.
func targetDir() {
    if (app.exSel == "") { return app.dir }
    if (dirExists(app.exSel)) { return app.exSel }
    return parentDir(app.exSel)
}

func startEntry(mode, dir, text, target) {
    app.entry = Entry { mode: mode, dir: dir, text: text, target: target }
    app.focus = "entry"
    app.ctx = null
    if (dir != app.dir) { mapSet(app.expanded, dir, true) }
    if (app.side != "files") { app.side = "files" }
    refreshFiles()
}

func commitEntry() {
    var e = app.entry
    app.entry = null
    app.focus = "editor"
    var name = trim(e.text)
    if (name == "" || contains(name, "/") || contains(name, "\\")) { return }
    if (e.mode == "rename") {
        var to = joinPath(parentDir(e.target), name)
        if (to == e.target) { return }
        if (fileExists(to) || dirExists(to)) {
            setStatus("«" + name + "» вже є")
            return
        }
        saveAll()
        try { movePath(e.target, to) } catch (err) {
            setStatus("Не вдалося перейменувати: " + toString(err))
            return
        }
        _renameOpen(e.target, to)
        refreshFiles()
        return
    }
    if (e.mode == "newdir") {
        var dp = joinPath(e.dir, name)
        if (dirExists(dp) || fileExists(dp)) {
            setStatus("«" + name + "» вже є")
            return
        }
        makeDir(dp)
        mapSet(app.expanded, dp, true)
        app.exSel = dp
        refreshFiles()
        return
    }
    // новий файл: без розширення - програма .nx
    if (indexOf(name, ".") < 0) { name = name + ".nx" }
    var fp = joinPath(e.dir, name)
    if (fileExists(fp) || dirExists(fp)) {
        setStatus("«" + name + "» вже є - відкрито його")
    } else {
        var content = ""
        if (fileKind(fp) == "blocks") { content = starterBlocksJson() }
        if (fileKind(fp) == "code") { content = "func main() {\n    print(\"Привіт!\")\n}\n" }
        writeFile(fp, content)
    }
    refreshFiles()
    app.exSel = fp
    openPath(fp)
}

// Після перейменування: вкладки й відкриті редактори - на нові шляхи
// (і для файлів усередині перейменованої теки).
func _renameOpen(from, to) {
    var i = 0
    while (i < len(app.tabs)) {
        var t = app.tabs[i]
        if (t == from || startsWith(t, from + "/")) {
            var nt = to + substring(t, len(from), len(t) - len(from))
            app.tabs[i] = nt
            if (mapHas(app.editors, t)) {
                var ed = mapGet(app.editors, t)
                ed.path = nt
                mapSet(app.editors, nt, ed)
                mapRemove(app.editors, t)
            }
            if (mapHas(app.blocks, t)) {
                var ws = mapGet(app.blocks, t)
                ws.path = nt
                mapSet(app.blocks, nt, ws)
                mapRemove(app.blocks, t)
            }
            if (app.active == t) { app.active = nt }
            if (app.current == t) { app.current = nt }
            if (app.split == t) { app.split = nt }
            if (app.currentB == t) { app.currentB = nt }
        }
        i = i + 1
    }
    if (app.exSel == from) { app.exSel = to }
}

func askDelete(path) {
    openDialog("Видалити «" + fileName(path) + "»?", "Це не можна скасувати.", "delete")
    app.dialog.target = path
}

func deletePath(path) {
    // закрити вкладки цього файла / файлів у цій теці
    var t = len(app.tabs) - 1
    while (t >= 0) {
        var p = app.tabs[t]
        if (p == path || startsWith(p, path + "/")) {
            mapRemove(app.editors, p)
            mapRemove(app.blocks, p)
            closeTab(p)
        }
        t = t - 1
    }
    if (dirExists(path)) { deleteDir(path) } else { deleteFile(path) }
    if (app.exSel == path) { app.exSel = "" }
    refreshFiles()
    setStatus("Видалено «" + fileName(path) + "»")
}

func entryKey(e) {
    if (e.key == "Enter") { commitEntry() }
    else if (e.key == "Escape") {
        app.entry = null
        app.focus = "editor"
    }
    else if (e.key == "Backspace" && len(app.entry.text) > 0) { app.entry.text = uiDropLast(app.entry.text) }
}

// Контекстне меню Провідника (права кнопка).
struct Ctx {
    items: array
    x: i32
    y: i32
    path: string
}

func openCtx(path, x, y) {
    var items = []
    if (path == "") {
        items = [["Новий файл", "newfile"], ["Нова тека", "newdir"]]
    } else if (dirExists(path)) {
        items = [["Новий файл", "newfile"], ["Нова тека", "newdir"], ["Перейменувати", "rename"], ["Видалити", "delete"], ["Копіювати шлях", "copypath"]]
    } else {
        items = [["Відкрити", "open"], ["Перейменувати", "rename"], ["Видалити", "delete"], ["Копіювати шлях", "copypath"]]
        if (endsWith(path, ".nx") && app.cfg.blocks) { insert(items, 1, ["Відкрити як блоки", "toblocks"]) }
    }
    if (path != "") {
        app.exSel = path
        app.exFocus = true
    }
    app.ctx = Ctx { items: items, x: x, y: y, path: path }
}

func ctxAction(act) {
    var c = app.ctx
    app.ctx = null
    var path = c.path
    var dir = app.dir
    if (path != "") { if (dirExists(path)) { dir = path } else { dir = parentDir(path) } }
    if (act == "newfile") { startEntry("newfile", dir, "", "") }
    else if (act == "newdir") { startEntry("newdir", dir, "", "") }
    else if (act == "rename") { startEntry("rename", parentDir(path), fileName(path), path) }
    else if (act == "delete") { askDelete(path) }
    else if (act == "open") { openPath(path) }
    else if (act == "toblocks") { codeToBlocksFile(path) }
    else if (act == "copypath") {
        clipboardSet(path)
        setStatus("Шлях скопійовано")
    }
}

func drawCtx() {
    var c = app.ctx
    var w = 60
    for it in c.items { w = max(w, textWidth(it[0], 14) + 36) }
    var h = len(c.items) * 26 + 8
    var x = min(c.x, surfaceWidth(S) - w - 4)
    var y = min(c.y, surfaceHeight(S) - h - 4)
    surfaceRoundRect(S, x + 3, y + 3, w, h, 6, 0x66000000)
    surfaceRoundRect(S, x, y, w, h, 6, C_SURFACE)
    // спершу все меню, потім пункти - пізніші області "зверху" для кліку
    uiRegion("ctx.box", x, y, w, h)
    var iy = y + 4
    for it in c.items {
        if (uiHover(x, iy, w, 26)) { surfaceRoundRect(S, x + 4, iy, w - 8, 26, 4, C_ACCENT) }
        var col = C_TEXT
        if (it[1] == "delete") { col = C_RED }
        if (uiHover(x, iy, w, 26)) { col = C_ON_ACCENT }
        surfaceText(S, it[0], x + 14, iy + 6, 14, col)
        uiRegion("ctx:" + it[1], x, iy, w, 26)
        iy = iy + 26
    }
}

func _entryRow(x, ry, w, depth, kind) {
    var indent = 10 + depth * 14
    iconFileKind(kind, x + indent + 18, ry + 3, 18, C_DIM)
    var bx = x + indent + 40
    surfaceRect(S, bx, ry + 1, w - (bx - x) - 6, 22, C_BG)
    surfaceRectLine(S, bx, ry + 1, w - (bx - x) - 6, 22, C_ACCENT, 1)
    var tw = surfaceText(S, app.entry.text, bx + 4, ry + 4, 16, C_TEXT)
    surfaceRect(S, bx + 5 + tw, ry + 3, 2, 18, C_ACCENT)
}

func _exIcon(id, x, y, tip) {
    var hover = uiHover(x, y, 22, 22)
    if (hover) {
        surfaceRoundRect(S, x, y, 22, 22, 4, C_SURFACE2)
        app.tooltip = tip
    }
    var c = C_SUBTEXT
    if (id == "ex.newfile") { iconNewFile(x + 3, y + 3, 16, c) }
    if (id == "ex.newdir") { iconNewFolder(x + 3, y + 3, 16, c) }
    if (id == "ex.refresh") { iconRefresh(x + 3, y + 3, 16, c) }
    if (id == "ex.collapse") { iconCollapseAll(x + 3, y + 3, 16, c) }
    uiRegion(id, x, y, 22, 22)
}

func drawExplorer(x, y, w, h) {
    // заголовок: назва теки + іконки (новий файл, нова тека, оновити, згорнути все)
    var title = toUpper(fileName(app.dir))
    var ttw = textWidth(uiFit(title, w - 130, 13), 13, true)
    if (uiHover(x + 8, y, ttw + 30, 24)) {
        surfaceRoundRect(S, x + 8, y, ttw + 30, 24, 4, C_SURFACE)
        app.tooltip = "Відкрити іншу теку (Ctrl+O)"
    }
    surfaceText(S, uiFit(title, w - 130, 13), x + 14, y + 4, 13, C_SUBTEXT, true)
    iconChevron(x + 16 + ttw, y + 2, 18, true, C_DIM)
    uiRegion("ex.openfolder", x + 8, y, ttw + 30, 24)
    var ix = x + w - 26
    _exIcon("ex.collapse", ix, y, "Згорнути всі теки")
    _exIcon("ex.refresh", ix - 24, y, "Оновити")
    _exIcon("ex.newdir", ix - 48, y, "Нова тека")
    _exIcon("ex.newfile", ix - 72, y, "Новий файл (без розширення - .nx, .nxb - блоки)")
    var top = y + 28
    var rowH = 24
    uiRegion("ex.empty", x, top, w, h - 28)
    surfaceClip(S, x, top, w, h - 28)
    var ry = top - app.sideScroll
    var e = app.entry
    // новий файл/тека в корені - рядок вводу першим
    if (e != null && e.mode != "rename" && e.dir == app.dir) {
        var k0 = "code"
        if (e.mode == "newdir") { k0 = "dir" } else { k0 = fileKind(e.text) }
        _entryRow(x, ry, w, 0, k0)
        ry = ry + rowH
    }
    for f in app.files {
        var path = f[0]
        if (e != null && e.mode == "rename" && e.target == path) {
            var kr = "dir"
            if (!f[3]) { kr = fileKind(e.text) }
            _entryRow(x, ry, w, f[2], kr)
            ry = ry + rowH
            continue
        }
        if (ry + rowH >= top && ry < top + h) {
            var on = path == app.active
            var sel = path == app.exSel
            var indent = 10 + f[2] * 14
            if (on) { surfaceRect(S, x, ry, w, rowH, C_SURFACE) }
            else if (sel) { surfaceRect(S, x, ry, w, rowH, C_BG) }
            else if (uiHover(x, ry, w, rowH)) { surfaceRect(S, x, ry, w, rowH, C_BG) }
            if (f[3]) {
                iconChevron(x + indent, ry + 2, 20, mapHas(app.expanded, path), C_SUBTEXT)
                iconFileKind("dir", x + indent + 18, ry + 3, 18, C_SUBTEXT)
                surfaceText(S, uiFit(f[1], w - indent - 50, 16), x + indent + 42, ry + 4, 16, C_SUBTEXT)
                uiRegion("dir:" + path, x, ry, w, rowH)
            } else {
                var kind = fileKind(path)
                iconFileKind(kind, x + indent + 18, ry + 3, 18, C_DIM)
                var col = C_SUBTEXT
                if (on) { col = C_TEXT }
                // стан у git: літера праворуч і колір назви (як у VS Code)
                var gl = ""
                if (app.git.isRepo && mapHas(app.git.byPath, path)) {
                    gl = mapGet(app.git.byPath, path)
                    col = gitLetterColor(gl)
                    surfaceText(S, gl, x + w - 34, ry + 4, 14, col, true)
                }
                surfaceText(S, uiFit(f[1], w - indent - 64, 16), x + indent + 42, ry + 4, 16, col)
                if (_isDirty(path)) { surfaceCircle(S, x + w - 16, ry + 12, 4, C_PEACH) }
                uiRegion("file:" + path, x, ry, w, rowH)
            }
        }
        ry = ry + rowH
        // новий файл/тека всередині цієї теки - одразу під нею
        if (f[3] && e != null && e.mode != "rename" && e.dir == path) {
            var k1 = "code"
            if (e.mode == "newdir") { k1 = "dir" } else { k1 = fileKind(e.text) }
            _entryRow(x, ry, w, f[2] + 1, k1)
            ry = ry + rowH
        }
    }
    if (len(app.files) == 0 && e == null) {
        surfaceText(S, "Тека порожня.", x + 14, ry + 6, 14, C_DIM)
        uiButton("ex.newfile2", "Створити файл", x + 14, ry + 30, w - 28, 28, "normal")
    }
    surfaceUnclip(S)
}

func drawSearchView(x, y, w, h) {
    var focused = app.focus == "search"
    var border = C_SURFACE2
    if (focused) { border = C_ACCENT }
    surfaceRoundRect(S, x + 10, y, w - 20, 30, 6, border)
    surfaceRoundRect(S, x + 11, y + 1, w - 22, 28, 6, C_BG)
    var tw = surfaceText(S, app.searchText, x + 20, y + 7, 16, C_TEXT)
    if (focused) { surfaceRect(S, x + 21 + tw, y + 5, 2, 20, C_ACCENT) }
    if (app.searchText == "" && !focused) { surfaceText(S, "Шукати в усіх файлах…", x + 20, y + 7, 16, C_DIM) }
    uiRegion("search.input", x + 10, y, w - 20, 30)
    var cy = y + 40
    if (len(app.searchText) >= 2) {
        surfaceText(S, toString(len(app.searchResults)) + " збігів", x + 14, cy, 14, C_DIM)
        cy = cy + 22
    }
    surfaceClip(S, x, cy, w, h - (cy - y))
    var ry = cy - app.sideScroll
    var lastFile = ""
    var i = 0
    while (i < len(app.searchResults) && ry < y + h) {
        var r = app.searchResults[i]
        if (r[0] != lastFile) {
            lastFile = r[0]
            iconFileKind(fileKind(r[0]), x + 10, ry + 3, 16, C_DIM)
            surfaceText(S, uiFit(fileName(r[0]), w - 40, 14), x + 32, ry + 4, 14, C_TEXT, true)
            ry = ry + 22
        }
        if (uiHover(x, ry, w, 22)) { surfaceRect(S, x, ry, w, 22, C_BG) }
        surfaceText(S, toString(r[1] + 1), x + 22, ry + 4, 14, C_DIM)
        surfaceText(S, uiFit(r[2], w - 64, 14), x + 56, ry + 4, 14, C_SUBTEXT)
        uiRegion("sres:" + toString(i), x, ry, w, 22)
        ry = ry + 22
        i = i + 1
    }
    surfaceUnclip(S)
}

func drawExtensionsView(x, y, w, h) {
    // контейнер - до кнопок, інакше перекрив би їх
    uiRegion("ext.panel", x, y, w, h)
    var contentH = drawExtensions(app.exts, userExtDir(), x, y, w, h, app.extScroll)
    app.extScroll = clamp(app.extScroll, 0, max(0, contentH - h + 20))
}

// ---------- розширення ----------

// Свої розширення - поруч з налаштуваннями: ~/.nyx-ide/розширення.
func userExtDir() {
    var path = configPath()
    var parts = split(replace(path, "\\", "/"), "/")
    return substring(path, 0, len(path) - len(parts[len(parts) - 1]) - 1) + "/розширення"
}

func reloadExtensions() {
    var off = []
    if (app.cfg != null) { off = app.cfg.extOff }
    app.exts = extLoadAll(joinPath(ideHome(), "extensions"), userExtDir(), off)
}

func _extById(id) {
    for e in app.exts { if (e.id == id) { return e } }
    return null
}

// Фонова перевірка файла розширеннями (після збереження й відкриття).
func lintFile(path) {
    if (path == "" || !fileExists(path)) { return }
    for e in app.exts {
        if (!extLints(e, path)) { continue }
        // попередня перевірка цього ж файла цим розширенням - вже не потрібна
        var k = len(app.lintJobs) - 1
        while (k >= 0) {
            var j = app.lintJobs[k]
            if (j[0] == e && j[1] == path) {
                try { procKill(j[2]) } catch (err) { }
                removeAt(app.lintJobs, k)
            }
            k = k - 1
        }
        var opts = newMap()
        mapSet(opts, "cwd", e.dir)
        var env = newMap()
        mapSet(env, "NX_EXIT_WITH_PARENT", "1")
        mapSet(opts, "env", env)
        try {
            append(app.lintJobs, [e, path, procStart(nxPath(), [e.dir + "/" + e.lintScript, path], opts)])
            e.status = "перевіряє " + fileName(path) + "…"
            e.statusKind = "info"
        } catch (err2) {
            e.status = "не вдалося запустити: " + toString(err2)
            e.statusKind = "err"
        }
    }
}

// Готові перевірки -> «ПРОБЛЕМИ». true - щось змінилось.
func pollLint() {
    var changed = false
    var k = len(app.lintJobs) - 1
    while (k >= 0) {
        var j = app.lintJobs[k]
        if (!procIsRunning(j[2])) {
            removeAt(app.lintJobs, k)
            var e = j[0]
            var path = j[1]
            var out = procOutput(j[2])
            var res = extParseLint(out)
            if (res[1] != "") {
                // скрипт розширення впав - рядок з його помилкою
                for l in split(procErrorOutput(j[2]) + "\n" + out, "\n") {
                    if (contains(l, "Error") || contains(l, "помилка") || contains(l, "ПОМИЛКА")) {
                        res = [[], "скрипт упав: " + replace(trim(l), "Runtime Error: ", "")]
                        break
                    }
                }
            }
            setExtProblems(e.name, path, res[0])
            if (res[1] != "") {
                e.status = res[1]
                e.statusKind = "err"
            } else {
                e.status = fileName(path) + ": " + toString(len(res[0])) + " знахідок"
                e.statusKind = "ok"
            }
            changed = true
        }
        k = k - 1
    }
    return changed
}

// Замінити проблеми одного розширення для одного файла.
func setExtProblems(source, path, found) {
    var keep = []
    for p in app.problems {
        if (!(p[4] == source && p[0] == path)) { append(keep, p) }
    }
    for f in found {
        var msg = f[2]
        if (f[3] != "") { msg = msg + " [" + f[3] + "]" }
        append(keep, [path, f[0], msg, f[1], source])
    }
    app.problems = keep
    syncMarks()
}

// Позначки проблем на жолобі відкритих редакторів.
func syncMarks() {
    for p in mapKeys(app.editors) {
        var marks = []
        for pr in app.problems {
            if (pr[0] == p && pr[1] >= 0) { append(marks, [pr[1], pr[3]]) }
        }
        mapGet(app.editors, p).marks = marks
    }
}

func extAction(id) {
    if (id == "ext.reload") {
        reloadExtensions()
        setStatus("Розширень: " + toString(len(app.exts)))
        return
    }
    if (id == "ext.new") {
        openDialog("Нове розширення: назва", "", "newext")
        return
    }
    if (startsWith(id, "ext.toggle:")) {
        var e = _extById(substring(id, 11, len(id) - 11))
        if (e == null) { return }
        e.enabled = !e.enabled
        var off = []
        for x in app.cfg.extOff { if (x != e.id) { append(off, x) } }
        if (!e.enabled) {
            append(off, e.id)
            // його проблеми - геть
            var keep = []
            for p in app.problems { if (p[4] != e.name) { append(keep, p) } }
            app.problems = keep
            syncMarks()
            e.status = ""
        } else if (app.current != "") { lintFile(app.current) }
        app.cfg.extOff = off
        saveSettings()
        return
    }
    if (startsWith(id, "ext.open:")) {
        var e2 = _extById(substring(id, 9, len(id) - 9))
        if (e2 == null) { return }
        // вбудоване - не правимо на місці (тека встановлення IDE): своя копія
        // в «розширення» з тим самим id замінює вбудоване
        if (e2.builtIn) {
            var copyDir = userExtDir() + "/" + e2.id
            if (!dirExists(copyDir)) {
                if (!dirExists(userExtDir())) { makeDir(userExtDir()) }
                makeDir(copyDir)
                for f in listDir(e2.dir) {
                    if (fileExists(e2.dir + "/" + f)) { copyFile(e2.dir + "/" + f, copyDir + "/" + f) }
                }
            }
            reloadExtensions()
            e2 = _extById(substring(id, 9, len(id) - 9))
            setStatus("Відкрито свою копію розширення (вбудоване лишається недоторканим)")
        }
        if (e2.lintScript != "" && fileExists(e2.dir + "/" + e2.lintScript)) { openPath(e2.dir + "/" + e2.lintScript) }
        openPath(e2.dir + "/extension.json")
        return
    }
    if (startsWith(id, "extcmd:")) {
        var rest = substring(id, 7, len(id) - 7)
        var sep = indexOf(rest, ":")
        var e3 = _extById(substring(rest, 0, sep))
        if (e3 == null) { return }
        var cid = substring(rest, sep + 1, len(rest) - sep - 1)
        for c in e3.commands {
            if (c[0] == cid) {
                app.panelOpen = true
                app.panelTab = "terminal"
                app.focus = "terminal"
                if (app.term.running) { termStop(app.term) }
                termExec(app.term, "nx \"" + e3.dir + "/" + c[2] + "\" \"" + app.dir + "\" \"" + app.active + "\"")
            }
        }
    }
}

func drawTabs(x, y, w) {
    surfaceRect(S, x, y, w, TABS_H, C_PANEL2)
    uiRegion("tabs", x, y, w, TABS_H)
    var tx = x
    for path in app.tabs {
        var name = fileName(path)
        var tw = textWidth(name, 14) + 64
        var on = path == app.active
        var bg = C_PANEL2
        if (on) { bg = C_BG }
        else if (uiHover(tx, y, tw, TABS_H)) { bg = C_PANEL }
        surfaceRect(S, tx, y, tw, TABS_H, bg)
        if (on) { surfaceRect(S, tx, y, tw, 2, C_ACCENT) }
        surfaceRect(S, tx + tw - 1, y + 6, 1, TABS_H - 12, C_BORDER)
        iconFileKind(fileKind(path), tx + 10, y + 8, 18, C_DIM)
        var col = C_SUBTEXT
        if (on) { col = C_TEXT }
        surfaceText(S, name, tx + 34, y + 10, 14, col)
        uiRegion("tab:" + path, tx, y, tw, TABS_H)
        // "●" незбережене, "×" - закрити (під мишею)
        var bx = tx + tw - 24
        if (uiHover(bx, y + 7, 20, 20)) {
            surfaceRoundRect(S, bx, y + 7, 20, 20, 4, C_SURFACE2)
            surfaceLine(S, bx + 6, y + 13, bx + 13, y + 20, C_TEXT, 2)
            surfaceLine(S, bx + 13, y + 13, bx + 6, y + 20, C_TEXT, 2)
        } else if (_isDirty(path)) {
            surfaceCircle(S, bx + 10, y + 17, 4, C_SUBTEXT)
        } else if (on || uiHover(tx, y, tw, TABS_H)) {
            surfaceLine(S, bx + 6, y + 13, bx + 13, y + 20, C_DIM, 2)
            surfaceLine(S, bx + 13, y + 13, bx + 6, y + 20, C_DIM, 2)
        }
        uiRegion("tabclose:" + path, bx, y + 7, 20, 20)
        tx = tx + tw
        if (tx > x + w) { break }
    }
}

func drawWelcome(x, y, w, h) {
    surfaceRect(S, x, y, w, h, C_BG)
    var cx = x + toInt(w / 2)
    var t1 = "Nyx IDE"
    surfaceText(S, t1, cx - toInt(textWidth(t1, 32, true) / 2), y + 60, 32, C_TEXT, true)
    var t2 = "Програмування блоками і кодом мовою NyxilumLang"
    surfaceText(S, t2, cx - toInt(textWidth(t2, 16) / 2), y + 104, 16, C_SUBTEXT)
    var bw = 260
    var bx = cx - toInt(bw / 2)
    var by = y + 150
    if (app.cfg.blocks) {
        uiButton("newblocks", "+ Нова програма з блоків", bx, by, bw, 36, "normal")
        by = by + 46
    }
    uiButton("newcode", "+ Нова програма кодом", bx, by, bw, 36, "normal")
    if (app.cfg.lessons) { uiButton("act:learn", "Уроки й приклади", bx, by + 46, bw, 36, "primary") }
    var t3 = "Ctrl+Shift+P - усі команди    Ctrl+P - відкрити файл"
    surfaceText(S, t3, cx - toInt(textWidth(t3, 14) / 2), by + 152, 14, C_DIM)
}

func layoutConsoleH(H) {
    var maxH = H - TITLE_H - STATUS_H - TABS_H - 120
    app.consoleH = clamp(app.consoleH, 90, max(90, maxH))
    return app.consoleH
}

func drawPanel(x, y, w, h) {
    surfaceRect(S, x, y, w, h, C_PANEL2)
    surfaceRect(S, x, y, w, 1, C_BORDER)
    uiRegion("panel", x, y, w, h)
    var tabs = [["console", "КОНСОЛЬ"], ["problems", "ПРОБЛЕМИ"], ["vars", "ЗМІННІ"], ["terminal", "ТЕРМІНАЛ"]]
    var tx = x + 10
    for t in tabs {
        var label = t[1]
        if (t[0] == "problems" && len(app.problems) > 0) { label = label + " " + toString(len(app.problems)) }
        var lw = textWidth(label, 14) + 16
        var on = app.panelTab == t[0]
        var col = C_DIM
        if (on) { col = C_TEXT }
        surfaceText(S, label, tx + 8, y + 8, 14, col, on)
        if (on) { surfaceRect(S, tx + 8, y + PANEL_HEAD_H - 3, lw - 16, 2, C_ACCENT) }
        uiRegion("ptab:" + t[0], tx, y, lw, PANEL_HEAD_H)
        tx = tx + lw + 6
    }
    if (app.con.running) {
        surfaceCircle(S, tx + 14, y + 15, 5, C_GREEN)
        surfaceText(S, "програма працює", tx + 26, y + 8, 14, C_GREEN)
    }
    uiButton("panel.toggle", "×", x + w - 34, y + 3, 26, 24, "flat")
    var by = y + PANEL_HEAD_H
    var bh = h - PANEL_HEAD_H
    if (app.panelTab == "console") { conDraw(app.con, x, by, w - 34, bh) }
    else if (app.panelTab == "vars") { drawVars(x, by, w, bh) }
    else if (app.panelTab == "terminal") {
        app.term.focused = app.focus == "terminal" && app.dialog == null && app.palette == null
        termDraw(app.term, x, by, w - 34, bh)
    }
    else { drawProblems(x, by, w, bh) }
}

// "ЗМІННІ": значення змінних у паузі покрокового запуску.
func drawVars(x, y, w, h) {
    surfaceRect(S, x, y, w, h, C_PANEL2)
    var con = app.con
    if (!con.paused) {
        var t = "Натисни «Крок за кроком» (F10) - програма зупинятиметься на кожному рядку, а тут буде видно змінні."
        if (con.running && con.debug) { t = "Програма виконується… (зупиниться на точці зупинки)" }
        var ty = y + 8
        for l in wrapLines(t, w - 28, 14) {
            surfaceText(S, l, x + 14, ty, 14, C_DIM)
            ty = ty + 18
        }
        return
    }
    surfaceClip(S, x, y, w, h)
    var where = "Функція " + con.pauseFunc + ", рядок " + toString(con.pauseLine + 1)
    surfaceText(S, where, x + 14, y + 6, 14, C_YELLOW, true)
    var cy = y + 30
    var col1 = x + 30
    var col2 = x + 30 + min(220, toInt(w * 0.25))
    var sections = [["Змінні функції", con.locals], ["Глобальні", con.globals]]
    for sec in sections {
        if (len(sec[1]) == 0) { continue }
        surfaceText(S, sec[0], x + 14, cy, 13, C_SUBTEXT, true)
        cy = cy + 20
        for v in sec[1] {
            surfaceText(S, uiFit(toString(v[0]), col2 - col1 - 10, 14), col1, cy, 14, C_ACCENT)
            var tw = surfaceText(S, "= " + uiFit(toString(v[1]), w - (col2 - x) - 140, 14), col2, cy, 14, C_TEXT)
            surfaceText(S, toString(v[2]), col2 + tw + 14, cy + 1, 12, C_DIM)
            cy = cy + 18
        }
        cy = cy + 6
    }
    if (len(con.locals) == 0 && len(con.globals) == 0) { surfaceText(S, "Змінних ще немає.", x + 14, cy, 14, C_DIM) }
    surfaceUnclip(S)
}

// Проблема: [файл, рядок (0-based, -1 - невідомо), повідомлення, вид "error"/"warning"/"info", джерело]
func drawProblems(x, y, w, h) {
    surfaceRect(S, x, y, w, h, C_PANEL2)
    if (len(app.problems) == 0) {
        surfaceText(S, "Проблем не знайдено.", x + 14, y + 8, 14, C_DIM)
        return
    }
    surfaceClip(S, x, y, w, h)
    var ry = y + 4
    var i = 0
    while (i < len(app.problems) && ry < y + h) {
        var p = app.problems[i]
        if (uiHover(x, ry, w, 22)) { surfaceRect(S, x, ry, w, 22, C_BG) }
        var col = C_RED
        if (p[3] == "warning") { col = C_YELLOW }
        if (p[3] == "info") { col = C_ACCENT }
        surfaceCircle(S, x + 18, ry + 11, 5, col)
        var where = fileName(p[0])
        if (p[1] >= 0) { where = where + ":" + toString(p[1] + 1) }
        var sx = surfaceText(S, where, x + 32, ry + 4, 14, C_SUBTEXT)
        surfaceText(S, uiFit(p[2], w - sx - 160, 14), x + 44 + sx, ry + 4, 14, C_TEXT)
        if (p[4] != "") { surfaceText(S, p[4], x + w - 12 - textWidth(p[4], 12), ry + 5, 12, C_DIM) }
        uiRegion("prob:" + toString(i), x, ry, w, 22)
        ry = ry + 22
        i = i + 1
    }
    surfaceUnclip(S)
}

func drawStatus(W, H) {
    var y = H - STATUS_H
    var bg = 0x2c5aa0
    if (app.con.running) { bg = 0xb5651d }
    if (app.con.running && app.con.paused) { bg = 0x8a6d1f }
    surfaceRect(S, 0, y, W, STATUS_H, bg)
    var fg = 0xffffff
    var x = 10
    // гілка git (клік - панель Git)
    if (app.git.isRepo) {
        iconBranch(x, y + 3, 18, fg)
        var gw = surfaceText(S, app.git.branch, x + 22, y + 5, 14, fg)
        if (len(app.git.files) > 0) { gw = gw + surfaceText(S, "*", x + 24 + gw, y + 5, 14, fg) }
        uiRegion("status.git", 0, y, x + 30 + gw, STATUS_H)
        x = x + 40 + gw
    }
    var xp = x
    var errs = 0
    var warns = 0
    for p in app.problems {
        if (p[3] == "error") { errs = errs + 1 }
        if (p[3] == "warning") { warns = warns + 1 }
    }
    // "×N  !N" - кількість проблем (клік - нижня панель "Проблеми")
    surfaceLine(S, x, y + 8, x + 8, y + 16, fg, 2)
    surfaceLine(S, x + 8, y + 8, x, y + 16, fg, 2)
    x = x + 14 + surfaceText(S, toString(errs), x + 14, y + 5, 14, fg)
    surfaceText(S, "!", x + 10, y + 5, 14, fg, true)
    x = x + 22 + surfaceText(S, toString(warns), x + 22, y + 5, 14, fg)
    uiRegion("status.problems", xp - 6, y, x + 16 - xp, STATUS_H)
    if (app.status != "" && timeMs() - app.statusTime < 4000) {
        surfaceText(S, uiFit(app.status, W - x - 480, 14), x + 24, y + 5, 14, fg)
    } else if (app.con.running && app.con.paused) {
        surfaceText(S, "Пауза: рядок " + toString(app.con.pauseLine + 1) + "   F10 крок · F11 всередину · F5 далі", x + 24, y + 5, 14, fg)
    } else if (app.con.running) {
        surfaceText(S, "Програма працює…", x + 24, y + 5, 14, fg)
    }
    // праворуч: позиція, відступи, кодування, мова
    var right = []
    var ed = currentEditor()
    if (app.active != "" && fileKind(app.active) == "blocks") {
        append(right, "Блоки")
    } else if (ed != null && app.active != "") {
        append(right, "Рядок " + toString(ed.cy + 1) + ", стовпчик " + toString(ed.cx + 1))
        append(right, "Пробіли: 4")
        append(right, "UTF-8")
        if (ed.plain) { append(right, "Текст") } else { append(right, "NyxilumLang") }
    }
    var rx = W - 12
    var k = len(right) - 1
    while (k >= 0) {
        var tw = textWidth(right[k], 14)
        rx = rx - tw
        surfaceText(S, right[k], rx, y + 5, 14, fg)
        rx = rx - 22
        k = k - 1
    }
}

// Шрифт інтерфейсу й шрифт коду (налаштування «Піксельний шрифт»).
func uiFontSans() {
    if (app.cfg != null && app.cfg.pixelFont) { surfaceFont("pixel") } else { surfaceFont("sans") }
}

var SIDE_CUR = 0
var HEADLESS = osEnv("NX_HEADLESS") == "1"
var SIDE_FULL = 0

// Шторка шириною SIDE_CUR (поки виїжджає - видно її праву частину).
func _drawSideSlide(bodyY, bodyH) {
    if (SIDE_CUR <= 0 || app.sideLast == "") { return }
    var view = app.side
    if (view == "") { view = app.sideLast }
    var saved = app.side
    app.side = view
    surfaceClip(S, ACT_W, bodyY, SIDE_CUR, bodyH)
    drawSidebar(ACT_W - (SIDE_FULL - SIDE_CUR), bodyY, SIDE_FULL, bodyH)
    surfaceUnclip(S)
    app.side = saved
    if (app.cfg.sideOverlay) {
        // тінь праворуч від шторки над кодом
        var k = 0
        while (k < 8) {
            surfaceRect(S, ACT_W + SIDE_CUR + k, bodyY, 1, bodyH, (0x30 - k * 6) * 16777216)
            k = k + 1
        }
    }
    if (app.side != "") {
        uiRegion("sash.side", ACT_W + SIDE_CUR - 3, bodyY, 7, bodyH)
        if (uiHover(ACT_W + SIDE_CUR - 3, bodyY, 7, bodyH) || app.drag == "side") {
            surfaceRect(S, ACT_W + SIDE_CUR - 1, bodyY, 2, bodyH, C_ACCENT)
        }
    }
}

func draw() {
    var W = surfaceWidth(S)
    var H = surfaceHeight(S)
    uiBegin()
    app.tooltip = ""
    // шрифт інтерфейсу: згладжений Noto Sans (код - Noto Sans Mono, див. edDraw)
    uiFontSans()
    surfaceClear(S, C_BG)
    drawTitleBar(W)
    var bodyY = TITLE_H
    var bodyH = H - TITLE_H - STATUS_H
    drawActivityBar(bodyY, bodyH)

    // шторка: плавно виїжджає/ховається (t 0..1); "поверх коду" - не
    // стискає редактор, малюється в кінці над ним
    if (app.side != "") { app.sideLast = app.side }
    var fullW = clamp(app.sideW, 160, max(160, W - ACT_W - 300))
    var open = 0
    if (app.side != "") { open = 1 }
    var t = open
    // без вікна (тести) - без анімації: клік одразу туди, де шторка буде
    if (app.cfg.anim && !HEADLESS) { t = uiAnim("sidebar", open, 170) }
    // повільніше на початку й у кінці (як висувна шухляда)
    var ease = t * t * (3 - 2 * t)
    SIDE_CUR = toInt(fullW * ease)
    SIDE_FULL = fullW
    var sideW = 0
    if (!app.cfg.sideOverlay) {
        sideW = SIDE_CUR
        _drawSideSlide(bodyY, bodyH)
    }
    var ex = ACT_W + sideW
    var ew = W - ex
    LEFT_W = ex
    var panelH = 0
    if (app.panelOpen) { panelH = layoutConsoleH(H) }
    var tabsY = bodyY
    var edY = tabsY + TABS_H
    var edH = bodyH - TABS_H - panelH

    syncDebugView()
    // сцена з'являється сама, щойно програма щось намалювала
    if (app.con.running && !app.stageOpen && fileExists(stageFrame())) {
        app.stageOpen = true
        // як у Scratch: на вузькому екрані бічна панель ховається, поки працює сцена
        if (W < 1500 && app.side != "") {
            app.sideBeforeStage = app.side
            app.side = ""
        }
    }
    // програма зупинилась - бічна панель повертається
    if (!app.con.running && app.sideBeforeStage != "-") {
        if (app.side == "") { app.side = app.sideBeforeStage }
        app.sideBeforeStage = "-"
    }
    var stageW = 0
    if (app.stageOpen) {
        stageW = clamp(toInt(ew * 0.4), 260, 560)
        ew = ew - stageW
    }
    if (len(app.tabs) == 0) {
        drawWelcome(ex, bodyY, ew, bodyH - panelH)
    } else {
        drawTabs(ex, tabsY, ew)
        if (app.mode == "blocks") {
            var ws = currentBlocks()
            if (ws != null) { blocksDraw(ws, ex, edY, ew, edH, blocksTitle(ws)) }
        } else {
            var ed = currentEditor()
            var edFocus = app.focus == "editor" && app.dialog == null && app.palette == null
            if (ed != null && app.split != "" && mapHas(app.editors, app.split) && ew >= 500) {
                drawSplit(ed, ex, edY, ew, edH, edFocus)
            } else if (ed != null) { edDraw(ed, ex, edY, ew, edH, edFocus) }
        }
    }
    if (app.stageOpen) { drawStage(ex + ew, bodyY, stageW, bodyH - panelH) }
    if (app.panelOpen) {
        drawPanel(ex, bodyY + bodyH - panelH, ew + stageW, panelH)
        uiRegion("split", ex, bodyY + bodyH - panelH - 3, ew + stageW, 7)
    }
    drawStatus(W, H)
    if (app.cfg.sideOverlay) { _drawSideSlide(bodyY, bodyH) }
    if (app.tooltip != "" && app.palette == null && app.dialog == null) { uiTooltip(app.tooltip) }
    if (app.offer != null && app.tour < 0 && app.palette == null && app.dialog == null) { drawOffer(W, H) }
    else if ((app.updInfo != null || app.updDone) && app.tour < 0 && app.palette == null && app.dialog == null && !app.askLevel) { drawUpdateBanner(W, H) }
    if (app.ctx != null) { drawCtx() }
    if (app.palette != null) { drawCmdPalette() }
    if (app.dialog != null) { drawDialog() }
    if (app.fpick != null) { drawFolderPick() }
    if (app.askLevel) { drawLevelAsk(W, H) }
    if (app.tour >= 0) { drawTour(app.tour) }
    if (app.demo != null) { drawDemoCursor() }
    drawDragGhost()
    drawConfetti()
    surfacePresent(S)
}

// ---------- події ----------

func toggleSide(view) {
    if (app.side == view) { app.side = "" } else {
        app.side = view
        app.sideScroll = 0
        if (view == "history") {
            app.histSel = -1
            loadHistory()
            offerOnce("history")
        }
        if (view == "ext") { offerOnce("ext") }
        if (view == "search") { app.focus = "search" }
        if (view == "files") { refreshFiles() }
    }
}

func doAction(id) {
    if (id == "run") { runCurrent() }
    else if (id == "debug") { runWith("step") }
    else if (id == "dbg.cont") { conDebug(app.con, "c") }
    else if (id == "dbg.over") { conDebug(app.con, "n") }
    else if (id == "dbg.into") { conDebug(app.con, "s") }
    else if (id == "dbg.out") { conDebug(app.con, "o") }
    else if (id == "stop") { conStop(app.con) }
    else if (id == "save") {
        saveAll()
        setStatus("Збережено √")
    }
    else if (id == "btogglecode") {
        var ws = currentBlocks()
        if (ws != null && app.mode == "blocks") { ws.showCode = !ws.showCode }
    }
    else if (id == "bopencode") { if (app.mode == "blocks") { blocksToCode() } }
    else if (id == "codetoblocks") { codeToBlocksFile(app.current) }
    else if (id == "split.close") { app.split = "" }
    else if (startsWith(id, "ext.") || startsWith(id, "extcmd:")) { extAction(id) }
    else if (startsWith(id, "git.")) { gitAction(id) }
    else if (startsWith(id, "upd.")) { updateAction(id) }
    else if (id == "terminal") {
        app.panelOpen = true
        app.panelTab = "terminal"
        app.focus = "terminal"
    }
    else if (id == "split.toggle") { toggleSplit() }
    else if (id == "gotodef") { if (app.mode == "code") { goToDefinition() } }
    else if (id == "renamesym") { if (app.mode == "code") { askRenameSymbol() } }
    else if (id == "bnewblock") { if (currentBlocks() != null) { openDialog("Новий блок", "", "newblock") } }
    else if (id == "bclear") {
        var ws2 = currentBlocks()
        if (ws2 != null) {
            blocksClear(ws2)
            setStatus("Почали спочатку (Ctrl+Z - повернути блоки)")
        }
    }
    else if (id == "newcode") { startEntry("newfile", targetDir(), freeName("code") + ".nx", "") }
    else if (id == "newblocks") { startEntry("newfile", targetDir(), freeName("blocks") + ".nxb", "") }
    else if (id == "con.clear") { conClear(app.con) }
    else if (id == "dialog.ok") { closeDialog(true) }
    else if (id == "dialog.cancel") { closeDialog(false) }
    else if (startsWith(id, "act:")) { toggleSide(substring(id, 4, len(id) - 4)) }
    else if (id == "side.collapse") { app.side = "" }
    else if (id == "stage.close") {
        app.stageOpen = false
        if (app.focus == "stage") { app.focus = "editor" }
    }
    else if (id == "stage.toggle") { app.stageOpen = !app.stageOpen }
    else if (id == "side.toggle") {
        if (app.side == "") { app.side = "files" } else { app.side = "" }
    }
    else if (id == "panel.toggle") { app.panelOpen = !app.panelOpen }
    else if (startsWith(id, "ptab:")) {
        app.panelTab = substring(id, 5, len(id) - 5)
        if (app.panelTab == "terminal") { app.focus = "terminal" }
    }
    else if (id == "status.git") {
        app.side = "git"
        app.git.stale = true
    }
    else if (id == "status.problems") {
        app.panelOpen = true
        app.panelTab = "problems"
    }
    else if (startsWith(id, "prob:")) {
        var p = app.problems[toInt(substring(id, 5, len(id) - 5))]
        if (fileExists(p[0])) {
            openPath(p[0])
            var ed = currentEditor()
            if (ed != null && p[1] >= 0 && app.mode == "code") { edGoToLine(ed, p[1]) }
        }
    }
    else if (id == "cmd.open") { openPalette("commands") }
    else if (id == "quickopen") { openPalette("files") }
    else if (id == "openfolder") { openFolderPicker() }
    else if (startsWith(id, "folder:")) { openFolder(substring(id, 7, len(id) - 7)) }
    else if (startsWith(id, "fp.")) { fpickAction(id) }
    else if (id == "ex.openfolder") { openFolderPicker() }
    else if (startsWith(id, "pal:")) {
        var it = app.palette.items[toInt(substring(id, 4, len(id) - 4))]
        app.palette = null
        doAction(it[0])
    }
    else if (id == "closetab") { if (app.active != "") { closeTab(app.active) } }
    else if (startsWith(id, "tabclose:")) { closeTab(substring(id, 9, len(id) - 9)) }
    else if (startsWith(id, "tab:")) { openPath(substring(id, 4, len(id) - 4)) }
    else if (startsWith(id, "dir:")) {
        var d = substring(id, 4, len(id) - 4)
        app.exSel = d
        app.exFocus = true
        if (mapHas(app.expanded, d)) { mapRemove(app.expanded, d) } else { mapSet(app.expanded, d, true) }
        refreshFiles()
    }
    else if (startsWith(id, "sres:")) {
        var r = app.searchResults[toInt(substring(id, 5, len(id) - 5))]
        openPath(r[0])
        var ed2 = currentEditor()
        if (ed2 != null && app.mode == "code") { edGoToLine(ed2, r[1]) }
    }
    else if (id == "find") {
        var ed3 = currentEditor()
        if (ed3 != null && app.mode == "code") { ed3.findOpen = true }
    }
    else if (id == "zoomin" || id == "zoomout") {
        var ed4 = currentEditor()
        var dz = 1
        if (id == "zoomout") { dz = -1 }
        if (ed4 != null) { edZoom(ed4, dz) }
    }
    else if (startsWith(id, "h.")) { historyAction(id) }
    else if (id == "t.next") { tourGo(app.tour + 1) }
    else if (id == "t.prev") { tourGo(app.tour - 1) }
    else if (id == "t.skip") { endTour() }
    else if (startsWith(id, "g.")) { guideAction(id) }
    else if (startsWith(id, "file:")) {
        app.exSel = substring(id, 5, len(id) - 5)
        openPath(app.exSel)
        app.exFocus = true
    }
    else if (id == "ex.newfile" || id == "ex.newfile2") { startEntry("newfile", targetDir(), "", "") }
    else if (id == "ex.newdir") { startEntry("newdir", targetDir(), "", "") }
    else if (id == "ex.refresh") {
        refreshFiles()
        setStatus("Оновлено")
    }
    else if (id == "ex.collapse") {
        app.expanded = newMap()
        refreshFiles()
    }
    else if (startsWith(id, "ctx:")) { ctxAction(substring(id, 4, len(id) - 4)) }
    else if (startsWith(id, "offer.")) { offerAction(id) }
    else if (startsWith(id, "set.")) { settingsAction(id) }
    else if (startsWith(id, "level:")) { applyLevel(substring(id, 6, len(id) - 6), true) }
}

func onMouseDown(e) {
    uiMouseX = e.x
    uiMouseY = e.y
    var id = uiHit(e.x, e.y)
    if (app.tour >= 0 && !_synthetic) {
        // під час екскурсії працюють лише її кнопки
        if (startsWith(id, "t.")) { uiPressedId = id }
        return
    }
    if (app.askLevel) {
        if (startsWith(id, "level:")) { uiPressedId = id }
        return
    }
    if (app.dialog != null && !startsWith(id, "dialog.")) { return }
    if (app.fpick != null) {
        if (startsWith(id, "fp.") && id != "fp.bg" && id != "fp.box" && id != "fp.list") {
            // клік по теці - вибрати; другий клік по вибраній - зайти
            if (startsWith(id, "fp.item:")) {
                var fi = toInt(substring(id, 8, len(id) - 8))
                if (fi != app.fpick.sel) {
                    app.fpick.sel = fi
                    return
                }
            }
            uiPressedId = id
        } else if (id == "fp.bg") { fpickAction("fp.cancel") }
        return
    }
    // шторка поверх коду: клік повз неї - сховати (і клік іде далі, як завжди)
    if (app.cfg.sideOverlay && app.side != "" && e.x > ACT_W + SIDE_CUR + 3 && app.palette == null) { app.side = "" }
    if (app.palette != null) {
        if (startsWith(id, "pal:")) { uiPressedId = id }
        else if (id != "pal.box") { app.palette = null }
        return
    }
    if (app.ctx != null) {
        if (startsWith(id, "ctx:")) { uiPressedId = id }
        else if (id != "ctx.box") { app.ctx = null }
        return
    }
    // клік повз поле нового файла/перейменування - як у VS Code, прийняти
    if (app.entry != null && !_synthetic) { commitEntry() }
    // права кнопка в Провіднику - меню
    if (e.button == 3) {
        if (startsWith(id, "file:")) {
            openCtx(substring(id, 5, len(id) - 5), e.x, e.y)
            return
        }
        if (startsWith(id, "dir:")) {
            openCtx(substring(id, 4, len(id) - 4), e.x, e.y)
            return
        }
        if (id == "ex.empty") {
            openCtx("", e.x, e.y)
            return
        }
    }

    // подвійний/потрійний клік: те саме місце (±4 px) протягом 400 мс
    if (timeMs() - app.lastClickTime < 400 && abs(e.x - app.lastClickX) < 5 && abs(e.y - app.lastClickY) < 5) {
        app.clickCount = app.clickCount + 1
    } else { app.clickCount = 1 }
    app.lastClickTime = timeMs()
    app.lastClickX = e.x
    app.lastClickY = e.y

    var bws = currentBlocks()
    if (app.mode == "blocks" && bws != null && app.active != "" && (startsWith(id, "b") || len(bws.menu) > 0)) {
        if (blocksMouseDown(bws, e, id)) {
            app.focus = "blocks"
            app.con.focused = false
            return
        }
    }

    // середня кнопка по вкладці - закрити
    if (e.button == 2 && startsWith(id, "tab:")) {
        closeTab(substring(id, 4, len(id) - 4))
        return
    }
    if (e.button != 1) { return }
    // кандидат на перетягування: вкладка чи файл/тека Провідника
    app.dragActive = false
    app.dragSrc = ""
    if (startsWith(id, "tab:")) {
        app.dragSrc = substring(id, 4, len(id) - 4)
        app.dragKind = "tab"
    } else if (startsWith(id, "file:") || startsWith(id, "dir:")) {
        app.dragSrc = substring(id, indexOf(id, ":") + 1, len(id) - indexOf(id, ":") - 1)
        app.dragKind = "file"
    }
    app.dragX = e.x
    app.dragY = e.y
    var ed = currentEditor()
    if (id == "editor2" && ed != null && app.split != "") {
        focusSplitPane()
        ed = currentEditor()
        id = "editor"
    }
    if (id == "editor" && ed != null) {
        app.focus = "editor"
        ed.acOpen = false
        app.con.focused = false
        var pos = edPosAt(ed, e.x, e.y)
        var shift = e.shift == true
        if (shift) {
            if (ed.ay < 0) {
                ed.ay = ed.cy
                ed.ax = ed.cx
            }
        } else { ed.ay = -1 }
        ed.cy = pos[0]
        ed.cx = pos[1]
        ed.wantCol = ed.cx
        app.exFocus = false
        if (e.ctrl == true && app.clickCount == 1) {
            // Ctrl+клік - до визначення (як у VS Code)
            ed.ay = -1
            goToDefinition()
        }
        else if (app.clickCount == 2) { edSelectWord(ed) }
        else if (app.clickCount >= 3) {
            ed.ay = ed.cy
            ed.ax = 0
            ed.cx = len(ed.lines[ed.cy])
        } else {
            if (!shift) {
                ed.ay = ed.cy
                ed.ax = ed.cx
            }
            app.drag = "editor"
        }
        return
    }
    if (id == "gutter" && ed != null) {
        edToggleBreakAt(ed, e.y)
        if (app.con.running && app.con.debug && app.dbgPath == ed.path) { conSetBreaks(app.con, edBreakLines(ed)) }
        return
    }
    if (id == "stage.frame") {
        app.focus = "stage"
        app.con.focused = false
        stageMouse("down", e)
        return
    }
    if (app.focus == "stage" && id != "stage.panel") { app.focus = "editor" }
    if (id == "split") {
        app.drag = "split"
        return
    }
    if (id == "sash.side") {
        app.drag = "side"
        return
    }
    if (id == "term.area") {
        app.focus = "terminal"
        app.con.focused = false
        termMouseDown(app.term, e.x, e.y)
        app.drag = "term"
        return
    }
    if (id == "con.input") {
        app.focus = "console"
        app.con.focused = true
        return
    }
    if (id == "search.input") {
        app.focus = "search"
        return
    }
    if (app.focus == "search") { app.focus = "editor" }
    uiPressedId = id
}

func onMouseUp(e) {
    if (app.focus == "stage" && stageMouse("up", e)) { return }
    var bws = currentBlocks()
    if (app.mode == "blocks" && bws != null && app.active != "") { blocksMouseUp(bws, e) }
    var id = uiHit(e.x, e.y)
    if (app.dragActive && app.dragKind == "file") { dropFile(app.dragSrc, dropTarget(id)) }
    else if (uiPressedId != "" && id == uiPressedId) { doAction(id) }
    uiPressedId = ""
    if (app.drag == "term") { termMouseUp(app.term) }
    // ширину шторки - запам'ятати для всіх тек
    if (app.drag == "side" && app.cfg.sideW != app.sideW) {
        app.cfg.sideW = app.sideW
        saveSettings()
    }
    app.drag = ""
    app.dragSrc = ""
    app.dragActive = false
}

// Тека, куди впаде файл, якщо відпустити над областю id ("" - нікуди).
func dropTarget(id) {
    if (startsWith(id, "dir:")) { return substring(id, 4, len(id) - 4) }
    if (startsWith(id, "file:")) { return parentDir(substring(id, 5, len(id) - 5)) }
    if (id == "ex.empty") { return app.dir }
    return ""
}

// Перенести файл чи теку src у теку dir (як перетягування в VS Code).
func dropFile(src, dir) {
    if (dir == "" || src == "" || dir == parentDir(src) || dir == src || startsWith(dir, src + "/")) { return }
    var to = joinPath(dir, fileName(src))
    if (fileExists(to) || dirExists(to)) {
        setStatus("У «" + fileName(dir) + "» вже є «" + fileName(src) + "»")
        return
    }
    saveAll()
    try { movePath(src, to) } catch (err) {
        setStatus("Не вдалося перенести: " + toString(err))
        return
    }
    _renameOpen(src, to)
    if (dir != app.dir) { mapSet(app.expanded, dir, true) }
    if (app.exSel == src) { app.exSel = to }
    refreshFiles()
    app.git.stale = true
    setStatus("Перенесено «" + fileName(src) + "» у «" + fileName(dir) + "»")
}

// Поки тягнемо: назва біля курсора й підсвічена тека-ціль.
func drawDragGhost() {
    if (!app.dragActive) { return }
    if (app.dragKind == "file") {
        var t = dropTarget(uiHit(uiMouseX, uiMouseY))
        if (t != "" && t != parentDir(app.dragSrc) && t != app.dragSrc && !startsWith(t, app.dragSrc + "/")) {
            var r = uiFind("dir:" + t)
            if (r == null) { r = uiFind("ex.empty") }
            if (r != null) { surfaceRectLine(S, r[0] + 2, r[1], r[2] - 4, r[3], C_ACCENT, 2) }
        }
    }
    var name = fileName(app.dragSrc)
    var w = textWidth(name, 14) + 20
    surfaceRoundRect(S, uiMouseX + 14, uiMouseY + 8, w, 26, 6, C_SURFACE2 + 0xdd000000)
    surfaceText(S, name, uiMouseX + 24, uiMouseY + 13, 14, C_TEXT)
}

func onMouseMove(e) {
    uiMouseX = e.x
    uiMouseY = e.y
    // перетягування вкладки / файла почалось (зсув > 6 пікселів)
    if (app.dragSrc != "" && !app.dragActive && abs(e.x - app.dragX) + abs(e.y - app.dragY) > 6) {
        app.dragActive = true
        uiPressedId = ""
    }
    if (app.dragActive && app.dragKind == "tab") {
        // вкладка під мишею - туди й переставляємо
        var over = uiHit(e.x, e.y)
        if (startsWith(over, "tab:") || startsWith(over, "tabclose:")) {
            var tp = substring(over, indexOf(over, ":") + 1, len(over) - indexOf(over, ":") - 1)
            var from = indexOf(app.tabs, app.dragSrc)
            var to = indexOf(app.tabs, tp)
            if (from >= 0 && to >= 0 && from != to) {
                removeAt(app.tabs, from)
                insert(app.tabs, to, app.dragSrc)
            }
        }
    }
    if (app.stageOpen && app.con.running) { stageMouse("move", e) }
    var bws = currentBlocks()
    if (app.mode == "blocks" && bws != null && app.active != "") { blocksMouseMove(bws, e) }
    var ed = currentEditor()
    if (app.drag == "editor" && ed != null) {
        var pos = edPosAt(ed, e.x, e.y)
        ed.cy = pos[0]
        ed.cx = pos[1]
        if (e.y < ed.y) { edScroll(ed, -1) }
        if (e.y > ed.y + ed.h) { edScroll(ed, 1) }
    }
    if (app.drag == "term") { termMouseMove(app.term, e.x, e.y) }
    if (app.drag == "split") {
        app.consoleH = surfaceHeight(S) - STATUS_H - e.y
    }
    if (app.drag == "side") {
        app.sideW = clamp(e.x - ACT_W, 160, max(160, surfaceWidth(S) - ACT_W - 300))
    }
}

func onWheel(e) {
    var id = uiHit(e.x, e.y)
    if (id == "h.diff") {
        app.histScroll = max(0, app.histScroll + e.dy * 3)
        return
    }
    if (id == "side.panel" || startsWith(id, "file:") || startsWith(id, "dir:") || startsWith(id, "sres:")) {
        app.sideScroll = max(0, app.sideScroll + e.dy * 48)
        return
    }
    var bws = currentBlocks()
    if (app.mode == "blocks" && bws != null && startsWith(id, "b")) {
        blocksWheel(bws, e)
        return
    }
    var ed = currentEditor()
    if (id == "editor2" && app.split != "" && mapHas(app.editors, app.split)) {
        var oe = mapGet(app.editors, app.split)
        if (oe == ed) { app.splitTop = clamp(app.splitTop + e.dy * 3, 0, max(0, len(ed.lines) - 3)) }
        else { edScroll(oe, e.dy * 3) }
        return
    }
    if (id == "editor" && ed != null) {
        if (e.ctrl) { edZoom(ed, -e.dy) } else { edScroll(ed, e.dy * 3) }
    } else if (id == "console") {
        app.con.scroll = max(0, app.con.scroll - e.dy * 3)
    } else if (startsWith(id, "ext.")) {
        app.extScroll = max(0, app.extScroll + e.dy * 48)
    } else if (id == "git.list") {
        app.git.listScroll = max(0, app.git.listScroll + e.dy * 48)
    } else if (id == "git.diff") {
        app.git.scroll = max(0, app.git.scroll + e.dy * 3)
    } else if (id == "term.area") {
        termScroll(app.term, -e.dy * 3)
    }
}

func onKey(e) {
    var k = e.key
    if (app.demo != null && !_synthetic) {
        if (k == "Escape") {
            app.demo = null
            setStatus("Показ зупинено")
        }
        return
    }
    if (app.askLevel) { return }
    if (app.dialog != null) {
        dialogKey(e)
        return
    }
    if (app.fpick != null) {
        fpickKey(e)
        return
    }
    if (e.ctrl && k == "o" && !e.shift) {
        openFolderPicker()
        return
    }
    if (app.palette != null) {
        paletteKey(e)
        return
    }
    if (app.entry != null) {
        entryKey(e)
        return
    }
    if (app.ctx != null && k == "Escape") {
        app.ctx = null
        return
    }
    if (app.offer != null && k == "Escape") {
        dismissOffer(false)
        return
    }
    if (app.tour >= 0) {
        if (k == "Escape") { endTour() }
        else if (k == "Right" || k == "Enter" || k == "Space") { tourGo(app.tour + 1) }
        else if (k == "Left") { tourGo(app.tour - 1) }
        return
    }
    // термінал у фокусі: його клавіші (Enter, Ctrl+C, ↑/↓...) - йому
    if (app.focus == "terminal" && app.panelOpen && app.panelTab == "terminal") {
        // Escape у vim/less/запущеній програмі - їй; біля запрошувача - назад у редактор
        var toProg = termIsPty(app.term) && app.term.vt != null && (app.term.vt.altOn || app.term.running)
        if (k == "Escape" && !toProg) {
            app.focus = "editor"
            return
        }
        if (!termSkipKey(e) && termKey(app.term, e)) { return }
    }
    if (e.ctrl && (k == "`" || k == "'")) {
        doAction("terminal")
        return
    }
    // клавіші налагодження - як у VS Code
    if (k == "F5" && e.shift) {
        conStop(app.con)
        return
    }
    if (k == "F5" || (e.ctrl && k == "r")) {
        if (app.con.running && app.con.paused) { conDebug(app.con, "c") }
        else if (app.con.running) { conStop(app.con) }
        else if (app.active != "" && fileKind(app.active) != "text") {
            // з точками зупинки - одразу в режимі "до точки зупинки"
            var ed0 = currentEditor()
            if (app.mode == "code" && ed0 != null && len(ed0.breaks) > 0) { runWith("cont") } else { runCurrent() }
        }
        return
    }
    if (k == "F10" || k == "F11") {
        if (app.con.running && app.con.paused) {
            if (k == "F10") { conDebug(app.con, "n") }
            else if (e.shift) { conDebug(app.con, "o") }
            else { conDebug(app.con, "s") }
        } else if (!app.con.running && app.active != "" && fileKind(app.active) != "text") { runWith("step") }
        return
    }
    if (e.ctrl && e.shift && k == "p") {
        openPalette("commands")
        return
    }
    if (e.ctrl && e.shift && k == "f") {
        app.side = "search"
        app.focus = "search"
        return
    }
    if (e.ctrl && k == "p") {
        openPalette("files")
        return
    }
    if (e.ctrl && k == "b") {
        doAction("side.toggle")
        return
    }
    if (e.ctrl && k == "j") {
        app.panelOpen = !app.panelOpen
        return
    }
    if (e.ctrl && k == "w") {
        doAction("closetab")
        return
    }
    // Ctrl+\ (на українській розкладці ця клавіша - «ґ»)
    if (e.ctrl && (k == "\\" || k == "ґ")) {
        toggleSplit()
        return
    }
    if (e.ctrl && k == "Tab" && len(app.tabs) > 1) {
        var i = indexOf(app.tabs, app.active)
        var step = 1
        if (e.shift) { step = len(app.tabs) - 1 }
        openPath(app.tabs[(i + step) % len(app.tabs)])
        return
    }
    if (e.ctrl && k == "s") {
        saveAll()
        setStatus("Збережено √")
        return
    }
    // F2: у Провіднику - перейменувати файл, у коді - ім'я всюди
    if (k == "F2" && app.exFocus && app.exSel != "" && app.side == "files") {
        startEntry("rename", parentDir(app.exSel), fileName(app.exSel), app.exSel)
        return
    }
    if (k == "F2" && app.mode == "code" && currentEditor() != null) {
        askRenameSymbol()
        return
    }
    if (k == "F12" && app.mode == "code" && currentEditor() != null) {
        goToDefinition()
        return
    }
    if (e.ctrl && k == "n") {
        doAction("newcode")
        return
    }
    // сцена у фокусі: клавіші - програмі (Escape - повернути фокус IDE)
    if (app.focus == "stage") {
        if (k == "Escape") { app.focus = "editor" }
        else { conStageInput(app.con, "key " + k) }
        return
    }
    if (app.focus == "search") {
        if (k == "Escape") { app.focus = "editor" }
        else if (k == "Backspace" && len(app.searchText) > 0) {
            app.searchText = uiDropLast(app.searchText)
            runSearch()
        }
        else if (k == "Enter") { runSearch() }
        return
    }
    if (app.focus == "console" && app.con.running) {
        if (k == "Escape") {
            app.focus = "editor"
            app.con.focused = false
            return
        }
        conKey(app.con, e)
        return
    }
    if (app.active == "") { return }
    if (app.mode == "blocks") {
        var bws = currentBlocks()
        if (bws != null) { blocksKey(bws, e) }
        return
    }
    var ed = currentEditor()
    // Ctrl+Z одразу після перейменування в кількох файлах - назад усюди
    if (ed != null && app.mode == "code" && e.ctrl && k == "z" && !e.shift && undoRenameGroup(ed)) { return }
    if (ed != null && app.mode == "code") { edKey(ed, e) }
}

func onText(e) {
    if (app.fpick != null) { return }
    if (app.dialog != null) {
        if (dialogIsConfirm(app.dialog)) { return }
        var newKind = app.dialog.action == "newcode" || app.dialog.action == "newblocks"
        if (!newKind || (e.text != "/" && e.text != "\\")) { app.dialog.text = app.dialog.text + e.text }
        return
    }
    if (app.entry != null) {
        if (e.text != "/" && e.text != "\\") { app.entry.text = app.entry.text + e.text }
        return
    }
    if (app.palette != null) {
        app.palette.text = app.palette.text + e.text
        app.palette.sel = 0
        refreshPalette()
        return
    }
    if (app.focus == "stage") {
        conStageInput(app.con, "text " + e.text)
        return
    }
    if (app.focus == "search") {
        app.searchText = app.searchText + e.text
        runSearch()
        return
    }
    if (app.focus == "console" && app.con.running) {
        app.con.input = app.con.input + e.text
        return
    }
    if (app.focus == "terminal" && app.panelOpen && app.panelTab == "terminal") {
        termTextInput(app.term, e.text)
        return
    }
    if (app.active == "") { return }
    if (app.mode == "blocks") {
        var bws = currentBlocks()
        if (bws != null) { blocksText(bws, e.text) }
        return
    }
    var ed = currentEditor()
    if (ed != null && app.mode == "code") {
        app.exFocus = false
        edTextInput(ed, e.text)
    }
}

func handle(e) {
    var t = e.type
    // Під час "Покажи мені" миша й клавіші людини ігноруються (крім Escape).
    if (app.demo != null && !_synthetic && t != "key") { return }
    if (t == "mousemove") { onMouseMove(e) }
    else if (t == "mousedown") { onMouseDown(e) }
    else if (t == "mouseup") { onMouseUp(e) }
    else if (t == "wheel") { onWheel(e) }
    else if (t == "key") { onKey(e) }
    else if (t == "keyup") { if (app.focus == "stage") { conStageInput(app.con, "keyup " + e.key) } }
    else if (t == "text") { onText(e) }
}

// ---------- екскурсія ----------

func startTour(firstRun) {
    app.tourFirstRun = firstRun
    app.side = "files"
    app.offer = null
    app.demo = null
    // з вимкненими блоками екскурсія - у режимі коду (кроки про блоки пропускаються)
    if (app.cfg.blocks) {
        if (app.mode != "blocks" || app.active == "") { setMode("blocks") }
    } else if (app.mode != "code" || app.active == "") { setMode("code") }
    tourGo(0)
}

// Крок екскурсії, недоречний з поточними налаштуваннями (блоки/уроки вимкнено).
func tourSkip(step) {
    var ids = TOUR[step][0]
    for id in ids {
        if (!app.cfg.blocks && (startsWith(id, "bcat") || id == "bpalette" || id == "bworkspace")) { return true }
        if (!app.cfg.lessons && id == "act:learn") { return true }
    }
    return false
}

func tourGo(step) {
    if (step < 0) { return }
    var dir = 1
    if (app.tour >= 0 && step < app.tour) { dir = -1 }
    while (step >= 0 && step < len(TOUR) && tourSkip(step)) { step = step + dir }
    if (step < 0) { return }
    if (step >= len(TOUR)) {
        endTour()
        return
    }
    app.tour = step
    app.demo = null
    app.side = "files"
    if (len(TOUR[step][3]) > 0) { startDemo(TOUR[step][3], false) }
}

func endTour() {
    app.tour = -1
    app.demo = null
    if (app.cfg.lessons) { app.side = "learn" } else { app.side = "files" }
    if (app.tourFirstRun) {
        app.guideTab = "lessons"
        openLesson(0)
    }
}

// ---------- історія версій ----------

func curPath() {
    if (app.mode == "blocks") { return app.currentB }
    return app.current
}

func curText() {
    if (app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws == null) { return "" }
        return stacksToJson(ws.stacks)
    }
    var ed = currentEditor()
    if (ed == null) { return "" }
    return edText(ed)
}

func loadHistory() {
    var file = curPath()
    app.histList = historyLoad(historyPath(app.dir, file))
    app.histCounts = []
    var prev = ""
    for v in app.histList {
        var now = readableText(file, v[2])
        append(app.histCounts, diffCounts(diffLines(prev, now)))
        prev = now
    }
    app.histDiffKey = ""
}

// Порівняння вибраної версії з поточним станом - лише коли щось змінилось.
func refreshHistoryDiff() {
    if (app.histSel < 0 || app.histSel >= len(app.histList)) { return }
    var cur = curText()
    var key = toString(app.histSel) + "|" + cur
    if (key == app.histDiffKey) { return }
    var file = curPath()
    app.histDiff = diffLines(readableText(file, app.histList[app.histSel][2]), readableText(file, cur))
    app.histDiffKey = key
}

func saveVersion(msg) {
    saveAll()
    if (historyAdd(historyPath(app.dir, curPath()), curText(), msg)) {
        setStatus("Версію збережено: " + msg)
    } else {
        setStatus("Нічого не змінилось від останньої версії")
    }
    loadHistory()
}

func historyAction(id) {
    if (id == "h.close") { app.side = "" }
    else if (id == "h.save") { openDialog("Що змінилось у цій версії?", "", "version") }
    else if (id == "h.back") { app.histSel = -1 }
    else if (startsWith(id, "h.sel:")) {
        app.histSel = toInt(substring(id, 6, len(id) - 6))
        app.histScroll = 0
    }
    else if (id == "h.restore") {
        var v = app.histList[app.histSel]
        // поточний стан - теж версією, щоб повернення можна було скасувати
        historyAdd(historyPath(app.dir, curPath()), curText(), "Перед поверненням до «" + v[1] + "»")
        if (app.mode == "blocks") {
            var ws = currentBlocks()
            wsSnapshot(ws)
            ws.stacks = stacksFromJson(v[2])
        } else {
            var ed = currentEditor()
            edBeginEdit(ed, "other")
            var cy = ed.cy
            edSetText(ed, v[2])
            ed.cy = min(cy, len(ed.lines) - 1)
            ed.dirty = true
        }
        saveAll()
        loadHistory()
        app.histSel = -1
        setStatus("Повернуто версію «" + v[1] + "»")
    }
}

// ---------- навчання ----------

func lessonCtx() {
    var stacks = []
    var ws = currentBlocks()
    if (ws != null) { stacks = ws.stacks }
    var code = ""
    var ed = currentEditor()
    if (ed != null) { code = edText(ed) }
    var cur = app.current
    if (app.mode == "blocks") { cur = app.currentB }
    // ctx[7] - програма зараз працює без помилки (малювання/герой не завершуються самі)
    return [stacks, code, app.con.lastOk, app.con.lastOutput, app.mode, fileName(cur), app.con.runs, app.con.running && app.con.runs >= 0 && len(app.problems) == 0]
}

// Позначити виконані уроки (перевіряється відкритий урок).
func checkLessons() {
    if (app.guideLesson < 0) { return }
    initLessons()
    var les = LESSONS[app.guideLesson]
    if (indexOf(app.done, les.title) < 0 && lessonDone(les, lessonCtx())) {
        append(app.done, les.title)
        saveProgress(joinPath(joinPath(app.dir, ".nyx"), "уроки.json"), app.done)
        setStatus("Урок пройдено: " + les.title + "!")
        startConfetti(les.title)
    }
}

// ---------- свято: конфеті, коли урок пройдено ----------

var _confetti = []       // [x, y, vx, vy, колір, розмір]
var _confettiStart = 0
var _confettiTitle = ""

func startConfetti(title) {
    _confetti = []
    _confettiStart = timeMs()
    _confettiTitle = title
    var W = surfaceWidth(S)
    var cols = [0xf38ba8, 0xa6e3a1, 0xf9e2af, 0x89b4fa, 0xcba6f7, 0xfab387, 0x94e2d5]
    var i = 0
    while (i < 90) {
        // два «фонтани» з нижніх кутів - угору й до середини
        var left = i % 2 == 0
        var x = 40
        var vx = randomInt(120, 420)
        if (!left) {
            x = W - 40
            vx = -vx
        }
        append(_confetti, [x, surfaceHeight(S) - 30, vx, -randomInt(520, 900), cols[i % len(cols)], randomInt(4, 9)])
        i = i + 1
    }
}

// Малює й рухає конфеті (1.8 с); поки летить - анімація триває.
func drawConfetti() {
    if (len(_confetti) == 0) { return }
    var t = (timeMs() - _confettiStart) / 1000
    if (t > 1.8) {
        _confetti = []
        return
    }
    uiAnimating = true
    for p in _confetti {
        var x = p[0] + p[2] * t
        var y = p[1] + p[3] * t + 700 * t * t
        var sz = p[5]
        // мерехтіння: "папірці" обертаються - то ширші, то вужчі
        var ww = max(2, toInt(sz * abs(sin(t * 9 + p[5]))))
        surfaceRect(S, toInt(x), toInt(y), ww, sz, p[4])
    }
    // плашка зверху: з'являється і тане
    var a = 1
    if (t < 0.2) { a = t / 0.2 }
    if (t > 1.4) { a = (1.8 - t) / 0.4 }
    var label = "Урок пройдено!"
    var W = surfaceWidth(S)
    var bw = textWidth(label, 24, true) + 48
    var bx = toInt((W - bw) / 2)
    surfaceRoundRect(S, bx, 70, bw, 52, 12, 0x40a060 + toInt(a * 230) * 16777216)
    surfaceText(S, label, bx + 24, 84, 24, 0xffffff + toInt(a * 255) * 16777216, true)
}

func firstCodeLesson() {
    initLessons()
    var i = 0
    while (i < len(LESSONS)) {
        if (LESSONS[i].mode == "code") { return i }
        i = i + 1
    }
    return 0
}

// Кожен урок - своя чиста програма ("Урок 2.nxb" лише з шапкою), щоб
// блоки різних уроків не накладались, а зроблене раніше не пропадало.
func openLesson(i) {
    initLessons()
    app.guideLesson = i
    var les = LESSONS[i]
    // урок 7 - про ту саму програму з блоків
    if (les.check == "tocode") {
        if (les.mode != app.mode) { setMode(les.mode) }
        return
    }
    var num = substring(les.title, 0, indexOf(les.title, "."))
    var lext = ".nx"
    if (les.mode == "blocks") { lext = ".nxb" }
    var path = joinPath(app.dir, "Урок " + num + lext)
    if (!fileExists(path)) {
        if (les.mode == "blocks") {
            var start = newBlock("start")
            start.x = 40
            start.y = 40
            writeFile(path, stacksToJson([start]))
        } else {
            writeFile(path, "func main() {\n    \n}\n")
        }
    }
    refreshFiles()
    if (les.mode == "blocks") { openBlocks(path) } else {
        openFile(path)
        var ed = currentEditor()
        if (len(ed.lines) == 3 && trim(ed.lines[1]) == "") {
            ed.cy = 1
            ed.cx = 4
        }
    }
}

func openExample(name) {
    var src = joinPath(joinPath(ideHome(), "examples"), name)
    if (!fileExists(src)) {
        setStatus("Нема прикладу " + name)
        return
    }
    var dot = indexOf(name, ".")
    var base = substring(name, 0, dot)
    var extn = substring(name, dot, len(name) - dot)
    var target = name
    var i = 2
    while (fileExists(joinPath(app.dir, target))) {
        target = base + " " + toString(i) + extn
        i = i + 1
    }
    writeFile(joinPath(app.dir, target), readFile(src))
    refreshFiles()
    openPath(joinPath(app.dir, target))
    setStatus("Приклад «" + base + "» відкрито - натисни «Запустити»!")
}

func guideAction(id) {
    initLessons()
    if (id == "g.close") { app.side = "" }
    else if (id == "g.tour") { startTour(false) }
    else if (id == "g.tab.lessons") { app.guideTab = "lessons" }
    else if (id == "g.tab.examples") { app.guideTab = "examples" }
    else if (id == "g.back") { app.guideLesson = -1 }
    else if (startsWith(id, "g.open:")) { openLesson(toInt(substring(id, 7, len(id) - 7))) }
    else if (id == "g.next") { openLesson(min(app.guideLesson + 1, len(LESSONS) - 1)) }
    else if (id == "g.demo") { startDemo(LESSONS[app.guideLesson].demo, true) }
    else if (startsWith(id, "g.ex:")) { openExample(substring(id, 5, len(id) - 5)) }
}

// ---------- "Покажи мені": IDE сама рухає курсор ----------
//
// Кожен крок уроку розкладається на прості дії (рух курсора, натиснути,
// відпустити, надрукувати), які подаються в ТІ САМІ обробники, що й
// справжня миша - тож показ і справжня робота не розходяться.

struct Ev {
    type: string
    x: i32
    y: i32
    button: i32
    shift: bool
    ctrl: bool
    alt: bool
    dx: i32
    dy: i32
    key: string
    text: string
}

// true, поки demoTick подає власні (штучні) події в handle().
var _synthetic = false

func _feed(e) {
    _synthetic = true
    handle(e)
    _synthetic = false
}

struct Demo {
    steps: array
    i: i32
    queue: array
    t0: i32
    fromX: i32
    fromY: i32
}

func _ev(type, x, y) {
    return Ev { type: type, x: x, y: y, button: 1, shift: false, ctrl: false, alt: false, dx: 0, dy: 0, key: "", text: "" }
}

func startDemo(steps, panToProgram) {
    if (len(steps) == 0) { return }
    if (panToProgram && app.mode != "blocks") { setMode("blocks") }
    // програма уроку - біля лівого верхнього кута робочої області, щоб усе
    // потрібне для показу було видно
    var ws = currentBlocks()
    if (panToProgram && ws != null) {
        for s in ws.stacks {
            if (s.spec == "start") {
                ws.panX = 30 - s.x
                ws.panY = 30 - s.y
            }
        }
    }
    app.demo = Demo { steps: steps, i: 0, queue: [], t0: timeMs(), fromX: uiMouseX, fromY: uiMouseY }
    app.cursorX = max(uiMouseX, LEFT_W + 200)
    app.cursorY = max(uiMouseY, TOP_H + 200)
    if (app.tour < 0) { setStatus("Дивись! (Escape - зупинити)") }
}

// Останній блок ланцюжка під першою шапкою.
func _demoChainEnd(ws) {
    for s in ws.stacks {
        if (s.spec == "start") { return lastOfChain(s) }
    }
    return null
}

// Останній "обіймаючий" блок у ланцюжку під шапкою.
func _demoLastC(ws) {
    var found = null
    for s in ws.stacks {
        if (s.spec == "start") {
            var b = s
            while (b != null) {
                var k = specOf(b.spec).kind
                if (k == "c" || k == "c2") { found = b }
                b = b.next
            }
        }
    }
    return found
}

func _demoRef(ws, ref) {
    if (ref == "end") { return _demoChainEnd(ws) }
    if (ref == "body") {
        var c = _demoLastC(ws)
        if (c == null) { return null }
        return c.body
    }
    for b in liveBlocks(ws.stacks) { if (b.spec == ref) { return b } }
    return null
}

func _palPos(id) {
    var k = 0
    while (k < len(_pHits)) {
        if (_pHits[k] == id) { return [_pHits[k + 1], _pHits[k + 2]] }
        k = k + 5
    }
    return null
}

func _slotCenter(b, idx) {
    var k = 0
    while (k < len(_sHits)) {
        if (_sHits[k] == b && _sHits[k + 1] == idx) { return [_sHits[k + 3], _sHits[k + 4], _sHits[k + 5], _sHits[k + 6]] }
        k = k + 7
    }
    return null
}

// Наступний крок уроку -> черга простих дій.
func _demoPlan(step) {
    var ws = currentBlocks()
    var q = []
    var kind = step[0]
    if (kind == "cat") {
        var ci = indexOf(CATEGORIES, step[1])
        var cr = uiFind("bcat:" + step[1])
        if (cr == null) { return q }
        append(q, ["move", cr[0] + toInt(cr[2] / 2), cr[1] + toInt(cr[3] / 2), 500])
        append(q, ["down"]) append(q, ["up"]) append(q, ["wait", 300])
    } else if (kind == "drag") {
        var src = _palPos(step[1])
        var anchor = null
        if (step[2] == "end") {
            var last = _demoChainEnd(ws)
            anchor = [last.sx, last.sy + last.h]
        } else {
            var c = _demoLastC(ws)
            anchor = [c.sx + ARM_W, c.sy + c.hh]
        }
        if (src == null || anchor == null) { return q }
        append(q, ["move", src[0] + 10, src[1] + 10, 600])
        append(q, ["down"])
        append(q, ["move", anchor[0] + 12, anchor[1] + 14, 900])
        append(q, ["up"]) append(q, ["wait", 300])
    } else if (kind == "dropin") {
        var src2 = _palPos(step[1])
        var host = _demoRef(ws, step[2])
        if (src2 == null || host == null) { return q }
        var sl = _slotCenter(host, step[3])
        if (sl == null) { return q }
        append(q, ["move", src2[0] + 5, src2[1] + 10, 600])
        append(q, ["down"])
        append(q, ["move", sl[0] + 4, sl[1] + toInt(sl[3] / 2) - 4, 900])
        append(q, ["up"]) append(q, ["wait", 300])
    } else if (kind == "type") {
        var host2 = _demoRef(ws, step[1])
        if (host2 == null) { return q }
        var sl2 = _slotCenter(host2, step[2])
        if (sl2 == null) { return q }
        append(q, ["move", sl2[0] + toInt(sl2[2] / 2), sl2[1] + toInt(sl2[3] / 2), 600])
        append(q, ["down"]) append(q, ["up"])
        var old = toString(host2.args[step[2]])
        var n = 0
        while (n < len(old)) {
            append(q, ["key", "Backspace"])
            n = n + 1
        }
        var t = step[3]
        var j = 0
        while (j < len(t)) {
            append(q, ["text", t[j]]) append(q, ["wait", 60])
            j = j + 1
        }
        append(q, ["key", "Enter"]) append(q, ["wait", 300])
    } else if (kind == "click") {
        var r = uiFind(step[1])
        if (r == null) { return q }
        append(q, ["move", r[0] + toInt(r[2] / 2), r[1] + toInt(r[3] / 2), 700])
        append(q, ["down"]) append(q, ["up"]) append(q, ["wait", 400])
    }
    return q
}

func demoTick() {
    var d = app.demo
    if (len(d.queue) == 0) {
        if (d.i >= len(d.steps)) {
            app.demo = null
            if (app.tour < 0) { setStatus("Ось так! Тепер спробуй сам(а).") }
            return
        }
        d.queue = _demoPlan(d.steps[d.i])
        d.i = d.i + 1
        d.t0 = timeMs()
        d.fromX = app.cursorX
        d.fromY = app.cursorY
        return
    }
    var a = d.queue[0]
    var done = true
    if (a[0] == "move") {
        var t = min(1, (timeMs() - d.t0) / a[3])
        // плавний старт і зупинка
        var e = t * t * (3 - 2 * t)
        app.cursorX = toInt(d.fromX + (a[1] - d.fromX) * e)
        app.cursorY = toInt(d.fromY + (a[2] - d.fromY) * e)
        _feed(_ev("mousemove", app.cursorX, app.cursorY))
        done = t >= 1
    } else if (a[0] == "down") {
        _feed(_ev("mousedown", app.cursorX, app.cursorY))
    } else if (a[0] == "up") {
        _feed(_ev("mouseup", app.cursorX, app.cursorY))
    } else if (a[0] == "key") {
        var ke = _ev("key", 0, 0)
        ke.key = a[1]
        _feed(ke)
    } else if (a[0] == "text") {
        var te = _ev("text", 0, 0)
        te.text = a[1]
        _feed(te)
    } else if (a[0] == "wait") {
        done = timeMs() - d.t0 >= a[1]
    }
    if (done && app.demo != null) {
        removeAt(d.queue, 0)
        d.t0 = timeMs()
        d.fromX = app.cursorX
        d.fromY = app.cursorY
    }
}

func drawDemoCursor() {
    var x = app.cursorX
    var y = app.cursorY
    surfacePolygon(S, [x + 2, y + 2, x + 2, y + 26, x + 9, y + 20, x + 14, y + 31, x + 19, y + 29, x + 14, y + 18, x + 23, y + 18], 0x66000000)
    surfacePolygon(S, [x, y, x, y + 24, x + 7, y + 18, x + 12, y + 29, x + 17, y + 27, x + 12, y + 16, x + 21, y + 16], C_YELLOW)
    surfaceCircleLine(S, x, y, 14, 0x88f9e2af, 2)
}

// ---------- старт і цикл ----------

func newApp(dir) {
    return App { mode: "code", dir: dir, files: [], expanded: newMap(), editors: newMap(), current: "",
        blocks: newMap(), currentB: "", tabs: [], active: "", side: "files", sideW: 270, sideScroll: 0,
        panelOpen: true, panelTab: "console", problems: [], palette: null, searchText: "", searchResults: [],
        genMap: [], guideTab: "lessons", guideLesson: -1, done: [], demo: null, cursorX: 0, cursorY: 0,
        hintRun: 0, tour: -1, tourFirstRun: false, histSel: -1, histScroll: 0, histList: [], histCounts: [],
        histDiff: [], histDiffKey: "", con: newConsole(), focus: "editor", drag: "", consoleH: 200,
        lastClickTime: 0, lastClickX: 0, lastClickY: 0, clickCount: 0, dialog: null, status: "",
        statusTime: 0, tooltip: "", probRun: 0, exSel: "", lastAutosave: 0, dbgPath: "", lastPauses: 0, stageOpen: false, stageRect: [], sideBeforeStage: "-", entry: null, ctx: null, cfg: null, askLevel: false, offer: null, exFocus: false, split: "", splitSide: 0, splitTop: 0, splitRect: [], renameGroup: null, term: newTerminal(dir), exts: [], lintJobs: [], extScroll: 0, git: newGitInfo(), dragSrc: "", dragKind: "", dragX: 0, dragY: 0, dragActive: false, updJob: null, updInfo: null, updRunning: false, updDone: false, updManual: false,
        fpick: null, sideLast: "" }
}

// Тека за замовчуванням: остання відкрита, інакше ~/NyxПрограми.
func defaultProgramsDir() { return joinPath(homeDir(), "NyxПрограми") }

func startDir(cfg) {
    if (cfg != null && len(cfg.recent) > 0 && dirExists(cfg.recent[0])) { return cfg.recent[0] }
    return defaultProgramsDir()
}

var FIRST_DIR = ""

// dir "" - остання тека, з якою працювали.
func ideInit(dir) {
    var cfg = loadSettings()
    if (dir == "") { dir = startDir(cfg) }
    if (!dirExists(dir)) { makeDir(dir) }
    FIRST_DIR = dir
    app = newApp(dir)

    var s = surfaceOpen("Nyx IDE", 1280, 800)
    uiInit(s)
    app.cfg = cfg
    if (app.cfg == null) {
        // перший запуск узагалі: спершу питання "хто ти в програмуванні"
        app.cfg = defaultSettings("beginner")
        app.askLevel = true
    }
    reloadExtensions()
    surfaceScale(app.cfg.uiScale / 100)
    applyTheme(app.cfg.theme)
    _loadFolder()
    startUpdateCheck()
    draw()
    return s
}

// Тека щойно стала поточною: файли, прогрес уроків, вкладки минулого разу.
func _loadFolder() {
    var dir = app.dir
    app.sideW = app.cfg.sideW
    app.term.root = dir
    refreshFiles()
    // порожня тека програм (не чужий проєкт) - приклад першої програми
    var own = dir == defaultProgramsDir() || fileExists(joinPath(joinPath(dir, ".nyx"), "уроки.json")) || len(listDir(dir)) == 0
    if (own && len(filesOfKind("code")) == 0 && len(filesOfKind("blocks")) == 0) {
        var example = joinPath(ideHome(), "examples/привіт.nx")
        var text = "func main() {\n    print(\"Привіт, світе!\")\n}\n"
        if (fileExists(example)) { text = readFile(example) }
        writeFile(joinPath(dir, "привіт.nx"), text)
        refreshFiles()
    }
    var progressPath = joinPath(joinPath(dir, ".nyx"), "уроки.json")
    if (fileExists(progressPath)) { app.done = loadProgress(progressPath) }
    else if (own) {
        if (!dirExists(joinPath(dir, ".nyx"))) { makeDir(joinPath(dir, ".nyx")) }
        saveProgress(progressPath, [])
    }
    rememberRecent(dir)
    surfaceTitle(S, "Nyx IDE — " + fileName(dir))
    // без питання про рівень - як було минулого разу (вкладки, курсори),
    // а вперше - перша програма коду
    if (!app.askLevel && !restoreSession()) {
        var codes = filesOfKind("code")
        if (len(codes) > 0) { openPath(codes[0]) }
    }
}

// Недавні теки (перша - поточна), до 10.
func rememberRecent(dir) {
    if (app.cfg == null || app.askLevel) { return }
    var list = [dir]
    for r in app.cfg.recent {
        if (r != dir && len(list) < 10) { append(list, r) }
    }
    app.cfg.recent = list
    saveSettings()
}

// Перейти в іншу теку (як File > Open Folder у VS Code): усе збережено,
// програма й термінал зупинені, потім усе - для нової теки.
func openFolder(dir) {
    dir = replace(dir, "\\", "/")
    while (len(dir) > 1 && endsWith(dir, "/") && !endsWith(dir, ":/")) { dir = substring(dir, 0, len(dir) - 1) }
    if (!dirExists(dir)) {
        setStatus("Нема такої теки: " + dir)
        return
    }
    if (dir == app.dir) {
        app.fpick = null
        return
    }
    // випадкові тести (NYX_IDE_NO_SHELL) - лише в межах своєї тимчасової теки
    if (osEnv("NYX_IDE_NO_SHELL") == "1" && !startsWith(dir, FIRST_DIR)) {
        setStatus("(інші теки вимкнено: NYX_IDE_NO_SHELL)")
        return
    }
    saveAll()
    saveSession()
    if (app.con.running) { conStop(app.con) }
    termClose(app.term)
    var old = app
    app = newApp(dir)
    app.cfg = old.cfg
    app.exts = old.exts
    app.updInfo = old.updInfo
    app.updDone = old.updDone
    app.side = old.side
    if (app.side == "") { app.side = "files" }
    _mtimes = newMap()
    _loadFolder()
    app.git.stale = true
    setStatus("Відкрито теку " + dir)
}

// ---------- вибір теки ----------

func openFolderPicker() {
    var start = app.dir
    var parts = split(start, "/")
    if (len(parts) > 1) { start = substring(app.dir, 0, len(app.dir) - len(parts[len(parts) - 1]) - 1) }
    if (start == "") { start = "/" }
    app.fpick = FolderPick { path: start, items: [], sel: 0, scroll: 0, msg: "" }
    _fpList()
    app.focus = "fpick"
}

func _fpList() {
    var fp = app.fpick
    var items = []
    try {
        for n in listDir(fp.path) {
            // приховані (.git, .cache) - не показуємо
            if (startsWith(n, ".")) { continue }
            if (dirExists(joinPath(fp.path, n))) { append(items, n) }
        }
        fp.msg = ""
    } catch (e) { fp.msg = "Немає доступу до цієї теки" }
    fp.items = sort(items)
    fp.sel = 0
    fp.scroll = 0
}

func _fpUp() {
    var fp = app.fpick
    var p = fp.path
    if (p == "/" || (len(p) <= 3 && contains(p, ":"))) { return }
    var parts = split(p, "/")
    var up = substring(p, 0, len(p) - len(parts[len(parts) - 1]) - 1)
    if (up == "") { up = "/" }
    if (len(up) == 2 && up[1] == ":") { up = up + "/" }
    fp.path = up
    _fpList()
}

func _fpEnter(name) {
    var fp = app.fpick
    fp.path = joinPath(fp.path, name)
    _fpList()
}

func fpickAction(id) {
    var fp = app.fpick
    if (id == "fp.cancel") {
        app.fpick = null
        app.focus = "editor"
    } else if (id == "fp.up") { _fpUp() }
    else if (id == "fp.home") {
        fp.path = replace(homeDir(), "\\", "/")
        _fpList()
    } else if (id == "fp.open") {
        var p = fp.path
        app.fpick = null
        app.focus = "editor"
        openFolder(p)
    } else if (id == "fp.system") { _fpSystemDialog() }
    else if (startsWith(id, "fp.item:")) {
        var i = toInt(substring(id, 8, len(id) - 8))
        if (i >= 0 && i < len(fp.items)) { _fpEnter(fp.items[i]) }
    } else if (startsWith(id, "fp.recent:")) {
        var r = substring(id, 10, len(id) - 10)
        app.fpick = null
        app.focus = "editor"
        openFolder(r)
    }
}

// Системне вікно вибору теки (zenity / kdialog / Windows), якщо є.
func _fpSystemDialog() {
    var fp = app.fpick
    if (HEADLESS || osEnv("NYX_IDE_NO_SHELL") == "1") {
        fp.msg = "Системне вікно тут недоступне"
        return
    }
    var r = null
    try {
        if (termIsWindows()) {
            var ps = "Add-Type -AssemblyName System.Windows.Forms; $d = New-Object System.Windows.Forms.FolderBrowserDialog; $d.SelectedPath = '" + replace(fp.path, "/", "\\") + "'; if ($d.ShowDialog() -eq 'OK') { [Console]::OutputEncoding = [Text.Encoding]::UTF8; $d.SelectedPath }"
            r = procRun("powershell", ["-NoProfile", "-STA", "-Command", ps])
        } else if (_have("zenity")) {
            r = procRun("zenity", ["--file-selection", "--directory", "--title=Відкрити теку", "--filename=" + fp.path + "/"])
        } else if (_have("kdialog")) {
            r = procRun("kdialog", ["--getexistingdirectory", fp.path])
        } else {
            fp.msg = "Системного вікна нема (zenity/kdialog) - вибери теку тут"
            return
        }
    } catch (e) {
        fp.msg = "Системне вікно не відкрилось - вибери теку тут"
        return
    }
    var chosen = trim(r.stdout)
    if (toInt(r.exitCode) == 0 && chosen != "" && dirExists(chosen)) {
        app.fpick = null
        app.focus = "editor"
        openFolder(chosen)
    }
}

func _have(cmd) {
    try {
        var r = procRun("/bin/sh", ["-c", "command -v " + cmd])
        return toInt(r.exitCode) == 0
    } catch (e) { return false }
}

func fpickKey(e) {
    var fp = app.fpick
    var k = e.key
    if (k == "Escape") { fpickAction("fp.cancel") }
    else if (k == "Up") { fp.sel = max(0, fp.sel - 1) }
    else if (k == "Down") { fp.sel = min(max(0, len(fp.items) - 1), fp.sel + 1) }
    else if (k == "Backspace" || k == "Left") { _fpUp() }
    else if (k == "Enter" && e.ctrl) { fpickAction("fp.open") }
    else if ((k == "Enter" || k == "Right") && len(fp.items) > 0) { _fpEnter(fp.items[fp.sel]) }
    else if (k == "Enter") { fpickAction("fp.open") }
}

func drawFolderPick() {
    var fp = app.fpick
    var W = surfaceWidth(S)
    var H = surfaceHeight(S)
    surfaceRect(S, 0, 0, W, H, 0x99000000)
    uiRegion("fp.bg", 0, 0, W, H)
    var w = min(640, W - 40)
    var h = min(560, H - 40)
    var x = toInt((W - w) / 2)
    var y = toInt((H - h) / 2)
    surfaceRoundRect(S, x, y, w, h, 10, C_PANEL)
    uiRegion("fp.box", x, y, w, h)
    surfaceText(S, "Відкрити теку", x + 20, y + 16, 20, C_TEXT, true)
    // шлях
    var cy = y + 52
    uiButton("fp.up", "← Вище", x + 20, cy, 90, 30, "normal")
    uiButton("fp.home", "Домівка", x + 116, cy, 90, 30, "normal")
    surfaceRoundRect(S, x + 214, cy, w - 234, 30, 6, C_BG)
    surfaceText(S, uiFit(fp.path, w - 254, 14), x + 224, cy + 7, 14, C_TEXT)
    cy = cy + 40
    // недавні
    var recent = []
    for r in app.cfg.recent { if (r != app.dir && dirExists(r) && len(recent) < 4) { append(recent, r) } }
    var listH = h - (cy - y) - 70
    if (len(recent) > 0) {
        surfaceText(S, "Недавні:", x + 20, cy + 4, 13, C_DIM)
        var rx = x + 84
        for r in recent {
            var lbl = fileName(r)
            var bw = min(textWidth(lbl, 14) + 20, 150)
            if (rx + bw > x + w - 20) { break }
            uiButton("fp.recent:" + r, uiFit(lbl, bw - 16, 14), rx, cy, bw, 26, "flat")
            rx = rx + bw + 6
        }
        cy = cy + 34
        listH = listH - 34
    }
    // теки
    surfaceRoundRect(S, x + 20, cy, w - 40, listH, 6, C_BG)
    uiRegion("fp.list", x + 20, cy, w - 40, listH)
    surfaceClip(S, x + 20, cy, w - 40, listH)
    var rowH = 26
    var vis = max(1, toInt(listH / rowH))
    if (fp.sel < fp.scroll) { fp.scroll = fp.sel }
    if (fp.sel >= fp.scroll + vis) { fp.scroll = fp.sel - vis + 1 }
    fp.scroll = clamp(fp.scroll, 0, max(0, len(fp.items) - vis))
    var i = fp.scroll
    var ry = cy
    while (i < len(fp.items) && ry < cy + listH) {
        if (i == fp.sel) { surfaceRect(S, x + 20, ry, w - 40, rowH, C_SURFACE) }
        else if (uiHover(x + 20, ry, w - 40, rowH)) { surfaceRect(S, x + 20, ry, w - 40, rowH, C_PANEL2) }
        iconFileKind("dir", x + 30, ry + 4, 18, C_SUBTEXT)
        surfaceText(S, uiFit(fp.items[i], w - 100, 15), x + 56, ry + 4, 15, C_TEXT)
        uiRegion("fp.item:" + toString(i), x + 20, ry, w - 40, rowH)
        ry = ry + rowH
        i = i + 1
    }
    if (len(fp.items) == 0) {
        var note = "Тут нема вкладених тек"
        if (fp.msg != "") { note = fp.msg }
        surfaceText(S, note, x + 36, cy + 12, 14, C_DIM)
    }
    surfaceUnclip(S)
    // кнопки
    var by = y + h - 50
    if (fp.msg != "" && len(fp.items) > 0) { surfaceText(S, uiFit(fp.msg, w - 40, 13), x + 20, by - 18, 13, C_YELLOW) }
    uiButton("fp.system", "Системне вікно…", x + 20, by, 160, 34, "flat")
    uiButton("fp.cancel", "Скасувати", x + w - 310, by, 110, 34, "normal")
    uiButton("fp.open", "Відкрити цю теку", x + w - 190, by, 170, 34, "primary")
}

// ---------- сесія: що було відкрито (<тека>/.nyx/сесія.json) ----------

// Своя тека програм (є .nyx) - сесія там; чужий проєкт не засмічуємо:
// ~/.nyx-ide/сесії/<назва>-<хеш шляху>.json.
func sessionPath() {
    var own = joinPath(app.dir, ".nyx")
    if (dirExists(own)) { return joinPath(own, "сесія.json") }
    var cfgDir = configPath()
    var parts = split(replace(cfgDir, "\\", "/"), "/")
    cfgDir = substring(cfgDir, 0, len(cfgDir) - len(parts[len(parts) - 1]) - 1)
    return joinPath(joinPath(cfgDir, "сесії"), fileName(app.dir) + "-" + _pathHash(app.dir) + ".json")
}

func _pathHash(s) {
    var h = 5381
    var i = 0
    while (i < len(s)) {
        h = (h * 33 + charCode(s[i])) % 2147483647
        i = i + 1
    }
    return toString(h)
}

func _rel(p) {
    if (startsWith(p, app.dir + "/")) { return substring(p, len(app.dir) + 1, len(p) - len(app.dir) - 1) }
    return p
}

func _abs(r) {
    if (startsWith(r, "/") || (len(r) > 1 && r[1] == ":")) { return r }
    return joinPath(app.dir, r)
}

func saveSession() {
    if (app == null || app.cfg == null) { return }
    var m = newMap()
    var tabs = []
    for t in app.tabs { append(tabs, _rel(t)) }
    mapSet(m, "tabs", tabs)
    mapSet(m, "active", _rel(app.active))
    mapSet(m, "side", app.side)
    mapSet(m, "sideW", app.sideW)
    mapSet(m, "panelOpen", app.panelOpen)
    mapSet(m, "panelTab", app.panelTab)
    mapSet(m, "consoleH", app.consoleH)
    mapSet(m, "split", _rel(app.split))
    mapSet(m, "splitSide", app.splitSide)
    var exp = []
    for d in mapKeys(app.expanded) { append(exp, _rel(d)) }
    mapSet(m, "expanded", exp)
    var pos = newMap()
    for p in mapKeys(app.editors) {
        var ed = mapGet(app.editors, p)
        mapSet(pos, _rel(p), [ed.cy, ed.cx, ed.top])
    }
    mapSet(m, "cursors", pos)
    try {
        var sp = sessionPath()
        var sparts = split(sp, "/")
        var sdir = substring(sp, 0, len(sp) - len(sparts[len(sparts) - 1]) - 1)
        if (!dirExists(sdir)) { makeDir(sdir) }
        writeFile(sp, toJson(m))
    } catch (e) { }
}

var _restoring = false

// true - сесію відновлено (хоч одна вкладка відкрилась).
func restoreSession() {
    _restoring = true
    var ok = _restoreSession()
    _restoring = false
    if (ok && app.active != "") { lintFile(app.active) }
    return ok
}

func _restoreSession() {
    var p = sessionPath()
    if (!fileExists(p)) { return false }
    try {
        var m = fromJson(readFile(p))
        if (mapHas(m, "expanded")) {
            for d in mapGet(m, "expanded") {
                var ad = _abs(toString(d))
                if (dirExists(ad)) { mapSet(app.expanded, ad, true) }
            }
            refreshFiles()
        }
        var cursors = newMap()
        if (mapHas(m, "cursors")) { cursors = mapGet(m, "cursors") }
        var opened = 0
        for t in mapGet(m, "tabs") {
            var at = _abs(toString(t))
            if (!fileExists(at)) { continue }
            openPath(at)
            opened = opened + 1
            _restoreCursor(at, cursors)
        }
        if (opened == 0) { return false }
        var act = _abs(toString(mapGet(m, "active")))
        if (fileExists(act)) { openPath(act) }
        var sp = _abs(toString(mapGet(m, "split")))
        if (mapGet(m, "split") != "" && fileExists(sp) && mapHas(app.editors, sp)) {
            app.split = sp
            app.splitSide = toInt(mapGet(m, "splitSide"))
        }
        if (mapHas(m, "side")) { app.side = toString(mapGet(m, "side")) }
        if (app.side == "learn" && !app.cfg.lessons) { app.side = "files" }
        if (mapHas(m, "panelOpen")) { app.panelOpen = mapGet(m, "panelOpen") == true }
        if (mapHas(m, "panelTab")) { app.panelTab = toString(mapGet(m, "panelTab")) }
        if (mapHas(m, "consoleH")) { app.consoleH = toInt(mapGet(m, "consoleH")) }
        return true
    } catch (e) {
        return false
    }
}

func _restoreCursor(path, cursors) {
    var r = _rel(path)
    if (!mapHas(cursors, r) || !mapHas(app.editors, path)) { return }
    var c = mapGet(cursors, r)
    var ed = mapGet(app.editors, path)
    ed.cy = clamp(toInt(c[0]), 0, len(ed.lines) - 1)
    ed.cx = clamp(toInt(c[1]), 0, len(ed.lines[ed.cy]))
    ed.top = clamp(toInt(c[2]), 0, max(0, len(ed.lines) - 1))
    ed.wantCol = ed.cx
}

// Клавіші IDE, які не йдуть у термінал навіть коли він у фокусі (як у VS Code).
func termSkipKey(e) {
    var k = e.key
    if (e.ctrl && e.shift && toLower(k) == "p") { return true }
    if (e.ctrl && !e.shift && !e.alt && (k == "p" || k == "b" || k == "j" || k == "`" || k == "'")) { return true }
    if (k == "F5" || k == "F10" || k == "F11") { return true }
    return false
}

// Один крок циклу: дочекатися подій (wait мс, -1 - безкінечно), обробити
// ВСІ, що назбирались, і лише потім один раз перемалювати.
// false - вікно закрили.
func ideStep(wait) {
    if ((app.con.running || len(app.lintJobs) > 0) && (wait < 0 || wait > 40)) { wait = 40 }
    var tw = termWait(app.term)
    if (tw >= 0 && (wait < 0 || wait > tw)) { wait = tw }
    if (app.con.running && app.stageOpen && (wait < 0 || wait > 16)) { wait = 16 }
    if (app.demo != null && (wait < 0 || wait > 16)) { wait = 16 }
    // анімація (наведення, конфеті...) - наступний кадр через ~16 мс
    if (uiAnimating && (wait < 0 || wait > 16)) { wait = 16 }
    var e = surfaceNextEvent(S, wait)
    var dirty = false
    while (e != null) {
        if (e.type == "close") { return false }
        handle(e)
        dirty = true
        e = surfaceNextEvent(S, 0)
    }
    if (app.con.proc != null && (app.con.running || dirty)) {
        if (conPoll(app.con)) { dirty = true }
        afterPoll()
    }
    if (tw >= 0) {
        var wasRunning = app.term.running
        if (termPoll(app.term)) {
            dirty = true
            // команда (git push/pull, ...) завершилась - стан git і файли могли змінитись
            if (wasRunning && !app.term.running) { afterExternalChange() }
        }
    }
    if (len(app.lintJobs) > 0 && pollLint()) { dirty = true }
    // раз на 2 с - чи не змінили відкриті файли ззовні
    if (timeMs() - _lastDiskCheck > 2000) { checkDiskChanges() }
    if (pollUpdate()) { dirty = true }
    // git: після збереження/команди - перечитати стан (не частіше ніж раз на 0.7 с)
    if (app.git.stale && app.git.available && timeMs() - app.git.last > 700) {
        gitRefresh(app.git, app.dir)
        dirty = true
    }
    // програма на сцені - кадр оновлюється безперервно; перший кадр -
    // перемалювати, щоб сцена відкрилась навіть без руху миші
    if (app.stageOpen && app.con.running) { dirty = true }
    if (!app.stageOpen && app.con.running && fileExists(stageFrame())) { dirty = true }
    if (app.demo != null) {
        demoTick()
        dirty = true
    }
    if (app.status != "" && timeMs() - app.statusTime > 4000 && timeMs() - app.statusTime < 4100) { dirty = true }
    // автозбереження раз на 30 с (як Auto Save у VS Code)
    if (timeMs() - app.lastAutosave > 30000) {
        app.lastAutosave = timeMs()
        saveAll()
        saveSession()
    }
    if (uiAnimating) { dirty = true }
    if (dirty) { draw() }
    if (_quitRequested) { return false }
    return surfaceIsOpen(S)
}

// ---------- запобіжник: помилка в самій IDE не закриває вікно ----------

var _errTimes = []

// Журнал - поруч з налаштуваннями (у тестах - поруч з NYX_IDE_CONFIG).
func errorLogPath() { return joinPath(parentDir(configPath()), "помилки.log") }

// Помилка всередині IDE: записати в журнал, зберегти роботу, скинути
// тимчасовий стан (меню, показ, перетягування), повідомити. true - можна
// працювати далі; false - помилки сиплються безперервно, краще закритись.
func recoverFromError(err) {
    var msg = toString(err)
    try {
        var dir = parentDir(errorLogPath())
        if (!dirExists(dir)) { makeDir(dir) }
        appendFile(errorLogPath(), formatDate(timestamp(), "yyyy-MM-dd HH:mm:ss") + "  " + msg + "\n")
    } catch (e1) { }
    try { saveAll() } catch (e2) { }
    try { saveSession() } catch (e3) { }
    app.demo = null
    app.drag = ""
    app.palette = null
    app.ctx = null
    app.entry = null
    app.dialog = null
    app.focus = "editor"
    uiPressedId = ""
    var ws = currentBlocks()
    if (ws != null) {
        ws.drag = null
        ws.pending = null
        ws.panning = false
        ws.menu = []
    }
    setStatus("Внутрішня помилка IDE - роботу збережено, можна працювати далі. Деталі: " + errorLogPath())
    var now = timeMs()
    append(_errTimes, now)
    while (len(_errTimes) > 0 && now - _errTimes[0] > 5000) { removeAt(_errTimes, 0) }
    return len(_errTimes) <= 20
}

func ideShutdown() {
    saveAll()
    saveSession()
    if (app.con.running) { conStop(app.con) }
    termClose(app.term)
}

func main() {
    var args = scriptArgs()
    // без теки - та, з якою працювали минулого разу
    var dir = ""
    if (len(args) > 0) { dir = args[0] }
    // відносна тека (nx-ide . у терміналі) - від поточної
    if (dir != "" && !startsWith(dir, "/") && !(len(dir) > 1 && dir[1] == ":")) {
        dir = replace(joinPath(replace(osCwd(), "\\", "/"), dir), "/./", "/")
        if (endsWith(dir, "/.")) { dir = substring(dir, 0, len(dir) - 2) }
    }
    ideInit(dir)
    var running = true
    while (running) {
        try {
            running = ideStep(-1)
        } catch (err) {
            running = recoverFromError(err)
            try { draw() } catch (err2) { }
        }
    }
    try { ideShutdown() } catch (err3) { saveAll() }
}
