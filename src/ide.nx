var app = null

// ---------- файли ----------

func homeDir() {
    var h = osEnv("HOME")
    if (h == null || h == "") { h = osEnv("USERPROFILE") }
    if (h == null || h == "") { h = osCwd() }
    return h
}

func joinPath(dir, name) {
    if (endsWith(dir, "/") || endsWith(dir, "\\")) { return dir + name }
    return dir + "/" + name
}

func fileName(path) {
    var parts = split(replace(path, "\\", "/"), "/")
    return parts[len(parts) - 1]
}

// Вид файла: "blocks" (.nxb), "code" (.nx), "text" (решта).
func fileKind(path) {
    if (endsWith(path, ".nxb")) { return "blocks" }
    if (endsWith(path, ".nx")) { return "code" }
    return "text"
}

// Розширення нових файлів у поточному режимі.
func ext() {
    if (app.mode == "blocks") { return ".nxb" }
    return ".nx"
}

// Тека IDE (там, де лежить src/): приклади, гайд.
func ideHome() { return joinPath(scriptDir(), "..") }

var SKIP_DIRS = ["node_modules", "bin", "obj", "__pycache__"]

// Дерево Провідника, розгорнуте в плаский список рядків:
// [шлях, назва, глибина, тека?]. Приховані (.nyx, .git) - не показуються.
func _walkDir(dir, depth, out) {
    var names = []
    try { names = sort(listDir(dir)) } catch (e) { return }
    var dirs = []
    var files = []
    for n in names {
        if (startsWith(n, ".")) { continue }
        var p = joinPath(dir, n)
        if (dirExists(p)) {
            if (indexOf(SKIP_DIRS, n) < 0) { append(dirs, n) }
        } else { append(files, n) }
    }
    for d in dirs {
        var dp = joinPath(dir, d)
        append(out, [dp, d, depth, true])
        if (mapHas(app.expanded, dp)) { _walkDir(dp, depth + 1, out) }
    }
    for f in files {
        // з вимкненим режимом блоків файли .nxb не показуються
        if (app.cfg != null && !app.cfg.blocks && endsWith(f, ".nxb")) { continue }
        append(out, [joinPath(dir, f), f, depth, false])
    }
}

func refreshFiles() {
    var out = []
    _walkDir(app.dir, 0, out)
    app.files = out
}

// Усі файли цього виду в корені теки (для уроків і "першого файла").
// Напряму з диска: Провідник може ховати .nxb (вимкнений режим блоків).
func filesOfKind(kind) {
    var res = []
    var names = []
    try { names = sort(listDir(app.dir)) } catch (e) { return res }
    for n in names {
        var p = joinPath(app.dir, n)
        if (!startsWith(n, ".") && fileKind(p) == kind && fileExists(p)) { append(res, p) }
    }
    return res
}

func currentEditor() {
    if (app.current == "") { return null }
    return mapGet(app.editors, app.current)
}

func currentBlocks() {
    if (app.currentB == "") { return null }
    return mapGet(app.blocks, app.currentB)
}

func _addTab(path) {
    if (indexOf(app.tabs, path) < 0) { append(app.tabs, path) }
    app.active = path
    surfaceTitle(S, "Nyx IDE — " + fileName(path))
    // перша зустріч з редактором блоків / коду - запропонувати гайд
    var kind = fileKind(path)
    if (kind == "blocks") { offerOnce("blocks") }
    if (kind == "code") { offerOnce("code") }
}

func openBlocks(path) {
    app.histSel = -1
    if (!mapHas(app.blocks, path)) {
        var text = ""
        if (fileExists(path)) { text = readFile(path) }
        mapSet(app.blocks, path, newBlocksWs(path, text))
    }
    app.currentB = path
    app.mode = "blocks"
    _addTab(path)
}

func openFile(path) {
    app.histSel = -1
    if (!mapHas(app.editors, path)) {
        var text = ""
        if (fileExists(path)) { text = readFile(path) }
        var ed = newEditor(text, path)
        ed.plain = fileKind(path) == "text"
        mapSet(app.editors, path, ed)
        mapSet(_mtimes, path, fileModified(path))
        // при відновленні сесії - лише активний файл (не 15 перевірок разом)
        if (!_restoring) { lintFile(path) }
    }
    app.current = path
    app.mode = "code"
    app.focus = "editor"
    _addTab(path)
}

// Відкрити будь-який файл у відповідному редакторі.
func openPath(path) {
    saveAll()
    app.exFocus = false
    if (fileKind(path) == "blocks") { openBlocks(path) } else { openFile(path) }
}

func closeTab(path) {
    saveAll()
    var i = indexOf(app.tabs, path)
    if (i < 0) { return }
    removeAt(app.tabs, i)
    if (app.split == path) { app.split = "" }
    if (app.current == path) { app.current = "" }
    if (app.currentB == path) { app.currentB = "" }
    if (app.active == path) {
        app.active = ""
        if (len(app.tabs) > 0) { openPath(app.tabs[min(i, len(app.tabs) - 1)]) }
        else { surfaceTitle(S, "Nyx IDE") }
    }
}

// Перейти в режим блоків/коду (уроки, показ): активна вкладка цього виду,
// інакше перший такий файл, інакше новий.
func setMode(mode) {
    saveAll()
    var kind = "code"
    if (mode == "blocks") { kind = "blocks" }
    if (app.active != "" && fileKind(app.active) == kind) {
        app.mode = mode
        return
    }
    for t in app.tabs {
        if (fileKind(t) == kind) {
            openPath(t)
            return
        }
    }
    refreshFiles()
    var list = filesOfKind(kind)
    if (len(list) == 0) {
        if (kind == "blocks") { writeFile(joinPath(app.dir, "мої блоки.nxb"), starterBlocksJson()) }
        else { writeFile(joinPath(app.dir, "програма1.nx"), "func main() {\n    print(\"Привіт!\")\n}\n") }
        refreshFiles()
        list = filesOfKind(kind)
    }
    openPath(list[0])
}

// Час зміни відкритих файлів, коли IDE їх читала чи писала востаннє:
// інший час - файл змінили ззовні (термінал, git, anylint --fix).
var _mtimes = newMap()
var _lastDiskCheck = 0

// Команда в терміналі завершилась: стан git, нові файли, змінені файли.
func afterExternalChange() {
    app.git.stale = true
    refreshFiles()
    checkDiskChanges()
}

// Відкриті файли, змінені на диску: без незбережених правок - перечитати
// (Ctrl+Z повертає як було), з правками - лише попередити.
func checkDiskChanges() {
    _lastDiskCheck = timeMs()
    for p in mapKeys(app.editors) {
        var m = fileModified(p)
        if (!mapHas(_mtimes, p)) {
            mapSet(_mtimes, p, m)
            continue
        }
        if (m == mapGet(_mtimes, p) || m < 0) { continue }
        mapSet(_mtimes, p, m)
        var ed = mapGet(app.editors, p)
        var text = normalizeText(readFile(p))
        if (text == edText(ed)) { continue }
        if (ed.dirty) {
            setStatus("«" + fileName(p) + "» змінено ззовні, але тут є незбережені правки - лишаю твою версію")
            continue
        }
        var top = ed.top
        edReplaceLines(ed, split(text, "\n"))
        ed.dirty = false
        ed.top = clamp(top, 0, max(0, len(ed.lines) - 1))
        lintFile(p)
        setStatus("«" + fileName(p) + "» змінено ззовні - перечитано (Ctrl+Z - як було)")
    }
    for p2 in mapKeys(app.blocks) {
        var m2 = fileModified(p2)
        if (!mapHas(_mtimes, p2)) {
            mapSet(_mtimes, p2, m2)
            continue
        }
        if (m2 == mapGet(_mtimes, p2) || m2 < 0) { continue }
        mapSet(_mtimes, p2, m2)
        var ws = mapGet(app.blocks, p2)
        if (!ws.dirty) { mapSet(app.blocks, p2, newBlocksWs(p2, readFile(p2))) }
    }
}

func saveEditor(ed) {
    if (ed == null || !ed.dirty) { return }
    writeFile(ed.path, edText(ed))
    mapSet(_mtimes, ed.path, fileModified(ed.path))
    ed.dirty = false
    lintFile(ed.path)
    app.git.stale = true
}

func saveAll() {
    for p in mapKeys(app.editors) { saveEditor(mapGet(app.editors, p)) }
    for p in mapKeys(app.blocks) {
        var ws = mapGet(app.blocks, p)
        if (ws.dirty) {
            writeFile(ws.path, stacksToJson(ws.stacks))
            mapSet(_mtimes, ws.path, fileModified(ws.path))
            ws.dirty = false
        }
    }
}

func setStatus(text) {
    app.status = text
    app.statusTime = timeMs()
}

// kind: "code" | "blocks"
func newFile(name, kind) {
    name = trim(name)
    if (name == "") { return }
    var e = ".nx"
    if (kind == "blocks") { e = ".nxb" }
    if (!endsWith(name, e)) { name = name + e }
    var path = joinPath(app.dir, name)
    if (fileExists(path)) {
        setStatus("Файл " + name + " вже є - відкрито його")
    } else if (kind == "blocks") {
        writeFile(path, starterBlocksJson())
    } else {
        writeFile(path, "func main() {\n    print(\"Привіт!\")\n}\n")
    }
    refreshFiles()
    openPath(path)
}

func freeName(kind) {
    var e = ".nx"
    if (kind == "blocks") { e = ".nxb" }
    var i = 1
    while (fileExists(joinPath(app.dir, "програма" + toString(i) + e))) { i = i + 1 }
    return "програма" + toString(i)
}

// ---------- запуск ----------

func blocksTitle(ws) {
    var n = fileName(ws.path)
    return substring(n, 0, len(n) - 4)
}

// debugMode: "" - звичайний запуск, "step" - покроково з першого рядка,
// "cont" - до точок зупинки.
func runCurrent() { runWith("") }

func runWith(debugMode) {
    saveAll()
    app.lastPauses = 0
    app.dbgPath = app.active
    if (app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws == null) { return }
        ws.errBlock = null
        ws.dbgBlock = null
        var g = generateCode(ws.stacks, blocksTitle(ws))
        app.genMap = g[1]
        var genDir = joinPath(app.dir, ".nyx")
        if (!dirExists(genDir)) { makeDir(genDir) }
        var genPath = joinPath(genDir, blocksTitle(ws) + ".nx")
        writeFile(genPath, g[0])
        conRun(app.con, genPath, app.dir, debugMode, [], stageDir())
        app.focus = "console"
        return
    }
    var ed = currentEditor()
    if (ed == null) { return }
    ed.errLine = -1
    var breaks = []
    if (debugMode != "") { breaks = edBreakLines(ed) }
    conRun(app.con, ed.path, app.dir, debugMode, breaks, stageDir())
    app.focus = "console"
}

func stageDir() { return joinPath(joinPath(app.dir, ".nyx"), "сцена") }
func stageFrame() { return stageDir() + "/frame.raw" }

// Сцена: вікно програми (малювання, ігри) - прямо в IDE, праворуч.
func drawStage(x, y, w, h) {
    surfaceRect(S, x, y, w, h, C_PANEL2)
    surfaceRect(S, x, y, 1, h, C_BORDER)
    uiRegion("stage.panel", x, y, w, h)
    surfaceText(S, "СЦЕНА", x + 12, y + 8, 13, C_SUBTEXT, true)
    uiButton("stage.close", "×", x + w - 30, y + 3, 26, 24, "flat")
    var by = y + 30
    var bh = h - 30
    surfaceRect(S, x + 8, by, w - 16, bh - 8, 0x000000)
    var r = surfaceDrawFrame(S, stageFrame(), x + 8, by, w - 16, bh - 8)
    if (r == null) {
        var t = "Тут з'явиться малюнок програми"
        surfaceText(S, t, x + toInt((w - textWidth(t, 14)) / 2), by + toInt(bh / 2) - 8, 14, C_DIM)
        app.stageRect = []
        return
    }
    // куди саме вписано кадр - для перерахунку координат миші
    var k = min((w - 16) / r[0], (bh - 8) / r[1])
    var dw = toInt(r[0] * k)
    var dh = toInt(r[1] * k)
    var fx = x + 8 + toInt((w - 16 - dw) / 2)
    var fy = by + toInt((bh - 8 - dh) / 2)
    app.stageRect = [fx, fy, dw, dh, r[0], r[1]]
    if (app.focus == "stage") { surfaceRectLine(S, fx - 2, fy - 2, dw + 4, dh + 4, C_ACCENT, 2) }
    uiRegion("stage.frame", fx, fy, dw, dh)
}

// Миша над сценою -> подія для програми в координатах її вікна.
func stageMouse(kind, e) {
    var r = app.stageRect
    if (len(r) == 0 || !app.con.running) { return false }
    if (e.x < r[0] || e.y < r[1] || e.x >= r[0] + r[2] || e.y >= r[1] + r[3]) { return false }
    var sx = toInt((e.x - r[0]) * r[4] / r[2])
    var sy = toInt((e.y - r[1]) * r[5] / r[3])
    var b = 1
    if (e.button != null) { b = e.button }
    if (kind == "move") { conStageInput(app.con, "move " + toString(sx) + " " + toString(sy)) }
    else { conStageInput(app.con, kind + " " + toString(sx) + " " + toString(sy) + " " + toString(b)) }
    return true
}

// Підсвітка місця паузи: рядок у редакторі коду, блок у редакторі блоків.
func syncDebugView() {
    var con = app.con
    for p in mapKeys(app.editors) {
        var ed = mapGet(app.editors, p)
        ed.dbgLine = -1
        if (con.paused && p == app.dbgPath) { ed.dbgLine = con.pauseLine }
    }
    for p2 in mapKeys(app.blocks) {
        var ws = mapGet(app.blocks, p2)
        ws.dbgBlock = null
        if (con.paused && p2 == app.dbgPath && con.pauseLine >= 0 && con.pauseLine < len(app.genMap)) {
            ws.dbgBlock = app.genMap[con.pauseLine]
        }
    }
    // нова пауза: показати "ЗМІННІ" (перший раз) і прокрутити до рядка
    if (con.paused && con.pauses != app.lastPauses) {
        if (app.lastPauses == 0) {
            app.panelOpen = true
            app.panelTab = "vars"
        }
        app.lastPauses = con.pauses
        if (app.active == app.dbgPath && app.mode == "code") {
            var e2 = currentEditor()
            var rows = max(1, toInt(e2.h / e2.lineH))
            if (con.pauseLine < e2.top || con.pauseLine >= e2.top + rows - 1) { e2.top = max(0, con.pauseLine - toInt(rows / 3)) }
        }
    }
}

// ---------- розділений редактор (Ctrl+\) ----------
//
// Дві панелі поруч. Активна (в якій курсор) - завжди поточний файл
// (app.current), тож уся решта IDE працює як без розділення; друга
// показує app.split - інший файл або той самий зі своєю прокруткою
// (app.splitTop). Клік по другій панелі робить її активною.

func toggleSplit() {
    if (app.split != "") {
        app.split = ""
        setStatus("Редактор знову один")
        return
    }
    if (app.mode != "code" || currentEditor() == null) {
        setStatus("Розділити можна редактор коду")
        return
    }
    app.split = app.current
    app.splitSide = 0
    app.splitTop = currentEditor().top
    setStatus("Редактор розділено. Клацни по панелі й відкрий у ній інший файл; Ctrl+\\ - прибрати")
}

func drawSplit(ed, x, y, w, h, focused) {
    var half = toInt((w - 2) / 2)
    var fx = x
    var ox = x + half + 2
    if (app.splitSide == 1) {
        ox = x
        fx = x + half + 2
    }
    var hdr = 24
    // друга панель: заголовок з назвою файла і "×"
    var other = mapGet(app.editors, app.split)
    surfaceRect(S, ox, y, half, hdr, C_PANEL)
    surfaceText(S, uiFit(fileName(app.split), half - 50, 14), ox + 10, y + 4, 14, C_DIM)
    uiButton("split.close", "×", ox + half - 28, y + 1, 24, 22, "flat")
    if (other == ed) {
        // той самий файл - своя прокрутка
        var keepTop = ed.top
        ed.top = clamp(app.splitTop, 0, max(0, len(ed.lines) - 1))
        edDraw(ed, ox, y + hdr, half, h - hdr, false)
        app.splitTop = ed.top
        ed.top = keepTop
    } else {
        edDraw(other, ox, y + hdr, half, h - hdr, false)
    }
    app.splitRect = [ox, y + hdr, half, h - hdr]
    // поверх областей "editor" другої панелі
    uiRegion("editor2", ox, y + hdr, half, h - hdr)
    surfaceRect(S, x + half, y, 2, h, C_BORDER)
    // активна панель - малюється останньою, її "editor" і "gutter" дійсні
    surfaceRect(S, fx, y, half, hdr, C_PANEL)
    surfaceText(S, uiFit(fileName(app.current), half - 20, 14), fx + 10, y + 4, 14, C_TEXT)
    surfaceRect(S, fx, y + hdr - 2, half, 2, C_ACCENT)
    edDraw(ed, fx, y + hdr, half, h - hdr, focused)
}

// Клік по другій панелі: вона стає активною (файли міняються місцями).
func focusSplitPane() {
    var cur = app.current
    var curEd = currentEditor()
    var target = app.split
    var curTop = curEd.top
    app.split = cur
    app.splitSide = 1 - app.splitSide
    if (target == cur) {
        // той самий файл: міняємо прокрутки
        var t = app.splitTop
        app.splitTop = curTop
        curEd.top = t
    } else {
        app.splitTop = 0
        openPath(target)
    }
    var ed = currentEditor()
    if (ed != null && len(app.splitRect) == 4) {
        // координати панелі, щоб клік одразу поставив курсор
        ed.x = app.splitRect[0]
        ed.y = app.splitRect[1]
        ed.w = app.splitRect[2]
        ed.h = app.splitRect[3]
    }
}

// ---------- перейти до визначення (F12) і перейменувати всюди (F2) ----------

// Файли коду проєкту (для імен, визначених в іншому файлі).
func _projectCode() {
    var out = []
    for p in filesOfKind("code") { append(out, p) }
    return out
}

func _linesOf(path) {
    if (mapHas(app.editors, path)) { return mapGet(app.editors, path).lines }
    return split(normalizeText(readFile(path)), "\n")
}

func goToDefinition() {
    var ed = currentEditor()
    if (ed == null) { return }
    var w = edWordAtCursor(ed)
    if (w == null) {
        setStatus("Постав курсор на назву (функції, змінної), щоб перейти до визначення")
        return
    }
    var word = w[2]
    var toks = edAllTokens(ed)
    var loc = symLocalDef(ed.lines, toks, word, ed.cy)
    if (loc != null) {
        edJumpTo(ed, loc[0], loc[1])
        setStatus("«" + word + "» - рядок " + toString(loc[0] + 1))
        return
    }
    var g = symGlobalDef(ed.lines, toks, word)
    if (g != null) {
        edJumpTo(ed, g[0], g[1])
        setStatus("«" + word + "» - рядок " + toString(g[0] + 1))
        return
    }
    for p in _projectCode() {
        if (p == ed.path) { continue }
        var lines = _linesOf(p)
        var g2 = symGlobalDef(lines, symTokens(lines), word)
        if (g2 != null) {
            openPath(p)
            var ed2 = currentEditor()
            if (ed2 != null) { edJumpTo(ed2, g2[0], g2[1]) }
            setStatus("«" + word + "» - " + fileName(p) + ", рядок " + toString(g2[0] + 1))
            return
        }
    }
    if (indexOf(BUILTIN_NAMES, word) >= 0) { setStatus("«" + word + "» - вбудована функція мови (наведи мишу - підказка)") }
    else { setStatus("Не знайшов, де визначено «" + word + "»") }
}

// Ctrl+Z: якщо остання зміна цього файла - перейменування в кількох
// файлах (і там після нього нічого не міняли), скасувати його в усіх.
func undoRenameGroup(ed) {
    var g = app.renameGroup
    if (g == null) { return false }
    var mine = false
    for it in g {
        if (!mapHas(app.editors, it[0]) || len(mapGet(app.editors, it[0]).undo) != it[1]) {
            app.renameGroup = null
            return false
        }
        if (it[0] == ed.path) { mine = true }
    }
    if (!mine) { return false }
    for it2 in g { edUndo(mapGet(app.editors, it2[0])) }
    app.renameGroup = null
    saveAll()
    setStatus("Перейменування скасовано в " + toString(len(g)) + " файлах")
    return true
}

func askRenameSymbol() {
    var ed = currentEditor()
    if (ed == null) { return }
    var w = edWordAtCursor(ed)
    if (w == null) {
        setStatus("Постав курсор на назву, яку треба перейменувати")
        return
    }
    if (indexOf(BUILTIN_NAMES, w[2]) >= 0 && symGlobalDef(ed.lines, edAllTokens(ed), w[2]) == null) {
        setStatus("«" + w[2] + "» - вбудована функція мови, її не перейменуєш")
        return
    }
    openDialog("Перейменувати «" + w[2] + "» всюди", w[2], "renamesym")
    app.dialog.target = w[2]
}

// Перейменувати word -> nw: локальну змінну/параметр - у її функції,
// глобальне ім'я - в усіх файлах коду проєкту (окрім місць, де таке саме
// ім'я - своя локальна змінна).
func renameSymbol(word, nw) {
    var ed = currentEditor()
    if (ed == null || nw == word) { return }
    if (!symValidName(nw)) {
        setStatus("«" + nw + "» - не годиться як назва (букви, цифри, _; не слово мови)")
        return
    }
    var toks = edAllTokens(ed)
    var loc = symLocalDef(ed.lines, toks, word, ed.cy)
    if (loc != null) {
        var occ = symOccurrences(ed.lines, toks, word, loc[2][0], loc[2][1])
        edReplaceLines(ed, symReplace(ed.lines, occ, word, nw))
        setStatus("Перейменовано «" + word + "» → «" + nw + "»: " + toString(len(occ)) + " місць у функції")
        return
    }
    var total = 0
    var files = 0
    var group = []
    var paths = _projectCode()
    if (indexOf(paths, ed.path) < 0) { append(paths, ed.path) }
    for p in paths {
        var lines = _linesOf(p)
        var tk = symTokens(lines)
        var occ2 = []
        for o in symOccurrences(lines, tk, word, 0, len(lines) - 1) {
            // своя локальна змінна з таким ім'ям - не наша
            var ld = symLocalDef(lines, tk, word, o[0])
            if (ld == null) { append(occ2, o) }
        }
        if (len(occ2) == 0) { continue }
        var nl = symReplace(lines, occ2, word, nw)
        // кожен файл - у редакторі (навіть без вкладки), щоб Ctrl+Z
        // повернув перейменування в усіх разом; збереже saveAll
        if (!mapHas(app.editors, p)) { mapSet(app.editors, p, newEditor(readFile(p), p)) }
        var ped = mapGet(app.editors, p)
        edReplaceLines(ped, nl)
        append(group, [p, len(ped.undo)])
        total = total + len(occ2)
        files = files + 1
    }
    app.renameGroup = null
    if (len(group) > 1) { app.renameGroup = group }
    setStatus("Перейменовано «" + word + "» → «" + nw + "»: " + toString(total) + " місць у " + toString(files) + " файл(ах)")
}

// ---------- оновлення ----------

// Раз на день (і не під час тестів) - nx update-self --check у фоні.
// now - кнопка «Перевірити зараз» у Налаштуваннях.
func startUpdateCheck() { _startUpdateCheck(false) }

func _startUpdateCheck(now) {
    if (!now && (!app.cfg.updCheck || osEnv("NX_HEADLESS") == "1")) { return }
    if (!now && timestamp() - app.cfg.lastUpd < 86400) { return }
    // з клону репозиторію (версія "dev") окрема програма не оновлюється
    if (isStandalone(nxPath()) && IDE_VERSION == "dev") { return }
    app.updManual = now
    app.cfg.lastUpd = timestamp()
    saveSettings()
    var o = newMap()
    var env = newMap()
    mapSet(env, "NX_EXIT_WITH_PARENT", "1")
    mapSet(o, "env", env)
    try { app.updJob = procStart(nxPath(), updateArgs(nxPath(), true), o) } catch (e) { app.updJob = null }
}

// true - щось змінилось (плашка / кінець оновлення).
func pollUpdate() {
    var changed = false
    if (app.updJob != null && !procIsRunning(app.updJob)) {
        var out = procOutput(app.updJob)
        var info = parseUpdateCheck(out)
        app.updJob = null
        if (info != null) {
            app.updInfo = info
            changed = true
        } else if (app.updManual) {
            // натиснули «Перевірити зараз» - відповісти й тоді, коли оновлень нема
            if (contains(out, "найновіша") || contains(out, "нема релізів")) { setStatus("Оновлень нема - у тебе найновіша версія") }
            else { setStatus("Не вдалося перевірити оновлення (нема інтернету?)") }
            changed = true
        }
        app.updManual = false
    }
    // оновлення в терміналі завершилось
    if (app.updRunning && !app.term.running) {
        app.updRunning = false
        var ok = false
        if (contains(termText(app.term), "Готово: nx оновлено")) { ok = true }
        if (ok) {
            app.updInfo = null
            app.updDone = true
        } else { setStatus("Оновлення не вдалося - деталі в терміналі") }
        changed = true
    }
    return changed
}

func drawUpdateBanner(W, H) {
    var w = 380
    var text = ""
    if (app.updDone) { text = "Nx IDE оновлено! Перезапусти, щоб працювати в новій версії." }
    else if (installedByPackage(nxPath())) { text = "Вийшла Nx IDE " + app.updInfo[1] + " (у тебе " + app.updInfo[0] + "). Встановлено пакетом - скачай новий зі сторінки релізу." }
    else { text = "Вийшла нова версія Nx IDE " + app.updInfo[1] + " (у тебе " + app.updInfo[0] + ")." }
    var lines = wrapLines(text, w - 32, 16)
    var h = 74 + len(lines) * 20
    var x = W - w - 16
    var y = H - STATUS_H - h - 12
    surfaceRoundRect(S, x + 3, y + 3, w, h, 10, 0x88000000)
    surfaceRoundRect(S, x, y, w, h, 10, C_PANEL)
    surfaceRoundRect(S, x, y, 4, h, 2, C_GREEN)
    var ly = y + 14
    for l in lines {
        surfaceText(S, l, x + 16, ly, 16, C_TEXT)
        ly = ly + 20
    }
    var by = y + h - 44
    if (app.updDone) {
        uiButton("upd.restart", "Перезапустити", x + 16, by, 160, 32, "primary")
        uiButton("upd.later", "Пізніше", x + 184, by, 110, 32, "normal")
    } else if (app.updRunning) {
        surfaceText(S, "Оновлюю... (дивись термінал)", x + 16, by + 7, 16, C_SUBTEXT)
    } else if (installedByPackage(nxPath())) {
        uiButton("upd.page", "Сторінка релізу", x + 16, by, 170, 32, "primary")
        uiButton("upd.later", "Пізніше", x + 194, by, 110, 32, "normal")
    } else {
        uiButton("upd.go", "Оновити", x + 16, by, 120, 32, "primary")
        uiButton("upd.later", "Пізніше", x + 144, by, 110, 32, "normal")
    }
}

func updateAction(id) {
    if (id == "upd.later") {
        app.updInfo = null
        app.updDone = false
    }
    else if (id == "upd.go") {
        saveAll()
        saveSession()
        app.panelOpen = true
        app.panelTab = "terminal"
        if (app.term.running) { termStop(app.term) }
        termExec(app.term, "nx " + join(updateArgs(nxPath(), false), " "))
        app.updRunning = app.term.running
        if (!app.updRunning) { setStatus("Не вдалося запустити оновлення - деталі в терміналі") }
    }
    else if (id == "upd.page") {
        if (isStandalone(nxPath())) { openUrl(IDE_RELEASES_URL) } else { openUrl(RELEASES_URL) }
    }
    else if (id == "upd.check") {
        _startUpdateCheck(true)
        setStatus("Перевіряю оновлення...")
    }
    else if (id == "upd.restart") { restartIde() }
}

// Відкрити посилання в браузері системи.
func openUrl(url) {
    try {
        if (termIsWindows()) { procStart("cmd.exe", ["/c", "start", "", url]) }
        else if (contains(toLower(osPlatform()), "mac") || contains(toLower(osPlatform()), "darwin")) { procStart("open", [url]) }
        else { procStart("xdg-open", [url]) }
    } catch (e) { setStatus("Відкрий у браузері: " + url) }
}

var _quitRequested = false

// Новий процес IDE (окремо від цього - без NX_EXIT_WITH_PARENT і без труб
// вводу-виводу), а цей - зберегти й закритись.
func restartIde() {
    saveAll()
    saveSession()
    try {
        if (termIsWindows()) {
            var o = newMap()
            mapSet(o, "rawArgs", "/d /c start \"\" /min \"" + nxPath() + "\" ide \"" + app.dir + "\"")
            procStart("cmd.exe", [], o)
        } else {
            procStart("/bin/sh", ["-c", "nohup \"$0\" ide \"$1\" >/dev/null 2>&1 &", nxPath(), app.dir])
        }
        _quitRequested = true
    } catch (e) { setStatus("Не вдалося перезапустити - відкрий IDE ще раз сам(а)") }
}

// ---------- git ----------

func gitAction(id) {
    var g = app.git
    if (id == "git.init") {
        var r = gitRun(app.dir, ["init"])
        if (r[0] == 0) {
            // службова тека IDE - не в git (локально, без .gitignore)
            var ex = joinPath(app.dir, ".git/info/exclude")
            if (fileExists(ex)) { appendFile(ex, "\n# Nx IDE\n.nyx/\n") }
            setStatus("Репозиторій створено - тепер можна робити коміти")
        } else { g.msg = trim(r[2]) }
        gitRefresh(g, app.dir)
    }
    else if (id == "git.branches") { g.showBranches = !g.showBranches }
    else if (startsWith(id, "git.co:")) {
        saveAll()
        var b = substring(id, 7, len(id) - 7)
        var r2 = gitCheckout(g, b, false)
        g.msg = ""
        if (r2[0]) {
            setStatus("Гілка " + b)
            reloadFromDisk()
        } else { g.msg = r2[1] }
        g.showBranches = false
        gitRefresh(g, app.dir)
    }
    else if (id == "git.newbranch") { openDialog("Нова гілка: назва", "", "gitbranch") }
    else if (id == "git.commit") {
        saveAll()
        gitRefresh(g, app.dir)
        if (len(g.files) == 0) { g.msg = "Нема змін для коміту" }
        else {
            g.msg = ""
            var what = toString(len(g.files)) + " файл."
            if (g.staged > 0) { what = "вибрано " + toString(g.staged) + " з " + toString(len(g.files)) }
            openDialog("Коміт: що змінилось? (" + what + ")", "", "gitcommit")
        }
    }
    else if (id == "git.push" || id == "git.pull") {
        saveAll()
        app.panelOpen = true
        app.panelTab = "terminal"
        app.focus = "terminal"
        if (app.term.running) { termStop(app.term) }
        if (id == "git.push") {
            // гілка без upstream - одразу з -u, як пропонує сам git
            if (g.upstream) { termRunIn(app.term, app.dir, "git push") } else { termRunIn(app.term, app.dir, "git push -u origin " + g.branch) }
        } else { termRunIn(app.term, app.dir, "git pull") }
    }
    else if (startsWith(id, "git.file:")) {
        var p = substring(id, 9, len(id) - 9)
        g.sel = p
        g.scroll = 0
        var now = ""
        if (fileExists(p)) {
            if (mapHas(app.editors, p)) { now = edText(mapGet(app.editors, p)) } else { now = replace(readFile(p), "\r", "") }
        }
        g.diff = gitCompactDiff(diffLines(gitHeadText(g, p), now))
        if (fileExists(p) && fileKind(p) != "blocks") { openPath(p) }
    }
    else if (id == "git.back") { g.sel = "" }
    else if (startsWith(id, "git.sfile:")) { gitAction("git.file:" + substring(id, 10, len(id) - 10)) }
    else if (startsWith(id, "git.tab:")) {
        g.tab = substring(id, 8, len(id) - 8)
        g.listScroll = 0
        g.scroll = 0
        if (g.tab == "history") {
            g.log = gitLog(g)
            g.logSel = ""
            g.logFile = ""
        }
    }
    else if (id == "git.stageall" || startsWith(id, "git.stage:")) {
        saveAll()
        var sp = ""
        if (id != "git.stageall") { sp = substring(id, 10, len(id) - 10) }
        var sr = gitStage(g, sp)
        if (sr[0] != 0) { g.msg = split(trim(sr[2]), "\n")[0] } else { g.msg = "" }
        gitRefresh(g, app.dir)
    }
    else if (id == "git.unstageall" || startsWith(id, "git.unstage:")) {
        var up = ""
        if (id != "git.unstageall") { up = substring(id, 12, len(id) - 12) }
        var ur = gitUnstage(g, up)
        if (ur[0] != 0) { g.msg = split(trim(ur[2]), "\n")[0] } else { g.msg = "" }
        gitRefresh(g, app.dir)
    }
    else if (startsWith(id, "git.discard:")) {
        var dp = substring(id, 12, len(id) - 12)
        openDialog("Скасувати зміни в «" + fileName(dp) + "»?", "Файл стане як в останньому коміті (новий файл - видалиться). Це не можна скасувати.", "gitdiscard")
        app.dialog.target = dp
    }
    else if (startsWith(id, "git.commitsel:")) {
        g.logSel = substring(id, 14, len(id) - 14)
        g.logFiles = gitCommitFiles(g, g.logSel)
        g.logFile = ""
    }
    else if (startsWith(id, "git.logfile:")) {
        g.logFile = substring(id, 12, len(id) - 12)
        g.diff = gitCommitDiff(g, g.logSel, g.logFile)
        g.scroll = 0
    }
    else if (id == "git.logback") {
        if (g.logFile != "") { g.logFile = "" } else { g.logSel = "" }
    }
}

// Після перемикання гілки файли на диску інші - відкриті редактори перечитати.
func reloadFromDisk() {
    for p in mapKeys(app.editors) {
        var ed = mapGet(app.editors, p)
        if (fileExists(p)) { edSetText(ed, readFile(p)) }
        mapSet(_mtimes, p, fileModified(p))
        ed.dirty = false
    }
    for p2 in mapKeys(app.blocks) {
        if (fileExists(p2)) { mapSet(app.blocks, p2, newBlocksWs(p2, readFile(p2))) }
    }
    refreshFiles()
}

// "Відкрити як блоки": проста програма кодом стає програмою з блоків
// (code_to_blocks.nx). Чого блоками не скласти - пояснення в консолі.
func codeToBlocksFile(path) {
    if (path == "" || !endsWith(path, ".nx")) {
        setStatus("Відкрий файл коду (.nx), щоб зробити з нього блоки")
        return
    }
    var text = ""
    if (mapHas(app.editors, path)) { text = edText(mapGet(app.editors, path)) } else { text = readFile(path) }
    var r = codeToBlocks(text)
    var n = fileName(path)
    if (r[1] != "") {
        app.panelOpen = true
        app.panelTab = "console"
        conAdd(app.con, "Не вийшло зробити блоки з " + n + " - " + r[1], "err")
        conAdd(app.con, "Блоками стають прості програми: print, змінні, повторення, умови, малювання, свої функції.", "info")
        setStatus("Цю програму блоками не скласти (подробиці - в консолі)")
        return
    }
    var base = substring(n, 0, len(n) - 3)
    if (endsWith(base, " (код)")) { base = substring(base, 0, len(base) - 6) }
    base = base + " (блоки)"
    var dir = parentDir(path)
    var name = base + ".nxb"
    var i = 2
    while (fileExists(joinPath(dir, name))) {
        name = base + " " + toString(i) + ".nxb"
        i = i + 1
    }
    writeFile(joinPath(dir, name), stacksToJson(r[0]))
    setMode("blocks")
    openPath(joinPath(dir, name))
    setStatus("Блоки з коду відкрито як " + name)
}

// "Відкрити як код": код з блоків стає звичайною програмою .nx.
func blocksToCode() {
    var ws = currentBlocks()
    if (ws == null) { return }
    var g = generateCode(ws.stacks, blocksTitle(ws))
    var base = blocksTitle(ws) + " (код)"
    var name = base + ".nx"
    var i = 2
    while (fileExists(joinPath(app.dir, name))) {
        name = base + " " + toString(i) + ".nx"
        i = i + 1
    }
    writeFile(joinPath(app.dir, name), g[0])
    setMode("code")
    openFile(joinPath(app.dir, name))
    setStatus("Код з блоків відкрито як " + name)
}

// Після невдалого запуску - підказка простими словами (один раз на запуск).
func addErrorHints() {
    var con = app.con
    if (con.running || con.lastOk || con.runs == app.hintRun || con.runs == 0) { return }
    app.hintRun = con.runs
    if (!app.cfg.hints) { return }
    var errText = ""
    for l in con.lines {
        if (l[1] == "err" || l[1] == "out") { errText = errText + l[0] + "\n" }
    }
    var code = ""
    if (app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws != null) { code = generateCode(ws.stacks, "")[0] }
    } else {
        var ed = currentEditor()
        if (ed != null) { code = edText(ed) }
    }
    var hints = explainError(errText, code)
    var first = true
    var maxW = max(300, con.w - 40)
    for h in hints {
        var prefix = "          "
        if (first) { prefix = "Підказка: " }
        // перенос по ширині консолі (вона сама рядки не переносить)
        for l in wrapLines(h, maxW - textWidth(prefix, 16), 16) {
            conAdd(con, prefix + l, "hint")
            prefix = "          "
        }
        first = false
    }
}

// "Проблеми" від запуску: після кожного завершеного запуску - заново.
// Джерело "запуск"; проблеми розширень (інше джерело) не чіпаються.
func updateRunProblems() {
    var con = app.con
    if (con.running || con.runs == app.probRun) { return }
    app.probRun = con.runs
    var keep = []
    for p in app.problems { if (p[4] != "запуск") { append(keep, p) } }
    app.problems = keep
    if (con.lastOk) { return }
    var msg = "Програма зупинилась з помилкою"
    for l in con.lines {
        if (startsWith(l[0], "Runtime Error")) { msg = replace(l[0], "Runtime Error: ", "") }
    }
    var line = -1
    if (app.mode == "code") { line = con.errLine }
    var file = app.active
    insert(app.problems, 0, [file, line, msg, "error", "запуск"])
    var at = 1
    for l2 in con.lines {
        if (l2[1] == "hint") {
            insert(app.problems, at, [file, line, trim(replace(l2[0], "Підказка: ", "")), "info", "запуск"])
            at = at + 1
        }
    }
}

// Після завершення з помилкою - підсвітити рядок у редакторі й перейти до нього.
func afterPoll() {
    var con = app.con
    addErrorHints()
    updateRunProblems()
    if (!con.running && con.errLine >= 0 && app.mode == "blocks") {
        var ws = currentBlocks()
        if (ws != null && con.errLine < len(app.genMap)) {
            ws.errBlock = app.genMap[con.errLine]
            if (ws.errBlock != null) { setStatus("Помилка в блоці, що обведений червоним") }
        }
        con.errLine = -1
        return
    }
    if (!con.running && con.errLine >= 0) {
        var ed = currentEditor()
        if (ed != null) {
            ed.errLine = con.errLine
            if (ed.errLine < len(ed.lines)) { edGoToLine(ed, ed.errLine) }
            app.focus = "editor"
        }
        con.errLine = -1
    }
}

// ---------- діалог (назва нової програми, опис версії) ----------

struct Dialog {
    title: string
    text: string
    action: string
    okLabel: string
    suffix: string
    target: string
}

// action: "newcode" | "newblocks" | "version"
func openDialog(title, text, action) {
    var okLabel = "Створити"
    var suffix = ".nx"
    if (action == "newblocks") { suffix = ".nxb" }
    if (action == "version") {
        okLabel = "Зберегти"
        suffix = ""
    }
    if (action == "delete") {
        okLabel = "Видалити"
        suffix = ""
    }
    if (action == "gitdiscard") {
        okLabel = "Скасувати зміни"
        suffix = ""
    }
    if (action == "newblock" || action == "newext" || action == "gitcommit" || action == "gitbranch") { suffix = "" }
    if (action == "gitcommit") { okLabel = "Коміт" }
    if (action == "renamesym") {
        okLabel = "Перейменувати"
        suffix = ""
    }
    app.dialog = Dialog { title: title, text: text, action: action, okLabel: okLabel, suffix: suffix, target: "" }
    app.focus = "dialog"
}

func closeDialog(ok) {
    var d = app.dialog
    app.dialog = null
    app.focus = "editor"
    if (ok && d.action == "newcode") { newFile(d.text, "code") }
    if (ok && d.action == "newblocks") { newFile(d.text, "blocks") }
    if (ok && d.action == "version") { saveVersion(d.text) }
    if (ok && d.action == "delete") { deletePath(d.target) }
    if (ok && d.action == "gitdiscard") {
        var dr = gitDiscard(app.git, d.target)
        if (dr[0] != 0) { app.git.msg = split(trim(dr[2]), "\n")[0] }
        else {
            app.git.msg = ""
            if (!fileExists(d.target) && indexOf(app.tabs, d.target) >= 0) {
                mapRemove(app.editors, d.target)
                closeTab(d.target)
            }
            checkDiskChanges()
            refreshFiles()
            setStatus("Зміни в «" + fileName(d.target) + "» скасовано")
        }
        app.git.sel = ""
        gitRefresh(app.git, app.dir)
    }
    if (ok && d.action == "newext" && trim(d.text) != "") {
        var edir = extCreateTemplate(userExtDir(), d.text)
        reloadExtensions()
        openPath(edir + "/extension.json")
        openPath(edir + "/lint.nx")
        setStatus("Розширення «" + trim(d.text) + "» створено - зміни lint.nx і збережи будь-який .nx")
    }
    if (ok && d.action == "gitcommit") {
        saveAll()
        var cr = gitCommit(app.git, trim(d.text))
        app.git.msg = ""
        if (cr[0]) { setStatus("Коміт зроблено: " + cr[1]) } else { app.git.msg = cr[1] }
        app.git.sel = ""
        gitRefresh(app.git, app.dir)
    }
    if (ok && d.action == "gitbranch" && trim(d.text) != "") {
        var br = gitCheckout(app.git, replace(trim(d.text), " ", "-"), true)
        if (br[0]) { setStatus("Нова гілка: " + trim(d.text)) } else { app.git.msg = br[1] }
        app.git.showBranches = false
        gitRefresh(app.git, app.dir)
    }
    if (ok && d.action == "renamesym") { renameSymbol(d.target, trim(d.text)) }
    if (ok && d.action == "newblock") {
        var ws = currentBlocks()
        if (ws != null) {
            if (blocksNewCustom(ws, d.text)) {
                setStatus("Готово! Збери під «визначити», що робить блок, і став його з «Мої блоки»")
            } else { setStatus("Потрібна назва блока (і такого ще не має бути)") }
        }
    }
}

func drawDialog() {
    var d = app.dialog
    var W = surfaceWidth(S)
    var H = surfaceHeight(S)
    surfaceRect(S, 0, 0, W, H, 0x99000000)
    var w = 460
    var h = 170
    if (d.action == "newblock") { h = 200 }
    var x = toInt((W - w) / 2)
    var y = toInt((H - h) / 2)
    surfaceRoundRect(S, x, y, w, h, 10, C_PANEL)
    surfaceText(S, uiFit(d.title, w - 40, 20), x + 20, y + 18, 20, C_TEXT, true)
    if (dialogIsConfirm(d)) {
        // підтвердження: без поля вводу
        var ty = y + 60
        for l in wrapLines(d.text, w - 40, 15) {
            surfaceText(S, l, x + 20, ty, 15, C_SUBTEXT)
            ty = ty + 19
        }
        var okW = max(110, uiButtonW(d.okLabel))
        uiButton("dialog.cancel", "Скасувати", x + w - 30 - okW - 110, y + h - 52, 110, 34, "normal")
        uiButton("dialog.ok", d.okLabel, x + w - 20 - okW, y + h - 52, okW, 34, "danger")
        return
    }
    surfaceRoundRect(S, x + 20, y + 58, w - 40, 36, 6, C_ACCENT)
    surfaceRoundRect(S, x + 21, y + 59, w - 42, 34, 6, C_BG)
    var tw = surfaceText(S, d.text, x + 32, y + 68, 16, C_TEXT)
    surfaceRect(S, x + 33 + tw, y + 66, 2, 20, C_ACCENT)
    surfaceText(S, d.suffix, x + w - 30 - textWidth(d.suffix, 16), y + 68, 16, C_DIM)
    if (d.action == "newblock") {
        surfaceText(S, "Назва, параметри - у дужках: стрибнути (висота)", x + 20, y + 104, 14, C_DIM)
    }
    uiButton("dialog.cancel", "Скасувати", x + w - 250, y + h - 52, 110, 34, "normal")
    uiButton("dialog.ok", d.okLabel, x + w - 130, y + h - 52, 110, 34, "primary")
}

// Діалог-питання «так/ні» (без поля вводу).
func dialogIsConfirm(d) { return d.action == "delete" || d.action == "gitdiscard" }

func dialogKey(e) {
    var d = app.dialog
    if (e.key == "Enter") {
        closeDialog(true)
        return
    }
    if (e.key == "Escape") {
        closeDialog(false)
        return
    }
    if (dialogIsConfirm(d)) { return }
    if (e.key == "Backspace" && len(d.text) > 0) { d.text = uiDropLast(d.text) }
}

// ---------- палітра команд (Ctrl+Shift+P) і швидке відкриття (Ctrl+P) ----------

struct Palette {
    mode: string
    text: string
    sel: i32
    items: array
}

// [id, назва, клавіші] - команди, доступні з палітри
func commandList() {
    var list = [
        ["run", "Запустити програму", "F5"],
        ["stop", "Зупинити програму", "Shift+F5"],
        ["debug", "Запустити покроково", "F10"],
        ["save", "Зберегти все", "Ctrl+S"],
        ["newcode", "Нова програма (код)", "Ctrl+N"],
        ["newblocks", "Нова програма з блоків", ""],
        ["closetab", "Закрити вкладку", "Ctrl+W"],
        ["side.toggle", "Показати/сховати бічну панель", "Ctrl+B"],
        ["panel.toggle", "Показати/сховати нижню панель", "Ctrl+J"],
        ["act:files", "Провідник", ""],
        ["act:search", "Пошук у файлах", "Ctrl+Shift+F"],
        ["act:history", "Історія версій", ""],
        ["h.save", "Зберегти версію", ""],
        ["act:learn", "Навчання: уроки й приклади", ""],
        ["g.tour", "Знайомство з IDE (екскурсія)", ""],
        ["act:ext", "Розширення", ""],
        ["act:settings", "Налаштування", ""],
        ["find", "Знайти у файлі", "Ctrl+F"],
        ["gotodef", "Перейти до визначення", "F12"],
        ["split.toggle", "Розділити редактор / прибрати розділення", "Ctrl+\\"],
        ["renamesym", "Перейменувати всюди", "F2"],
        ["zoomin", "Збільшити шрифт", "Ctrl+="],
        ["zoomout", "Зменшити шрифт", "Ctrl+-"],
        ["btogglecode", "Блоки: показати/сховати код", ""],
        ["bopencode", "Блоки: відкрити як код", ""],
        ["codetoblocks", "Код: відкрити як блоки", ""],
        ["con.clear", "Очистити консоль", ""],
        ["terminal", "Термінал", "Ctrl+`"],
        ["stage.toggle", "Показати/сховати сцену", ""],
        ["quickopen", "Відкрити файл…", "Ctrl+P"],
        ["openfolder", "Відкрити теку…", "Ctrl+O"]
    ]
    for r in app.cfg.recent {
        if (r != app.dir) { append(list, ["folder:" + r, "Недавня тека: " + fileName(r) + "  (" + r + ")", ""]) }
    }
    for e in app.exts {
        if (!e.enabled) { continue }
        for c in e.commands { append(list, ["extcmd:" + e.id + ":" + c[0], e.name + ": " + c[1], ""]) }
    }
    return list
}

func openPalette(mode) {
    app.palette = Palette { mode: mode, text: "", sel: 0, items: [] }
    refreshPalette()
}

func refreshPalette() {
    var p = app.palette
    var q = toLower(p.text)
    var items = []
    if (p.mode == "files") {
        refreshFiles()
        for f in app.files {
            if (!f[3] && (q == "" || contains(toLower(f[1]), q))) { append(items, ["file:" + f[0], f[1], ""]) }
        }
    } else {
        for c in commandList() {
            var hide = (!app.cfg.blocks && (c[0] == "newblocks" || c[0] == "codetoblocks" || startsWith(c[0], "b"))) || (!app.cfg.lessons && c[0] == "act:learn")
            if (!hide && (q == "" || contains(toLower(c[1]), q))) { append(items, c) }
        }
    }
    p.items = slice(items, 0, min(len(items), 14))
    p.sel = clamp(p.sel, 0, max(0, len(p.items) - 1))
}

func paletteKey(e) {
    var p = app.palette
    var k = e.key
    if (k == "Escape") {
        app.palette = null
        return
    }
    if (k == "Down" && len(p.items) > 0) { p.sel = (p.sel + 1) % len(p.items) }
    else if (k == "Up" && len(p.items) > 0) { p.sel = (p.sel - 1 + len(p.items)) % len(p.items) }
    else if (k == "Enter") {
        if (len(p.items) > 0) {
            var id = p.items[p.sel][0]
            app.palette = null
            doAction(id)
        }
    }
    else if (k == "Backspace" && len(p.text) > 0) {
        p.text = uiDropLast(p.text)
        refreshPalette()
    }
}

func drawCmdPalette() {
    var p = app.palette
    var W = surfaceWidth(S)
    var w = min(620, W - 40)
    var x = toInt((W - w) / 2)
    var y = TITLE_H + 6
    var rowH = 26
    var h = 48 + len(p.items) * rowH + 8
    surfaceRoundRect(S, x + 4, y + 4, w, h, 8, 0x88000000)
    surfaceRoundRect(S, x, y, w, h, 8, C_PANEL)
    uiRegion("pal.box", x, y, w, h)
    surfaceRoundRect(S, x + 8, y + 8, w - 16, 32, 6, C_ACCENT)
    surfaceRoundRect(S, x + 9, y + 9, w - 18, 30, 6, C_BG)
    var prefix = "> "
    if (p.mode == "files") { prefix = "" }
    var tw = surfaceText(S, prefix + p.text, x + 18, y + 16, 16, C_TEXT)
    surfaceRect(S, x + 19 + tw, y + 14, 2, 20, C_ACCENT)
    if (p.text == "") {
        var hint = "Назва команди…"
        if (p.mode == "files") { hint = "Назва файла…" }
        surfaceText(S, hint, x + 28 + tw, y + 16, 16, C_DIM)
    }
    var iy = y + 48
    var i = 0
    while (i < len(p.items)) {
        var it = p.items[i]
        if (i == p.sel) { surfaceRoundRect(S, x + 6, iy, w - 12, rowH, 5, C_SURFACE2) }
        if (p.mode == "files") {
            iconFileKind(fileKind(it[1]), x + 14, iy + 3, 20, C_SUBTEXT)
            surfaceText(S, it[1], x + 42, iy + 5, 16, C_TEXT)
        } else {
            surfaceText(S, it[1], x + 16, iy + 5, 16, C_TEXT)
            if (it[2] != "") { surfaceText(S, it[2], x + w - 16 - textWidth(it[2], 14), iy + 6, 14, C_DIM) }
        }
        uiRegion("pal:" + toString(i), x + 6, iy, w - 12, rowH)
        iy = iy + rowH
        i = i + 1
    }
}

// ---------- пошук у файлах ----------

func runSearch() {
    app.searchResults = []
    var q = toLower(app.searchText)
    if (len(q) < 2) { return }
    for f in _allFiles(app.dir, 0) {
        if (fileKind(f) == "blocks") { continue }
        var lines = []
        try { lines = split(readFile(f), "\n") } catch (e) { continue }
        var ln = 0
        while (ln < len(lines)) {
            if (contains(toLower(lines[ln]), q)) {
                append(app.searchResults, [f, ln, trim(lines[ln])])
                if (len(app.searchResults) >= 200) { return }
            }
            ln = ln + 1
        }
    }
}

// Усі файли теки рекурсивно (без прихованих і великих службових тек).
func _allFiles(dir, depth) {
    var out = []
    if (depth > 6) { return out }
    var names = []
    try { names = listDir(dir) } catch (e) { return out }
    for n in names {
        if (startsWith(n, ".") || indexOf(SKIP_DIRS, n) >= 0) { continue }
        var p = joinPath(dir, n)
        if (dirExists(p)) { for x in _allFiles(p, depth + 1) { append(out, x) } }
        else { append(out, p) }
    }
    return out
}

// ---------- налаштування, рівень, пропозиції гайду ----------

struct Settings {
    level: string
    blocks: bool
    lessons: bool
    hints: bool
    offers: bool
    seen: array
    extOff: array
    pixelFont: bool
    uiScale: i32
    theme: string
    updCheck: bool
    lastUpd: i32
    recent: array
    sideW: i32
    sideOverlay: bool
    anim: bool
    edFont: i32
    tabSize: i32
    autoClose: bool
    termFont: i32
}

// Глобальні налаштування (однакові для всіх тек): ~/.nyx-ide/налаштування.json,
// або шлях з NYX_IDE_CONFIG (тести - щоб не чіпати справжні налаштування).
func configPath() {
    var p = osEnv("NYX_IDE_CONFIG")
    if (p != null && p != "") { return p }
    return joinPath(joinPath(homeDir(), ".nyx-ide"), "налаштування.json")
}

func _numOf(m, k) {
    if (!mapHas(m, k)) { return 0 }
    return toInt(mapGet(m, k))
}

func _themeOf(m) {
    if (!mapHas(m, "theme")) { return "dark" }
    return toString(mapGet(m, "theme"))
}

func _scaleOf(m) {
    if (!mapHas(m, "uiScale")) { return 100 }
    return clamp(toInt(mapGet(m, "uiScale")), 50, 300)
}

func _strList(m, k) {
    var out = []
    if (mapHas(m, k)) { for x in mapGet(m, k) { append(out, toString(x)) } }
    return out
}

func _boolOf(m, k, def) {
    if (!mapHas(m, k)) { return def }
    return mapGet(m, k) == true
}

func _intOf(m, k, def, lo, hi) {
    if (!mapHas(m, k)) { return def }
    return clamp(toInt(mapGet(m, k)), lo, hi)
}

func loadSettings() {
    var path = configPath()
    if (!fileExists(path)) { return null }
    try {
        var m = fromJson(readFile(path))
        var c = defaultSettings(toString(mapGet(m, "level")))
        c.blocks = _boolOf(m, "blocks", c.blocks)
        c.lessons = _boolOf(m, "lessons", c.lessons)
        c.hints = _boolOf(m, "hints", c.hints)
        c.offers = _boolOf(m, "offers", c.offers)
        c.seen = _strList(m, "seen")
        c.extOff = _strList(m, "extOff")
        c.pixelFont = _boolOf(m, "pixelFont", false)
        c.uiScale = _scaleOf(m)
        c.theme = _themeOf(m)
        c.updCheck = _boolOf(m, "updCheck", true)
        c.lastUpd = _numOf(m, "lastUpd")
        c.recent = _strList(m, "recent")
        c.sideW = _intOf(m, "sideW", 270, 160, 900)
        c.sideOverlay = _boolOf(m, "sideOverlay", false)
        c.anim = _boolOf(m, "anim", true)
        c.edFont = _intOf(m, "edFont", 16, 10, 40)
        c.tabSize = _intOf(m, "tabSize", 4, 2, 8)
        c.autoClose = _boolOf(m, "autoClose", true)
        c.termFont = _intOf(m, "termFont", 15, 10, 30)
        return c
    } catch (e) { return null }
}

func saveSettings() {
    var c = app.cfg
    var m = newMap()
    mapSet(m, "level", c.level)
    mapSet(m, "blocks", c.blocks)
    mapSet(m, "lessons", c.lessons)
    mapSet(m, "hints", c.hints)
    mapSet(m, "offers", c.offers)
    mapSet(m, "seen", c.seen)
    mapSet(m, "extOff", c.extOff)
    mapSet(m, "pixelFont", c.pixelFont)
    mapSet(m, "uiScale", c.uiScale)
    mapSet(m, "theme", c.theme)
    mapSet(m, "updCheck", c.updCheck)
    mapSet(m, "lastUpd", c.lastUpd)
    mapSet(m, "recent", c.recent)
    mapSet(m, "sideW", c.sideW)
    mapSet(m, "sideOverlay", c.sideOverlay)
    mapSet(m, "anim", c.anim)
    mapSet(m, "edFont", c.edFont)
    mapSet(m, "tabSize", c.tabSize)
    mapSet(m, "autoClose", c.autoClose)
    mapSet(m, "termFont", c.termFont)
    var path = configPath()
    var parts = split(replace(path, "\\", "/"), "/")
    var dir = substring(path, 0, len(path) - len(parts[len(parts) - 1]) - 1)
    if (dir != "" && !dirExists(dir)) { makeDir(dir) }
    writeFile(path, toJson(m))
}

func defaultSettings(level) {
    if (level != "beginner" && level != "middle" && level != "advanced") { level = "beginner" }
    var adv = level == "advanced"
    return Settings { level: level, blocks: !adv, lessons: !adv, hints: !adv, offers: true, seen: [], extOff: [], pixelFont: false,
        uiScale: 100, theme: "dark", updCheck: true, lastUpd: 0, recent: [], sideW: 270, sideOverlay: false, anim: true,
        edFont: 16, tabSize: 4, autoClose: true, termFont: 15 }
}

var LEVELS = [["beginner", "Новачок", "Ніколи не програмував(ла) або тільки починаю"],
              ["middle", "Середній", "Вже трохи писав(ла) код, але IDE нова"],
              ["advanced", "Просунутий", "Пишу програми; блоки й уроки не потрібні"]]

// Вибір рівня (перший запуск або в Налаштуваннях): виставляє налаштування.
func applyLevel(level, firstRun) {
    // рівень міняє лише те, що від нього залежить (решта налаштувань - як були)
    var d = defaultSettings(level)
    if (app.cfg == null) { app.cfg = d }
    app.cfg.level = d.level
    app.cfg.blocks = d.blocks
    app.cfg.lessons = d.lessons
    app.cfg.hints = d.hints
    app.askLevel = false
    saveSettings()
    if (!firstRun) { return }
    if (level == "beginner") {
        // новачкові - одразу: екскурсія, потім урок 1
        app.mode = "blocks"
        openLesson(0)
        startTour(true)
    } else {
        // іншим гайд не нав'язуємо - лише пропонуємо (з кнопкою "Не треба")
        offerOnce("tour")
    }
}

// Пропозиції гайду: ключ -> [текст, дія кнопки "Показати"].
func offerInfo(key) {
    if (key == "tour") { return ["Показати, що де в Nyx IDE? (коротка екскурсія)", "g.tour"] }
    if (key == "blocks") { return ["Показати, як складати програму з блоків?", "offer.blocks"] }
    if (key == "code") { return ["Показати основи коду NyxilumLang?", "offer.code"] }
    if (key == "history") { return ["Пояснити, як працює історія версій?", "offer.history"] }
    if (key == "ext") { return ["Пояснити, що таке розширення?", "offer.ext"] }
    return null
}

// Запропонувати (один раз на ключ, якщо пропозиції ввімкнено).
func offerOnce(key) {
    if (app.cfg == null || !app.cfg.offers || app.tour >= 0 || app.demo != null) { return }
    if (indexOf(app.cfg.seen, key) >= 0) { return }
    // пропозиції-уроки - лише коли уроки ввімкнено
    if (!app.cfg.lessons && (key == "blocks" || key == "code")) { return }
    app.offer = key
}

func dismissOffer(forever) {
    if (app.offer != null) {
        append(app.cfg.seen, app.offer)
        app.offer = null
    }
    if (forever) { app.cfg.offers = false }
    saveSettings()
}

func drawOffer(W, H) {
    var info = offerInfo(app.offer)
    if (info == null) { return }
    var w = 360
    var lines = wrapLines(info[0], w - 32, 16)
    var h = 74 + len(lines) * 20
    var x = W - w - 16
    var y = H - STATUS_H - h - 12
    surfaceRoundRect(S, x + 3, y + 3, w, h, 10, 0x88000000)
    surfaceRoundRect(S, x, y, w, h, 10, C_PANEL)
    surfaceRoundRect(S, x, y, 4, h, 2, C_YELLOW)
    var ly = y + 14
    for l in lines {
        surfaceText(S, l, x + 16, ly, 16, C_TEXT)
        ly = ly + 20
    }
    uiButton("offer.yes", "Показати", x + 16, y + h - 44, 110, 32, "primary")
    uiButton("offer.no", "Не треба", x + 134, y + h - 44, 100, 32, "normal")
    uiButton("offer.never", "Не пропонувати", x + 240, y + h - 44, w - 252, 32, "flat")
}

func offerAction(id) {
    var key = app.offer
    if (id == "offer.no") {
        dismissOffer(false)
        return
    }
    if (id == "offer.never") {
        dismissOffer(true)
        setStatus("Гайд більше не пропонуватиметься (увімкнути - у Налаштуваннях)")
        return
    }
    if (id == "offer.yes") {
        var info = offerInfo(key)
        dismissOffer(false)
        doAction(info[1])
        return
    }
    // дії "Показати"
    if (id == "offer.blocks") {
        app.side = "learn"
        openLesson(0)
        startDemo(LESSONS[0].demo, true)
    } else if (id == "offer.code") {
        app.side = "learn"
        app.guideTab = "lessons"
        app.guideLesson = firstCodeLesson()
    } else if (id == "offer.history") {
        startTour(false)
        tourGo(9)
    } else if (id == "offer.ext") {
        setStatus("Розширення - окремі програми .nx, які додають IDE нові можливості (наприклад, перевірку коду Anylint).")
    }
}

func drawLevelAsk(W, H) {
    surfaceRect(S, 0, 0, W, H, 0xcc000000)
    var w = min(760, W - 40)
    var h = 330
    var x = toInt((W - w) / 2)
    var y = toInt((H - h) / 2)
    surfaceRoundRect(S, x, y, w, h, 14, C_PANEL)
    surfaceText(S, "Привіт! Хто ти в програмуванні?", x + 28, y + 26, 24, C_TEXT, true)
    surfaceText(S, "Від цього залежить, скільки IDE підказуватиме. Змінити можна будь-коли в Налаштуваннях.", x + 28, y + 64, 14, C_SUBTEXT)
    var cw = toInt((w - 56 - 24) / 3)
    var i = 0
    while (i < len(LEVELS)) {
        var lv = LEVELS[i]
        var cx = x + 28 + i * (cw + 12)
        var cy = y + 100
        var ch = 190
        var hover = uiHover(cx, cy, cw, ch)
        var bg = C_SURFACE
        if (hover) { bg = C_SURFACE2 }
        surfaceRoundRect(S, cx, cy, cw, ch, 10, bg)
        var colors = [C_GREEN, C_ACCENT, C_MAUVE]
        surfaceRoundRect(S, cx, cy, cw, 6, 3, colors[i])
        surfaceText(S, lv[1], cx + 16, cy + 22, 20, C_TEXT, true)
        var ly = cy + 60
        for l in wrapLines(lv[2], cw - 32, 14) {
            surfaceText(S, l, cx + 16, ly, 14, C_SUBTEXT)
            ly = ly + 18
        }
        var what = "Екскурсія й уроки одразу"
        if (lv[0] == "middle") { what = "Блоки й уроки є, гайд - за бажанням" }
        if (lv[0] == "advanced") { what = "Без блоків і уроків (можна ввімкнути)" }
        var wl = wrapLines(what, cw - 32, 12)
        var wy = cy + ch - 14 - len(wl) * 16
        for l2 in wl {
            surfaceText(S, l2, cx + 16, wy, 12, C_DIM)
            wy = wy + 16
        }
        uiRegion("level:" + lv[0], cx, cy, cw, ch)
        i = i + 1
    }
}

// Перемикач у Налаштуваннях.
func _toggle(id, label, on, x, y, w) {
    if (uiHover(x, y, w, 30)) { surfaceRoundRect(S, x, y, w, 30, 6, C_BG) }
    var tx = x + w - 52
    // повзунок їде плавно
    var target = 0
    if (on) { target = 1 }
    var t = uiAnim("tg:" + id, target, 150)
    surfaceRoundRect(S, tx, y + 6, 40, 18, 9, uiMix(C_SURFACE2, C_GREEN, t))
    var knob = tx + 3 + toInt(22 * t)
    surfaceCircle(S, knob + 6, y + 15, 7, 0xffffff)
    surfaceText(S, label, x + 10, y + 7, 16, C_TEXT)
    uiRegion(id, x, y, w, 30)
}

