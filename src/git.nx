// Git у Nx IDE (як «Система контролю версій» у VS Code): гілка, змінені
// файли (і літери біля них у Провіднику), різниця з останнім комітом,
// вибір файлів для коміту (+ / −), скасування змін файла, коміт, гілки,
// історія комітів (що змінилось у кожному), push/pull (у терміналі - там
// видно, що відповідає сервер, і там же можна ввести пароль).
//
// Усе через програму git (procRun); якщо її нема - панель пояснює, що
// встановити. «Історія версій» - наш маленький git для новачків; ця
// панель - справжній, для проєктів на GitHub.

import "theme.nx"
import "ui.nx"
import "history.nx"
import "icons.nx"

struct GitInfo {
    available: bool
    isRepo: bool
    root: string
    branch: string
    files: array
    byPath: any
    branches: array
    ahead: i32
    behind: i32
    upstream: bool
    stale: bool
    last: i32
    sel: string
    diff: array
    scroll: i32
    showBranches: bool
    msg: string
    tab: string
    log: array
    logSel: string
    logFiles: array
    logFile: string
    listScroll: i32
    staged: i32
}

func newGitInfo() {
    return GitInfo { available: true, isRepo: false, root: "", branch: "", files: [], byPath: newMap(), branches: [],
        ahead: 0, behind: 0, upstream: false, stale: true, last: 0, sel: "", diff: [], scroll: 0, showBranches: false, msg: "",
        tab: "changes", log: [], logSel: "", logFiles: [], logFile: "", listScroll: 0, staged: 0 }
}

// [код виходу, stdout, stderr]; код -1 - git не запустився.
func gitRun(dir, args) {
    var o = newMap()
    mapSet(o, "cwd", dir)
    try {
        var r = procRun("git", args, o)
        return [toInt(r.exitCode), r.stdout, r.stderr]
    } catch (e) {
        return [-1, "", toString(e)]
    }
}

func _gitLines(text) {
    var out = []
    for l in split(replace(text, "\r", ""), "\n") { if (trim(l) != "") { append(out, l) } }
    return out
}

// Літера стану з двох символів "XY" git status --porcelain.
func gitLetter(xy) {
    if (xy == "??") { return "U" }
    var x = xy[0]
    var y = xy[1]
    if (x == "D" || y == "D") { return "D" }
    if (x == "A") { return "A" }
    if (x == "R") { return "R" }
    if (x == "U" || y == "U") { return "!" }
    return "M"
}

func gitLetterColor(l) {
    if (l == "U" || l == "A") { return C_GREEN }
    if (l == "D" || l == "!") { return C_RED }
    if (l == "R") { return C_ACCENT }
    return C_YELLOW
}

func gitLetterName(l) {
    if (l == "U") { return "новий" }
    if (l == "A") { return "доданий" }
    if (l == "D") { return "видалений" }
    if (l == "R") { return "перейменований" }
    if (l == "!") { return "конфлікт" }
    return "змінений"
}

// Перечитати стан репозиторію теки dir.
func gitRefresh(g, dir) {
    g.stale = false
    g.last = timeMs()
    var r = gitRun(dir, ["rev-parse", "--show-toplevel"])
    if (r[0] == -1) {
        g.available = false
        g.isRepo = false
        return
    }
    g.available = true
    if (r[0] != 0) {
        g.isRepo = false
        g.files = []
        g.byPath = newMap()
        return
    }
    g.isRepo = true
    g.root = trim(r[1])
    _gitExcludeNyx(g.root)
    g.branch = trim(gitRun(dir, ["branch", "--show-current"])[1])
    if (g.branch == "") { g.branch = "(без гілки)" }
    var files = []
    var byPath = newMap()
    var nStaged = 0
    for l in _gitLines(gitRun(dir, ["-c", "core.quotePath=false", "status", "--porcelain=v1", "-uall"])[1]) {
        if (len(l) < 4) { continue }
        var xy = substring(l, 0, 2)
        var rel = substring(l, 3, len(l) - 3)
        var arrow = indexOf(rel, " -> ")
        if (arrow >= 0) { rel = substring(rel, arrow + 4, len(rel) - arrow - 4) }
        if (startsWith(rel, "\"") && endsWith(rel, "\"")) { rel = _gitUnquote(substring(rel, 1, len(rel) - 2)) }
        // службова тека IDE (уроки, сцена, історія версій) - не проєкт
        if (startsWith(rel, ".nyx/") || contains(rel, "/.nyx/")) { continue }
        var absP = g.root + "/" + rel
        var letter = gitLetter(xy)
        // [літера, шлях у репо, повний шлях, у підготовлених, є непідготовлені зміни]
        var inIndex = xy[0] != " " && xy[0] != "?"
        var inTree = xy[1] != " "
        if (inIndex) { nStaged = nStaged + 1 }
        append(files, [letter, rel, absP, inIndex, inTree])
        mapSet(byPath, absP, letter)
    }
    g.staged = nStaged
    g.files = files
    g.byPath = byPath
    g.branches = []
    for b in _gitLines(gitRun(dir, ["branch", "--format=%(refname:short)"])[1]) { append(g.branches, trim(b)) }
    var ab = gitRun(dir, ["rev-list", "--left-right", "--count", "@{u}...HEAD"])
    g.upstream = ab[0] == 0
    g.ahead = 0
    g.behind = 0
    if (g.upstream) {
        var parts = split(replace(trim(ab[1]), "\t", " "), " ")
        if (len(parts) >= 2) {
            g.behind = toInt(parts[0])
            g.ahead = toInt(parts[len(parts) - 1])
        }
    }
}

// Службова тека IDE (.nyx/ - уроки, сесія, сцена) не має потрапляти в
// коміти - і тоді, коли репозиторій створено не кнопкою, а в терміналі.
// Локально (.git/info/exclude), без .gitignore у проєкті.
func _gitExcludeNyx(root) {
    var ex = root + "/.git/info/exclude"
    if (!dirExists(root + "/.git/info")) { return }
    var cur = ""
    if (fileExists(ex)) { cur = readFile(ex) }
    if (contains(cur, ".nyx/")) { return }
    try { appendFile(ex, "\n# Nx IDE\n.nyx/\n") } catch (e) { }
}

// Назва в лапках (є \" чи \\): прибрати екранування.
func _gitUnquote(s) {
    var out = ""
    var i = 0
    while (i < len(s)) {
        if (s[i] == "\\" && i + 1 < len(s)) {
            out = out + s[i + 1]
            i = i + 2
            continue
        }
        out = out + s[i]
        i = i + 1
    }
    return out
}

func _gitBase(p) {
    var parts = split(replace(p, "\\", "/"), "/")
    return parts[len(parts) - 1]
}

// Вміст файла в останньому коміті ("" - файла там ще нема).
func gitHeadText(g, path) {
    if (!startsWith(path, g.root + "/")) { return "" }
    var rel = substring(path, len(g.root) + 1, len(path) - len(g.root) - 1)
    var r = gitRun(g.root, ["show", "HEAD:" + rel])
    if (r[0] != 0) { return "" }
    return replace(r[1], "\r", "")
}

// Коміт: підготовлені файли, а якщо їх нема - усі зміни. [вдалося, повідомлення].
func gitCommit(g, msg) {
    if (g.staged == 0) {
        var a = gitRun(g.root, ["add", "-A"])
        if (a[0] != 0) { return [false, trim(a[2])] }
    }
    var c = gitRun(g.root, ["commit", "-m", msg])
    if (c[0] != 0) {
        var why = trim(c[2] + "\n" + c[1])
        if (contains(why, "user.email") || contains(why, "user.name") || contains(why, "Please tell me who you are")) {
            why = "git не знає, хто ти: у терміналі виконай  git config --global user.name \"Ім'я\"  і  git config --global user.email \"пошта\""
        }
        if (contains(why, "nothing to commit")) { why = "Нема змін для коміту" }
        return [false, split(why, "\n")[0]]
    }
    return [true, split(trim(c[1]), "\n")[0]]
}

func _gitRel(g, path) {
    if (startsWith(path, g.root + "/")) { return substring(path, len(g.root) + 1, len(path) - len(g.root) - 1) }
    return path
}

// Підготувати файл до коміту (git add). "" - усі.
func gitStage(g, path) {
    if (path == "") { return gitRun(g.root, ["add", "-A"]) }
    return gitRun(g.root, ["add", "-A", "--", _gitRel(g, path)])
}

// Прибрати з підготовлених (зміни у файлі лишаються). "" - усі.
func gitUnstage(g, path) {
    var args = ["restore", "--staged", "--"]
    if (path == "") { append(args, ".") } else { append(args, _gitRel(g, path)) }
    var r = gitRun(g.root, args)
    if (r[0] != 0) {
        // ще жодного коміту - restore нема з чим порівнювати
        var a2 = ["rm", "--cached", "-r", "-q", "--"]
        if (path == "") { append(a2, ".") } else { append(a2, _gitRel(g, path)) }
        r = gitRun(g.root, a2)
    }
    return r
}

// Скасувати зміни файла - як в останньому коміті (новий файл - видалити).
func gitDiscard(g, path) {
    var rel = _gitRel(g, path)
    var known = gitRun(g.root, ["ls-files", "--error-unmatch", "--", rel])[0] == 0
    var inHead = gitRun(g.root, ["cat-file", "-e", "HEAD:" + rel])[0] == 0
    if (!known && !inHead) {
        if (fileExists(path)) { deleteFile(path) }
        return [0, "", ""]
    }
    if (!inHead) {
        // доданий, але ще не в коміті: прибрати з індексу й видалити
        gitRun(g.root, ["rm", "--cached", "-q", "--", rel])
        if (fileExists(path)) { deleteFile(path) }
        return [0, "", ""]
    }
    return gitRun(g.root, ["restore", "--staged", "--worktree", "--source=HEAD", "--", rel])
}

// Історія: [повний хеш, короткий, автор, коли, повідомлення].
func gitLog(g) {
    var out = []
    var sep = fromCharCode(31)
    var r = gitRun(g.root, ["log", "-n", "300", "--format=%H" + "%x1f" + "%h" + "%x1f" + "%an" + "%x1f" + "%ar" + "%x1f" + "%s"])
    if (r[0] != 0) { return out }
    for l in _gitLines(r[1]) {
        var p = split(l, sep)
        if (len(p) >= 5) { append(out, [p[0], p[1], p[2], p[3], p[4]]) }
    }
    return out
}

// Файли коміту: [літера, шлях].
func gitCommitFiles(g, hash) {
    var out = []
    var r = gitRun(g.root, ["-c", "core.quotePath=false", "show", "--name-status", "--format=", "-M", hash])
    for l in _gitLines(r[1]) {
        var p = split(l, "\t")
        if (len(p) < 2) { continue }
        var letter = p[0][0]
        if (letter == "?") { letter = "U" }
        append(out, [letter, p[len(p) - 1]])
    }
    return out
}

// Що змінилось у файлі в цьому коміті: [знак, текст], як gitCompactDiff.
func gitCommitDiff(g, hash, rel) {
    var out = []
    var r = gitRun(g.root, ["-c", "core.quotePath=false", "show", "--format=", "-M", hash, "--", rel])
    var body = false
    for l in split(replace(r[1], "\r", ""), "\n") {
        if (startsWith(l, "@@")) {
            if (len(out) > 0) { append(out, [" ", "..."]) }
            body = true
            continue
        }
        if (!body) { continue }
        if (startsWith(l, "diff --git")) {
            body = false
            continue
        }
        if (startsWith(l, "\\")) { continue }
        if (len(l) == 0) { continue }
        append(out, [l[0], substring(l, 1, len(l) - 1)])
    }
    if (len(out) == 0 && contains(r[1], "Binary")) { append(out, [" ", "(двійковий файл)"]) }
    return out
}

func gitCheckout(g, branch, create) {
    var args = ["checkout", branch]
    if (create) { args = ["checkout", "-b", branch] }
    var r = gitRun(g.root, args)
    if (r[0] != 0) {
        var why = trim(r[2])
        if (contains(why, "would be overwritten")) { why = "Спершу зроби коміт - є незбережені в git зміни, які перемкнення затерло б" }
        return [false, split(why, "\n")[0]]
    }
    return [true, ""]
}

// ---------- панель ----------

var GIT_TIP = ""

func drawGit(g, x, y, w, h) {
    GIT_TIP = ""
    surfaceClip(S, x, y, w, h)
    var cy = y + 4
    if (!g.available) {
        for l in wrapLines("Програму git не знайдено. Встанови її (git-scm.com або «sudo apt install git») і перезапусти IDE.", w - 28, 14) {
            surfaceText(S, l, x + 14, cy, 14, C_SUBTEXT)
            cy = cy + 18
        }
        surfaceUnclip(S)
        return
    }
    if (!g.isRepo) {
        for l in wrapLines("Ця тека ще не git-репозиторій. Git зберігає історію проєкту (коміти) і дає викласти його на GitHub. Як «Історія версій», лише для справжніх проєктів.", w - 28, 14) {
            surfaceText(S, l, x + 14, cy, 14, C_SUBTEXT)
            cy = cy + 18
        }
        uiButton("git.init", "Створити репозиторій (git init)", x + 12, cy + 10, w - 24, 32, "primary")
        surfaceUnclip(S)
        return
    }
    // гілка і синхронізація
    var bw = surfaceText(S, "Гілка:", x + 14, cy + 6, 14, C_DIM)
    var bbw = w - bw - 120
    uiButton("git.branches", uiFit(g.branch, bbw - 30, 14), x + 20 + bw, cy, bbw, 28, "normal")
    // шеврон "розкрити" (у шрифті нема ▾)
    var chx = x + 20 + bw + bbw - 16
    surfaceLine(S, chx - 4, cy + 12, chx, cy + 16, C_SUBTEXT, 2)
    surfaceLine(S, chx, cy + 16, chx + 4, cy + 12, C_SUBTEXT, 2)
    if (g.upstream) {
        var sync = "↑" + toString(g.ahead) + " ↓" + toString(g.behind)
        surfaceText(S, sync, x + w - 90, cy + 6, 14, C_SUBTEXT)
    }
    cy = cy + 36
    if (g.showBranches) {
        for b in g.branches {
            var on = b == g.branch
            if (uiHover(x + 8, cy, w - 16, 26)) { surfaceRoundRect(S, x + 8, cy, w - 16, 26, 4, C_SURFACE) }
            if (on) { surfaceCircle(S, x + 20, cy + 13, 4, C_GREEN) }
            surfaceText(S, b, x + 32, cy + 5, 14, C_TEXT, on)
            uiRegion("git.co:" + b, x + 8, cy, w - 16, 26)
            cy = cy + 28
        }
        uiButton("git.newbranch", "+ Нова гілка", x + 12, cy + 2, w - 24, 28, "flat")
        cy = cy + 40
    }
    var half = toInt((w - 32) / 3)
    var commitLabel = "Коміт"
    if (g.staged > 0) { commitLabel = "Коміт (" + toString(g.staged) + ")" }
    uiButton("git.commit", commitLabel, x + 12, cy, half, 30, "primary")
    uiButton("git.pull", "Pull", x + 16 + half, cy, half, 30, "normal")
    uiButton("git.push", "Push", x + 20 + half * 2, cy, half, 30, "normal")
    cy = cy + 40
    if (g.msg != "") {
        for l in wrapLines(g.msg, w - 28, 13) {
            surfaceText(S, l, x + 14, cy, 13, C_YELLOW)
            cy = cy + 17
        }
        cy = cy + 4
    }
    // вкладки: зміни / історія
    var tabW = toInt((w - 28) / 2)
    var tabs = [["changes", "Зміни"], ["history", "Історія"]]
    var ti = 0
    while (ti < 2) {
        var tx = x + 12 + ti * (tabW + 4)
        var on = g.tab == tabs[ti][0]
        if (on) { surfaceRoundRect(S, tx, cy, tabW, 26, 4, C_SURFACE) }
        else if (uiHover(tx, cy, tabW, 26)) { surfaceRoundRect(S, tx, cy, tabW, 26, 4, C_BG) }
        var col = C_DIM
        if (on) { col = C_TEXT }
        var lw = textWidth(tabs[ti][1], 14)
        surfaceText(S, tabs[ti][1], tx + toInt((tabW - lw) / 2), cy + 5, 14, col, on)
        uiRegion("git.tab:" + tabs[ti][0], tx, cy, tabW, 26)
        ti = ti + 1
    }
    cy = cy + 34

    if (g.tab == "history") {
        _drawHistory(g, x, cy, w, y + h - cy)
        surfaceUnclip(S)
        return
    }
    if (g.sel != "") {
        uiButton("git.back", "← Усі зміни", x + 8, cy, 130, 28, "flat")
        cy = cy + 34
        surfaceText(S, uiFit(_gitBase(g.sel), w - 28, 14), x + 14, cy, 14, C_TEXT, true)
        cy = cy + 22
        surfaceText(S, "Що змінилось після останнього коміту:", x + 14, cy, 13, C_DIM)
        cy = cy + 22
        _drawDiff(g.diff, g.scroll, x, cy, w, y + h - cy)
        uiRegion("git.diff", x, cy, w, y + h - cy)
        surfaceUnclip(S)
        return
    }
    if (len(g.files) == 0) {
        surfaceText(S, "Усе збережено в коміті - змін нема.", x + 14, cy, 14, C_DIM)
        surfaceUnclip(S)
        return
    }
    // список: підготовлені до коміту, далі решта змін (прокручується)
    var listTop = cy
    uiRegion("git.list", x, listTop, w, y + h - listTop)
    surfaceClip(S, x, listTop, w, y + h - listTop)
    cy = listTop - g.listScroll
    if (g.staged > 0) {
        cy = _gitSection(g, "ПІДГОТОВЛЕНО ДО КОМІТУ", true, x, cy, w, listTop, y + h)
        cy = cy + 8
    }
    var nTree = 0
    for f in g.files { if (f[4]) { nTree = nTree + 1 } }
    if (nTree > 0) { cy = _gitSection(g, "ЗМІНИ", false, x, cy, w, listTop, y + h) }
    if (g.staged == 0) {
        for l in wrapLines("+ біля файла - лише його в коміт. Нічого не вибрано - «Коміт» бере всі зміни.", w - 28, 12) {
            cy = cy + 4
            if (cy > listTop - 20 && cy < y + h) { surfaceText(S, l, x + 14, cy, 12, C_DIM) }
            cy = cy + 12
        }
    }
    // скільки можна прокрутити
    var contentH = cy + g.listScroll - listTop
    g.listScroll = clamp(g.listScroll, 0, max(0, contentH - (y + h - listTop) + 20))
    surfaceUnclip(S)
    surfaceUnclip(S)
}

// Розділ списку змін; повертає y після нього.
func _gitSection(g, title, staged, x, cy, w, top, bottom) {
    var n = 0
    for f in g.files {
        if ((staged && f[3]) || (!staged && f[4])) { n = n + 1 }
    }
    if (cy > top - 30 && cy < bottom) {
        surfaceText(S, title + " (" + toString(n) + ")", x + 14, cy + 4, 13, C_SUBTEXT, true)
        // усі одразу: + / −
        var allId = "git.stageall"
        var allLbl = "+"
        if (staged) {
            allId = "git.unstageall"
            allLbl = "−"
        }
        _gitIconBtn(allId, allLbl, x + w - 34, cy, C_SUBTEXT)
    }
    cy = cy + 26
    for f in g.files {
        if (!((staged && f[3]) || (!staged && f[4]))) { continue }
        if (cy > top - 24 && cy < bottom) {
            var hov = uiHover(x, cy, w, 24) && uiHover(x, top, w, bottom - top)
            if (hov) { surfaceRect(S, x, cy, w, 24, C_BG) }
            var name = _gitBase(f[1])
            var nw = surfaceText(S, uiFit(name, w - 110, 15), x + 14, cy + 4, 15, C_TEXT)
            var dirPart = substring(f[1], 0, len(f[1]) - len(name))
            if (dirPart != "") { surfaceText(S, uiFit(dirPart, w - nw - 110, 12), x + 22 + nw, cy + 6, 12, C_DIM) }
            surfaceText(S, f[0], x + w - 24, cy + 4, 15, gitLetterColor(f[0]), true)
            var prefix = "git.file:"
            if (staged) { prefix = "git.sfile:" }
            uiRegion(prefix + f[2], x, cy, w, 24)
            if (staged) { _gitIconBtn("git.unstage:" + f[2], "−", x + w - 52, cy, C_SUBTEXT) }
            else {
                _gitIconBtn("git.discard:" + f[2], "undo", x + w - 76, cy, C_SUBTEXT)
                _gitIconBtn("git.stage:" + f[2], "+", x + w - 52, cy, C_SUBTEXT)
            }
        }
        cy = cy + 24
    }
    return cy
}

// Підказки до кнопок-значків (IDE показує g.tip біля миші).
var GIT_TIPS = [["git.stageall", "Підготувати всі до коміту"], ["git.unstageall", "Прибрати всі з підготовлених"],
    ["git.stage:", "У коміт (підготувати)"], ["git.unstage:", "Прибрати з коміту"], ["git.discard:", "Скасувати зміни файла"]]

func _gitIconBtn(id, label, x, y, col) {
    if (uiHover(x, y + 2, 22, 20)) {
        surfaceRoundRect(S, x, y + 2, 22, 20, 4, C_SURFACE2)
        for t in GIT_TIPS { if (startsWith(id, t[0])) { GIT_TIP = t[1] } }
    }
    if (label == "undo") { iconUndo(x + 3, y + 4, 16, col) }
    else {
        var lw = textWidth(label, 16)
        surfaceText(S, label, x + toInt((22 - lw) / 2), y + 2, 16, col, true)
    }
    uiRegion(id, x, y + 2, 22, 20)
}

// Вкладка «Історія»: коміти -> файли коміту -> що змінилось у файлі.
func _drawHistory(g, x, y, w, h) {
    var cy = y
    if (g.logFile != "") {
        uiButton("git.logback", "← Файли коміту", x + 8, cy, 150, 28, "flat")
        cy = cy + 34
        surfaceText(S, uiFit(_gitBase(g.logFile), w - 28, 14), x + 14, cy, 14, C_TEXT, true)
        cy = cy + 22
        _drawDiff(g.diff, g.scroll, x, cy, w, y + h - cy)
        uiRegion("git.diff", x, cy, w, y + h - cy)
        return
    }
    if (g.logSel != "") {
        uiButton("git.logback", "← Усі коміти", x + 8, cy, 130, 28, "flat")
        cy = cy + 34
        var c = null
        for e in g.log { if (e[0] == g.logSel) { c = e } }
        if (c != null) {
            for l in wrapLines(c[4], w - 28, 14) {
                surfaceText(S, l, x + 14, cy, 14, C_TEXT, true)
                cy = cy + 18
            }
            surfaceText(S, uiFit(c[1] + " · " + c[2] + " · " + c[3], w - 28, 12), x + 14, cy + 2, 12, C_DIM)
            cy = cy + 24
        }
        for f in g.logFiles {
            if (cy > y + h) { break }
            if (uiHover(x, cy, w, 24)) { surfaceRect(S, x, cy, w, 24, C_BG) }
            var name = _gitBase(f[1])
            var nw = surfaceText(S, uiFit(name, w - 60, 15), x + 14, cy + 4, 15, C_TEXT)
            var dirPart = substring(f[1], 0, len(f[1]) - len(name))
            if (dirPart != "") { surfaceText(S, uiFit(dirPart, w - nw - 60, 12), x + 22 + nw, cy + 6, 12, C_DIM) }
            surfaceText(S, f[0], x + w - 24, cy + 4, 15, gitLetterColor(f[0]), true)
            uiRegion("git.logfile:" + f[1], x, cy, w, 24)
            cy = cy + 24
        }
        return
    }
    if (len(g.log) == 0) {
        surfaceText(S, "Комітів ще нема.", x + 14, cy, 14, C_DIM)
        return
    }
    uiRegion("git.list", x, y, w, h)
    surfaceClip(S, x, y, w, h)
    cy = y - g.listScroll
    for e in g.log {
        if (cy > y - 44 && cy < y + h) {
            if (uiHover(x, cy, w, 42) && uiHover(x, y, w, h)) { surfaceRect(S, x, cy, w, 42, C_BG) }
            surfaceText(S, uiFit(e[4], w - 28, 14), x + 14, cy + 4, 14, C_TEXT)
            surfaceText(S, uiFit(e[1] + " · " + e[2] + " · " + e[3], w - 28, 12), x + 14, cy + 23, 12, C_DIM)
            uiRegion("git.commitsel:" + e[0], x, cy, w, 42)
        }
        cy = cy + 44
    }
    g.listScroll = clamp(g.listScroll, 0, max(0, len(g.log) * 44 - h + 20))
    surfaceUnclip(S)
}

func _drawDiff(d, scroll, x, y, w, h) {
    var prevFont = surfaceFont("mono")
    if (prevFont == "pixel") { surfaceFont("pixel") }
    var cw = textWidth("M", 14)
    var lh = 17
    var cy = y
    var row = 0
    var shown = 0
    for r in d {
        // лише змінене й по 2 рядки навколо - як у git diff
        if (row >= scroll && cy + lh < y + h) {
            var bg = -1
            var fg = C_DIM
            if (r[0] == "+") {
                bg = C_DIFF_ADD
                fg = C_GREEN
            }
            if (r[0] == "-") {
                bg = C_DIFF_DEL
                fg = C_RED
            }
            if (bg >= 0) { surfaceRect(S, x + 8, cy - 1, w - 16, lh, bg) }
            surfaceText(S, r[0], x + 12, cy, 14, fg)
            surfaceText(S, r[1], x + 12 + 2 * cw, cy, 14, fg)
            cy = cy + lh
            shown = shown + 1
        }
        row = row + 1
    }
    if (len(d) == 0) { surfaceText(S, "Без змін.", x + 14, y, 14, C_DIM) }
    surfaceFont(prevFont)
}

// Лише змінені рядки з 2 рядками контексту (у великому файлі зміна не губиться).
func gitCompactDiff(d) {
    var keep = []
    var n = len(d)
    var i = 0
    while (i < n) {
        append(keep, false)
        i = i + 1
    }
    i = 0
    while (i < n) {
        if (d[i][0] != " ") {
            var k = max(0, i - 2)
            while (k <= min(n - 1, i + 2)) {
                keep[k] = true
                k = k + 1
            }
        }
        i = i + 1
    }
    var out = []
    var gap = false
    i = 0
    while (i < n) {
        if (keep[i]) {
            if (gap && len(out) > 0) { append(out, [" ", "..."]) }
            append(out, d[i])
            gap = false
        } else { gap = true }
        i = i + 1
    }
    return out
}
